@echo off
REM ============================================================================
REM  deploy-all.bat
REM  Orchestrates a full deployment: one Controller node + multiple Agent nodes.
REM  Run from the solution root directory.
REM
REM  Edit the CONFIGURATION section below to define your environment, then run:
REM    deploy\deploy-all.bat
REM
REM  This script calls deploy-controller.bat and deploy-agent.bat for each node.
REM ============================================================================
setlocal enabledelayedexpansion

REM ????????????????????????????????????????????????????????????????????????????
REM ?  CONFIGURATION - Edit these values for your environment                  ?
REM ????????????????????????????????????????????????????????????????????????????

REM Controller settings
set "CONTROLLER_NODE=CONTROLLER01"
set "CONTROLLER_PORT=5100"

REM Agent nodes (space-separated list of machine names)
set "AGENT_NODES=AGENT01 AGENT02 AGENT03"
set "AGENT_PORT=5200"

REM WebApi (IIS) settings
set "WEBAPI_NODE=WEBSERVER01"
set "WEBAPI_IIS_SITE=TestControllerWeb"

REM ????????????????????????????????????????????????????????????????????????????
REM ?  DEPLOYMENT                                                              ?
REM ????????????????????????????????????????????????????????????????????????????

set "SCRIPT_DIR=%~dp0"
set "FAIL_COUNT=0"

echo.
echo ############################################################################
echo #  Full Deployment: Controller + Agents
echo ############################################################################
echo #  Controller : %CONTROLLER_NODE%:%CONTROLLER_PORT%
echo #  Agents     : %AGENT_NODES%
echo #  WebApi IIS : %WEBAPI_NODE% (site: %WEBAPI_IIS_SITE%)
echo ############################################################################
echo.

REM ?? Deploy Controller ??????????????????????????????????????????????????????
echo ==== Deploying Controller to %CONTROLLER_NODE% ====
call "%SCRIPT_DIR%deploy-controller.bat" %CONTROLLER_NODE% %CONTROLLER_PORT%
if errorlevel 1 (
    echo.
    echo **** FAILED: Controller deployment to %CONTROLLER_NODE% ****
    set /a FAIL_COUNT+=1
) else (
    echo.
    echo **** SUCCESS: Controller deployed to %CONTROLLER_NODE% ****
)
echo.

REM ?? Deploy Agents ??????????????????????????????????????????????????????????
for %%A in (%AGENT_NODES%) do (
    echo ==== Deploying Agent to %%A ====
    call "%SCRIPT_DIR%deploy-agent.bat" %%A %CONTROLLER_NODE% %AGENT_PORT% %CONTROLLER_PORT%
    if errorlevel 1 (
        echo.
        echo **** FAILED: Agent deployment to %%A ****
        set /a FAIL_COUNT+=1
    ) else (
        echo.
        echo **** SUCCESS: Agent deployed to %%A ****
    )
    echo.
)

REM ?? Deploy WebApi (IIS) ????????????????????????????????????????????????????
echo ==== Deploying WebApi to %WEBAPI_NODE% ====
call "%SCRIPT_DIR%deploy-webapi.bat" %WEBAPI_NODE% %WEBAPI_IIS_SITE%
if errorlevel 1 (
    echo.
    echo **** FAILED: WebApi deployment to %WEBAPI_NODE% ****
    set /a FAIL_COUNT+=1
) else (
    echo.
    echo **** SUCCESS: WebApi deployed to %WEBAPI_NODE% ****
)
echo.

REM ?? Summary ????????????????????????????????????????????????????????????????
echo.
echo ############################################################################
if %FAIL_COUNT% EQU 0 (
    echo #  All deployments completed successfully!
) else (
    echo #  Deployment finished with %FAIL_COUNT% failure(s). Review output above.
)
echo ############################################################################
echo.
echo  Topology:
echo    Controller: http://%CONTROLLER_NODE%:%CONTROLLER_PORT%
echo    WebApi:     http://%WEBAPI_NODE%/ (IIS: %WEBAPI_IIS_SITE%)
for %%A in (%AGENT_NODES%) do (
    echo    Agent:      http://%%A:%AGENT_PORT%  --^> Controller
)
echo.

endlocal
if %FAIL_COUNT% GTR 0 exit /b 1
