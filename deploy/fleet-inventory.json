{
  "$comment": [
    "Fleet inventory for deploy/Invoke-FleetDeployment.ps1.",
    "Tokens usable in configPatch values: $NODE, $GRPCPORT, $CONTROLLER, $CONTROLLERPORT, $WEBAPIPORT.",
    "'merge' adds a key ONLY when absent (non-destructive, safe to re-run).",
    "'set' forces a value every run - use only for values the deployer owns."
  ],

  "controller": {
    "node": "jvgr22",
    "sharePath": "C$\\TestControllerService",
    "publishDir": "publish\\controller",
    "grpcPort": 5100,
    "webApiPort": 5200,
    "processName": "TestControllerGrpc",
    "lockProbe": "TestControllerGrpc.dll",
    "launchMode": "Manual"
  },

  "agentDefaults": {
    "sharePath": "C$\\TestAgentService",
    "publishDir": "publish\\agent",
    "grpcPort": 5200,
    "taskName": "TestAgentGrpc Interactive",
    "processName": "TestAgentGrpc",
    "lockProbe": "TestAgentGrpc.dll",
    "launchMode": "ScheduledTask"
  },

  "agents": [
    { "node": "jvgr1" },
    { "node": "jvkpri" },
    { "node": "jvkbak" },
    { "node": "jvhist" },
    { "node": "jvgr2" },
    { "node": "warmgr" },
    { "node": "warmbak" },
    { "node": "warmhist" },
    { "node": "warmpri" }
  ],

  "$preserveNote": "robocopy /MIR DELETES destination files absent from the publish source. Everything here is host-local STATE, not a deliverable: omitting impact-*.db once destroyed 344 KB of ranker learning data on jvgr22. Verify with: compare the deployed folder against publish\\controller and add anything that is not a build artifact.",
  "preserveFiles": [
    "appsettings.json",
    "commandpolicy.json",
    "WatchList.xml",
    "orchestrator.db",
    "orchestrator.db-wal",
    "orchestrator.db-shm",
    "impact-index.db",
    "impact-index.db-wal",
    "impact-index.db-shm",
    "impact-outcomes.db",
    "impact-outcomes.db-wal",
    "impact-outcomes.db-shm"
  ],
  "preserveFolders": [ "Logs", "Data", "Parameters" ],

  "agentConfigPatch": {
    "merge": {
      "WindowsUpdate": {
        "Enabled": true,
        "PollIntervalSeconds": 300,
        "CoalescingWindowSeconds": 30,
        "MaxCoalescingSeconds": 300,
        "SnapshotIntervalSeconds": 3600,
        "StartupDelaySeconds": 20,
        "ScanTimeoutSeconds": 180,
        "ScanPendingUpdates": true,
        "WatchEventLog": true,
        "MaxReportedItems": 30
      }
    },
    "set": {
      "AgentSettings.AgentName": "$NODE",
      "AgentSettings.AgentEndpoint": "http://$NODE:$GRPCPORT",
      "AgentSettings.ControllerAddress": "http://$CONTROLLER:$CONTROLLERPORT"
    }
  },

  "controllerConfigPatch": {
    "$note": "'merge' adds a key only when absent, so a re-deploy never overwrites operator-tuned values and never touches server-specific settings such as VocabularyFile.",
    "merge": {
      "ImpactMapping": {
        "IndexRoot": null,
        "IndexStaleAfter": "14.00:00:00",
        "Persistence": {
          "Enabled": true,
          "NetworkPath": "\\\\dev\\link\\DevTransfer\\VJPersistence",
          "BackupInterval": "00:30:00",
          "StartupDelay": "00:02:00",
          "KeepVersions": 5,
          "IncludeIndex": false,
          "MergeAcrossHosts": true,
          "CanonicalFolderName": "_canonical",
          "HostId": ""
        }
      }
    },
    "set": {},
    "mergeAgentsList": true
  }
}
