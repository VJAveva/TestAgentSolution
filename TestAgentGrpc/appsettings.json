{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Grpc": "Debug"
    }
  },

  "AgentSettings": {
    "AgentName": null,
    "GrpcPort": 5200,
    "AllowPortFallback": false,
    "FallbackPorts": [ 5201, 5202, 5203 ],
    "ControllerAddress": "http://localhost:5100",
    "AgentEndpoint": null,

    "RegistrationRetryCount": 3,
    "RegistrationRetryIntervalSeconds": 5,
    "RegistrationCallTimeoutSeconds": 20,
    "AgentSharedSecret": "",

    "HeartbeatIntervalSeconds": 15,

    "MaxExecutionHistoryCount": 200,
    "MaxOutputLinesPerExecution": 5000,
    "CollectSystemMetrics": true,
    "MaxExecutionTimeoutMinutes": 20160,
    "WatchdogGraceMinutes": 60
  },

  "AgentKestrel": {
    "KeepAliveTimeoutMinutes": 20160,
    "DisableMinRequestBodyDataRate": true,
    "DisableMinResponseDataRate": true,
    "WarnOnPlaintextHttp2": true,
    "EnableTls": false,
    "TlsPort": 5443,
    "CertThumbprint": "",
    "CertFilePath": "",
    "CertPassword": "",
    "RequireClientCertificate": false
  },

  "CommandPolicy": {
    "Mode": "AuditOnly",
    "DetectShellChaining": true,
    "AllowedCommandPrefixes": [],
    "AllowlistPath": "commandpolicy.json",
    "BlockOnUnknown": false
  },

  "NotificationSettings": {
    "NotifyOnControllerLost": true,
    "NotifyOnControllerRecovered": true,
    "NotifyOnCommandReceived": false,
    "NotifyOnCommandCompleted": false
  },

  "AuditSettings": {
    "Enabled": true,
    "LogDirectory": "C:\\TestAgentSolution\\Logs\\audit",
    "RetentionDays": 30,
    "MaxFileSizeMb": 50,
    "LogHeartbeatEveryN": 10
  },

  "WindowsUpdate": {
    "//": "Windows Update posture detection. The agent reports pending updates + reboot-required to the controller, which drains the node from dispatch when a reboot is outstanding. Set Enabled=false to opt a node out entirely.",
    "Enabled": true,
    "PollIntervalSeconds": 300,
    "CoalescingWindowSeconds": 30,
    "MaxCoalescingSeconds": 300,
    "SnapshotIntervalSeconds": 3600,
    "StartupDelaySeconds": 20,
    "ScanTimeoutSeconds": 180,
    "ScanPendingUpdates": true,
    "WatchEventLog": true,
    "MaxReportedItems": 30
  }
}
