{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Grpc": "Debug"
    }
  },

  "AgentSettings": {
    "AgentName": null,
    "GrpcPort": 5200,
    "ControllerAddress": "http://localhost:5100",
    "AgentEndpoint": null,

    "RegistrationRetryCount": 3,
    "RegistrationRetryIntervalSeconds": 5,

    "HeartbeatIntervalSeconds": 15,

    "MaxExecutionHistoryCount": 200,
    "MaxOutputLinesPerExecution": 5000,
    "CollectSystemMetrics": true,
    "MaxExecutionTimeoutMinutes": 120
  },

  "AgentKestrel": {
    "KeepAliveTimeoutMinutes": 240,
    "DisableMinRequestBodyDataRate": true,
    "DisableMinResponseDataRate": true,
    "WarnOnPlaintextHttp2": true
  },

  "CommandPolicy": {
    "Mode": "AuditOnly",
    "DetectShellChaining": true,
    "AllowedCommandPrefixes": []
  },

  "NotificationSettings": {
    "NotifyOnControllerLost": true,
    "NotifyOnControllerRecovered": true,
    "NotifyOnCommandReceived": false,
    "NotifyOnCommandCompleted": false
  },

  "AuditSettings": {
    "Enabled": true,
    "LogDirectory": "C:\\TestAgentSolution\\Logs\\audit",
    "RetentionDays": 30,
    "MaxFileSizeMb": 50,
    "LogHeartbeatEveryN": 10
  }
}
