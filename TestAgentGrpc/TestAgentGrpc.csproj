<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>TestAgentGrpc</RootNamespace>
    <AssemblyName>TestAgentGrpc</AssemblyName>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Proto types are generated locally AND imported from TestControllerGrpc.Core (same .proto source).
         Local generation is intentional for gRPC server hosting; suppress the expected type-conflict warnings. -->
    <NoWarn>$(NoWarn);CS0436</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Grpc.AspNetCore" Version="2.62.0" />
    <PackageReference Include="Grpc.Net.Client" Version="2.62.0" />
    <PackageReference Include="Google.Protobuf" Version="3.26.1" />
    <PackageReference Include="Grpc.Tools" Version="2.62.0" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="..\TestControllerGrpc.Core\Protos\test_agent.proto" Link="Protos\test_agent.proto" GrpcServices="Both" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TestControllerGrpc.Core\TestControllerGrpc.Core.csproj" />
  </ItemGroup>

</Project>
