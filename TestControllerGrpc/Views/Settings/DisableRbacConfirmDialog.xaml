<Window x:Class="TestControllerGrpc.Views.Settings.DisableRbacConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Disable RBAC" Width="440" Height="300"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False" WindowStyle="ToolWindow"
        Background="{DynamicResource BgSurface}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Warning header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="âš  Disable RBAC" FontSize="{StaticResource FontSize16}" FontWeight="SemiBold"
                       Foreground="{DynamicResource AccRed}"/>
            <TextBlock TextWrapping="Wrap" FontSize="{StaticResource FontSize11}" Margin="0,8,0,0" Opacity="0.9"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Text="This will revoke all sessions, archive all users, and switch the system to Default mode. The WPF client will have unrestricted access. Web Client will be read-only."/>
        </StackPanel>

        <!-- Confirmation input -->
        <StackPanel Grid.Row="1">
            <TextBlock FontSize="{StaticResource FontSize11}" Margin="0,0,0,8"
                       Foreground="{DynamicResource TextSecondaryBrush}">
                <Run Text="Type "/>
                <Run Text="DISABLE RBAC" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                <Run Text=" to confirm:"/>
            </TextBlock>
            <TextBox Text="{Binding DisableConfirmText, UpdateSourceTrigger=PropertyChanged}"
                     FontFamily="Consolas" FontSize="{StaticResource FontSize14}" AutomationProperties.Name="Confirmation phrase" />
        </StackPanel>

        <!-- Error display -->
        <TextBlock Grid.Row="3" Text="{Binding DisableError}" Foreground="{DynamicResource AccRed}"
                   FontSize="{StaticResource FontSize11}" TextWrapping="Wrap" Margin="0,8,0,8"
                   Visibility="{Binding DisableError, Converter={StaticResource StringToVisConverter}, FallbackValue=Collapsed}"/>

        <!-- Buttons -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Margin="0,0,12,0" MinWidth="80"
                    IsCancel="True"/>
            <Button Content="Disable RBAC" MinWidth="120"
                    Command="{Binding ConfirmSwitchToDefaultCommand}"/>
        </StackPanel>
    </Grid>
</Window>
