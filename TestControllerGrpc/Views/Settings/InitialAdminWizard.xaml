<Window x:Class="TestControllerGrpc.Views.Settings.InitialAdminWizard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Switch to Secured Mode" Width="460" Height="420"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False" WindowStyle="ToolWindow"
        Background="{DynamicResource BgSurfaceBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Create Initial Administrator" FontSize="16" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}"/>
            <TextBlock TextWrapping="Wrap" FontSize="12" Margin="0,8,0,0" Opacity="0.8"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Text="This will enable RBAC. All current Web Client sessions will be disconnected and require login. In-flight pipelines will continue running under the new Admin account."/>
        </StackPanel>

        <!-- Form -->
        <StackPanel Grid.Row="1" Margin="0,0,0,12">
            <TextBlock Text="Username" FontSize="12" Margin="0,0,0,4"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
            <TextBox Text="{Binding WizardUsername, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,0,0,12"/>

            <TextBlock Text="Email" FontSize="12" Margin="0,0,0,4"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
            <TextBox Text="{Binding WizardEmail, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,0,0,12"/>

            <TextBlock Text="Password (min 12 characters)" FontSize="12" Margin="0,0,0,4"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
            <PasswordBox x:Name="PasswordBox" Margin="0,0,0,12"
                         PasswordChanged="PasswordBox_PasswordChanged"/>

            <TextBlock Text="Confirm Password" FontSize="12" Margin="0,0,0,4"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
            <PasswordBox x:Name="ConfirmPasswordBox" Margin="0,0,0,4"
                         PasswordChanged="ConfirmPasswordBox_PasswordChanged"/>
        </StackPanel>

        <!-- Error display -->
        <TextBlock Grid.Row="3" Text="{Binding WizardError}" Foreground="#FFF38BA8"
                   FontSize="12" TextWrapping="Wrap" Margin="0,0,0,12"
                   Visibility="{Binding WizardError, Converter={StaticResource StringToVisibility}}"/>

        <!-- Buttons -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Margin="0,0,12,0" MinWidth="80"
                    Command="{Binding CloseWizardCommand}"/>
            <Button Content="Enable Secured Mode" MinWidth="160"
                    Command="{Binding ConfirmSwitchToSecuredCommand}"
                    IsEnabled="{Binding IsWizardValid}"/>
        </StackPanel>
    </Grid>
</Window>
