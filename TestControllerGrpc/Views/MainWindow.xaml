                                                                <Border x:Name="Track" Width="36" Height="18" CornerRadius="9"
                                                                        Background="{DynamicResource BgSurface}" BorderThickness="1"
                                                                        BorderBrush="{DynamicResource Bdr}">
                                                                    <Ellipse x:Name="Thumb" Width="14" Height="14" Fill="{DynamicResource TextS}"
                                                                             HorizontalAlignment="Left" Margin="1,0,0,0" />
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsChecked" Value="True">
                                                                        <Setter TargetName="Track" Property="Background" Value="{DynamicResource Accent}" />
                                                                        <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Accent}" />
                                                                        <Setter TargetName="Thumb" Property="Fill" Value="White" />
                                                                        <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                                                                        <Setter TargetName="Thumb" Property="Margin" Value="0,0,1,0" />
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </ToggleButton.Template>
                                                    </ToggleButton>
                                                    <TextBlock Text="Simplified" FontSize="10" Foreground="{DynamicResource TextS}"
                                                               VerticalAlignment="Center" Margin="6,0,0,0" />
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="View" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource TextS}"
                                                   HorizontalAlignment="Center" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </TabItem>

                    <!-- ─── EXECUTION TAB ─── -->
                    <TabItem Header="EXECUTION">
                        <Border Background="{DynamicResource RibbonTabBg}" Padding="6,6" ClipToBounds="True">
                            <ScrollViewer Style="{StaticResource RibbonScrollViewer}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="{DynamicResource GroupBg}" CornerRadius="6" Padding="8,6" Margin="2">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Style="{StaticResource RibbonBtnGreen}" Command="{Binding TriggerAllWatchItemsCommand}"
                                                    ToolTip="Execute all enabled WatchItems (F5)">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <TextBlock Style="{StaticResource RibbonIconText}" Text="&#xE768;" Foreground="{DynamicResource AccGreen}" />
                                                    <TextBlock Text="Execute All" FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource RibbonBtnGreen}" Command="{Binding TriggerWatchItemCommand}"
                                                    ToolTip="Trigger selected WatchItem">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <TextBlock Style="{StaticResource RibbonIconText}" Text="&#xE769;" Foreground="{DynamicResource AccGreen}" />
                                                    <TextBlock Text="Trigger Item" FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource RibbonBtnGreen}" Command="{Binding TriggerEventCommand}"
                                                    ToolTip="Trigger selected Event">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <TextBlock Style="{StaticResource RibbonIconText}" Text="&#xEA80;" Foreground="{DynamicResource AccGreen}" />
                                                    <TextBlock Text="Trigger Event" FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource RibbonBtnGreen}" Command="{Binding ExecuteGroupCommand}"
                                                    ToolTip="Execute selected ActionGroup">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <TextBlock Style="{StaticResource RibbonIconText}" Text="&#xE8CB;" Foreground="{DynamicResource AccGreen}" />
                                                    <TextBlock Text="Exec Group" FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource RibbonBtnGreen}" Command="{Binding ExecuteSingleActionCommand}"
                                                    ToolTip="Execute selected Action">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <TextBlock Style="{StaticResource RibbonIconText}" Text="&#xEA80;" Foreground="{DynamicResource AccGreen}" />
                                                    <TextBlock Text="Exec Action" FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                        <TextBlock Text="Run" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource AccGreen}"
                                                   HorizontalAlignment="Center" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Width="1" Background="{DynamicResource Bdr}" Margin="4,8" />
                                <Border Background="{DynamicResource GroupBg}" CornerRadius="6" Padding="8,6" Margin="2">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Style="{StaticResource RibbonBtnYellow}" Command="{Binding ResetStatusCommand}"
                                                    ToolTip="Reset all execution status indicators">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <TextBlock Style="{StaticResource RibbonIconText}" Text="&#xE72C;" Foreground="{DynamicResource AccYellow}" />
                                                    <TextBlock Text="Reset Status" FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                                </StackPanel>
                                            </Button>
                                            <Border Background="{DynamicResource DangerBtnBg}" CornerRadius="4" Padding="0" Margin="2"
                                                    Visibility="{Binding IsExecuting, Converter={StaticResource BoolVis}}">
                                                <Button Style="{StaticResource RibbonBtnDanger}" Command="{Binding CancelExecutionCommand}"
                                                        ToolTip="Cancel the running execution (Shift+F5)">
                                                    <StackPanel HorizontalAlignment="Center">
                                                        <TextBlock Style="{StaticResource RibbonIconText}" Text="&#xE71A;" Foreground="{DynamicResource AccRed}" />
                                                        <TextBlock Text="Cancel" FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                                    </StackPanel>
                                                </Button>
                                            </Border>
                                            <Button Style="{StaticResource RibbonBtnYellow}" Command="{Binding RetryFailedCommand}"
                                                    ToolTip="Retry only the failed actions from the last execution (Ctrl+Shift+R)">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <TextBlock Style="{StaticResource RibbonIconText}" Text="&#xE72C;" Foreground="{DynamicResource AccPeach}" />
                                                    <TextBlock Text="Retry Failed" FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                        <TextBlock Text="Control" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource AccYellow}"
                                                   HorizontalAlignment="Center" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Width="1" Background="{DynamicResource Bdr}" Margin="4,8" />
                                <Border Background="{DynamicResource GroupBg}" CornerRadius="6" Padding="8,6" Margin="2">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Style="{StaticResource RibbonBtnAccent}" Command="{Binding ExecutionDashboard.OpenDashboardWindowCommand}"
                                                    ToolTip="Open Multi-Session Execution Dashboard (F12)">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <TextBlock Style="{StaticResource RibbonIconText}" Text="&#xE9F9;" Foreground="{DynamicResource Accent}" />
                                                    <TextBlock Text="Dashboard" FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                        <TextBlock Text="View" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource Accent}"
                                                   HorizontalAlignment="Center" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Width="1" Background="{DynamicResource Bdr}" Margin="4,8" />
                                <Border Background="{DynamicResource GroupBg}" CornerRadius="6" Padding="8,6" Margin="2">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Style="{StaticResource RibbonBtnAccent}" Command="{Binding CopyLogCommand}"
                                                    ToolTip="Copy all log entries to clipboard (Ctrl+Shift+C)">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <TextBlock Style="{StaticResource RibbonIconText}" Text="&#xE8C8;" Foreground="{DynamicResource Accent}" />
                                                    <TextBlock Text="Copy Log" FontSize="10" HorizontalAlignment="Center" Margin="0,1,0,0" />
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource RibbonBtnDanger}" Command="{Binding CopyFailedLogCommand}"
                                                    ToolTip="Copy only failed log entries">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <TextBlock Style="{StaticResource RibbonIconText}" Text="&#xE7BA;" Foreground="{DynamicResource AccRed}" />
                                                    <TextBlock Text="Copy Failed" FontSize="10" HorizontalAlignment="Center" Margin="0,1,0,0" />
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource RibbonBtnYellow}" Command="{Binding ClearLogCommand}"
                                                    ToolTip="Clear all log entries (Ctrl+Shift+L)">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <TextBlock Style="{StaticResource RibbonIconText}" Text="&#xE894;" Foreground="{DynamicResource AccYellow}" />
                                                    <TextBlock Text="Clear Log" FontSize="10" HorizontalAlignment="Center" Margin="0,1,0,0" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                        <TextBlock Text="Log" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource Accent}"
                                                   HorizontalAlignment="Center" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Width="1" Background="{DynamicResource Bdr}" Margin="4,8" />
                                <Border Background="{DynamicResource GroupBg}" CornerRadius="6" Padding="8,6" Margin="2">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <ToggleButton IsChecked="{Binding IsLogPanePinned}" Cursor="Hand"
                                                          ToolTip="Show/Hide Execution Log">
                                                <ToggleButton.Template>
                                                    <ControlTemplate TargetType="ToggleButton">
                                                        <Border x:Name="Track" Width="32" Height="16" CornerRadius="8"
                                                                Background="{DynamicResource Accent}" BorderThickness="1"
                                                                BorderBrush="{DynamicResource Accent}">
                                                            <Ellipse x:Name="Thumb" Width="12" Height="12" Fill="White"
                                                                     HorizontalAlignment="Right" Margin="0,0,1,0" />
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsChecked" Value="False">
                                                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource BgSurface}" />
                                                                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Bdr}" />
                                                                <Setter TargetName="Thumb" Property="Fill" Value="{DynamicResource TextS}" />
                                                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Left" />
                                                                <Setter TargetName="Thumb" Property="Margin" Value="1,0,0,0" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </ToggleButton.Template>
                                            </ToggleButton>
                                            <TextBlock Text="Execution Log" FontSize="11" Foreground="{DynamicResource TextP}"
                                                       VerticalAlignment="Center" Margin="6,0,0,0" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <ToggleButton IsChecked="{Binding IsAgentPanePinned}" Cursor="Hand"
                                                          ToolTip="Show/Hide Agent Panel">
                                                <ToggleButton.Template>
                                                    <ControlTemplate TargetType="ToggleButton">
                                                        <Border x:Name="Track" Width="32" Height="16" CornerRadius="8"
                                                                Background="{DynamicResource Accent}" BorderThickness="1"
                                                                BorderBrush="{DynamicResource Accent}">
                                                            <Ellipse x:Name="Thumb" Width="12" Height="12" Fill="White"
                                                                     HorizontalAlignment="Right" Margin="0,0,1,0" />
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsChecked" Value="False">
                                                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource BgSurface}" />
                                                                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Bdr}" />
                                                                <Setter TargetName="Thumb" Property="Fill" Value="{DynamicResource TextS}" />
                                                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Left" />
                                                                <Setter TargetName="Thumb" Property="Margin" Value="1,0,0,0" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </ToggleButton.Template>
                                            </ToggleButton>
                                            <TextBlock Text="Agent Panel" FontSize="11" Foreground="{DynamicResource TextP}"
                                                       VerticalAlignment="Center" Margin="6,0,0,0" />
                                        </StackPanel>
                                        <TextBlock Text="Panels" FontSize="9" FontWeight="Bold"
                                                   Foreground="{DynamicResource TextS}"
                                                   HorizontalAlignment="Center" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </TabItem>
                    <!-- ─── TOOLS TAB ─── -->
                    <TabItem Header="TOOLS">
                        <Border Background="{DynamicResource RibbonTabBg}" Padding="6,6" ClipToBounds="True">
                            <ScrollViewer Style="{StaticResource RibbonScrollViewer}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="{DynamicResource GroupBg}" CornerRadius="6" Padding="8,6" Margin="2">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Style="{StaticResource RibbonBtnGreen}" Command="{Binding OpenResultsCommand}"
                                                    ToolTip="Open the Results Dashboard window">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <TextBlock Style="{StaticResource RibbonIconText}" Text="&#xE9D9;" Foreground="{DynamicResource AccGreen}" />
                                                    <TextBlock Text="Results Viewer" FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource RibbonBtnGreen}" Command="{Binding OpenReportCardCommand}"
                                                    ToolTip="Open the Build Report Card">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <TextBlock Style="{StaticResource RibbonIconText}" Text="&#xE9F9;" Foreground="{DynamicResource AccGreen}" />
                                                    <TextBlock Text="Report Card" FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                        <TextBlock Text="Results" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource AccGreen}"
                                                   HorizontalAlignment="Center" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Width="1" Background="{DynamicResource Bdr}" Margin="4,8" />
                                <Border Background="{DynamicResource GroupBg}" CornerRadius="6" Padding="8,6" Margin="2">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Style="{StaticResource RibbonBtnAccent}" Command="{Binding OpenHelpCommand}"
                                                    ToolTip="Open Help &amp; Feature Guide (F1)">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <TextBlock Style="{StaticResource RibbonIconText}" Text="&#xE897;" Foreground="{DynamicResource Accent}" />
                                                    <TextBlock Text="Help" FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                        <TextBlock Text="Help" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource Accent}"
                                                   HorizontalAlignment="Center" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Width="1" Background="{DynamicResource Bdr}" Margin="4,8" />
                                <Border Background="{DynamicResource GroupBg}" CornerRadius="6" Padding="8,6" Margin="2">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Style="{StaticResource RibbonBtnYellow}" Command="{Binding OpenSettingsCommand}"
                                                    ToolTip="Open Security Mode settings">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <TextBlock Style="{StaticResource RibbonIconText}" Text="&#xE72E;" Foreground="{DynamicResource AccYellow}" />
                                                    <TextBlock Text="Security" FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                        <TextBlock Text="Security" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource AccYellow}"
                                                   HorizontalAlignment="Center" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </TabItem>

                    <!-- ─── ADMIN TAB (visible when User_Create capability present) ─── -->
                    <TabItem Header="ADMIN" x:Name="AdminTab"
                             Visibility="{Binding IsUsersTabVisible, Converter={StaticResource BoolVis}}">
                        <Border Background="{DynamicResource RibbonTabBg}" Padding="6,6" ClipToBounds="True">
                            <ScrollViewer Style="{StaticResource RibbonScrollViewer}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="{DynamicResource GroupBg}" CornerRadius="6" Padding="8,6" Margin="2">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Style="{StaticResource RibbonBtnMauve}" Command="{Binding OpenUserManagementCommand}"
                                                    ToolTip="Open User Management">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <TextBlock Style="{StaticResource RibbonIconText}" Text="&#xE77B;" Foreground="{DynamicResource AccMauve}" />
                                                    <TextBlock Text="Users" FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource RibbonBtnMauve}" Command="{Binding OpenAuditViewerCommand}"
                                                    ToolTip="Open Audit Log Viewer">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <TextBlock Style="{StaticResource RibbonIconText}" Text="&#xE7BA;" Foreground="{DynamicResource AccMauve}" />
                                                    <TextBlock Text="Audit Log" FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                        <TextBlock Text="Administration" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource AccMauve}"
                                                   HorizontalAlignment="Center" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </TabItem>
                </TabControl>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════ -->
        <!-- STATUSBAR — single consolidated row                       -->
        <!-- ═══════════════════════════════════════════════════════════ -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource BgPanel}" Padding="6,4"
                BorderBrush="{DynamicResource Bdr}" BorderThickness="0,1,0,0">
            <DockPanel>
                <!-- Far left: File path -->
                <TextBlock DockPanel.Dock="Left" FontSize="11" FontFamily="Consolas"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextS}" TextTrimming="CharacterEllipsis"
                           MaxWidth="250" ToolTip="{Binding VocabFilePath}" Margin="4,0,12,0">
                    <Run Text="{Binding VocabFilePath}" />
                </TextBlock>

                <!-- Far right: Health Pill + flyout -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="8,0,4,0"
                            VerticalAlignment="Center">
                    <ToggleButton x:Name="HealthPillToggle" Cursor="Hand"
                                  Padding="6,2" BorderThickness="1" VerticalAlignment="Center">
                        <ToggleButton.Template>
                            <ControlTemplate TargetType="ToggleButton">
                                <Border x:Name="PillBorder" CornerRadius="8" Padding="8,3"
                                        BorderThickness="1" BorderBrush="{DynamicResource Bdr}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource StatusSuccessBg}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HealthMetrics.OverallHealth}" Value="Amber">
                                                    <Setter Property="Background" Value="{DynamicResource RunningBadgeBg}" />
                                                    <Setter Property="BorderBrush" Value="#F0B070" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding HealthMetrics.OverallHealth}" Value="Red">
                                                    <Setter Property="Background" Value="{DynamicResource AlertErrorBg}" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource AccRed}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"
                                               Text="{Binding HealthMetrics.HealthPillText}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource StatusSuccessFg}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HealthMetrics.OverallHealth}" Value="Amber">
                                                        <Setter Property="Foreground" Value="#B87A30" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding HealthMetrics.OverallHealth}" Value="Red">
                                                        <Setter Property="Foreground" Value="{DynamicResource AccRed}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </ControlTemplate>
                        </ToggleButton.Template>
                    </ToggleButton>

                    <!-- Health flyout popup -->
                    <Popup IsOpen="{Binding IsChecked, ElementName=HealthPillToggle}"
                           PlacementTarget="{Binding ElementName=HealthPillToggle}"
                           Placement="Top" StaysOpen="False" AllowsTransparency="True"
                           PopupAnimation="Fade" VerticalOffset="-4">
                        <Border Background="{DynamicResource BgPanel}" BorderBrush="{DynamicResource Bdr}"
                                BorderThickness="1" CornerRadius="6" Padding="12,10"
                                MinWidth="280" MaxWidth="400" MaxHeight="260">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10" Opacity="0.25" ShadowDepth="3" Direction="270"/>
                            </Border.Effect>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <TextBlock FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextP}"
                                           Margin="0,0,0,8">
                                    <Run Text="Controller health — "/>
                                    <Run Text="{Binding HealthMetrics.IssueCount, Mode=OneWay}"/>
                                    <Run Text=" issue(s)"/>
                                </TextBlock>

                                <!-- Issue rows -->
                                <StackPanel Margin="0,0,0,4"
                                            Visibility="{Binding HealthMetrics.IsCritical, Converter={StaticResource BoolVis}}">
                                    <TextBlock FontSize="10" Foreground="{DynamicResource TextS}" TextWrapping="Wrap"
                                               Text="{Binding HealthMetrics.AlertSummary}" />
                                </StackPanel>

                                <!-- Detail metrics -->
                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="CPU" FontSize="10" Foreground="{DynamicResource TextS}" Margin="0,2" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Right" Margin="8,2"
                                               Foreground="{Binding HealthMetrics.CpuHealth, Converter={StaticResource HealthBrush}}">
                                        <Run Text="{Binding HealthMetrics.CpuPercent, StringFormat={}{0:F0}%, Mode=OneWay}" />
                                    </TextBlock>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Memory" FontSize="10" Foreground="{DynamicResource TextS}" Margin="0,2" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Right" Margin="8,2"
                                               Foreground="{Binding HealthMetrics.MemoryHealth, Converter={StaticResource HealthBrush}}">
                                        <Run Text="{Binding HealthMetrics.MemoryUsedGb, StringFormat={}{0:F1} GB, Mode=OneWay}" />
                                    </TextBlock>
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Disk" FontSize="10" Foreground="{DynamicResource TextS}" Margin="0,2" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Right" Margin="8,2"
                                               Foreground="{Binding HealthMetrics.DiskHealth, Converter={StaticResource HealthBrush}}">
                                        <Run Text="{Binding HealthMetrics.DiskPercent, StringFormat={}{0:F0}%, Mode=OneWay}" />
                                    </TextBlock>
                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Network" FontSize="10" Foreground="{DynamicResource TextS}" Margin="0,2" />
                                    <TextBlock Grid.Row="3" Grid.Column="1" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Right" Margin="8,2"
                                               Foreground="{Binding HealthMetrics.NetworkHealth, Converter={StaticResource HealthBrush}}">
                                        <Run Text="{Binding HealthMetrics.NetworkLatencyMs, StringFormat={}{0:F0} ms, Mode=OneWay}" />
                                    </TextBlock>
                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Agents" FontSize="10" Foreground="{DynamicResource TextS}" Margin="0,2" />
                                    <TextBlock Grid.Row="4" Grid.Column="1" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Right" Margin="8,2"
                                               Foreground="{Binding HealthMetrics.AgentsHealth, Converter={StaticResource HealthBrush}}">
                                        <Run Text="{Binding HealthMetrics.AgentsOnline, Mode=OneWay}" /><Run Text="/" /><Run Text="{Binding HealthMetrics.AgentsTotal, Mode=OneWay}" /><Run Text=" online" />
                                    </TextBlock>
                                </Grid>
                            </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Popup>
                </StackPanel>

                <!-- Right of metrics: thin divider before pill -->
                <Rectangle DockPanel.Dock="Right" Width="1" Fill="{DynamicResource Bdr}" Margin="8,4" Opacity="0.6" />

                <!-- Right: EXECUTING indicator -->
                <TextBlock DockPanel.Dock="Right" Text=" EXECUTING " Foreground="{DynamicResource AccRed}" FontWeight="Bold"
                           FontSize="11" VerticalAlignment="Center" Margin="6,0"
                           Visibility="{Binding IsExecuting, Converter={StaticResource BoolVis}}" />

                <!-- Center/Right: Metrics strip fills remaining space, right-aligned -->
                <views:HealthMetricsStrip DataContext="{Binding HealthMetrics}"
                                          HorizontalAlignment="Right" VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <!-- ═══════════════════════════════════════════════════════ -->
        <!-- MAIN CONTENT: 3-column, 3-row Grid                       -->
        <!-- Row 0 = Panels | Row 1 = Splitter | Row 2 = Log          -->
        <!-- ═══════════════════════════════════════════════════════ -->
        <Grid x:Name="MainContentGrid" SizeChanged="MainContentGrid_SizeChanged">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="250" />
                <RowDefinition Height="Auto" />
                <RowDefinition x:Name="RowLogPane" Height="2*" MinHeight="120" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ColTreePanel" Width="2.5*" MinWidth="220" /> <!-- Col 0: Tree -->
                <ColumnDefinition Width="Auto" />                    <!-- Col 1: Splitter -->
                <ColumnDefinition x:Name="ColNodeProperties" Width="5*" MinWidth="300" /> <!-- Col 2: Node Props -->
                <ColumnDefinition x:Name="ColAgentSplitter" Width="Auto" /> <!-- Col 3: Splitter -->
                <ColumnDefinition x:Name="ColAgentPanel" Width="2*" MinWidth="240" /> <!-- Col 4: Agents -->
            </Grid.ColumnDefinitions>

            <!-- ═══════════════════════════════════════════════════════ -->
            <!-- LEFT PANEL (Col 0, Row 0): TabControl                 -->
            <!-- ═══════════════════════════════════════════════════════ -->

            <!-- Collapsed tree pane: vertical restore tab -->
            <Border Grid.Column="0" Grid.Row="0" Background="{DynamicResource BgCard}"
                    Width="28" HorizontalAlignment="Left" VerticalAlignment="Stretch"
                    BorderBrush="{DynamicResource Bdr}" BorderThickness="0,0,1,0"
                    Visibility="{Binding IsTreePanePinned, Converter={StaticResource InvBoolVis}}">
                <Button Command="{Binding ShowTreePaneCommand}" Cursor="Hand"
                        ToolTip="Show WatchList tree (Ctrl+1)"
                        Background="Transparent" BorderThickness="0"
                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                    <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                               Foreground="{DynamicResource Accent}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               RenderTransformOrigin="0.5,0.5">
                        <TextBlock.LayoutTransform>
                            <RotateTransform Angle="-90" />
                        </TextBlock.LayoutTransform>
                    </TextBlock>
                </Button>
            </Border>

            <!-- Full tree panel (visible when pinned) -->
            <Border Grid.Column="0" Grid.Row="0" Background="{DynamicResource BgPanel}"
                    Visibility="{Binding IsTreePanePinned, Converter={StaticResource BoolVis}}">
                <TabControl Background="Transparent" BorderThickness="0" Padding="0">
                    <TabControl.Resources>
                        <Style TargetType="TabItem" BasedOn="{StaticResource LeftPanelTab}" />
                    </TabControl.Resources>

                    <!-- Test Plan Tab -->
                    <TabItem>
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" Margin="0,0,4,0" />
                                <TextBlock Text="Test Plans" VerticalAlignment="Center" />
                            </StackPanel>
                        </TabItem.Header>
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Margin="6,5,6,2">
                                <!-- Search / filter box -->
                                <Grid>
                                    <TextBox Text="{Binding TreeSearchText, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource Fld}" FontSize="11" Padding="22,4,24,4" Margin="0" />
                                    <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="12" IsHitTestVisible="False"
                                               VerticalAlignment="Center" Margin="6,0,0,0"
                                               Foreground="{DynamicResource TextS}" />
                                    <Button Content="✕" FontSize="9" Padding="4,2" Margin="0,2,2,5"
                                            Background="Transparent" BorderThickness="0" Cursor="Hand"
                                            Foreground="{DynamicResource TextS}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                            Command="{Binding ClearTreeSearchCommand}" ToolTip="Clear search" />
                                </Grid>
                            </StackPanel>
                            <TreeView x:Name="WatchListTreeView" ItemsSource="{Binding TreeRoots}"
                                      Background="Transparent" Foreground="{DynamicResource TextDefaultBrush}"
                                      BorderThickness="0" Margin="4,0,4,4" Padding="0,4"
                                      ItemContainerStyle="{StaticResource SpecTVI}"
                                      ItemTemplate="{StaticResource WatchTreeSpecTemplate}"
                                      AllowDrop="True" />
                        </DockPanel>
                    </TabItem>

                    <!-- Library Tab -->
                    <TabItem>
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" Margin="0,0,4,0" />
                                <TextBlock Text="Library" VerticalAlignment="Center" />
                            </StackPanel>
                        </TabItem.Header>
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Margin="6,5,6,2">
                                <!-- Search / filter box -->
                                <Grid>
                                    <TextBox Text="{Binding TemplateSearchText, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource Fld}" FontSize="11" Padding="22,4,24,4" Margin="0" />
                                    <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="12" IsHitTestVisible="False"
                                               VerticalAlignment="Center" Margin="6,0,0,0"
                                               Foreground="{DynamicResource TextS}" />
                                    <Button Content="✕" FontSize="9" Padding="4,2" Margin="0,2,2,5"
                                            Background="Transparent" BorderThickness="0" Cursor="Hand"
                                            Foreground="{DynamicResource TextS}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                            Command="{Binding ClearTemplateSearchCommand}" ToolTip="Clear search" />
                                </Grid>
                            </StackPanel>
                            <TreeView x:Name="TemplateTreeView" ItemsSource="{Binding TemplateRoots}"
                                      Background="Transparent" Foreground="{DynamicResource TextDefaultBrush}"
                                      BorderThickness="0" Margin="4,0,4,4" Padding="0,4"
                                      ItemContainerStyle="{StaticResource SpecTVI}"
                                      ItemTemplate="{StaticResource WatchTreeSpecTemplate}" />
                        </DockPanel>
                    </TabItem>

                    <!-- History Tab (read-only observer, no gRPC interaction) -->
                    <TabItem>
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE81C;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" Margin="0,0,4,0" />
                                <TextBlock Text="History" VerticalAlignment="Center" />
                            </StackPanel>
                        </TabItem.Header>
                        <panels:ExecutionHistoryPanel />
                    </TabItem>
                </TabControl>
            </Border>

            <!-- Vertical splitter: Left | Center -->
            <GridSplitter Grid.Column="1" Grid.Row="0" Width="4" Background="{DynamicResource BgSurface}"
                          HorizontalAlignment="Center" VerticalAlignment="Stretch"
                          ResizeBehavior="PreviousAndNext"
                          AutomationProperties.Name="Resize tree panel width"
                          Visibility="{Binding IsTreePanePinned, Converter={StaticResource BoolVis}}" />

            <!-- ═══════════════════════════════════════════════════════ -->
            <!-- CENTER PANEL (Col 2, Row 0): Node Properties          -->
            <!-- ═══════════════════════════════════════════════════════ -->

            <!-- Node Properties panel -->
            <Border Grid.Column="2" Grid.Row="0" Margin="5" Background="{DynamicResource BgPanel}" CornerRadius="6"
                    BorderBrush="{DynamicResource Bdr}" BorderThickness="1" DataContext="{Binding ActiveEditNode}">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="{DynamicResource BgCard}" Padding="12,8" CornerRadius="6,6,0,0">
                        <DockPanel>
                            <TextBlock Text="Node Properties" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource Accent}" />
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                                <Border CornerRadius="4" Padding="6,2" Margin="0,0,8,0"
                                        Background="{DynamicResource RunningBadgeBg}"
                                        Visibility="{Binding ExecutionStatus, Converter={StaticResource VisWhen}, ConverterParameter=Running}">
                                    <TextBlock Text="RUNNING" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Accent}" />
                                </Border>
                                <Border CornerRadius="4" Padding="6,2" Margin="0,0,8,0"
                                        Background="{DynamicResource SuccessBadgeBg}"
                                        Visibility="{Binding ExecutionStatus, Converter={StaticResource VisWhen}, ConverterParameter=Success}">
                                    <TextBlock Text="SUCCESS" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccGreen}" />
                                </Border>
                                <Border CornerRadius="4" Padding="6,2" Margin="0,0,8,0"
                                        Background="{DynamicResource FailedBadgeBg}"
                                        Visibility="{Binding ExecutionStatus, Converter={StaticResource VisWhen}, ConverterParameter=Failed}">
                                    <TextBlock Text="FAILED" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccRed}" />
                                </Border>
                                <Border CornerRadius="4" Padding="6,2" Margin="0,0,8,0"
                                        Background="{DynamicResource PartialBadgeBg}"
                                        Visibility="{Binding ExecutionStatus, Converter={StaticResource VisWhen}, ConverterParameter=PartialFailure}">
                                    <TextBlock Text="PARTIAL" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccPeach}" />
                                </Border>
                                <Border CornerRadius="4" Padding="6,2" Margin="0,0,8,0"
                                        Background="{DynamicResource CancelledBadgeBg}"
                                        Visibility="{Binding ExecutionStatus, Converter={StaticResource VisWhen}, ConverterParameter=Cancelled}">
                                    <TextBlock Text="CANCELLED" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextS}" />
                                </Border>
                                <TextBlock Text="{Binding NodeKind, StringFormat='[ {0} ]'}"
                                           Foreground="{DynamicResource AccMauve}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border DockPanel.Dock="Bottom" Padding="12,6" Background="{DynamicResource BgCard}" CornerRadius="0,0,6,6"
                            BorderBrush="{DynamicResource Bdr}" BorderThickness="0,1,0,0">
                        <Button Content="Apply Changes" Style="{StaticResource Btn}" HorizontalAlignment="Left"
                                Command="{Binding DataContext.ApplyChangesCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                    </Border>
                    <!-- Content area: watermark + properties (overlapped) -->
                    <Grid>
                        <!-- Watermark (behind, shown when no node selected) -->
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Margin="0,40,0,0"
                                    Visibility="{Binding DataContext.ShowWatermark,
                                        RelativeSource={RelativeSource AncestorType=Window},
                                        Converter={StaticResource BoolVis}}">
                            <Image Source="pack://application:,,,/Resources/nextgen_watermark.png"
                                   Width="340" Height="340"
                                   Opacity="{DynamicResource WatermarkOpacity}"
                                   HorizontalAlignment="Center"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                            <TextBlock Text="Select a node to view its properties"
                                       FontSize="12" Foreground="{DynamicResource TextS}"
                                       HorizontalAlignment="Center" Margin="0,12,0,0"
                                       Opacity="0.4" />
                        </StackPanel>

                        <!-- Properties (in front, shown when node selected) -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12,8"
                                      Visibility="{Binding DataContext.ShowWatermark,
                                          RelativeSource={RelativeSource AncestorType=Window},
                                          Converter={StaticResource InvBoolVis}}">
                            <StackPanel>
                                <!-- ===== WatchList (root) ===== -->
                            <StackPanel Visibility="{Binding NodeKind, Converter={StaticResource VisWhen}, ConverterParameter=WatchList, FallbackValue=Collapsed}">
                                <Border Background="{DynamicResource WatchRootBg}" CornerRadius="6" Padding="14" Margin="0,5">
                                    <StackPanel>
                                        <TextBlock Text="WatchList Root" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource AccGreen}" Margin="0,0,0,8" />
                                        <TextBlock Foreground="{DynamicResource TextS}" FontSize="12" Margin="0,2">
                                            <Run Text="File: " FontWeight="SemiBold" />
                                            <Run Text="{Binding DataContext.VocabFilePath, RelativeSource={RelativeSource AncestorType=Window}}" FontFamily="Consolas" />
                                        </TextBlock>
                                        <TextBlock Foreground="{DynamicResource TextS}" FontSize="12" Margin="0,2">
                                            <Run Text="Test Items: " FontWeight="SemiBold" />
                                            <Run Text="{Binding ChildCount, Mode=OneWay}" Foreground="{DynamicResource AccGreen}" FontWeight="Bold" />
                                        </TextBlock>
                                        <TextBlock Text="This is the single Test Plan root. Use + Test Item to add items, or Open to load from file."
                                                   FontSize="11" Foreground="{DynamicResource TextS}" TextWrapping="Wrap" Margin="0,8,0,0" FontStyle="Italic" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <!-- ===== TemplateList (root) ===== -->
                            <StackPanel Visibility="{Binding NodeKind, Converter={StaticResource VisWhen}, ConverterParameter=TemplateList, FallbackValue=Collapsed}">
                                <Border Background="{DynamicResource TemplateRootBg}" CornerRadius="6" Padding="14" Margin="0,5">
                                    <StackPanel>
                                        <TextBlock Text="Templates Root" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource AccMauve}" Margin="0,0,0,8" />
                                        <TextBlock Foreground="{DynamicResource TextS}" FontSize="12" Margin="0,2">
                                            <Run Text="Templates: " FontWeight="SemiBold" />
                                            <Run Text="{Binding ChildCount, Mode=OneWay}" Foreground="{DynamicResource AccMauve}" FontWeight="Bold" />
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                                <Border Background="{DynamicResource InfoBoxBg}" CornerRadius="4" Padding="8" Margin="0,5,0,0"
                                        BorderBrush="{DynamicResource Bdr}" BorderThickness="1">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Style="{StaticResource SmBtn}"
                                                Background="{DynamicResource AccMauve}" Foreground="{DynamicResource TreeBadgeFg}"
                                                Command="{Binding DataContext.EditTemplateXmlCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                ToolTip="Open Template XML Editor">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,4,0" />
                                                <TextBlock Text="Edit Template XML" />
                                            </StackPanel>
                                        </Button>
                                    </DockPanel>
                                </Border>
                            </StackPanel>
                            <!-- ===== WatchItem ===== -->
                            <StackPanel Visibility="{Binding NodeKind, Converter={StaticResource VisWhen}, ConverterParameter=WatchItem, FallbackValue=Collapsed}">
                                <Border Background="{DynamicResource WatchRootBg}" CornerRadius="4" Padding="8,6" Margin="0,0,0,8"
                                        BorderBrush="{DynamicResource AccGreen}" BorderThickness="1">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="▶ Trigger All Events" Style="{StaticResource TriggerOutlineBtn}"
                                                Command="{Binding DataContext.TriggerWatchItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                ToolTip="Manually execute all events for this WatchItem" />
                                        <TextBlock Text="Execute all events for this WatchItem" FontSize="11"
                                                   Foreground="{DynamicResource AccGreen}" VerticalAlignment="Center" />
                                    </DockPanel>
                                </Border>
                                <!-- General section -->
                                <Expander Style="{StaticResource SectionExpander}" IsExpanded="True">
                                    <Expander.Header>
                                        <TextBlock Text="GENERAL" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextS}" />
                                    </Expander.Header>
                                    <StackPanel Margin="0,4,0,0">
                                        <Label Content="TAG" Style="{StaticResource Lbl}" />
                                        <Grid>
                                            <TextBox Text="{Binding Tag, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Fld}" FontSize="14" FontWeight="Bold" />
                                            <TextBlock Text="e.g. MyWatchItem" IsHitTestVisible="False" FontSize="12.5" Padding="8,6"
                                                       Foreground="{DynamicResource PlaceholderFg}" VerticalAlignment="Center"
                                                       Visibility="{Binding Tag, Converter={StaticResource EmptyVis}}" />
                                        </Grid>
                                        <CheckBox Content="Enabled" IsChecked="{Binding IsEnabled}" Foreground="{DynamicResource TextP}" Margin="0,4" />
                                    </StackPanel>
                                </Expander>
                                <!-- Source section -->
                                <Expander Style="{StaticResource SectionExpander}" IsExpanded="True">
                                    <Expander.Header>
                                        <TextBlock Text="SOURCE" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextS}" />
                                    </Expander.Header>
                                    <StackPanel Margin="0,4,0,0">
                                        <Label Content="WATCH PATH" Style="{StaticResource Lbl}" />
                                        <Grid>
                                            <TextBox Text="{Binding WatchPath, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Fld}" FontFamily="Consolas" />
                                            <TextBlock Text="e.g. C:\WatchFolder" IsHitTestVisible="False" FontSize="12.5" FontFamily="Consolas" Padding="8,6"
                                                       Foreground="{DynamicResource PlaceholderFg}" VerticalAlignment="Center"
                                                       Visibility="{Binding WatchPath, Converter={StaticResource EmptyVis}}" />
                                        </Grid>
                                        <Label Content="FILTER" Style="{StaticResource Lbl}" />
                                        <Grid>
                                            <TextBox Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Fld}" FontFamily="Consolas" />
                                            <TextBlock Text="e.g. *.txt" IsHitTestVisible="False" FontSize="12.5" FontFamily="Consolas" Padding="8,6"
                                                       Foreground="{DynamicResource PlaceholderFg}" VerticalAlignment="Center"
                                                       Visibility="{Binding Filter, Converter={StaticResource EmptyVis}}" />
                                        </Grid>

                                        <!-- Trigger file metadata fields (read from Filter file) -->
                                        <TextBlock Text="TRIGGER FILE FIELDS" FontSize="10" FontWeight="Bold"
                                                   Foreground="{DynamicResource TextS}" Margin="0,12,0,4" />
                                        <Label Content="BUILD NUMBER FIELD" Style="{StaticResource Lbl}" />
                                        <TextBox Text="{Binding BuildNumberField, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Fld}" FontFamily="Consolas" />
                                        <Label Content="DROP LOCATION FIELD" Style="{StaticResource Lbl}" />
                                        <TextBox Text="{Binding DropLocationField, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Fld}" FontFamily="Consolas" />

                                        <!-- ══ Build Source ══ -->
                                        <TextBlock Text="BUILD SOURCE" Style="{StaticResource Sec}" />

                                        <Label Content="BUILD BASE PATH" Style="{StaticResource Lbl}" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0"
                                                     Text="{Binding BuildBasePath, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource Fld}"
                                                     FontFamily="Consolas" FontSize="11"
                                                     ToolTip="Network base path for builds (e.g., \\server\repl\Ado\SP\)" />
                                            <Button Grid.Column="1" Content="📂 Browse Build"
                                                    Style="{StaticResource SmBtn}" Margin="4,0,0,0"
                                                    Padding="8,4"
                                                    Background="{DynamicResource AccentBtnBg}"
                                                    Foreground="{DynamicResource Accent}"
                                                    Command="{Binding DataContext.BrowseBuildCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    ToolTip="Browse network path to select a build folder" />
                                        </Grid>

                                        <!-- Save the browsed build to the global file + every pipeline's parameter file -->
                                        <Button Margin="0,8,0,4" Padding="10,6" HorizontalAlignment="Left"
                                                Style="{StaticResource SmBtn}"
                                                Background="{DynamicResource AccentBtnBg}" Foreground="{DynamicResource Accent}"
                                                Command="{Binding DataContext.SaveBuildToAllFilesCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                ToolTip="Write the build selected via Browse Build (_BuildNumber and _DropLocation) to the global variables file and every pipeline's parameter file. All other parameters are preserved.">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,6,0" />
                                                <TextBlock Text="Save Build to All Pipelines" FontSize="11" FontWeight="SemiBold" />
                                            </StackPanel>
                                        </Button>

                                        <Label Content="SELECTED BUILD" Style="{StaticResource Lbl}"
                                               Visibility="{Binding SelectedBuildPath, Converter={StaticResource EmptyVis}}" />
                                        <TextBox Text="{Binding SelectedBuildPath, Mode=OneWay}"
                                                 Style="{StaticResource Fld}" IsReadOnly="True"
                                                 FontFamily="Consolas" FontSize="11"
                                                 Foreground="{DynamicResource AccGreen}"
                                                 Visibility="{Binding SelectedBuildPath, Converter={StaticResource EmptyVis}}"
                                                 ToolTip="Full path to selected build" />

                                        <!-- Select Build & Trigger button -->
                                        <Button Margin="0,8,0,4" Padding="10,6" HorizontalAlignment="Left"
                                                Visibility="{Binding SelectedBuildPath, Converter={StaticResource EmptyVis}}"
                                                Command="{Binding DataContext.SelectBuildAndTriggerCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                ToolTip="Write build info to Variables.txt and rename trigger file to start execution">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource TriggerBtn}">
                                                    <Setter Property="Background" Value="{DynamicResource GreenBtnBg}" />
                                                    <Setter Property="Foreground" Value="{DynamicResource AccGreen}" />
                                                </Style>
                                            </Button.Style>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="▶" FontSize="12" Margin="0,0,6,0" />
                                                <TextBlock Text="Select Build &amp; Trigger" FontSize="11" FontWeight="SemiBold" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Expander>
                                <!-- Action section -->
                                <Expander Style="{StaticResource SectionExpander}" IsExpanded="False">
                                    <Expander.Header>
                                        <TextBlock Text="ACTIONS" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextS}" />
                                    </Expander.Header>
                                    <Border Background="{DynamicResource InfoBoxBg}" CornerRadius="4" Padding="8,6" Margin="0,4,0,0"
                                            BorderBrush="{DynamicResource Bdr}" BorderThickness="1">
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Style="{StaticResource SmBtn}"
                                                    Background="{DynamicResource AccPeach}" Foreground="{DynamicResource TreeBadgeFg}"
                                                    Command="{Binding DataContext.ToggleXmlEditorCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    ToolTip="Open WatchItem XML Editor with validation, auto-fix, and structure preview">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,4,0" />
                                                    <TextBlock Text="Edit Test Item XML" />
                                                </StackPanel>
                                            </Button>
                                            <TextBlock Text="Test Item XML Editor" FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource AccPeach}" VerticalAlignment="Center" />
                                        </DockPanel>
                                    </Border>
                                </Expander>
                            </StackPanel>
                            <!-- ===== Event ===== -->
                            <StackPanel Visibility="{Binding NodeKind, Converter={StaticResource VisWhen}, ConverterParameter=Event, FallbackValue=Collapsed}">
                                <Border Background="{DynamicResource WatchRootBg}" CornerRadius="4" Padding="8" Margin="0,0,0,8"
                                        BorderBrush="{DynamicResource AccGreen}" BorderThickness="1">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="Trigger Event" Style="{StaticResource TriggerOutlineBtn}"
                                                Command="{Binding DataContext.TriggerEventCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                ToolTip="Manually execute this event's action pipeline" />
                                        <TextBlock Text="Execute this event's action pipeline" FontSize="11"
                                                   Foreground="{DynamicResource AccGreen}" VerticalAlignment="Center" />
                                    </DockPanel>
                                </Border>
                                <Label Content="EVENT TYPE" Style="{StaticResource Lbl}" />
                                <ComboBox ItemsSource="{StaticResource EventTypes}" SelectedItem="{Binding EventType}" Style="{StaticResource Cmb}" />
                                <Label Content="EXECUTION TYPE" Style="{StaticResource Lbl}" />
                                <ComboBox ItemsSource="{StaticResource ExecModes}" SelectedItem="{Binding ExecutionTypeText}" Style="{StaticResource Cmb}" />
                            </StackPanel>
                            <!-- ===== ActionGroup ===== -->
                            <StackPanel Visibility="{Binding NodeKind, Converter={StaticResource VisWhen}, ConverterParameter=ActionGroup, FallbackValue=Collapsed}">
                                <Label Content="TAG" Style="{StaticResource Lbl}" />
                                <TextBox Text="{Binding Tag, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Fld}" />
                                <Label Content="EXECUTION TYPE" Style="{StaticResource Lbl}" />
                                <ComboBox ItemsSource="{StaticResource ExecModes}" SelectedItem="{Binding ExecutionTypeText}" Style="{StaticResource Cmb}" />
                                <CheckBox Content="FailAndContinue" IsChecked="{Binding FailAndContinue}" Foreground="{DynamicResource TextP}" Margin="0,6" />
                            </StackPanel>
                            <!-- ===== Action ===== -->
                            <StackPanel Visibility="{Binding NodeKind, Converter={StaticResource VisWhen}, ConverterParameter=Action, FallbackValue=Collapsed}">
                                <Label Content="TAG" Style="{StaticResource Lbl}" />
                                <TextBox Text="{Binding Tag, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Fld}" />
                                <Label Content="ACTION TYPE" Style="{StaticResource Lbl}" />
                                <ComboBox ItemsSource="{StaticResource ActionTypes}" SelectedItem="{Binding ActionTypeText}" Style="{StaticResource Cmb}" />
                                <StackPanel Visibility="{Binding ActionTypeText, Converter={StaticResource ActionVis}, ConverterParameter=RunCommand|RunRemoteCommand}">
                                    <TextBlock Text="COMMAND SETTINGS" Style="{StaticResource Sec}" />
                                    <Label Content="COMMAND" Style="{StaticResource Lbl}" />
                                    <TextBox Text="{Binding Command, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Fld}" FontFamily="Consolas" />
                                    <Label Content="PARAMETERS" Style="{StaticResource Lbl}" />
                                    <TextBox Text="{Binding Parameters, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Fld}" FontFamily="Consolas"
                                             TextWrapping="Wrap" AcceptsReturn="True" Height="52" VerticalScrollBarVisibility="Auto" />
                                    <Label Content="RESOLVED PARAMETERS" Style="{StaticResource Lbl}" />
                                    <TextBox Text="{Binding ResolvedParameters, Mode=OneWay}" Style="{StaticResource Fld}" FontFamily="Consolas"
                                             IsReadOnly="True" Foreground="{DynamicResource AccGreen}"
                                             TextWrapping="Wrap" Height="52" VerticalScrollBarVisibility="Auto"
                                             ToolTip="Read-only: shows parameters with [Token] placeholders resolved" />
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <Label Content="TIMEOUT (seconds)" Style="{StaticResource Lbl}" />
                                            <TextBox Text="{Binding Timeout, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Fld}" />
                                            <TextBlock Text="0 = no timeout. For installs use 3600 (1h) or 7200 (2h)." />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <Label Content="POLL INTERVAL (ms)" Style="{StaticResource Lbl}" />
                                            <TextBox Text="{Binding PollInterval, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Fld}" />
                                        </StackPanel>
                                    </Grid>
                                    <Label Content="COMPLETION CHECK COMMAND" Style="{StaticResource Lbl}" />
                                    <TextBox Text="{Binding CompletionCheckCommand, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Fld}" FontFamily="Consolas"
                                             TextWrapping="Wrap" AcceptsReturn="False"
                                             ToolTip="Optional: command to poll after main process exits to detect child process completion. E.g. cmd /c tasklist | findstr msiexec || echo DONE" />
                                    <Grid Margin="0,0,0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="2*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <Label Content="CHECK INTERVAL (s)" Style="{StaticResource Lbl}" />
                                            <TextBox Text="{Binding CompletionPollIntervalSeconds, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Fld}"
                                                     ToolTip="How often to run the check command (seconds). Default: 30" />
                                        </StackPanel>
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Margin="0,5">
                                        <CheckBox Content="FailAndContinue" IsChecked="{Binding FailAndContinue}" Foreground="{DynamicResource TextP}" Margin="0,0,16,0" />
                                        <CheckBox Content="IsReboot" IsChecked="{Binding IsReboot}" Foreground="{DynamicResource TextP}" />
                                    </StackPanel>
                                        <!-- Smart Retry -->
                                        <TextBlock Text="SMART RETRY" Style="{StaticResource Sec}" />
                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" /><ColumnDefinition Width="12" />
                                                <ColumnDefinition Width="*" /><ColumnDefinition Width="12" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <Label Content="MAX RETRIES" Style="{StaticResource Lbl}" />
                                                <TextBox Text="{Binding MaxRetries, UpdateSourceTrigger=PropertyChanged}"
                                                         Style="{StaticResource Fld}"
                                                         ToolTip="0 = no retry. 1-5 = retry on failure. Each retry waits longer." />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <Label Content="RETRY DELAY (s)" Style="{StaticResource Lbl}" />
                                                <TextBox Text="{Binding RetryDelaySeconds, UpdateSourceTrigger=PropertyChanged}"
                                                         Style="{StaticResource Fld}"
                                                         ToolTip="Initial delay in seconds before first retry. Default: 10" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="4">
                                                <Label Content="BACKOFF" Style="{StaticResource Lbl}" />
                                                <TextBox Text="{Binding RetryBackoff, UpdateSourceTrigger=PropertyChanged}"
                                                         Style="{StaticResource Fld}"
                                                         ToolTip="Exponential = delay doubles each retry. Fixed = same delay every time." />
                                            </StackPanel>
                                        </Grid>
                                        <Label Content="RETRY ON EXIT CODES" Style="{StaticResource Lbl}" />
                                        <TextBox Text="{Binding RetryOnExitCodes, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource Fld}"
                                                 ToolTip="Comma-separated exit codes to retry on. Empty = retry on any failure. Example: -1,1,2" />
                                    </StackPanel>
                                <StackPanel Visibility="{Binding ActionTypeText, Converter={StaticResource ActionVis}, ConverterParameter=RunRemoteCommand}">
                                    <TextBlock Text="REMOTE AGENT" Style="{StaticResource Sec}" />
                                    <Label Content="AGENT NAME" Style="{StaticResource Lbl}" />
                                    <TextBox Text="{Binding AgentName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Fld}" />
                                    <Label Content="RESOLVED AGENT NAME" Style="{StaticResource Lbl}" />
                                    <TextBox Text="{Binding ResolvedAgentName, Mode=OneWay}" Style="{StaticResource Fld}"
                                             IsReadOnly="True" Foreground="{DynamicResource AccGreen}"
                                             ToolTip="Read-only: shows AgentName with [Token] placeholders resolved" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <Label Content="USERNAME" Style="{StaticResource Lbl}" />
                                            <TextBox Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Fld}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <Label Content="PASSWORD" Style="{StaticResource Lbl}" />
                                            <TextBox Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Fld}" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                                <StackPanel Visibility="{Binding ActionTypeText, Converter={StaticResource ActionVis}, ConverterParameter=SendMail}">
                                    <TextBlock Text="EMAIL SETTINGS" Style="{StaticResource Sec}" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <Label Content="FROM" Style="{StaticResource Lbl}" />
                                            <TextBox Text="{Binding From, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Fld}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <Label Content="TO" Style="{StaticResource Lbl}" />
                                            <TextBox Text="{Binding To, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Fld}" />
                                        </StackPanel>
                                    </Grid>
                                    <Label Content="TITLE" Style="{StaticResource Lbl}" />
                                    <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Fld}" />
                                    <Label Content="BODY" Style="{StaticResource Lbl}" />
                                    <TextBox Text="{Binding Body, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Fld}"
                                             TextWrapping="Wrap" AcceptsReturn="True" Height="60" VerticalScrollBarVisibility="Auto" />
                                    <Label Content="ATTACHMENT" Style="{StaticResource Lbl}" />
                                    <TextBox Text="{Binding Attachment, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Fld}" FontFamily="Consolas" />
                                    <Label Content="EMBED" Style="{StaticResource Lbl}" />
                                    <TextBox Text="{Binding Embed, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Fld}" FontFamily="Consolas" />
                                    <Label Content="LARGE FILES SHARE" Style="{StaticResource Lbl}" />
                                    <TextBox Text="{Binding LargeFilesShare, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Fld}" FontFamily="Consolas" />
                                </StackPanel>
                            </StackPanel>
                            <!-- ===== Initialize ===== -->
                            <StackPanel Visibility="{Binding NodeKind, Converter={StaticResource VisWhen}, ConverterParameter=Initialize, FallbackValue=Collapsed}">
                                <Label Content="TAG" Style="{StaticResource Lbl}" />
                                <TextBox Text="{Binding Tag, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Fld}" />

                                <Label Content="PARAMETER FILE" Style="{StaticResource Lbl}" Margin="0,8,0,0" />
                                <DockPanel>
                                    <Button Content="Browse..." DockPanel.Dock="Right" Margin="6,2,0,5"
                                            Style="{StaticResource SmBtn}"
                                            Command="{Binding DataContext.BrowseParameterFileCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                    <TextBox Text="{Binding ParameterFile, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource Fld}" FontFamily="Consolas" />
                                </DockPanel>

                                <!-- Parameters header + action buttons -->
                                <DockPanel Margin="0,12,0,4">
                                    <TextBlock Text="PARAMETERS" Foreground="{DynamicResource TextS}"
                                               FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                                        <Button Content="Reload" Style="{StaticResource SmBtn}"
                                                Command="{Binding DataContext.LoadParameterFileFromNodeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                Margin="0,0,4,0" />
                                        <Button Content="Save File" Style="{StaticResource SmBtn}"
                                                Command="{Binding DataContext.SaveParameterFileCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                    </StackPanel>
                                </DockPanel>

                                <!-- Parameter DataGrid -->
                                <DataGrid ItemsSource="{Binding DataContext.ParameterFileEntries, RelativeSource={RelativeSource AncestorType=Window}}"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False" CanUserDeleteRows="False"
                                          CanUserSortColumns="False"
                                          HeadersVisibility="Column"
                                          GridLinesVisibility="Horizontal"
                                          Background="Transparent"
                                          Foreground="{DynamicResource TextP}"
                                          BorderThickness="1"
                                          BorderBrush="{DynamicResource Bdr}"
                                          RowBackground="{DynamicResource BtnBg}"
                                          AlternatingRowBackground="{DynamicResource InfoBoxBg}"
                                          MaxHeight="200"
                                          Margin="0,0,0,4">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Key" Width="*"
                                            Binding="{Binding Key, UpdateSourceTrigger=PropertyChanged}"
                                            Foreground="{DynamicResource TextP}" />
                                        <DataGridTextColumn Header="Value" Width="2*"
                                            Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                            Foreground="{DynamicResource TextP}" />
                                        <DataGridTemplateColumn Header="" Width="30">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Content="✕" FontSize="10"
                                                            Background="Transparent" Foreground="{DynamicResource AccRed}"
                                                            BorderThickness="0" Cursor="Hand" Padding="4,0"
                                                            Command="{Binding DataContext.RemoveParameterEntryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <!-- Add Parameter button -->
                                <Button Content="+ Add Parameter" HorizontalAlignment="Left"
                                        Style="{StaticResource SmBtn}" Margin="0,0,0,8"
                                        Command="{Binding DataContext.AddParameterEntryCommand, RelativeSource={RelativeSource AncestorType=Window}}" />

                                <!-- Status message -->
                                <TextBlock Text="{Binding DataContext.ParameterFileStatus, RelativeSource={RelativeSource AncestorType=Window}}"
                                           FontSize="10" FontStyle="Italic"
                                           Foreground="{DynamicResource TextS}"
                                           TextWrapping="Wrap" Margin="0,0,0,4" />

                                <!-- Help text -->
                                <TextBlock TextWrapping="Wrap" FontSize="10" Foreground="{DynamicResource TextS}">
                                    <Run Text="ⓘ" FontWeight="Bold" />
                                    <Run Text=" Use [Key] tokens in sibling Action commands. Example: [ServerName] resolves to the value defined above." />
                                </TextBlock>
                            </StackPanel>
                            <!-- ===== Ref ===== -->
                            <StackPanel Visibility="{Binding NodeKind, Converter={StaticResource VisWhen}, ConverterParameter=Ref, FallbackValue=Collapsed}">
                                <Label Content="TEMPLATE ID" Style="{StaticResource Lbl}" />
                                <TextBox Text="{Binding TemplateID, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Fld}" />
                                <TextBlock TextWrapping="Wrap" FontSize="10" Foreground="{DynamicResource TextS}" Margin="0,4">
                                    <Run Text="ⓘ" FontWeight="Bold" />
                                    <Run Text=" This node expands to the children of the referenced Template at execution time." />
                                </TextBlock>
                            </StackPanel>

                            <!-- ══ Execution Error Panel ══ -->
                            <Border Margin="0,12,0,0" Padding="8" CornerRadius="4"
                                    Background="{DynamicResource AlertErrorBg}" BorderBrush="{DynamicResource AlertErrorBdr}" BorderThickness="1">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding LastExecutionError}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="&#x2716;" Foreground="{DynamicResource AccRed}" FontWeight="Bold"
                                                   FontSize="12" Margin="0,0,4,0" />
                                        <TextBlock Text="LAST EXECUTION ERROR" FontSize="10"
                                                   FontWeight="Bold" Foreground="{DynamicResource AccRed}" />
                                        <TextBlock Text="{Binding LastExitCode, StringFormat=' (exit {0})'}"
                                                   FontSize="10" Foreground="{DynamicResource TextS}"
                                                   Margin="4,0,0,0" />
                                    </StackPanel>
                                    <TextBox Text="{Binding LastExecutionError, Mode=OneWay}"
                                             IsReadOnly="True" TextWrapping="Wrap"
                                             Background="Transparent" BorderThickness="0"
                                             Foreground="{DynamicResource AccRed}" FontFamily="Consolas" FontSize="11"
                                             MaxHeight="100" VerticalScrollBarVisibility="Auto" />
                                </StackPanel>
                            </Border>
                                        </StackPanel>
                                    </ScrollViewer>
                                </Grid>
                            </DockPanel>
                        </Border>

            <!-- ═══════════════════════════════════════════════════════ -->
            <!-- INLINE XML EDITOR PANEL (Col 2, Row 0): overlays center panel -->
            <!-- ═══════════════════════════════════════════════════════ -->
            <Border Grid.Column="2" Grid.Row="0" Margin="5" Background="{DynamicResource BgPanel}" CornerRadius="6"
                    BorderBrush="{DynamicResource Accent}" BorderThickness="2"
                    Visibility="{Binding IsInlineXmlEditorVisible, Converter={StaticResource BoolVis}}">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="{DynamicResource BgCard}" Padding="12,8" CornerRadius="6,6,0,0">
                        <DockPanel>
                            <TextBlock FontSize="14" FontWeight="Bold" Foreground="{DynamicResource Accent}">
                                <Run Text="XML Editor" />
                                <Run Text=" — " Foreground="{DynamicResource TextS}" />
                                <Run Text="{Binding InlineXmlEditorScope, Mode=OneWay}" Foreground="{DynamicResource AccMauve}" />
                            </TextBlock>
                            <Button DockPanel.Dock="Right" Content="✕ Close" Style="{StaticResource SmBtn}" HorizontalAlignment="Right"
                                    Background="{DynamicResource DangerBtnBg}" Foreground="{DynamicResource AccRed}"
                                    Command="{Binding ToggleInlineXmlEditorCommand}" ToolTip="Close inline XML editor" />
                        </DockPanel>
                    </Border>
                    <Border DockPanel.Dock="Bottom" Padding="12,6" Background="{DynamicResource BgCard}" CornerRadius="0,0,6,6"
                            BorderBrush="{DynamicResource Bdr}" BorderThickness="0,1,0,0">
                        <DockPanel>
                            <Button Content="Apply XML" Style="{StaticResource Btn}" HorizontalAlignment="Left"
                                    Command="{Binding ApplyInlineXmlCommand}" />
                            <TextBlock Text="{Binding InlineXmlEditorStatus}" FontSize="11" FontFamily="Consolas"
                                       Foreground="{DynamicResource AccYellow}" VerticalAlignment="Center" Margin="12,0,0,0"
                                       TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                    </Border>
                    <!-- AvalonEdit host — instantiated in code-behind -->
                    <Border x:Name="InlineXmlEditorHost" Background="{DynamicResource FieldBg}" Margin="4" />
                </DockPanel>
            </Border>

            <!-- ═══════════════════════════════════════════════════════ -->
            <!-- VERTICAL SPLITTER: Center | Right                      -->
            <!-- ═══════════════════════════════════════════════════════ -->
            <GridSplitter Grid.Column="3" Grid.Row="0" Width="4" Background="{DynamicResource BgSurface}"
                          HorizontalAlignment="Center" VerticalAlignment="Stretch"
                          ResizeBehavior="PreviousAndNext"
                          AutomationProperties.Name="Resize agent panel width"
                          Visibility="{Binding IsAgentPanePinned, Converter={StaticResource BoolVis}}" />

            <!-- ═══════════════════════════════════════════════════════ -->
            <!-- RIGHT PANEL (Col 4, Row 0): Agents                    -->
            <!-- ═══════════════════════════════════════════════════════ -->
            <Border Grid.Column="4" Grid.Row="0" Margin="5" Background="{DynamicResource BgPanel}" CornerRadius="6"
                    BorderBrush="{DynamicResource Bdr}" BorderThickness="1"
                    Visibility="{Binding IsAgentPanePinned, Converter={StaticResource BoolVis}}">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="{DynamicResource BgCard}" Padding="10,6" CornerRadius="6,6,0,0">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <ToggleButton IsChecked="{Binding IsAgentPanePinned}" ToolTip="Pin / Auto-Hide"
                                              Width="20" Height="20" Padding="0" Background="Transparent"
                                              BorderThickness="0" Cursor="Hand">
                                    <ToggleButton.Style>
                                        <Style TargetType="ToggleButton">
                                            <Setter Property="Content">
                                                <Setter.Value>
                                                    <TextBlock Text="&#xE718;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                                               Foreground="{DynamicResource TextS}" />
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <Trigger Property="IsChecked" Value="False">
                                                    <Setter Property="Content">
                                                        <Setter.Value>
                                                            <TextBlock Text="&#xE718;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                                                       Foreground="{DynamicResource TextS}" Opacity="0.4" />
                                                        </Setter.Value>
                                                    </Setter>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ToggleButton.Style>
                                </ToggleButton>
                                <Button Command="{Binding ToggleAgentPanePinCommand}" ToolTip="Auto Hide"
                                        Width="20" Height="20" Padding="0" Background="Transparent"
                                        BorderThickness="0" Cursor="Hand" Margin="2,0">
                                    <TextBlock Text="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                               Foreground="{DynamicResource TextS}" />
                                </Button>
                                <Button Command="{Binding HideAgentPaneCommand}" ToolTip="Hide"
                                        Width="20" Height="20" Padding="0" Background="Transparent"
                                        BorderThickness="0" Cursor="Hand">
                                    <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                               Foreground="{DynamicResource TextS}" />
                                </Button>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Agents" FontSize="13" FontWeight="Bold"
                                           Foreground="{DynamicResource AccPeach}" Margin="0,0,6,0" />
                                <TextBlock FontSize="10" Foreground="{DynamicResource TextS}" VerticalAlignment="Center">
                                    <Run Text="(" /><Run Text="{Binding AgentWorkspace.Fleet.Cards.Count, Mode=OneWay}" /><Run Text=")" />
                                </TextBlock>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <aw:AgentWorkspaceView DataContext="{Binding AgentWorkspace}" />
                </DockPanel>
            </Border>


            <!-- Agent Auto-Hide Tab (visible only when agent pane is unpinned) -->
            <Border Grid.Column="4" Grid.Row="0" Width="28" HorizontalAlignment="Right"
                    Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Bdr}"
                    BorderThickness="1" CornerRadius="6"
                    Visibility="{Binding IsAgentPanePinned, Converter={StaticResource InvBoolVis}}">
                <Button Command="{Binding ShowAgentPaneCommand}"
                        Background="Transparent" BorderThickness="0" Cursor="Hand"
                        VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                    <Button.LayoutTransform>
                        <RotateTransform Angle="90" />
                    </Button.LayoutTransform>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                   Foreground="{DynamicResource AccPeach}" Margin="0,0,4,0" />
                        <TextBlock Text="Agents" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccPeach}" />
                        <TextBlock FontSize="9" Foreground="{DynamicResource TextS}" Margin="4,0,0,0">
                            <Run Text="(" /><Run Text="{Binding AgentWorkspace.Fleet.Cards.Count, Mode=OneWay}" /><Run Text=")" />
                        </TextBlock>
                    </StackPanel>
                </Button>
            </Border>

            <!-- ═══════════════════════════════════════════════════════ -->
            <!-- HORIZONTAL SPLITTER (Row 1, spans all columns)        -->
            <!-- ═══════════════════════════════════════════════════════ -->
            <GridSplitter Grid.Row="1" Grid.ColumnSpan="5" Height="4" HorizontalAlignment="Stretch"
                          Background="{DynamicResource BgSurface}" ResizeBehavior="PreviousAndNext"
                          AutomationProperties.Name="Resize log panel height"
                          Visibility="{Binding IsLogPanePinned, Converter={StaticResource BoolVis}}" />

            <!-- ═══════════════════════════════════════════════════════ -->
            <!-- EXECUTION LOG (Row 2, spans all columns)              -->
            <!-- ═══════════════════════════════════════════════════════ -->
            <Border Grid.Row="2" Grid.ColumnSpan="5" Margin="5,0,5,5" Background="{DynamicResource BgPanel}" CornerRadius="6"
                    BorderBrush="{DynamicResource Bdr}" BorderThickness="1"
                    Visibility="{Binding IsLogPanePinned, Converter={StaticResource BoolVis}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Row 0: Dockable Header -->
                    <Border Grid.Row="0" Background="{DynamicResource BgCard}" Padding="10,6" CornerRadius="6,6,0,0">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <ToggleButton IsChecked="{Binding IsLogPanePinned}" ToolTip="Pin / Auto-Hide"
                                              Width="22" Height="22" Padding="0" Background="Transparent"
                                              BorderThickness="0" Cursor="Hand">
                                    <ToggleButton.Style>
                                        <Style TargetType="ToggleButton">
                                            <Setter Property="Content">
                                                <Setter.Value>
                                                    <TextBlock Text="&#xE718;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                                               Foreground="{DynamicResource TextS}" />
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <Trigger Property="IsChecked" Value="False">
                                                    <Setter Property="Content">
                                                        <Setter.Value>
                                                            <TextBlock Text="&#xE718;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                                                       Foreground="{DynamicResource TextS}" Opacity="0.4" />
                                                        </Setter.Value>
                                                    </Setter>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ToggleButton.Style>
                                </ToggleButton>
                                <Button Command="{Binding ToggleLogCollapseCommand}" ToolTip="Collapse/Expand"
                                        Width="22" Height="22" Padding="0" Background="Transparent"
                                        BorderThickness="0" Cursor="Hand" Margin="2,0">
                                    <TextBlock FontSize="10" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource TextS}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="&#xE949;" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsLogCollapsed}" Value="True">
                                                        <Setter Property="Text" Value="&#xE948;" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Button>
                                <Button Command="{Binding ToggleLogPanePinCommand}" ToolTip="Auto Hide"
                                        Width="22" Height="22" Padding="0" Background="Transparent"
                                        BorderThickness="0" Cursor="Hand" Margin="2,0">
                                    <TextBlock Text="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                               Foreground="{DynamicResource TextS}" />
                                </Button>
                                <Button Command="{Binding HideLogPaneCommand}" ToolTip="Hide Log Pane"
                                        Width="22" Height="22" Padding="0" Background="Transparent"
                                        BorderThickness="0" Cursor="Hand">
                                    <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                               Foreground="{DynamicResource TextS}" />
                                </Button>
                            </StackPanel>
                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Execution Log" FontSize="13" FontWeight="Bold"
                                           Foreground="{DynamicResource AccGreen}"
                                           VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock FontSize="11" Foreground="{DynamicResource TextS}" VerticalAlignment="Center">
                                    <Run Text="(" /><Run Text="{Binding FilteredLogEntries.Count, Mode=OneWay}" FontWeight="Bold" /><Run Text=" entries" />
                                </TextBlock>
                                <!-- Error count badge -->
                                <Border CornerRadius="8" Padding="6,1" Margin="8,0,0,0"
                                        Background="{DynamicResource FailedBadgeBg}"
                                        Visibility="{Binding LogErrorCount, Converter={StaticResource IntToVis}}">
                                    <TextBlock FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccRed}">
                                        <Run Text="{Binding LogErrorCount, Mode=OneWay}" />
                                        <Run Text=" errors" />
                                    </TextBlock>
                                </Border>
                                <!-- Warning count badge -->
                                <Border CornerRadius="8" Padding="6,1" Margin="4,0,0,0"
                                        Background="{DynamicResource YellowBtnBg}"
                                        Visibility="{Binding LogWarningCount, Converter={StaticResource IntToVis}}">
                                    <TextBlock FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccYellow}">
                                        <Run Text="{Binding LogWarningCount, Mode=OneWay}" />
                                        <Run Text=" warn" />
                                    </TextBlock>
                                </Border>
                                <TextBlock Text=")" FontSize="11" Foreground="{DynamicResource TextS}" VerticalAlignment="Center" Margin="4,0,0,0" />
                                <TextBlock Text=" PAUSED" FontSize="10" FontWeight="Bold"
                                           Foreground="{DynamicResource AccYellow}"
                                           VerticalAlignment="Center" Margin="8,0,0,0"
                                           Visibility="{Binding IsLogPaused, Converter={StaticResource BoolVis}}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- Row 1: Enhanced Filter Bar -->
                    <Border Grid.Row="1" Background="{DynamicResource InfoBoxBg}" Padding="8,4"
                            Visibility="{Binding IsLogCollapsed, Converter={StaticResource InvBoolVis}}">
                        <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Session filter -->
                            <TextBlock Text="Session:" FontSize="10" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextS}" VerticalAlignment="Center" Margin="0,0,4,0" />
                            <ComboBox Width="80" ItemsSource="{Binding AvailableSessionIds}"
                                      SelectedItem="{Binding LogFilterSession}"
                                      Style="{StaticResource Cmb}" Margin="0,0,8,0"
                                      ToolTip="Filter by execution session" />

                            <!-- Pipeline filter -->
                            <TextBlock Text="Pipeline:" FontSize="10" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextS}" VerticalAlignment="Center" Margin="0,0,4,0" />
                            <ComboBox Width="140" ItemsSource="{Binding AvailableWatchItemTags}"
                                      SelectedItem="{Binding LogFilterTag}" IsEditable="True"
                                      Text="{Binding LogFilterTag, UpdateSourceTrigger=PropertyChanged}"
                                      Style="{StaticResource Cmb}" Margin="0,0,8,0"
                                      ToolTip="Filter by pipeline; the Agent list narrows to agents used in the selected pipeline" />

                            <!-- Agent filter -->
                            <TextBlock Text="Agent:" FontSize="10" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextS}" VerticalAlignment="Center" Margin="0,0,4,0" />
                            <ComboBox Width="100" ItemsSource="{Binding AvailableAgentNames}"
                                      SelectedItem="{Binding LogFilterAgent}" IsEditable="True"
                                      Text="{Binding LogFilterAgent, UpdateSourceTrigger=PropertyChanged}"
                                      Style="{StaticResource Cmb}" Margin="0,0,8,0" />

                            <!-- Level filter -->
                            <TextBlock Text="Level:" FontSize="10" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextS}" VerticalAlignment="Center" Margin="0,0,4,0" />
                            <ComboBox Width="80" ItemsSource="{Binding LogLevelOptions}"
                                      SelectedItem="{Binding LogLevelFilter}"
                                      Style="{StaticResource Cmb}" Margin="0,0,8,0" />

                            <!-- Search with regex toggle -->
                            <TextBlock Text="Search:" FontSize="10" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextS}" VerticalAlignment="Center" Margin="0,0,4,0" />
                            <TextBox x:Name="LogSearchBox" Width="150"
                                     Text="{Binding LogSearchText, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource Fld}" Margin="0,0,2,0" Padding="5,3"
                                     ToolTip="Search text or regex pattern (Ctrl+L to focus)" />
                            <ToggleButton IsChecked="{Binding IsRegexSearch}"
                                          Content=".*" FontFamily="Consolas" FontSize="10"
                                          Padding="4,3" MinWidth="28"
                                          ToolTip="Toggle regex search mode"
                                          Background="{DynamicResource BtnBg}" Foreground="{DynamicResource TextS}"
                                          BorderThickness="1" BorderBrush="{DynamicResource Bdr}" Cursor="Hand" />

                            <!-- Search match count -->
                            <TextBlock FontSize="9" Foreground="{DynamicResource TextS}" VerticalAlignment="Center"
                                       Margin="4,0,0,0"
                                       Visibility="{Binding LogSearchText, Converter={StaticResource NonEmptyVis}}">
                                <Run Text="{Binding SearchMatchCount, Mode=OneWay}" />
                                <Run Text=" matches" />
                            </TextBlock>

                            <Border Width="1" Background="{DynamicResource Bdr}" Margin="8,4" />

                            <!-- Quick toggles -->
                            <ToggleButton IsChecked="{Binding ShowErrorsOnly}"
                                          Padding="6,3" Margin="0,0,4,0"
                                          ToolTip="Show only errors"
                                          Background="{DynamicResource BtnBg}" Foreground="{DynamicResource TextS}"
                                          BorderThickness="1" BorderBrush="{DynamicResource Bdr}" Cursor="Hand">
                                <TextBlock Text="Errors Only" FontSize="10" />
                            </ToggleButton>

                            <Button Content="Reset" Style="{StaticResource SmBtn}" Padding="6,3"
                                    Command="{Binding ClearLogFilterCommand}" ToolTip="Reset all filters" />

                            <Border Width="1" Background="{DynamicResource Bdr}" Margin="8,4" />

                            <CheckBox Content="Auto-scroll" IsChecked="{Binding IsAutoScrollEnabled}"
                                      Foreground="{DynamicResource TextS}" FontSize="10" VerticalAlignment="Center" />
                        </WrapPanel>
                    </Border>

                    <!-- Row 2: Log Output (GAP 9 fix: virtualization enabled)
                         VirtualizingStackPanel ensures WPF only creates ListBoxItem containers
                         for visible rows, not all 10K entries. Recycling reuses discarded
                         containers. ScrollUnit=Pixel gives smooth scrolling. -->
                    <ListBox Grid.Row="2" x:Name="LogListBox" ItemsSource="{Binding FilteredLogEntries}" Background="Transparent"
                             BorderThickness="0" FontFamily="Consolas" FontSize="13" Padding="4,2"
                             SelectionMode="Extended"
                             VirtualizingStackPanel.IsVirtualizing="True"
                             VirtualizingStackPanel.VirtualizationMode="Recycling"
                             ScrollViewer.CanContentScroll="True"
                             VirtualizingPanel.ScrollUnit="Pixel"
                             Visibility="{Binding IsLogCollapsed, Converter={StaticResource InvBoolVis}}">
                        <ListBox.ContextMenu>
                            <ContextMenu Background="{DynamicResource BgCard}" Foreground="{DynamicResource TextP}"
                                         BorderBrush="{DynamicResource Bdr}">
                                <MenuItem Header="Copy Selected" Click="OnCopySelectedLog" />
                                <MenuItem Header="Copy All" Command="{Binding CopyLogCommand}" />
                                <MenuItem Header="Copy Failed Only" Command="{Binding CopyFailedLogCommand}" />
                                <Separator />
                                <MenuItem Header="Clear Log" Command="{Binding ClearLogCommand}" />
                            </ContextMenu>
                        </ListBox.ContextMenu>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="6,2" />
                                <Setter Property="Foreground" Value="{DynamicResource TextS}" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Bd" Padding="{TemplateBinding Padding}" Background="Transparent">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SelectedItemBg}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:LogEntryViewModel}">
                                <StackPanel Orientation="Horizontal" Margin="0,0.5">
                                    <!-- Session color dot -->
                                    <Ellipse Width="6" Height="6" Margin="0,0,4,0" VerticalAlignment="Center"
                                             Visibility="{Binding SessionId, Converter={StaticResource NonEmptyVis}}">
                                        <Ellipse.Fill>
                                            <SolidColorBrush Color="{Binding SessionColor}" />
                                        </Ellipse.Fill>
                                    </Ellipse>
                                    <!-- Timestamp -->
                                    <TextBlock FontFamily="Consolas" FontSize="10"
                                               Foreground="{DynamicResource TextS}" Margin="0,0,6,0">
                                        <Run Text="[" /><Run Text="{Binding Timestamp, Mode=OneWay}" /><Run Text="]" />
                                    </TextBlock>
                                    <!-- Session ID badge -->
                                    <Border CornerRadius="2" Padding="3,0" Margin="0,0,4,0"
                                            Visibility="{Binding SessionId, Converter={StaticResource NonEmptyVis}}">
                                        <Border.Background>
                                            <SolidColorBrush Color="{Binding SessionColor}" Opacity="0.15" />
                                        </Border.Background>
                                        <TextBlock Text="{Binding SessionId}" FontFamily="Consolas" FontSize="9"
                                                   FontWeight="Bold">
                                            <TextBlock.Foreground>
                                                <SolidColorBrush Color="{Binding SessionColor}" />
                                            </TextBlock.Foreground>
                                        </TextBlock>
                                    </Border>
                                    <!-- Message with severity coloring -->
                                    <TextBlock Text="{Binding Message}" FontFamily="Consolas" FontSize="11"
                                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource TextP}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Severity}" Value="Error">
                                                        <Setter Property="Foreground" Value="{DynamicResource AccRed}" />
                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Severity}" Value="Warning">
                                                        <Setter Property="Foreground" Value="{DynamicResource AccYellow}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Severity}" Value="Success">
                                                        <Setter Property="Foreground" Value="{DynamicResource AccGreen}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Row 3: Command Bar -->
                    <Border Grid.Row="3" Background="{DynamicResource BgCard}" Padding="8,5" CornerRadius="0,0,6,6"
                            BorderBrush="{DynamicResource Bdr}" BorderThickness="0,1,0,0"
                            Visibility="{Binding IsLogCollapsed, Converter={StaticResource InvBoolVis}}">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Style="{StaticResource SmBtn}" Command="{Binding ToggleLogPauseCommand}"
                                        ToolTip="Pause/Resume live log updates (Ctrl+Shift+P)">
                                    <TextBlock VerticalAlignment="Center" Margin="0,0,4,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="Pause" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsLogPaused}" Value="True">
                                                        <Setter Property="Text" Value="Resume" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Button>
                                <Button Content="Clear" Style="{StaticResource SmBtn}"
                                        Background="{DynamicResource YellowBtnBg}" Foreground="{DynamicResource AccYellow}"
                                        Command="{Binding ClearLogCommand}" ToolTip="Clear all log entries (Ctrl+Shift+L)" />
                                <Button Content="{Binding CopyButtonLabel}" Style="{StaticResource SmBtn}"
                                        Background="{DynamicResource AccentBtnBg}" Foreground="{DynamicResource Accent}"
                                        Command="{Binding CopyLogCommand}" ToolTip="Copy log entries to clipboard (Ctrl+Shift+C)" />
                                <Button Content="Copy Errors" Style="{StaticResource SmBtn}"
                                        Foreground="{DynamicResource AccRed}"
                                        Command="{Binding CopyFailedLogCommand}" ToolTip="Copy only error lines to clipboard" />
                                <Button Content="Export" Style="{StaticResource SmBtn}"
                                        Background="{DynamicResource GreenBtnBg}" Foreground="{DynamicResource AccGreen}"
                                        Command="{Binding ExportLogCommand}" ToolTip="Export to file (.log, .csv) (Ctrl+E)" />
                            </StackPanel>
                            <TextBlock/>
                        </DockPanel>
                    </Border>

                    <!-- Execution overlay spinner -->
                    <Border Grid.RowSpan="4" Background="{DynamicResource OverlayBg}" CornerRadius="6"
                            Visibility="{Binding IsExecuting, Converter={StaticResource BoolVis}}"
                            IsHitTestVisible="False">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="28" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center"
                                       FontWeight="Bold">
                                <TextBlock.RenderTransform>
                                    <RotateTransform Angle="0" CenterX="14" CenterY="14" />
                                </TextBlock.RenderTransform>
                                <TextBlock.Triggers>
                                    <EventTrigger RoutedEvent="Loaded">
                                        <BeginStoryboard>
                                            <Storyboard RepeatBehavior="Forever">
                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                 From="0" To="360" Duration="0:0:1.5" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </TextBlock.Triggers>
                            </TextBlock>
                            <TextBlock Text="Executing..." FontSize="11" Foreground="{DynamicResource Accent}"
                                       FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Log Auto-Hide Tab (visible only when log pane is unpinned) -->
            <Border Grid.Row="2" Grid.ColumnSpan="5" VerticalAlignment="Bottom" Height="28"
                    Margin="5,0,5,5"
                    Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Bdr}"
                    BorderThickness="1" CornerRadius="6"
                    Visibility="{Binding IsLogPanePinned, Converter={StaticResource InvBoolVis}}">
                <Button Command="{Binding ShowLogPaneCommand}"
                        Background="Transparent" BorderThickness="0" Cursor="Hand"
                        HorizontalAlignment="Left" Padding="12,4">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE7C5;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                   Foreground="{DynamicResource AccGreen}" Margin="0,0,6,0" />
                        <TextBlock Text="Execution Log" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccGreen}" />
                        <TextBlock FontSize="10" Foreground="{DynamicResource TextS}" Margin="6,0,0,0">
                            <Run Text="(" /><Run Text="{Binding FilteredLogEntries.Count, Mode=OneWay}" /><Run Text=")" />
                        </TextBlock>
                    </StackPanel>
                </Button>
            </Border>

        </Grid>
    </DockPanel>
</Window>
