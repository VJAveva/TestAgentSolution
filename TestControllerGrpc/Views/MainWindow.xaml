<Window x:Class="TestControllerGrpc.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        xmlns:vm="clr-namespace:TestControllerGrpc.ViewModels"
        Title="TestController  -  WatchList Editor"
        Height="900" Width="1400" MinWidth="1000" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBg}">

    <Window.Icon>
        <DrawingImage>
            <DrawingImage.Drawing>
                <GeometryDrawing Brush="#FF89B4FA" Geometry="M12,2 C6.48,2 2,6.48 2,12 C2,17.52 6.48,22 12,22 C17.52,22 22,17.52 22,12 C22,6.48 17.52,2 12,2 Z M10,17 L5,12 L6.41,10.59 L10,14.17 L17.59,6.58 L19,8 Z" />
            </DrawingImage.Drawing>
        </DrawingImage>
    </Window.Icon>

    <Window.Resources>
        <vm:NodeKindToVisibilityConverter x:Key="VisWhen" />
        <vm:ActionTypeFieldVisibilityConverter x:Key="ActionVis" />
        <vm:InverseBoolToVisibilityConverter x:Key="InvBoolVis" />
        <vm:NodeKindToIconBgConverter x:Key="IconBgConv" />
        <vm:StringEmptyToVisibilityConverter x:Key="EmptyVis" />
        <vm:EditingContextToVisibilityConverter x:Key="CtxVis" />
        <BooleanToVisibilityConverter x:Key="BoolVis" />

        <x:Array x:Key="EventTypes" Type="{x:Type sys:String}">
            <sys:String>Renamed</sys:String><sys:String>Created</sys:String><sys:String>Changed</sys:String>
        </x:Array>
        <x:Array x:Key="ExecModes" Type="{x:Type sys:String}">
            <sys:String>Sequential</sys:String><sys:String>Parallel</sys:String>
        </x:Array>
        <x:Array x:Key="ActionTypes" Type="{x:Type sys:String}">
            <sys:String>RunCommand</sys:String><sys:String>RunRemoteCommand</sys:String><sys:String>SendMail</sys:String>
        </x:Array>

        <!-- ── Base Styles ── -->
        <Style TargetType="Button" x:Key="Btn">
            <Setter Property="Background" Value="{DynamicResource Accent}" />
            <Setter Property="Foreground" Value="{DynamicResource TreeBadgeFg}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Margin" Value="3" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style TargetType="Button" x:Key="SmBtn" BasedOn="{StaticResource Btn}">
            <Setter Property="FontSize" Value="11" /><Setter Property="Padding" Value="8,4" /><Setter Property="Margin" Value="3" />
        </Style>
        <Style TargetType="Button" x:Key="DangerBtn" BasedOn="{StaticResource SmBtn}">
            <Setter Property="Background" Value="{DynamicResource DangerBtnBgAlt}" /><Setter Property="Foreground" Value="{DynamicResource AccRed}" />
        </Style>
        <Style TargetType="Button" x:Key="MoveBtn" BasedOn="{StaticResource SmBtn}">
            <Setter Property="Background" Value="{DynamicResource AccentBtnBg}" /><Setter Property="Foreground" Value="{DynamicResource Accent}" />
            <Setter Property="Padding" Value="7,3" /><Setter Property="MinWidth" Value="30" />
        </Style>
        <Style TargetType="Button" x:Key="TriggerBtn" BasedOn="{StaticResource SmBtn}">
            <Setter Property="Background" Value="{DynamicResource AccGreen}" /><Setter Property="Foreground" Value="{DynamicResource TreeBadgeFg}" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <!-- Secondary outline trigger button -->
        <Style TargetType="Button" x:Key="TriggerOutlineBtn" BasedOn="{StaticResource SmBtn}">
            <Setter Property="Background" Value="{DynamicResource GreenBtnBg}" />
            <Setter Property="Foreground" Value="{DynamicResource AccGreen}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style TargetType="TextBox" x:Key="Fld">
            <Setter Property="Background" Value="{DynamicResource FieldBg}" /><Setter Property="Foreground" Value="{DynamicResource TextP}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Bdr}" /><Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="6,4" /><Setter Property="FontSize" Value="12.5" /><Setter Property="Margin" Value="0,2,0,5" />
        </Style>
        <Style TargetType="Label" x:Key="Lbl">
            <Setter Property="Foreground" Value="{DynamicResource TextS}" /><Setter Property="FontSize" Value="11" />
            <Setter Property="Padding" Value="0,6,0,2" /><Setter Property="FontWeight" Value="Medium" />
        </Style>
        <Style TargetType="ComboBox" x:Key="Cmb">
            <Setter Property="Background" Value="{DynamicResource BgCard}" />
            <Setter Property="Foreground" Value="{DynamicResource TextP}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Bdr}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Margin" Value="0,2,0,5" />
            <Setter Property="Padding" Value="6,4" />
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="{DynamicResource BgCard}" />
            <Setter Property="Foreground" Value="{DynamicResource TextP}" />
            <Setter Property="Padding" Value="6,4" />
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Accent}" />
                    <Setter Property="Foreground" Value="{DynamicResource TreeBadgeFg}" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource BgSurface}" />
                    <Setter Property="Foreground" Value="{DynamicResource TextP}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Sec" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" /><Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource Accent}" /><Setter Property="Margin" Value="0,10,0,4" />
        </Style>
        <Style x:Key="TVI" TargetType="TreeViewItem">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
            <Setter Property="Visibility" Value="{Binding IsFilterVisible, Converter={StaticResource BoolVis}}" />
            <Setter Property="Foreground" Value="{DynamicResource TextP}" />
            <Setter Property="Padding" Value="2,3" /><Setter Property="Margin" Value="0,1" />
        </Style>

        <!-- ── Left-panel tab style ── -->
        <Style x:Key="LeftPanelTab" TargetType="TabItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextS}" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBd" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                BorderThickness="0,0,0,2" BorderBrush="Transparent"
                                SnapsToDevicePixels="True" Cursor="Hand">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBd" Property="BorderBrush" Value="{DynamicResource Accent}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextP}" />
                                <Setter TargetName="TabBd" Property="Background" Value="{DynamicResource TabSelectedBg}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBd" Property="Background" Value="{DynamicResource TabHoverBg}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Collapsible section (Expander) style ── -->
        <Style x:Key="SectionExpander" TargetType="Expander">
            <Setter Property="IsExpanded" Value="True" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="Foreground" Value="{DynamicResource TextP}" />
        </Style>

        <!-- ── Ribbon button styles ── -->
        <Style x:Key="RibbonBtn" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource BtnBg}" />
            <Setter Property="Foreground" Value="{DynamicResource TextP}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BtnBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="MinWidth" Value="52" />
            <Setter Property="Height" Value="52" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BtnHoverBg}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BtnPressedBg}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                                <Setter Property="Foreground" Value="{DynamicResource DisabledFg}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RibbonBtnAccent" TargetType="Button" BasedOn="{StaticResource RibbonBtn}">
            <Setter Property="Background" Value="{DynamicResource AccentBtnBg}" />
            <Setter Property="Foreground" Value="{DynamicResource Accent}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="RibbonBtnGreen" TargetType="Button" BasedOn="{StaticResource RibbonBtn}">
            <Setter Property="Background" Value="{DynamicResource GreenBtnBg}" />
            <Setter Property="Foreground" Value="{DynamicResource AccGreen}" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style x:Key="RibbonBtnDanger" TargetType="Button" BasedOn="{StaticResource RibbonBtn}">
            <Setter Property="Background" Value="{DynamicResource DangerBtnBg}" />
            <Setter Property="Foreground" Value="{DynamicResource AccRed}" />
        </Style>
        <Style x:Key="RibbonBtnMauve" TargetType="Button" BasedOn="{StaticResource RibbonBtn}">
            <Setter Property="Background" Value="{DynamicResource MauveBtnBg}" />
            <Setter Property="Foreground" Value="{DynamicResource AccMauve}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="RibbonBtnYellow" TargetType="Button" BasedOn="{StaticResource RibbonBtn}">
            <Setter Property="Background" Value="{DynamicResource YellowBtnBg}" />
            <Setter Property="Foreground" Value="{DynamicResource AccYellow}" />
        </Style>
        <Style x:Key="RibbonBtnLarge" TargetType="Button" BasedOn="{StaticResource RibbonBtn}">
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="MinWidth" Value="56" />
        </Style>

        <!-- ── Centralized Icon TextBlock styles (Segoe MDL2 Assets) ── -->
        <Style x:Key="IconText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Foreground" Value="{DynamicResource IconFg}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
        </Style>
        <Style x:Key="RibbonIconText" TargetType="TextBlock" BasedOn="{StaticResource IconText}">
            <Setter Property="FontSize" Value="20" />
        </Style>
        <Style x:Key="TreeIconText" TargetType="TextBlock" BasedOn="{StaticResource IconText}">
            <Setter Property="FontSize" Value="14" />
        </Style>

        <!-- ── Tree templates ── -->
        <HierarchicalDataTemplate x:Key="WatchTreeTemplate" DataType="{x:Type vm:TreeNodeViewModel}" ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal" Margin="0,1"
                        ToolTip="{Binding StatusTooltip}">
                <!-- Icon container: semantic glyph + status overlay dot -->
                <Grid Width="24" Height="20" Margin="0,0,5,0">
                    <!-- Icon background -->
                    <Border CornerRadius="4" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Width="22" Height="18"
                            Background="{Binding NodeKind, Converter={StaticResource IconBgConv}}">
                        <TextBlock Text="{Binding NodeIconGlyph}" Style="{StaticResource TreeIconText}"
                                   Foreground="{DynamicResource TextP}" />
                    </Border>
                    <!-- Status overlay dot (bottom-right corner) -->
                    <Ellipse Width="8" Height="8"
                             HorizontalAlignment="Right" VerticalAlignment="Bottom"
                             Margin="0,0,-1,-1" StrokeThickness="1.5">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Setter Property="Fill" Value="Transparent" />
                                <Setter Property="Stroke" Value="{DynamicResource BgPanel}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ExecutionStatus}" Value="Success">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Setter Property="Fill" Value="{DynamicResource StatusGreen}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ExecutionStatus}" Value="Failed">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Setter Property="Fill" Value="{DynamicResource StatusRed}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ExecutionStatus}" Value="Running">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Setter Property="Fill" Value="{DynamicResource StatusBlue}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Setter Property="Fill" Value="{DynamicResource StatusGray}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                </Grid>
                <!-- Node text with status-aware styling -->
                <TextBlock Text="{Binding ResolvedDisplayText}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="FontSize" Value="12" />
                            <Setter Property="Foreground" Value="{DynamicResource TextP}" />
                            <Setter Property="ToolTip" Value="{Binding StatusTooltip}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding NodeKind}" Value="WatchList">
                                    <Setter Property="FontWeight" Value="Bold" />
                                    <Setter Property="FontSize" Value="13" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ExecutionStatus}" Value="Failed">
                                    <Setter Property="Foreground" Value="{DynamicResource AccRed}" />
                                    <Setter Property="FontWeight" Value="Bold" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ExecutionStatus}" Value="Running">
                                    <Setter Property="Foreground" Value="{DynamicResource Accent}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ExecutionStatus}" Value="Success">
                                    <Setter Property="Foreground" Value="{DynamicResource AccGreen}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                    <Setter Property="Foreground" Value="{DynamicResource TextS}" />
                                    <Setter Property="FontStyle" Value="Italic" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding HasUnresolvedTokens}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource AccYellow}" />
                                    <Setter Property="ToolTip" Value="{Binding UnresolvedTokenTooltip}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <!-- Status symbol inline -->
                <TextBlock Text="{Binding StatusSymbol}" FontSize="11" FontWeight="Bold" Margin="6,0,0,0" VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Setter Property="Foreground" Value="Transparent" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ExecutionStatus}" Value="Running">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Setter Property="Foreground" Value="{DynamicResource Accent}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ExecutionStatus}" Value="Success">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Setter Property="Foreground" Value="{DynamicResource AccGreen}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ExecutionStatus}" Value="Failed">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Setter Property="Foreground" Value="{DynamicResource AccRed}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </HierarchicalDataTemplate>

        <HierarchicalDataTemplate x:Key="TemplateTreeTemplate" DataType="{x:Type vm:TreeNodeViewModel}" ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal" Margin="0,1"
                        ToolTip="{Binding StatusTooltip}">
                <!-- Icon container: semantic glyph + status overlay dot -->
                <Grid Width="24" Height="20" Margin="0,0,5,0">
                    <Border CornerRadius="4" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Width="22" Height="18"
                            Background="{Binding NodeKind, Converter={StaticResource IconBgConv}}">
                        <TextBlock Text="{Binding NodeIconGlyph}" Style="{StaticResource TreeIconText}"
                                   Foreground="{DynamicResource TextP}" />
                    </Border>
                    <!-- Status overlay dot -->
                    <Ellipse Width="8" Height="8"
                             HorizontalAlignment="Right" VerticalAlignment="Bottom"
                             Margin="0,0,-1,-1" StrokeThickness="1.5">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Setter Property="Fill" Value="Transparent" />
                                <Setter Property="Stroke" Value="{DynamicResource BgPanel}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ExecutionStatus}" Value="Success">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Setter Property="Fill" Value="{DynamicResource StatusGreen}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ExecutionStatus}" Value="Failed">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Setter Property="Fill" Value="{DynamicResource StatusRed}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ExecutionStatus}" Value="Running">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Setter Property="Fill" Value="{DynamicResource StatusBlue}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                </Grid>
                <!-- Node text with status-aware styling -->
                <TextBlock Text="{Binding ResolvedDisplayText}" FontSize="11.5" TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource TextP}" />
                            <Setter Property="ToolTip" Value="{Binding StatusTooltip}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding NodeKind}" Value="TemplateList">
                                    <Setter Property="FontWeight" Value="Bold" />
                                    <Setter Property="FontSize" Value="13" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ExecutionStatus}" Value="Failed">
                                    <Setter Property="Foreground" Value="{DynamicResource AccRed}" />
                                    <Setter Property="FontWeight" Value="Bold" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ExecutionStatus}" Value="Running">
                                    <Setter Property="Foreground" Value="{DynamicResource Accent}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ExecutionStatus}" Value="Success">
                                    <Setter Property="Foreground" Value="{DynamicResource AccGreen}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding HasUnresolvedTokens}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource AccYellow}" />
                                    <Setter Property="ToolTip" Value="{Binding UnresolvedTokenTooltip}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </HierarchicalDataTemplate>
    </Window.Resources>

    <DockPanel>
        <!-- ═══════════════════════════════════════════════════════════ -->
        <!-- RIBBON                                                    -->
        <!-- ═══════════════════════════════════════════════════════════ -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource RibbonBg}"
                BorderBrush="{DynamicResource Bdr}" BorderThickness="0,0,0,1">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding StatusMessage}" Foreground="{DynamicResource AccGreen}"
                           FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="12,0" />
                <TabControl Background="Transparent" BorderThickness="0" Padding="0">
                    <TabControl.Resources>
                        <Style TargetType="TabItem">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Foreground" Value="{DynamicResource TextS}" />
                            <Setter Property="Padding" Value="14,6" />
                            <Setter Property="FontSize" Value="11" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="TabItem">
                                        <Border x:Name="TabBd" Background="{TemplateBinding Background}"
                                                Padding="{TemplateBinding Padding}"
                                                BorderThickness="0,0,0,2" BorderBrush="Transparent"
                                                SnapsToDevicePixels="True" Cursor="Hand">
                                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="TabBd" Property="BorderBrush" Value="{DynamicResource Accent}" />
                                                <Setter Property="Foreground" Value="{DynamicResource TextP}" />
                                                <Setter TargetName="TabBd" Property="Background" Value="{DynamicResource TabSelectedBg}" />
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="TabBd" Property="Background" Value="{DynamicResource TabHoverBg}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </TabControl.Resources>

                    <!-- ─── HOME TAB ─── -->
                    <TabItem Header="HOME">
                        <Border Background="{DynamicResource RibbonTabBg}" Padding="6,6">
                            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- File Operations -->
                                <Border Background="{DynamicResource GroupBg}" CornerRadius="6" Padding="8,6" Margin="2">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Style="{StaticResource RibbonBtnLarge}" Command="{Binding LoadVocabularyCommand}"
                                                    ToolTip="Open a WatchList vocabulary file">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <TextBlock Style="{StaticResource RibbonIconText}" Text="&#xE8E5;" />
                                                    <TextBlock Text="Open" FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource RibbonBtnLarge}" Command="{Binding SaveVocabularyCommand}"
                                                    ToolTip="Save to current file">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <TextBlock Style="{StaticResource RibbonIconText}" Text="&#xE74E;" />
                                                    <TextBlock Text="Save" FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource RibbonBtnLarge}" Command="{Binding SaveVocabularyAsCommand}"
                                                    ToolTip="Save to a new file">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <TextBlock Style="{StaticResource RibbonIconText}" Text="&#xE792;" />
                                                    <TextBlock Text="Save As" FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource RibbonBtnLarge}" Command="{Binding ImportWatchItemsCommand}"
                                                    ToolTip="Import WatchItems from another XML file (additive merge)">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <TextBlock Style="{StaticResource RibbonIconText}" Text="&#xE8B5;" />
                                                    <TextBlock Text="Import" FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource RibbonBtnLarge}" Command="{Binding ExportWatchItemsCommand}"
                                                    ToolTip="Export selected WatchItem (or all) to XML file">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <TextBlock Style="{StaticResource RibbonIconText}" Text="&#xE898;" />
                                                    <TextBlock Text="Export" FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource RibbonBtnLarge}" Command="{Binding OpenWatchListEditorCommand}"
                                                    ToolTip="Open the full WatchList XML in the editor window">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <TextBlock Style="{StaticResource RibbonIconText}" Text="&#xE70F;" />
                                                    <TextBlock Text="Edit XML" FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                        <TextBlock Text="File" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource TextS}"
                                                   HorizontalAlignment="Center" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Width="1" Background="{DynamicResource Bdr}" Margin="4,8" />
                                <!-- WatchList Commands -->
                                <Border Background="{DynamicResource GroupBg}" CornerRadius="6" Padding="8,6" Margin="2"
                                        Visibility="{Binding ActiveEditingContext, Converter={StaticResource CtxVis}, ConverterParameter=WatchList}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Style="{StaticResource RibbonBtnAccent}" Command="{Binding AddWatchItemCommand}"
                                                    ToolTip="Add a new WatchItem to the root">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <TextBlock Style="{StaticResource RibbonIconText}" Text="&#xE710;" Foreground="{DynamicResource Accent}" />
                                                    <TextBlock Text="WatchItem" FontSize="10" HorizontalAlignment="Center" Margin="0,1,0,0" />
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource RibbonBtnAccent}" Command="{Binding AddChildNodeCommand}"
                                                    ToolTip="Add Event to WatchItem, or ActionGroup to Event/ActionGroup">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <TextBlock Style="{StaticResource RibbonIconText}" Text="&#xE8B7;" Foreground="{DynamicResource Accent}" />
                                                    <TextBlock Text="Event" FontSize="10" HorizontalAlignment="Center" Margin="0,1,0,0" />
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource RibbonBtnAccent}" Command="{Binding AddActionGroupCommand}"
                                                    ToolTip="Add new ActionGroup to selected WatchItem, Event, ActionGroup, or Template">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <TextBlock Style="{StaticResource RibbonIconText}" Text="&#xE8CB;" Foreground="{DynamicResource Accent}" />
                                                    <TextBlock Text="Group" FontSize="10" HorizontalAlignment="Center" Margin="0,1,0,0" />
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource RibbonBtnAccent}" Command="{Binding AddActionToGroupCommand}"
                                                    ToolTip="Add Action to the selected ActionGroup">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <TextBlock Style="{StaticResource RibbonIconText}" Text="&#xEA80;" Foreground="{DynamicResource Accent}" />
                                                    <TextBlock Text="Action" FontSize="10" HorizontalAlignment="Center" Margin="0,1,0,0" />
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource RibbonBtnAccent}" Command="{Binding AddRefToGroupCommand}"
                                                    ToolTip="Add a template reference to the selected group">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <TextBlock Style="{StaticResource RibbonIconText}" Text="&#xE71B;" Foreground="{DynamicResource Accent}" />
                                                    <TextBlock Text="Ref" FontSize="10" HorizontalAlignment="Center" Margin="0,1,0,0" />
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource RibbonBtnAccent}" Command="{Binding AddInitializeToGroupCommand}"
                                                    ToolTip="Add Initialize (parameter file) node">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <TextBlock Style="{StaticResource RibbonIconText}" Text="&#xE70F;" Foreground="{DynamicResource Accent}" />
                                                    <TextBlock Text="Init" FontSize="10" HorizontalAlignment="Center" Margin="0,1,0,0" />
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource RibbonBtnDanger}" Command="{Binding ConfirmDeleteSelectedNodeCommand}"
                                                    ToolTip="Delete selected node (with confirmation)">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <TextBlock Style="{StaticResource RibbonIconText}" Text="&#xE74D;" Foreground="{DynamicResource AccRed}" />
                                                    <TextBlock Text="Delete" FontSize="10" HorizontalAlignment="Center" Margin="0,1,0,0" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                        <TextBlock Text="WatchList" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource Accent}"
                                                   HorizontalAlignment="Center" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Width="1" Background="{DynamicResource Bdr}" Margin="4,8" />
                                <!-- Template Commands -->
                                <Border Background="{DynamicResource GroupBg}" CornerRadius="6" Padding="8,6" Margin="2"
                                        Visibility="{Binding ActiveEditingContext, Converter={StaticResource CtxVis}, ConverterParameter=Templates}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Style="{StaticResource RibbonBtnMauve}" Command="{Binding AddTemplateCommand}"
                                                    ToolTip="Add a new template">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <TextBlock Style="{StaticResource RibbonIconText}" Text="&#xE710;" Foreground="{DynamicResource AccMauve}" />
                                                    <TextBlock Text="Template" FontSize="10" HorizontalAlignment="Center" Margin="0,1,0,0" />
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource RibbonBtnMauve}" Command="{Binding AddGroupToTemplateCommand}"
                                                    ToolTip="Add ActionGroup to selected template">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <TextBlock Style="{StaticResource RibbonIconText}" Text="&#xE8B7;" Foreground="{DynamicResource AccMauve}" />
                                                    <TextBlock Text="Group" FontSize="10" HorizontalAlignment="Center" Margin="0,1,0,0" />
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource RibbonBtnMauve}" Command="{Binding AddActionToTemplateCommand}"
                                                    ToolTip="Add Action to selected template or group">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <TextBlock Style="{StaticResource RibbonIconText}" Text="&#xEA80;" Foreground="{DynamicResource AccMauve}" />
                                                    <TextBlock Text="Action" FontSize="10" HorizontalAlignment="Center" Margin="0,1,0,0" />
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource RibbonBtnMauve}" Command="{Binding AddRefToTemplateCommand}"
                                                    ToolTip="Add template reference to selected template or group">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <TextBlock Style="{StaticResource RibbonIconText}" Text="&#xE71B;" Foreground="{DynamicResource AccMauve}" />
                                                    <TextBlock Text="Ref" FontSize="10" HorizontalAlignment="Center" Margin="0,1,0,0" />
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource RibbonBtnDanger}" Command="{Binding DeleteTemplateCommand}"
                                                    ToolTip="Delete selected template node">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <TextBlock Style="{StaticResource RibbonIconText}" Text="&#xE74D;" Foreground="{DynamicResource AccRed}" />
                                                    <TextBlock Text="Delete" FontSize="10" HorizontalAlignment="Center" Margin="0,1,0,0" />
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource RibbonBtnMauve}" Command="{Binding EditTemplateXmlCommand}"
                                                    ToolTip="Open Template XML Editor">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,4,0" />
                                                    <TextBlock Text="Edit Template XML" />
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource RibbonBtnMauve}" Command="{Binding ImportTemplatesCommand}"
                                                    ToolTip="Import Templates from XML file">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <TextBlock Style="{StaticResource RibbonIconText}" Text="&#xE8B5;" Foreground="{DynamicResource AccMauve}" />
                                                    <TextBlock Text="Import" FontSize="10" HorizontalAlignment="Center" Margin="0,1,0,0" />
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource RibbonBtnMauve}" Command="{Binding ExportTemplatesCommand}"
                                                    ToolTip="Export selected Template (or all) to XML file">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <TextBlock Style="{StaticResource RibbonIconText}" Text="&#xE898;" Foreground="{DynamicResource AccMauve}" />
                                                    <TextBlock Text="Export" FontSize="10" HorizontalAlignment="Center" Margin="0,1,0,0" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                        <TextBlock Text="Templates" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource AccMauve}"
                                                   HorizontalAlignment="Center" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Width="1" Background="{DynamicResource Bdr}" Margin="4,8" />
                                <!-- System Commands -->
                                <Border Background="{DynamicResource GroupBg}" CornerRadius="6" Padding="8,6" Margin="2">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Style="{StaticResource RibbonBtnGreen}" Command="{Binding TriggerAllWatchItemsCommand}"
                                                    ToolTip="Execute all enabled WatchItems"
                                                    Visibility="{Binding ShowExecuteAll}">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <TextBlock Style="{StaticResource RibbonIconText}" Text="&#xE768;" Foreground="{DynamicResource AccGreen}" />
                                                    <TextBlock Text="Execute All" FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource RibbonBtnGreen}" Command="{Binding TriggerWatchItemCommand}"
                                                    ToolTip="Trigger selected WatchItem"
                                                    Visibility="{Binding ShowTriggerAllEvents}">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <TextBlock Style="{StaticResource RibbonIconText}" Text="&#xE769;" Foreground="{DynamicResource AccGreen}" />
                                                    <TextBlock Text="Trigger Item" FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource RibbonBtnGreen}" Command="{Binding TriggerEventCommand}"
                                                    ToolTip="Trigger selected Event"
                                                    Visibility="{Binding ShowTriggerEvent}">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <TextBlock Style="{StaticResource RibbonIconText}" Text="&#xEA80;" Foreground="{DynamicResource AccGreen}" />
                                                    <TextBlock Text="Trigger Event" FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource RibbonBtnGreen}" Command="{Binding ExecuteGroupCommand}"
                                                    ToolTip="Execute selected ActionGroup"
                                                    Visibility="{Binding ShowExecuteGroup}">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <TextBlock Style="{StaticResource RibbonIconText}" Text="&#xE8CB;" Foreground="{DynamicResource AccGreen}" />
                                                    <TextBlock Text="Exec Group" FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource RibbonBtnGreen}" Command="{Binding ExecuteSingleActionCommand}"
                                                    ToolTip="Execute selected Action"
                                                    Visibility="{Binding ShowExecuteAction}">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <TextBlock Style="{StaticResource RibbonIconText}" Text="&#xEA80;" Foreground="{DynamicResource AccGreen}" />
                                                    <TextBlock Text="Exec Action" FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                        <TextBlock Text="Run" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource AccGreen}"
                                                   HorizontalAlignment="Center" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>
                            </WrapPanel>
                        </Border>
                    </TabItem>

                    <!-- ─── EXECUTION TAB ─── -->
                    <TabItem Header="EXECUTION">
                        <Border Background="{DynamicResource RibbonTabBg}" Padding="6,6">
                            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="{DynamicResource GroupBg}" CornerRadius="6" Padding="8,6" Margin="2">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Style="{StaticResource RibbonBtnGreen}" Command="{Binding TriggerAllWatchItemsCommand}"
                                                    ToolTip="Execute all enabled WatchItems">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <TextBlock Style="{StaticResource RibbonIconText}" Text="&#xE768;" Foreground="{DynamicResource AccGreen}" />
                                                    <TextBlock Text="Execute All" FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource RibbonBtnGreen}" Command="{Binding TriggerWatchItemCommand}"
                                                    ToolTip="Trigger selected WatchItem">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <TextBlock Style="{StaticResource RibbonIconText}" Text="&#xE769;" Foreground="{DynamicResource AccGreen}" />
                                                    <TextBlock Text="Trigger Item" FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource RibbonBtnGreen}" Command="{Binding TriggerEventCommand}"
                                                    ToolTip="Trigger selected Event">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <TextBlock Style="{StaticResource RibbonIconText}" Text="&#xEA80;" Foreground="{DynamicResource AccGreen}" />
                                                    <TextBlock Text="Trigger Event" FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource RibbonBtnGreen}" Command="{Binding ExecuteGroupCommand}"
                                                    ToolTip="Execute selected ActionGroup">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <TextBlock Style="{StaticResource RibbonIconText}" Text="&#xE8CB;" Foreground="{DynamicResource AccGreen}" />
                                                    <TextBlock Text="Exec Group" FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource RibbonBtnGreen}" Command="{Binding ExecuteSingleActionCommand}"
                                                    ToolTip="Execute selected Action">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <TextBlock Style="{StaticResource RibbonIconText}" Text="&#xEA80;" Foreground="{DynamicResource AccGreen}" />
                                                    <TextBlock Text="Exec Action" FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                        <TextBlock Text="Run" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource AccGreen}"
                                                   HorizontalAlignment="Center" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Width="1" Background="{DynamicResource Bdr}" Margin="4,8" />
                                <Border Background="{DynamicResource GroupBg}" CornerRadius="6" Padding="8,6" Margin="2">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Style="{StaticResource RibbonBtnYellow}" Command="{Binding ResetStatusCommand}"
                                                    ToolTip="Reset all execution status indicators">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <TextBlock Style="{StaticResource RibbonIconText}" Text="&#xE72C;" Foreground="{DynamicResource AccYellow}" />
                                                    <TextBlock Text="Reset Status" FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                                </StackPanel>
                                            </Button>
                                            <Border Background="{DynamicResource DangerBtnBg}" CornerRadius="4" Padding="0" Margin="2"
                                                    Visibility="{Binding IsExecuting, Converter={StaticResource BoolVis}}">
                                                <Button Style="{StaticResource RibbonBtnDanger}" Command="{Binding CancelExecutionCommand}"
                                                        ToolTip="Cancel the running execution">
                                                    <StackPanel HorizontalAlignment="Center">
                                                        <TextBlock Style="{StaticResource RibbonIconText}" Text="&#xE71A;" Foreground="{DynamicResource AccRed}" />
                                                        <TextBlock Text="Cancel" FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                                    </StackPanel>
                                                </Button>
                                            </Border>
                                            <Button Style="{StaticResource RibbonBtnYellow}" Command="{Binding RetryFailedCommand}"
                                                    ToolTip="Retry only the failed actions from the last execution">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <TextBlock Style="{StaticResource RibbonIconText}" Text="&#xE72C;" Foreground="{DynamicResource AccPeach}" />
                                                    <TextBlock Text="Retry Failed" FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                        <TextBlock Text="Control" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource AccYellow}"
                                                   HorizontalAlignment="Center" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Width="1" Background="{DynamicResource Bdr}" Margin="4,8" />
                                <Border Background="{DynamicResource GroupBg}" CornerRadius="6" Padding="8,6" Margin="2">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Style="{StaticResource RibbonBtnAccent}" Command="{Binding CopyLogCommand}"
                                                    ToolTip="Copy all log entries to clipboard">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <TextBlock Style="{StaticResource RibbonIconText}" Text="&#xE8C8;" Foreground="{DynamicResource Accent}" />
                                                    <TextBlock Text="Copy Log" FontSize="10" HorizontalAlignment="Center" Margin="0,1,0,0" />
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource RibbonBtnDanger}" Command="{Binding CopyFailedLogCommand}"
                                                    ToolTip="Copy only failed log entries">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <TextBlock Style="{StaticResource RibbonIconText}" Text="&#xE7BA;" Foreground="{DynamicResource AccRed}" />
                                                    <TextBlock Text="Copy Failed" FontSize="10" HorizontalAlignment="Center" Margin="0,1,0,0" />
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource RibbonBtnYellow}" Command="{Binding ClearLogCommand}"
                                                    ToolTip="Clear all log entries">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <TextBlock Style="{StaticResource RibbonIconText}" Text="&#xE894;" Foreground="{DynamicResource AccYellow}" />
                                                    <TextBlock Text="Clear Log" FontSize="10" HorizontalAlignment="Center" Margin="0,1,0,0" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                        <TextBlock Text="Log" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource Accent}"
                                                   HorizontalAlignment="Center" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>
                            </WrapPanel>
                        </Border>
                    </TabItem>

                    <!-- ─── VIEW TAB ─── -->
                    <TabItem Header="VIEW">
                        <Border Background="{DynamicResource RibbonTabBg}" Padding="6,6">
                            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="{DynamicResource GroupBg}" CornerRadius="6" Padding="8,6" Margin="2">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="Theme:" FontSize="11" Foreground="{DynamicResource TextS}"
                                                       VerticalAlignment="Center" Margin="4,0,8,0" />
                                            <ComboBox ItemsSource="{Binding AvailableThemes}"
                                                      SelectedItem="{Binding SelectedTheme}"
                                                      Style="{StaticResource Cmb}" Width="140" Margin="0" />
                                        </StackPanel>
                                        <TextBlock Text="Appearance" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource TextS}"
                                                   HorizontalAlignment="Center" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>
                            </WrapPanel>
                        </Border>
                    </TabItem>
                </TabControl>
            </DockPanel>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════ -->
        <!-- STATUSBAR (Row 2)                                         -->
        <!-- ═══════════════════════════════════════════════════════════ -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource BgPanel}" Padding="8,5"
                BorderBrush="{DynamicResource Bdr}" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Left: File path -->
                <TextBlock Grid.Column="0" FontSize="10" FontFamily="Consolas" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextS}" TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding VocabFilePath}" Margin="4,0">
                    <Run Text="File: " FontWeight="SemiBold" /><Run Text="{Binding VocabFilePath}" />
                </TextBlock>

                <!-- Center: Application status -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0">
                    <TextBlock FontSize="11" Foreground="{DynamicResource TextS}">
                        <Run Text="Watchers: " /><Run Text="{Binding ActiveWatchers, Mode=OneWay}" Foreground="{DynamicResource AccGreen}" FontWeight="Bold" />
                        <Run Text="  Templates: " /><Run Text="{Binding TemplateRoots.Count, Mode=OneWay}" Foreground="{DynamicResource AccMauve}" FontWeight="Bold" />
                    </TextBlock>
                    <TextBlock Text=" EXECUTING " Foreground="{DynamicResource AccRed}" FontWeight="Bold"
                               FontSize="11" VerticalAlignment="Center" Margin="8,0"
                               Visibility="{Binding IsExecuting, Converter={StaticResource BoolVis}}" />
                </StackPanel>

                <!-- Right: Agent status -->
                <TextBlock Grid.Column="2" FontSize="11" Foreground="{DynamicResource TextS}"
                           VerticalAlignment="Center" HorizontalAlignment="Right" Margin="4,0">
                    <Run Text="Agents: " /><Run Text="{Binding AgentStatusSummary, Mode=OneWay}" Foreground="{DynamicResource Accent}" FontWeight="Bold" />
                </TextBlock>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════════════════════ -->
        <!-- MAIN CONTENT: 3-column, 3-row Grid                       -->
        <!-- Row 0 = Panels | Row 1 = Splitter | Row 2 = Log          -->
        <!-- ═══════════════════════════════════════════════════════ -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="250" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="2*" MinHeight="120" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" MinWidth="200" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="3*" MinWidth="280" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="3*" MinWidth="280" />
            </Grid.ColumnDefinitions>

            <!-- ═══════════════════════════════════════════════════════ -->
            <!-- LEFT PANEL (Col 0, Row 0): TabControl                 -->
            <!-- ═══════════════════════════════════════════════════════ -->
            <Border Grid.Column="0" Grid.Row="0" Background="{DynamicResource BgPanel}">
                <TabControl Background="Transparent" BorderThickness="0" Padding="0">
                    <TabControl.Resources>
                        <Style TargetType="TabItem" BasedOn="{StaticResource LeftPanelTab}" />
                    </TabControl.Resources>

                    <!-- WatchList Tab -->
                    <TabItem>
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" Margin="0,0,4,0" />
                                <TextBlock Text="WatchList" VerticalAlignment="Center" />
                            </StackPanel>
                        </TabItem.Header>
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Margin="6,5,6,2">
                                <!-- Search / filter box -->
                                <Grid>
                                    <TextBox Text="{Binding TreeSearchText, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource Fld}" FontSize="11" Padding="22,4,24,4" Margin="0" />
                                    <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="12" IsHitTestVisible="False"
                                               VerticalAlignment="Center" Margin="6,0,0,0"
                                               Foreground="{DynamicResource TextS}" />
                                    <Button Content="✕" FontSize="9" Padding="4,2" Margin="0,2,2,5"
                                            Background="Transparent" BorderThickness="0" Cursor="Hand"
                                            Foreground="{DynamicResource TextS}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                            Command="{Binding ClearTreeSearchCommand}" ToolTip="Clear search" />
                                </Grid>
                            </StackPanel>
                            <TreeView x:Name="WatchListTreeView" ItemsSource="{Binding TreeRoots}"
                                      Background="Transparent" Foreground="{DynamicResource TextP}"
                                      BorderThickness="0" Margin="4,0,4,4" Padding="0,4"
                                      ItemContainerStyle="{StaticResource TVI}"
                                      ItemTemplate="{StaticResource WatchTreeTemplate}"
                                      AllowDrop="True" />
                        </DockPanel>
                    </TabItem>

                    <!-- Templates Tab -->
                    <TabItem>
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" Margin="0,0,4,0" />
                                <TextBlock Text="Templates" VerticalAlignment="Center" />
                            </StackPanel>
                        </TabItem.Header>
                        <DockPanel>
                            <TreeView x:Name="TemplateTreeView" ItemsSource="{Binding TemplateRoots}"
                                      Background="Transparent" Foreground="{DynamicResource TextP}"
                                      BorderThickness="0" Margin="4,0,4,4" Padding="0,4"
                                      ItemContainerStyle="{StaticResource TVI}"
                                      ItemTemplate="{StaticResource TemplateTreeTemplate}" />
                        </DockPanel>
                    </TabItem>
                </TabControl>
            </Border>

            <!-- Vertical splitter: Left | Center -->
            <GridSplitter Grid.Column="1" Grid.Row="0" Width="4" Background="{DynamicResource BgSurface}"
                          HorizontalAlignment="Center" VerticalAlignment="Stretch"
                          ResizeBehavior="PreviousAndNext" />

            <!-- ═══════════════════════════════════════════════════════ -->
            <!-- CENTER PANEL (Col 2, Row 0): Node Properties          -->
            <!-- ═══════════════════════════════════════════════════════ -->
            <Border Grid.Column="2" Grid.Row="0" Margin="5" Background="{DynamicResource BgPanel}" CornerRadius="6"
                    BorderBrush="{DynamicResource Bdr}" BorderThickness="1" DataContext="{Binding ActiveEditNode}">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="{DynamicResource BgCard}" Padding="12,8" CornerRadius="6,6,0,0">
                        <DockPanel>
                            <TextBlock Text="Node Properties" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource Accent}" />
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                                <Border CornerRadius="4" Padding="6,2" Margin="0,0,8,0"
                                        Background="{DynamicResource RunningBadgeBg}"
                                        Visibility="{Binding ExecutionStatus, Converter={StaticResource VisWhen}, ConverterParameter=Running}">
                                    <TextBlock Text="RUNNING" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Accent}" />
                                </Border>
                                <Border CornerRadius="4" Padding="6,2" Margin="0,0,8,0"
                                        Background="{DynamicResource SuccessBadgeBg}"
                                        Visibility="{Binding ExecutionStatus, Converter={StaticResource VisWhen}, ConverterParameter=Success}">
                                    <TextBlock Text="SUCCESS" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccGreen}" />
                                </Border>
                                <Border CornerRadius="4" Padding="6,2" Margin="0,0,8,0"
                                        Background="{DynamicResource FailedBadgeBg}"
                                        Visibility="{Binding ExecutionStatus, Converter={StaticResource VisWhen}, ConverterParameter=Failed}">
                                    <TextBlock Text="FAILED" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccRed}" />
                                </Border>
                                <TextBlock Text="{Binding NodeKind, StringFormat='[ {0} ]'}"
                                           Foreground="{DynamicResource AccMauve}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border DockPanel.Dock="Bottom" Padding="12,6" Background="{DynamicResource BgCard}" CornerRadius="0,0,6,6"
                            BorderBrush="{DynamicResource Bdr}" BorderThickness="0,1,0,0">
                        <Button Content="Apply Changes" Style="{StaticResource Btn}" HorizontalAlignment="Left"
                                Command="{Binding DataContext.ApplyChangesCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                    </Border>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12,8">
                        <StackPanel>
                            <!-- ===== WatchList (root) ===== -->
                            <StackPanel Visibility="{Binding NodeKind, Converter={StaticResource VisWhen}, ConverterParameter=WatchList, FallbackValue=Collapsed}">
                                <Border Background="{DynamicResource WatchRootBg}" CornerRadius="6" Padding="14" Margin="0,5">
                                    <StackPanel>
                                        <TextBlock Text="WatchList Root" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource AccGreen}" Margin="0,0,0,8" />
                                        <TextBlock Foreground="{DynamicResource TextS}" FontSize="12" Margin="0,2">
                                            <Run Text="File: " FontWeight="SemiBold" />
                                            <Run Text="{Binding DataContext.VocabFilePath, RelativeSource={RelativeSource AncestorType=Window}}" FontFamily="Consolas" />
                                        </TextBlock>
                                        <TextBlock Foreground="{DynamicResource TextS}" FontSize="12" Margin="0,2">
                                            <Run Text="WatchItems: " FontWeight="SemiBold" />
                                            <Run Text="{Binding ChildCount, Mode=OneWay}" Foreground="{DynamicResource AccGreen}" FontWeight="Bold" />
                                        </TextBlock>
                                        <TextBlock Text="This is the single WatchList root. Use + WatchItem to add items, or Open to load from file."
                                                   FontSize="11" Foreground="{DynamicResource TextS}" TextWrapping="Wrap" Margin="0,8,0,0" FontStyle="Italic" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <!-- ===== TemplateList (root) ===== -->
                            <StackPanel Visibility="{Binding NodeKind, Converter={StaticResource VisWhen}, ConverterParameter=TemplateList, FallbackValue=Collapsed}">
                                <Border Background="{DynamicResource TemplateRootBg}" CornerRadius="6" Padding="14" Margin="0,5">
                                    <StackPanel>
                                        <TextBlock Text="Templates Root" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource AccMauve}" Margin="0,0,0,8" />
                                        <TextBlock Foreground="{DynamicResource TextS}" FontSize="12" Margin="0,2">
                                            <Run Text="Templates: " FontWeight="SemiBold" />
                                            <Run Text="{Binding ChildCount, Mode=OneWay}" Foreground="{DynamicResource AccMauve}" FontWeight="Bold" />
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                                <Border Background="{DynamicResource InfoBoxBg}" CornerRadius="4" Padding="8" Margin="0,5,0,0"
                                        BorderBrush="{DynamicResource Bdr}" BorderThickness="1">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Style="{StaticResource SmBtn}"
                                                Background="{DynamicResource AccMauve}" Foreground="{DynamicResource TreeBadgeFg}"
                                                Command="{Binding DataContext.EditTemplateXmlCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                ToolTip="Open Template XML Editor">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,4,0" />
                                                <TextBlock Text="Edit Template XML" />
                                            </StackPanel>
                                        </Button>
                                    </DockPanel>
                                </Border>
                            </StackPanel>
                            <!-- ===== WatchItem ===== -->
                            <StackPanel Visibility="{Binding NodeKind, Converter={StaticResource VisWhen}, ConverterParameter=WatchItem, FallbackValue=Collapsed}">
                                <Border Background="{DynamicResource WatchRootBg}" CornerRadius="4" Padding="8" Margin="0,0,0,8"
                                        BorderBrush="{DynamicResource AccGreen}" BorderThickness="1">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="▶ Trigger All Events" Style="{StaticResource TriggerOutlineBtn}"
                                                Command="{Binding DataContext.TriggerWatchItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                ToolTip="Manually execute all events for this WatchItem" />
                                        <TextBlock Text="Execute all events for this WatchItem" FontSize="11"
                                                   Foreground="{DynamicResource AccGreen}" VerticalAlignment="Center" />
                                    </DockPanel>
                                </Border>
                                <!-- General section -->
                                <Expander Style="{StaticResource SectionExpander}" IsExpanded="True">
                                    <Expander.Header>
                                        <TextBlock Text="GENERAL" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextS}" />
                                    </Expander.Header>
                                    <StackPanel Margin="0,4,0,0">
                                        <Label Content="TAG" Style="{StaticResource Lbl}" />
                                        <Grid>
                                            <TextBox Text="{Binding Tag, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Fld}" FontSize="14" FontWeight="Bold" />
                                            <TextBlock Text="e.g. MyWatchItem" IsHitTestVisible="False" FontSize="12.5" Padding="8,6"
                                                       Foreground="{DynamicResource PlaceholderFg}" VerticalAlignment="Center"
                                                       Visibility="{Binding Tag, Converter={StaticResource EmptyVis}}" />
                                        </Grid>
                                        <CheckBox Content="Enabled" IsChecked="{Binding IsEnabled}" Foreground="{DynamicResource TextP}" Margin="0,4" />
                                    </StackPanel>
                                </Expander>
                                <!-- Source section -->
                                <Expander Style="{StaticResource SectionExpander}" IsExpanded="True">
                                    <Expander.Header>
                                        <TextBlock Text="SOURCE" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextS}" />
                                    </Expander.Header>
                                    <StackPanel Margin="0,4,0,0">
                                        <Label Content="WATCH PATH" Style="{StaticResource Lbl}" />
                                        <Grid>
                                            <TextBox Text="{Binding WatchPath, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Fld}" FontFamily="Consolas" />
                                            <TextBlock Text="e.g. C:\WatchFolder" IsHitTestVisible="False" FontSize="12.5" FontFamily="Consolas" Padding="8,6"
                                                       Foreground="{DynamicResource PlaceholderFg}" VerticalAlignment="Center"
                                                       Visibility="{Binding WatchPath, Converter={StaticResource EmptyVis}}" />
                                        </Grid>
                                        <Label Content="FILTER" Style="{StaticResource Lbl}" />
                                        <Grid>
                                            <TextBox Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Fld}" FontFamily="Consolas" />
                                            <TextBlock Text="e.g. *.txt" IsHitTestVisible="False" FontSize="12.5" FontFamily="Consolas" Padding="8,6"
                                                       Foreground="{DynamicResource PlaceholderFg}" VerticalAlignment="Center"
                                                       Visibility="{Binding Filter, Converter={StaticResource EmptyVis}}" />
                                        </Grid>
                                    </StackPanel>
                                </Expander>
                                <!-- Action section -->
                                <Expander Style="{StaticResource SectionExpander}" IsExpanded="False">
                                    <Expander.Header>
                                        <TextBlock Text="ACTIONS" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextS}" />
                                    </Expander.Header>
                                    <Border Background="{DynamicResource InfoBoxBg}" CornerRadius="4" Padding="8,6" Margin="0,4,0,0"
                                            BorderBrush="{DynamicResource Bdr}" BorderThickness="1">
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Style="{StaticResource SmBtn}"
                                                    Background="{DynamicResource AccPeach}" Foreground="{DynamicResource TreeBadgeFg}"
                                                    Command="{Binding DataContext.ToggleXmlEditorCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    ToolTip="Open WatchItem XML Editor with validation, auto-fix, and structure preview">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,4,0" />
                                                    <TextBlock Text="Edit WatchItem XML" />
                                                </StackPanel>
                                            </Button>
                                            <TextBlock Text="WatchItem XML Editor" FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource AccPeach}" VerticalAlignment="Center" />
                                        </DockPanel>
                                    </Border>
                                </Expander>
                            </StackPanel>
                            <!-- ===== Event ===== -->
                            <StackPanel Visibility="{Binding NodeKind, Converter={StaticResource VisWhen}, ConverterParameter=Event, FallbackValue=Collapsed}">
                                <Border Background="{DynamicResource WatchRootBg}" CornerRadius="4" Padding="8" Margin="0,0,0,8"
                                        BorderBrush="{DynamicResource AccGreen}" BorderThickness="1">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="Trigger Event" Style="{StaticResource TriggerOutlineBtn}"
                                                Command="{Binding DataContext.TriggerEventCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                ToolTip="Manually execute this event's action pipeline" />
                                        <TextBlock Text="Execute this event's action pipeline" FontSize="11"
                                                   Foreground="{DynamicResource AccGreen}" VerticalAlignment="Center" />
                                    </DockPanel>
                                </Border>
                                <Label Content="EVENT TYPE" Style="{StaticResource Lbl}" />
                                <ComboBox ItemsSource="{StaticResource EventTypes}" SelectedItem="{Binding EventType}" Style="{StaticResource Cmb}" />
                                <Label Content="EXECUTION TYPE" Style="{StaticResource Lbl}" />
                                <ComboBox ItemsSource="{StaticResource ExecModes}" SelectedItem="{Binding ExecutionTypeText}" Style="{StaticResource Cmb}" />
                            </StackPanel>
                            <!-- ===== ActionGroup ===== -->
                            <StackPanel Visibility="{Binding NodeKind, Converter={StaticResource VisWhen}, ConverterParameter=ActionGroup, FallbackValue=Collapsed}">
                                <Label Content="TAG" Style="{StaticResource Lbl}" />
                                <TextBox Text="{Binding Tag, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Fld}" />
                                <Label Content="EXECUTION TYPE" Style="{StaticResource Lbl}" />
                                <ComboBox ItemsSource="{StaticResource ExecModes}" SelectedItem="{Binding ExecutionTypeText}" Style="{StaticResource Cmb}" />
                                <CheckBox Content="FailAndContinue" IsChecked="{Binding FailAndContinue}" Foreground="{DynamicResource TextP}" Margin="0,6" />
                            </StackPanel>
                            <!-- ===== Action ===== -->
                            <StackPanel Visibility="{Binding NodeKind, Converter={StaticResource VisWhen}, ConverterParameter=Action, FallbackValue=Collapsed}">
                                <Label Content="ACTION TYPE" Style="{StaticResource Lbl}" />
                                <ComboBox ItemsSource="{StaticResource ActionTypes}" SelectedItem="{Binding ActionTypeText}" Style="{StaticResource Cmb}" />
                                <StackPanel Visibility="{Binding ActionTypeText, Converter={StaticResource ActionVis}, ConverterParameter=RunCommand|RunRemoteCommand}">
                                    <TextBlock Text="COMMAND SETTINGS" Style="{StaticResource Sec}" />
                                    <Label Content="COMMAND" Style="{StaticResource Lbl}" />
                                    <TextBox Text="{Binding Command, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Fld}" FontFamily="Consolas" />
                                    <Label Content="PARAMETERS" Style="{StaticResource Lbl}" />
                                    <TextBox Text="{Binding Parameters, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Fld}" FontFamily="Consolas"
                                             TextWrapping="Wrap" AcceptsReturn="True" Height="52" VerticalScrollBarVisibility="Auto" />
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <Label Content="TIMEOUT (sec)" Style="{StaticResource Lbl}" />
                                            <TextBox Text="{Binding Timeout, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Fld}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <Label Content="POLL INTERVAL (ms)" Style="{StaticResource Lbl}" />
                                            <TextBox Text="{Binding PollInterval, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Fld}" />
                                        </StackPanel>
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Margin="0,5">
                                        <CheckBox Content="FailAndContinue" IsChecked="{Binding FailAndContinue}" Foreground="{DynamicResource TextP}" Margin="0,0,16,0" />
                                        <CheckBox Content="IsReboot" IsChecked="{Binding IsReboot}" Foreground="{DynamicResource TextP}" />
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Visibility="{Binding ActionTypeText, Converter={StaticResource ActionVis}, ConverterParameter=RunRemoteCommand}">
                                    <TextBlock Text="REMOTE AGENT" Style="{StaticResource Sec}" />
                                    <Label Content="AGENT NAME" Style="{StaticResource Lbl}" />
                                    <TextBox Text="{Binding AgentName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Fld}" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <Label Content="USERNAME" Style="{StaticResource Lbl}" />
                                            <TextBox Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Fld}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <Label Content="PASSWORD" Style="{StaticResource Lbl}" />
                                            <TextBox Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Fld}" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                                <StackPanel Visibility="{Binding ActionTypeText, Converter={StaticResource ActionVis}, ConverterParameter=SendMail}">
                                    <TextBlock Text="MAIL SETTINGS" Style="{StaticResource Sec}" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <Label Content="FROM" Style="{StaticResource Lbl}" />
                                            <TextBox Text="{Binding From, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Fld}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <Label Content="TO" Style="{StaticResource Lbl}" />
                                            <TextBox Text="{Binding To, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Fld}" />
                                        </StackPanel>
                                    </Grid>
                                    <Label Content="SUBJECT" Style="{StaticResource Lbl}" />
                                    <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Fld}" />
                                    <Label Content="BODY" Style="{StaticResource Lbl}" />
                                    <TextBox Text="{Binding Body, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Fld}"
                                             TextWrapping="Wrap" AcceptsReturn="True" Height="50" VerticalScrollBarVisibility="Auto" />
                                    <Label Content="ATTACHMENT" Style="{StaticResource Lbl}" />
                                    <TextBox Text="{Binding Attachment, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Fld}"
                                             TextWrapping="Wrap" AcceptsReturn="True" Height="50" VerticalScrollBarVisibility="Auto" />
                                </StackPanel>
                            </StackPanel>
                            <!-- ===== Initialize ===== -->
                            <StackPanel Visibility="{Binding NodeKind, Converter={StaticResource VisWhen}, ConverterParameter=Initialize, FallbackValue=Collapsed}">
                                <Label Content="TAG" Style="{StaticResource Lbl}" />
                                <TextBox Text="{Binding Tag, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Fld}" />

                                <Label Content="PARAMETER FILE" Style="{StaticResource Lbl}" Margin="0,8,0,0" />
                                <DockPanel>
                                    <Button Content="Browse..." DockPanel.Dock="Right" Margin="6,2,0,5"
                                            Style="{StaticResource SmBtn}"
                                            Command="{Binding DataContext.BrowseParameterFileCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                    <TextBox Text="{Binding ParameterFile, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource Fld}" FontFamily="Consolas" />
                                </DockPanel>

                                <!-- Parameters header + action buttons -->
                                <DockPanel Margin="0,12,0,4">
                                    <TextBlock Text="PARAMETERS" Foreground="{DynamicResource TextS}"
                                               FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                                        <Button Content="Reload" Style="{StaticResource SmBtn}"
                                                Command="{Binding DataContext.LoadParameterFileFromNodeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                Margin="0,0,4,0" />
                                        <Button Content="Save File" Style="{StaticResource SmBtn}"
                                                Command="{Binding DataContext.SaveParameterFileCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                    </StackPanel>
                                </DockPanel>

                                <!-- Parameter DataGrid -->
                                <DataGrid ItemsSource="{Binding DataContext.ParameterFileEntries, RelativeSource={RelativeSource AncestorType=Window}}"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False" CanUserDeleteRows="False"
                                          CanUserSortColumns="False"
                                          HeadersVisibility="Column"
                                          GridLinesVisibility="Horizontal"
                                          Background="Transparent"
                                          Foreground="{DynamicResource TextP}"
                                          BorderThickness="1"
                                          BorderBrush="{DynamicResource Bdr}"
                                          RowBackground="#10FFFFFF"
                                          AlternatingRowBackground="#18FFFFFF"
                                          MaxHeight="200"
                                          Margin="0,0,0,4">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Key" Width="*"
                                            Binding="{Binding Key, UpdateSourceTrigger=PropertyChanged}"
                                            Foreground="{DynamicResource TextP}" />
                                        <DataGridTextColumn Header="Value" Width="2*"
                                            Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                            Foreground="{DynamicResource TextP}" />
                                        <DataGridTemplateColumn Header="" Width="30">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Content="✕" FontSize="10"
                                                            Background="Transparent" Foreground="#F85149"
                                                            BorderThickness="0" Cursor="Hand" Padding="4,0"
                                                            Command="{Binding DataContext.RemoveParameterEntryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <!-- Add Parameter button -->
                                <Button Content="+ Add Parameter" HorizontalAlignment="Left"
                                        Style="{StaticResource SmBtn}" Margin="0,0,0,8"
                                        Command="{Binding DataContext.AddParameterEntryCommand, RelativeSource={RelativeSource AncestorType=Window}}" />

                                <!-- Status message -->
                                <TextBlock Text="{Binding DataContext.ParameterFileStatus, RelativeSource={RelativeSource AncestorType=Window}}"
                                           FontSize="10" FontStyle="Italic"
                                           Foreground="{DynamicResource TextS}"
                                           TextWrapping="Wrap" Margin="0,0,0,4" />

                                <!-- Help text -->
                                <TextBlock TextWrapping="Wrap" FontSize="10" Foreground="{DynamicResource TextS}">
                                    <Run Text="ⓘ" FontWeight="Bold" />
                                    <Run Text=" Use [Key] tokens in sibling Action commands. Example: [ServerName] resolves to the value defined above." />
                                </TextBlock>
                            </StackPanel>
                            <!-- ===== Ref ===== -->
                            <StackPanel Visibility="{Binding NodeKind, Converter={StaticResource VisWhen}, ConverterParameter=Ref, FallbackValue=Collapsed}">
                                <Label Content="TEMPLATE ID" Style="{StaticResource Lbl}" />
                                <TextBox Text="{Binding TemplateID, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Fld}" />
                                <TextBlock TextWrapping="Wrap" FontSize="10" Foreground="{DynamicResource TextS}" Margin="0,4">
                                    <Run Text="ⓘ" FontWeight="Bold" />
                                    <Run Text=" This node expands to the children of the referenced Template at execution time." />
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- ═══════════════════════════════════════════════════════ -->
            <!-- INLINE XML EDITOR PANEL (Col 2, Row 0): overlays center panel -->
            <!-- ═══════════════════════════════════════════════════════ -->
            <Border Grid.Column="2" Grid.Row="0" Margin="5" Background="{DynamicResource BgPanel}" CornerRadius="6"
                    BorderBrush="{DynamicResource Accent}" BorderThickness="2"
                    Visibility="{Binding IsInlineXmlEditorVisible, Converter={StaticResource BoolVis}}">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="{DynamicResource BgCard}" Padding="12,8" CornerRadius="6,6,0,0">
                        <DockPanel>
                            <TextBlock FontSize="14" FontWeight="Bold" Foreground="{DynamicResource Accent}">
                                <Run Text="XML Editor" />
                                <Run Text=" — " Foreground="{DynamicResource TextS}" />
                                <Run Text="{Binding InlineXmlEditorScope, Mode=OneWay}" Foreground="{DynamicResource AccMauve}" />
                            </TextBlock>
                            <Button DockPanel.Dock="Right" Content="✕ Close" Style="{StaticResource SmBtn}" HorizontalAlignment="Right"
                                    Background="{DynamicResource DangerBtnBg}" Foreground="{DynamicResource AccRed}"
                                    Command="{Binding ToggleInlineXmlEditorCommand}" ToolTip="Close inline XML editor" />
                        </DockPanel>
                    </Border>
                    <Border DockPanel.Dock="Bottom" Padding="12,6" Background="{DynamicResource BgCard}" CornerRadius="0,0,6,6"
                            BorderBrush="{DynamicResource Bdr}" BorderThickness="0,1,0,0">
                        <DockPanel>
                            <Button Content="Apply XML" Style="{StaticResource Btn}" HorizontalAlignment="Left"
                                    Command="{Binding ApplyInlineXmlCommand}" />
                            <TextBlock Text="{Binding InlineXmlEditorStatus}" FontSize="11" FontFamily="Consolas"
                                       Foreground="{DynamicResource AccYellow}" VerticalAlignment="Center" Margin="12,0,0,0"
                                       TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                    </Border>
                    <!-- AvalonEdit host — instantiated in code-behind -->
                    <Border x:Name="InlineXmlEditorHost" Background="{DynamicResource FieldBg}" Margin="4" />
                </DockPanel>
            </Border>

            <!-- ═══════════════════════════════════════════════════════ -->
            <!-- VERTICAL SPLITTER: Center | Right                      -->
            <!-- ═══════════════════════════════════════════════════════ -->
            <GridSplitter Grid.Column="3" Grid.Row="0" Width="4" Background="{DynamicResource BgSurface}"
                          HorizontalAlignment="Center" VerticalAlignment="Stretch"
                          ResizeBehavior="PreviousAndNext" />

            <!-- ═══════════════════════════════════════════════════════ -->
            <!-- RIGHT PANEL (Col 4, Row 0): Agents                    -->
            <!-- ═══════════════════════════════════════════════════════ -->
            <Border Grid.Column="4" Grid.Row="0" Margin="5" Background="{DynamicResource BgPanel}" CornerRadius="6"
                    BorderBrush="{DynamicResource Bdr}" BorderThickness="1">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="{DynamicResource BgCard}" Padding="10,6" CornerRadius="6,6,0,0">
                        <TextBlock Text="Agents" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource AccPeach}" />
                    </Border>
                    <Border DockPanel.Dock="Top" Padding="8,6" BorderBrush="{DynamicResource Bdr}" BorderThickness="0,0,0,1">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="2*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <Label Content="Name" Style="{StaticResource Lbl}" />
                                    <TextBox Text="{Binding NewAgentName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Fld}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <Label Content="gRPC Address" Style="{StaticResource Lbl}" />
                                    <TextBox Text="{Binding NewAgentAddress, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Fld}" FontFamily="Consolas" FontSize="11" />
                                </StackPanel>
                            </Grid>
                            <WrapPanel Orientation="Horizontal" Margin="0,5,0,5">
                                <Button Content="Register + Test" Style="{StaticResource SmBtn}"
                                        Background="{DynamicResource AccPeach}" Foreground="{DynamicResource TreeBadgeFg}"
                                        Command="{Binding RegisterAgentCommand}" ToolTip="Register new agent and test connection" />
                                <Button Content="Test All" Style="{StaticResource SmBtn}"
                                        Background="{DynamicResource AccentBtnBg}" Foreground="{DynamicResource Accent}"
                                        Command="{Binding TestAllAgentsCommand}" ToolTip="Test connectivity to all registered agents" />
                                <Button Content="Test" Style="{StaticResource SmBtn}"
                                        Background="{DynamicResource GreenBtnBg}" Foreground="{DynamicResource AccGreen}"
                                        Command="{Binding TestConnectionCommand}" ToolTip="Test connectivity to selected agent" />
                                <Button Content="Diagnose" Style="{StaticResource SmBtn}"
                                        Background="{DynamicResource MauveBtnBg}" Foreground="{DynamicResource AccMauve}"
                                        Command="{Binding DiagnoseAgentCommand}" ToolTip="Run full connectivity diagnostic" />
                                <Button Content="Remove" Style="{StaticResource DangerBtn}"
                                        Command="{Binding UnregisterAgentCommand}" ToolTip="Remove selected agent" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                    <ListBox ItemsSource="{Binding RegisteredAgents}"
                             SelectedItem="{Binding SelectedAgent}"
                             Background="Transparent" BorderThickness="0"
                             Margin="6,5,6,6">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="4,3" />
                                <Setter Property="Margin" Value="0,2" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Foreground" Value="{DynamicResource TextP}" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource InfoBoxBg}" CornerRadius="4" Padding="8,6">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding StatusIcon}" FontSize="13" FontWeight="Bold" Margin="0,0,8,0" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource TextS}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ConnectionStatus}" Value="Online">
                                                                <Setter Property="Foreground" Value="{DynamicResource AccGreen}" />
                                                                <Setter Property="FontWeight" Value="Bold" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding ConnectionStatus}" Value="Testing">
                                                                <Setter Property="Foreground" Value="{DynamicResource Accent}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding ConnectionStatus}" Value="Offline">
                                                                <Setter Property="Foreground" Value="{DynamicResource AccRed}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding ConnectionStatus}" Value="Error">
                                                                <Setter Property="Foreground" Value="{DynamicResource AccPeach}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextP}">
                                                    <Run Text="{Binding Name, Mode=OneWay}" />
                                                    <Run Text="  " />
                                                    <Run Text="{Binding Address, Mode=OneWay}" FontFamily="Consolas" FontSize="10" Foreground="{DynamicResource TextS}" />
                                                </TextBlock>
                                                <TextBlock Text="{Binding DetailLine}" FontSize="9.5" FontFamily="Consolas" Margin="0,1,0,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource TextS}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding ConnectionStatus}" Value="Online">
                                                                    <Setter Property="Foreground" Value="{DynamicResource AccGreen}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding ConnectionStatus}" Value="Offline">
                                                                    <Setter Property="Foreground" Value="{DynamicResource AccRed}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding LastChecked}" FontSize="9" FontFamily="Consolas"
                                                       Foreground="{DynamicResource TextS}" VerticalAlignment="Center" Margin="6,0,0,0" />
                                        </Grid>
                                        <Border Background="{DynamicResource AlertErrorBg}" CornerRadius="3" Padding="6,4" Margin="0,4,0,0"
                                                BorderBrush="{DynamicResource AlertErrorBdr}" BorderThickness="1">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ConnectionStatus}" Value="Offline">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding ConnectionStatus}" Value="Error">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding ErrorDetail}" FontSize="9" FontFamily="Consolas"
                                                       Foreground="{DynamicResource AccRed}" TextWrapping="Wrap" />
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- ═══════════════════════════════════════════════════════ -->
            <!-- HORIZONTAL SPLITTER (Row 1, spans all columns)        -->
            <!-- ═══════════════════════════════════════════════════════ -->
            <GridSplitter Grid.Row="1" Grid.ColumnSpan="5" Height="4" HorizontalAlignment="Stretch"
                          Background="{DynamicResource BgSurface}" ResizeBehavior="PreviousAndNext" />

            <!-- ═══════════════════════════════════════════════════════ -->
            <!-- EXECUTION LOG (Row 2, spans all columns)              -->
            <!-- ═══════════════════════════════════════════════════════ -->
            <Border Grid.Row="2" Grid.ColumnSpan="5" Margin="5,0,5,5" Background="{DynamicResource BgPanel}" CornerRadius="6"
                    BorderBrush="{DynamicResource Bdr}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Row 0: Header -->
                    <Border Grid.Row="0" Background="{DynamicResource BgCard}" Padding="10,6" CornerRadius="6,6,0,0">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Execution Log" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource AccGreen}"
                                           VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock FontSize="11" Foreground="{DynamicResource TextS}" VerticalAlignment="Center">
                                    <Run Text="(" /><Run Text="{Binding FilteredLogEntries.Count, Mode=OneWay}" FontWeight="Bold" /><Run Text=" entries)" />
                                </TextBlock>
                                <TextBlock Text=" PAUSED" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccYellow}"
                                           VerticalAlignment="Center" Margin="8,0,0,0"
                                           Visibility="{Binding IsLogPaused, Converter={StaticResource BoolVis}}" />
                            </StackPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource SmBtn}" Padding="6,3"
                                    Background="{DynamicResource BtnBg}" Foreground="{DynamicResource TextS}"
                                    Command="{Binding ToggleLogCollapseCommand}" HorizontalAlignment="Right"
                                    ToolTip="Collapse/Expand log panel">
                                <TextBlock FontSize="10">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="Collapse" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsLogCollapsed}" Value="True">
                                                    <Setter Property="Text" Value="Expand" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Button>
                        </DockPanel>
                    </Border>

                    <!-- Row 1: Filter Bar -->
                    <Border Grid.Row="1" Background="{DynamicResource InfoBoxBg}" Padding="8,5"
                            Visibility="{Binding IsLogCollapsed, Converter={StaticResource InvBoolVis}}">
                        <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Tag:" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextS}"
                                       VerticalAlignment="Center" Margin="0,0,5,0" />
                            <ComboBox Width="120" ItemsSource="{Binding AvailableWatchItemTags}"
                                      SelectedItem="{Binding LogFilterTag}" IsEditable="True"
                                      Text="{Binding LogFilterTag, UpdateSourceTrigger=PropertyChanged}"
                                      Style="{StaticResource Cmb}" Margin="0,0,8,0"
                                      ToolTip="Filter by WatchItem Tag" />
                            <TextBlock Text="Agent:" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextS}"
                                       VerticalAlignment="Center" Margin="0,0,5,0" />
                            <ComboBox Width="120" ItemsSource="{Binding AvailableAgentNames}"
                                      SelectedItem="{Binding LogFilterAgent}" IsEditable="True"
                                      Text="{Binding LogFilterAgent, UpdateSourceTrigger=PropertyChanged}"
                                      Style="{StaticResource Cmb}" Margin="0,0,8,0"
                                      ToolTip="Filter by Agent name" />
                            <TextBlock Text="Level:" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextS}"
                                       VerticalAlignment="Center" Margin="0,0,5,0" />
                            <ComboBox Width="100" ItemsSource="{Binding LogLevelOptions}"
                                      SelectedItem="{Binding LogLevelFilter}"
                                      Style="{StaticResource Cmb}" Margin="0,0,8,0"
                                      ToolTip="Filter by log severity level" />
                            <TextBlock Text="Search:" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextS}"
                                       VerticalAlignment="Center" Margin="0,0,5,0" />
                            <TextBox Width="140" Text="{Binding LogSearchText, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource Fld}" Margin="0,0,5,0" Padding="5,3"
                                     ToolTip="Search log messages" />
                            <Button Content="Clear" Style="{StaticResource SmBtn}" Padding="6,3"
                                    Background="{DynamicResource BtnBg}" Foreground="{DynamicResource TextS}"
                                    Command="{Binding ClearLogFilterCommand}" ToolTip="Clear all filters" />
                            <Border Width="1" Background="{DynamicResource Bdr}" Margin="8,4" />
                            <CheckBox Content="Auto-scroll" IsChecked="{Binding IsAutoScrollEnabled}"
                                      Foreground="{DynamicResource TextS}" FontSize="10" VerticalAlignment="Center" Margin="0,0,5,0" />
                        </WrapPanel>
                    </Border>

                    <!-- Row 2: Log Output -->
                    <ListBox Grid.Row="2" x:Name="LogListBox" ItemsSource="{Binding FilteredLogEntries}" Background="Transparent"
                             BorderThickness="0" FontFamily="Consolas" FontSize="11" Padding="4,2"
                             SelectionMode="Extended"
                             Visibility="{Binding IsLogCollapsed, Converter={StaticResource InvBoolVis}}">
                        <ListBox.ContextMenu>
                            <ContextMenu Background="{DynamicResource BgCard}" Foreground="{DynamicResource TextP}"
                                         BorderBrush="{DynamicResource Bdr}">
                                <MenuItem Header="Copy Selected" Click="OnCopySelectedLog" />
                                <MenuItem Header="Copy All" Command="{Binding CopyLogCommand}" />
                                <MenuItem Header="Copy Failed Only" Command="{Binding CopyFailedLogCommand}" />
                                <Separator />
                                <MenuItem Header="Clear Log" Command="{Binding ClearLogCommand}" />
                            </ContextMenu>
                        </ListBox.ContextMenu>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="6,2" />
                                <Setter Property="Foreground" Value="{DynamicResource TextS}" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Bd" Padding="{TemplateBinding Padding}" Background="Transparent">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SelectedItemBg}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:LogEntryViewModel}">
                                <TextBlock FontFamily="Consolas" FontSize="11" TextWrapping="NoWrap">
                                    <Run Text="[" /><Run Text="{Binding Timestamp, Mode=OneWay}" /><Run Text="] " /><Run Text="{Binding Message, Mode=OneWay}" />
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource TextS}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Severity}" Value="Error">
                                                    <Setter Property="Foreground" Value="{DynamicResource AccRed}" />
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Severity}" Value="Success">
                                                    <Setter Property="Foreground" Value="{DynamicResource AccGreen}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Severity}" Value="Warning">
                                                    <Setter Property="Foreground" Value="{DynamicResource AccYellow}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Row 3: Command Bar -->
                    <Border Grid.Row="3" Background="{DynamicResource BgCard}" Padding="8,5" CornerRadius="0,0,6,6"
                            BorderBrush="{DynamicResource Bdr}" BorderThickness="0,1,0,0"
                            Visibility="{Binding IsLogCollapsed, Converter={StaticResource InvBoolVis}}">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Style="{StaticResource SmBtn}" Command="{Binding ToggleLogPauseCommand}"
                                        ToolTip="Pause/Resume live log updates">
                                    <TextBlock VerticalAlignment="Center" Margin="0,0,4,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="Pause" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsLogPaused}" Value="True">
                                                        <Setter Property="Text" Value="Resume" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Button>
                                <Button Content="Clear" Style="{StaticResource SmBtn}"
                                        Background="{DynamicResource YellowBtnBg}" Foreground="{DynamicResource AccYellow}"
                                        Command="{Binding ClearLogCommand}" ToolTip="Clear all log entries" />
                                <Button Content="Copy All" Style="{StaticResource SmBtn}"
                                        Background="{DynamicResource AccentBtnBg}" Foreground="{DynamicResource Accent}"
                                        Command="{Binding CopyLogCommand}" ToolTip="Copy all log entries to clipboard" />
                                <Button Content="Export" Style="{StaticResource SmBtn}"
                                        Background="{DynamicResource GreenBtnBg}" Foreground="{DynamicResource AccGreen}"
                                        Command="{Binding ExportLogCommand}" ToolTip="Export log to text file" />
                            </StackPanel>
                            <TextBlock/>
                        </DockPanel>
                    </Border>

                    <!-- Execution overlay spinner -->
                    <Border Grid.RowSpan="4" Background="{DynamicResource OverlayBg}" CornerRadius="6"
                            Visibility="{Binding IsExecuting, Converter={StaticResource BoolVis}}"
                            IsHitTestVisible="False">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="28" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center"
                                       FontWeight="Bold">
                                <TextBlock.RenderTransform>
                                    <RotateTransform Angle="0" CenterX="14" CenterY="14" />
                                </TextBlock.RenderTransform>
                                <TextBlock.Triggers>
                                    <EventTrigger RoutedEvent="Loaded">
                                        <BeginStoryboard>
                                            <Storyboard RepeatBehavior="Forever">
                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                 From="0" To="360" Duration="0:0:1.5" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </TextBlock.Triggers>
                            </TextBlock>
                            <TextBlock Text="Executing..." FontSize="11" Foreground="{DynamicResource Accent}"
                                       FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</Window>
