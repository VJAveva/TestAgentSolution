<Window x:Class="TestControllerGrpc.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        xmlns:vm="clr-namespace:TestControllerGrpc.ViewModels"
        Title="TestController  -  WatchList Editor"
        Height="840" Width="1360" MinWidth="1000" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="#FF1E1E2E">

    <Window.Resources>
        <vm:NodeKindToVisibilityConverter x:Key="VisWhen" />
        <vm:ActionTypeFieldVisibilityConverter x:Key="ActionVis" />
        <BooleanToVisibilityConverter x:Key="BoolVis" />

        <SolidColorBrush x:Key="BgPanel"   Color="#FF181825" />
        <SolidColorBrush x:Key="BgCard"    Color="#FF313244" />
        <SolidColorBrush x:Key="BgSurface" Color="#FF45475A" />
        <SolidColorBrush x:Key="Accent"    Color="#FF89B4FA" />
        <SolidColorBrush x:Key="AccGreen"  Color="#FFA6E3A1" />
        <SolidColorBrush x:Key="AccPeach"  Color="#FFFAB387" />
        <SolidColorBrush x:Key="AccRed"    Color="#FFF38BA8" />
        <SolidColorBrush x:Key="AccMauve"  Color="#FFCBA6F7" />
        <SolidColorBrush x:Key="AccYellow" Color="#FFF9E2AF" />
        <SolidColorBrush x:Key="TextP"     Color="#FFCDD6F4" />
        <SolidColorBrush x:Key="TextS"     Color="#FF9399B2" />
        <SolidColorBrush x:Key="Bdr"       Color="#FF585B70" />

        <x:Array x:Key="EventTypes" Type="{x:Type sys:String}">
            <sys:String>Renamed</sys:String><sys:String>Created</sys:String><sys:String>Changed</sys:String>
        </x:Array>
        <x:Array x:Key="ExecModes" Type="{x:Type sys:String}">
            <sys:String>Sequential</sys:String><sys:String>Parallel</sys:String>
        </x:Array>
        <x:Array x:Key="ActionTypes" Type="{x:Type sys:String}">
            <sys:String>RunCommand</sys:String><sys:String>RunRemoteCommand</sys:String><sys:String>SendMail</sys:String>
        </x:Array>

        <Style TargetType="Button" x:Key="Btn">
            <Setter Property="Background" Value="{StaticResource Accent}" />
            <Setter Property="Foreground" Value="#FF1E1E2E" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style TargetType="Button" x:Key="SmBtn" BasedOn="{StaticResource Btn}">
            <Setter Property="FontSize" Value="11" /><Setter Property="Padding" Value="8,3" />
        </Style>
        <Style TargetType="Button" x:Key="DangerBtn" BasedOn="{StaticResource SmBtn}">
            <Setter Property="Background" Value="#44F38BA8" /><Setter Property="Foreground" Value="{StaticResource AccRed}" />
        </Style>
        <Style TargetType="Button" x:Key="MoveBtn" BasedOn="{StaticResource SmBtn}">
            <Setter Property="Background" Value="#3389B4FA" /><Setter Property="Foreground" Value="{StaticResource Accent}" />
            <Setter Property="Padding" Value="7,2" /><Setter Property="MinWidth" Value="30" />
        </Style>
        <Style TargetType="Button" x:Key="TriggerBtn" BasedOn="{StaticResource SmBtn}">
            <Setter Property="Background" Value="{StaticResource AccGreen}" /><Setter Property="Foreground" Value="#FF1E1E2E" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style TargetType="TextBox" x:Key="Fld">
            <Setter Property="Background" Value="#22FFFFFF" /><Setter Property="Foreground" Value="{StaticResource TextP}" />
            <Setter Property="BorderBrush" Value="{StaticResource Bdr}" /><Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="6,4" /><Setter Property="FontSize" Value="12.5" /><Setter Property="Margin" Value="0,2,0,4" />
        </Style>
        <Style TargetType="Label" x:Key="Lbl">
            <Setter Property="Foreground" Value="{StaticResource TextS}" /><Setter Property="FontSize" Value="11" />
            <Setter Property="Padding" Value="0,6,0,1" /><Setter Property="FontWeight" Value="Medium" />
        </Style>
        <Style TargetType="ComboBox" x:Key="Cmb">
            <Setter Property="Background" Value="#22FFFFFF" /><Setter Property="Foreground" Value="{StaticResource TextP}" />
            <Setter Property="BorderBrush" Value="{StaticResource Bdr}" /><Setter Property="BorderThickness" Value="1" />
            <Setter Property="Margin" Value="0,2,0,4" /><Setter Property="Padding" Value="6,4" />
        </Style>
        <Style x:Key="Sec" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" /><Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource Accent}" /><Setter Property="Margin" Value="0,10,0,4" />
        </Style>
        <Style x:Key="TVI" TargetType="TreeViewItem">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
            <Setter Property="Foreground" Value="{StaticResource TextP}" />
            <Setter Property="Padding" Value="2,3" /><Setter Property="Margin" Value="0,1" />
        </Style>

        <!-- Shared tree item template with execution status indicator -->
        <HierarchicalDataTemplate x:Key="WatchTreeTemplate" DataType="{x:Type vm:TreeNodeViewModel}" ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal" Margin="0,1">
                <Border CornerRadius="3" Padding="4,1" Margin="0,0,4,0" MinWidth="22" HorizontalAlignment="Center">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{StaticResource Accent}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding NodeKind}" Value="WatchList">
                                    <Setter Property="Background" Value="{StaticResource AccGreen}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding NodeIcon}" FontSize="10" FontWeight="Bold"
                               Foreground="#FF1E1E2E" HorizontalAlignment="Center" />
                </Border>
                <TextBlock Text="{Binding DisplayText}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="FontSize" Value="12" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding NodeKind}" Value="WatchList">
                                    <Setter Property="FontWeight" Value="Bold" />
                                    <Setter Property="FontSize" Value="13" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <!-- F4: Execution status indicator -->
                <TextBlock Text="{Binding StatusSymbol}" FontSize="11" FontWeight="Bold" Margin="6,0,0,0" VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Setter Property="Foreground" Value="Transparent" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ExecutionStatus}" Value="Running">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Setter Property="Foreground" Value="{StaticResource Accent}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ExecutionStatus}" Value="Success">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Setter Property="Foreground" Value="{StaticResource AccGreen}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ExecutionStatus}" Value="Failed">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Setter Property="Foreground" Value="{StaticResource AccRed}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </HierarchicalDataTemplate>

        <HierarchicalDataTemplate x:Key="TemplateTreeTemplate" DataType="{x:Type vm:TreeNodeViewModel}" ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal" Margin="0,1">
                <Border CornerRadius="3" Padding="4,1" Margin="0,0,4,0" MinWidth="22" HorizontalAlignment="Center">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{StaticResource AccMauve}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding NodeKind}" Value="TemplateList">
                                    <Setter Property="Background" Value="{StaticResource AccPeach}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding NodeIcon}" FontSize="10" FontWeight="Bold"
                               Foreground="#FF1E1E2E" HorizontalAlignment="Center" />
                </Border>
                <TextBlock Text="{Binding DisplayText}" FontSize="11.5" TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding NodeKind}" Value="TemplateList">
                                    <Setter Property="FontWeight" Value="Bold" />
                                    <Setter Property="FontSize" Value="13" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </HierarchicalDataTemplate>
    </Window.Resources>

    <DockPanel>
        <!-- TOOLBAR -->
        <Border DockPanel.Dock="Top" Background="{StaticResource BgPanel}" Padding="10,6"
                BorderBrush="{StaticResource Bdr}" BorderThickness="0,0,0,1">
            <DockPanel>
                <StackPanel Orientation="Horizontal">
                    <Button Content="Open" Style="{StaticResource Btn}" Command="{Binding LoadVocabularyCommand}" />
                    <Button Content="Save" Style="{StaticResource Btn}" Command="{Binding SaveVocabularyCommand}" />
                    <Button Content="Save As" Style="{StaticResource Btn}" Command="{Binding SaveVocabularyAsCommand}" />
                    <TextBlock Text="{Binding VocabFilePath}" Foreground="{StaticResource TextS}" FontSize="11"
                               VerticalAlignment="Center" Margin="14,0,8,0" TextTrimming="CharacterEllipsis"
                               MaxWidth="360" FontFamily="Consolas" />
                    <!-- Execution controls -->
                    <Border Background="#33F38BA8" CornerRadius="4" Padding="2" Margin="4,0"
                            Visibility="{Binding IsExecuting, Converter={StaticResource BoolVis}}">
                        <Button Content="Cancel" Style="{StaticResource DangerBtn}" Command="{Binding CancelExecutionCommand}" />
                    </Border>
                    <Button Content="Reset Status" Style="{StaticResource SmBtn}" Margin="4,0"
                            Background="#33F9E2AF" Foreground="{StaticResource AccYellow}"
                            Command="{Binding ResetStatusCommand}" />
                </StackPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding StatusMessage}" Foreground="{StaticResource AccGreen}"
                           FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Right" />
            </DockPanel>
        </Border>

        <!-- STATUSBAR -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource BgPanel}" Padding="10,4"
                BorderBrush="{StaticResource Bdr}" BorderThickness="0,1,0,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text=" EXECUTING " Foreground="{StaticResource AccRed}" FontWeight="Bold"
                           FontSize="11" VerticalAlignment="Center" Margin="8,0"
                           Visibility="{Binding IsExecuting, Converter={StaticResource BoolVis}}" />
                <TextBlock FontSize="11" Foreground="{StaticResource TextS}">
                    <Run Text="Watchers: " /><Run Text="{Binding ActiveWatchers, Mode=OneWay}" Foreground="{StaticResource AccGreen}" FontWeight="Bold" />
                    <Run Text="  Agents: " /><Run Text="{Binding RegisteredAgents.Count, Mode=OneWay}" Foreground="{StaticResource Accent}" FontWeight="Bold" />
                    <Run Text="  Templates: " /><Run Text="{Binding TemplateRoots.Count, Mode=OneWay}" Foreground="{StaticResource AccMauve}" FontWeight="Bold" />
                </TextBlock>
            </DockPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" MinWidth="200" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="280" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="280" MinWidth="200" />
            </Grid.ColumnDefinitions>

            <!-- LEFT: WatchList Tree -->
            <Border Grid.Column="0" Background="{StaticResource BgPanel}">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="{StaticResource BgCard}" Padding="12,8"
                            BorderBrush="{StaticResource Bdr}" BorderThickness="0,0,0,1">
                        <TextBlock Text="WatchList Tree" FontSize="14" FontWeight="Bold" Foreground="{StaticResource Accent}" />
                    </Border>
                    <WrapPanel DockPanel.Dock="Top" Margin="6,6,6,2">
                        <Button Content="+ WatchItem" Style="{StaticResource SmBtn}" Command="{Binding AddWatchItemCommand}" />
                        <Button Content="+ Child" Style="{StaticResource SmBtn}" Command="{Binding AddChildNodeCommand}" />
                        <Button Content="+ Action" Style="{StaticResource SmBtn}" Command="{Binding AddActionToGroupCommand}" />
                        <Button Content="+ Ref" Style="{StaticResource SmBtn}" Command="{Binding AddRefToGroupCommand}" />
                        <Button Content="Delete" Style="{StaticResource DangerBtn}" Command="{Binding DeleteSelectedNodeCommand}" />
                    </WrapPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="6,2,6,4">
                        <Button Content="Up" Style="{StaticResource MoveBtn}" Command="{Binding MoveUpCommand}" />
                        <Button Content="Down" Style="{StaticResource MoveBtn}" Command="{Binding MoveDownCommand}" />
                    </StackPanel>
                    <TreeView x:Name="WatchListTreeView" ItemsSource="{Binding TreeRoots}"
                              Background="Transparent" Foreground="{StaticResource TextP}"
                              BorderThickness="0" Margin="4,0,4,4" Padding="0,4"
                              ItemContainerStyle="{StaticResource TVI}"
                              ItemTemplate="{StaticResource WatchTreeTemplate}" />
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" Width="4" Background="{StaticResource BgSurface}"
                          HorizontalAlignment="Center" VerticalAlignment="Stretch"
                          ResizeBehavior="PreviousAndNext" />

            <!-- CENTER: Properties + Log -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="200" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="200" MinHeight="100" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Margin="4" Background="{StaticResource BgPanel}" CornerRadius="6"
                        BorderBrush="{StaticResource Bdr}" BorderThickness="1" DataContext="{Binding ActiveEditNode}">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Background="{StaticResource BgCard}" Padding="12,8" CornerRadius="6,6,0,0">
                            <DockPanel>
                                <TextBlock Text="Node Properties" FontSize="14" FontWeight="Bold" Foreground="{StaticResource Accent}" />
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <!-- Execution status badge -->
                                    <Border CornerRadius="4" Padding="6,2" Margin="0,0,8,0"
                                            Visibility="{Binding ExecutionStatus, Converter={StaticResource VisWhen}, ConverterParameter=Running}">
                                        <Border.Background><SolidColorBrush Color="#3389B4FA" /></Border.Background>
                                        <TextBlock Text="RUNNING" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Accent}" />
                                    </Border>
                                    <Border CornerRadius="4" Padding="6,2" Margin="0,0,8,0"
                                            Visibility="{Binding ExecutionStatus, Converter={StaticResource VisWhen}, ConverterParameter=Success}">
                                        <Border.Background><SolidColorBrush Color="#33A6E3A1" /></Border.Background>
                                        <TextBlock Text="SUCCESS" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccGreen}" />
                                    </Border>
                                    <Border CornerRadius="4" Padding="6,2" Margin="0,0,8,0"
                                            Visibility="{Binding ExecutionStatus, Converter={StaticResource VisWhen}, ConverterParameter=Failed}">
                                        <Border.Background><SolidColorBrush Color="#33F38BA8" /></Border.Background>
                                        <TextBlock Text="FAILED" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccRed}" />
                                    </Border>
                                    <TextBlock Text="{Binding NodeKind, StringFormat='[ {0} ]'}"
                                               Foreground="{StaticResource AccMauve}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <Border DockPanel.Dock="Bottom" Padding="12,6" Background="{StaticResource BgCard}" CornerRadius="0,0,6,6"
                                BorderBrush="{StaticResource Bdr}" BorderThickness="0,1,0,0">
                            <Button Content="Apply Changes" Style="{StaticResource Btn}" HorizontalAlignment="Left"
                                    Command="{Binding DataContext.ApplyChangesCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                        </Border>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12,8">
                            <StackPanel>
                                <!-- ===== WatchList (root) ===== -->
                                <StackPanel Visibility="{Binding NodeKind, Converter={StaticResource VisWhen}, ConverterParameter=WatchList, FallbackValue=Collapsed}">
                                    <Border Background="#22A6E3A1" CornerRadius="6" Padding="14" Margin="0,4">
                                        <StackPanel>
                                            <TextBlock Text="WatchList Root" FontSize="16" FontWeight="Bold" Foreground="{StaticResource AccGreen}" Margin="0,0,0,8" />
                                            <TextBlock Foreground="{StaticResource TextS}" FontSize="12" Margin="0,2">
                                                <Run Text="File: " FontWeight="SemiBold" />
                                                <Run Text="{Binding DataContext.VocabFilePath, RelativeSource={RelativeSource AncestorType=Window}}" FontFamily="Consolas" />
                                            </TextBlock>
                                            <TextBlock Foreground="{StaticResource TextS}" FontSize="12" Margin="0,2">
                                                <Run Text="WatchItems: " FontWeight="SemiBold" />
                                                <Run Text="{Binding ChildCount, Mode=OneWay}" Foreground="{StaticResource AccGreen}" FontWeight="Bold" />
                                            </TextBlock>
                                            <TextBlock Text="This is the single WatchList root. Use + WatchItem to add items, or Open to load from file."
                                                       FontSize="11" Foreground="{StaticResource TextS}" TextWrapping="Wrap" Margin="0,8,0,0" FontStyle="Italic" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- ===== TemplateList (root) ===== -->
                                <StackPanel Visibility="{Binding NodeKind, Converter={StaticResource VisWhen}, ConverterParameter=TemplateList, FallbackValue=Collapsed}">
                                    <Border Background="#22CBA6F7" CornerRadius="6" Padding="14" Margin="0,4">
                                        <StackPanel>
                                            <TextBlock Text="Templates Root" FontSize="16" FontWeight="Bold" Foreground="{StaticResource AccMauve}" Margin="0,0,0,8" />
                                            <TextBlock Foreground="{StaticResource TextS}" FontSize="12" Margin="0,2">
                                                <Run Text="Templates: " FontWeight="SemiBold" />
                                                <Run Text="{Binding ChildCount, Mode=OneWay}" Foreground="{StaticResource AccMauve}" FontWeight="Bold" />
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- ===== WatchItem ===== -->
                                <StackPanel Visibility="{Binding NodeKind, Converter={StaticResource VisWhen}, ConverterParameter=WatchItem, FallbackValue=Collapsed}">
                                    <!-- F3: Trigger all events on this WatchItem -->
                                    <Border Background="#22A6E3A1" CornerRadius="4" Padding="8" Margin="0,0,0,8"
                                            BorderBrush="{StaticResource AccGreen}" BorderThickness="1">
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Content="Trigger All Events" Style="{StaticResource TriggerBtn}"
                                                    Command="{Binding DataContext.TriggerWatchItemCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                            <TextBlock Text="Manually execute all events for this WatchItem" FontSize="11"
                                                       Foreground="{StaticResource AccGreen}" VerticalAlignment="Center" />
                                        </DockPanel>
                                    </Border>
                                    <Label Content="TAG" Style="{StaticResource Lbl}" />
                                    <TextBox Text="{Binding Tag, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Fld}" FontSize="14" FontWeight="Bold" />
                                    <Label Content="WATCH PATH" Style="{StaticResource Lbl}" />
                                    <TextBox Text="{Binding WatchPath, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Fld}" FontFamily="Consolas" />
                                    <Label Content="FILTER" Style="{StaticResource Lbl}" />
                                    <TextBox Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Fld}" FontFamily="Consolas" />
                                    <CheckBox Content="Enabled" IsChecked="{Binding IsEnabled}" Foreground="{StaticResource TextP}" Margin="0,6" />

                                    <!-- F2: Inline XML Editor toggle -->
                                    <Border Background="#22FFFFFF" CornerRadius="4" Padding="8" Margin="0,10,0,0"
                                            BorderBrush="{StaticResource Bdr}" BorderThickness="1">
                                        <StackPanel>
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right" Content="Edit XML" Style="{StaticResource SmBtn}"
                                                        Background="{StaticResource AccPeach}" Foreground="#FF1E1E2E"
                                                        Command="{Binding DataContext.ToggleXmlEditorCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                <TextBlock Text="Raw XML Editor" FontSize="11" FontWeight="SemiBold"
                                                           Foreground="{StaticResource AccPeach}" VerticalAlignment="Center" />
                                            </DockPanel>
                                            <!-- Inline XML editor body (visible when toggled) -->
                                            <StackPanel Visibility="{Binding DataContext.IsXmlEditorOpen, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolVis}}">
                                                <TextBox Text="{Binding DataContext.XmlEditorText, RelativeSource={RelativeSource AncestorType=Window}, UpdateSourceTrigger=PropertyChanged}"
                                                         AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap"
                                                         VerticalScrollBarVisibility="Auto" Height="200"
                                                         FontFamily="Consolas" FontSize="12"
                                                         Background="#FF181825" Foreground="{StaticResource TextP}"
                                                         BorderBrush="{StaticResource Bdr}" BorderThickness="1"
                                                         Padding="8" Margin="0,8,0,4" />
                                                <TextBlock Text="{Binding DataContext.XmlEditorStatus, RelativeSource={RelativeSource AncestorType=Window}}"
                                                           FontSize="11" TextWrapping="Wrap" Margin="0,0,0,4">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{StaticResource AccGreen}" />
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <StackPanel Orientation="Horizontal">
                                                    <Button Content="Apply XML" Style="{StaticResource SmBtn}"
                                                            Background="{StaticResource AccGreen}" Foreground="#FF1E1E2E"
                                                            Command="{Binding DataContext.ApplyXmlEditorCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                    <Button Content="Revert" Style="{StaticResource SmBtn}" Margin="6,0,0,0"
                                                            Background="#3389B4FA" Foreground="{StaticResource Accent}"
                                                            Command="{Binding DataContext.RevertXmlEditorCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- ===== Event ===== -->
                                <StackPanel Visibility="{Binding NodeKind, Converter={StaticResource VisWhen}, ConverterParameter=Event, FallbackValue=Collapsed}">
                                    <!-- F3: Trigger this single event -->
                                    <Border Background="#22A6E3A1" CornerRadius="4" Padding="8" Margin="0,0,0,8"
                                            BorderBrush="{StaticResource AccGreen}" BorderThickness="1">
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Content="Trigger Event" Style="{StaticResource TriggerBtn}"
                                                    Command="{Binding DataContext.TriggerEventCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                            <TextBlock Text="Manually execute this event's action pipeline" FontSize="11"
                                                       Foreground="{StaticResource AccGreen}" VerticalAlignment="Center" />
                                        </DockPanel>
                                    </Border>
                                    <Label Content="EVENT TYPE" Style="{StaticResource Lbl}" />
                                    <ComboBox ItemsSource="{StaticResource EventTypes}" SelectedItem="{Binding EventType}" Style="{StaticResource Cmb}" />
                                    <Label Content="EXECUTION TYPE" Style="{StaticResource Lbl}" />
                                    <ComboBox ItemsSource="{StaticResource ExecModes}" SelectedItem="{Binding ExecutionTypeText}" Style="{StaticResource Cmb}" />
                                </StackPanel>

                                <!-- ===== ActionGroup ===== -->
                                <StackPanel Visibility="{Binding NodeKind, Converter={StaticResource VisWhen}, ConverterParameter=ActionGroup, FallbackValue=Collapsed}">
                                    <Label Content="TAG" Style="{StaticResource Lbl}" />
                                    <TextBox Text="{Binding Tag, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Fld}" />
                                    <Label Content="EXECUTION TYPE" Style="{StaticResource Lbl}" />
                                    <ComboBox ItemsSource="{StaticResource ExecModes}" SelectedItem="{Binding ExecutionTypeText}" Style="{StaticResource Cmb}" />
                                    <CheckBox Content="FailAndContinue" IsChecked="{Binding FailAndContinue}" Foreground="{StaticResource TextP}" Margin="0,6" />
                                </StackPanel>

                                <!-- ===== Action ===== -->
                                <StackPanel Visibility="{Binding NodeKind, Converter={StaticResource VisWhen}, ConverterParameter=Action, FallbackValue=Collapsed}">
                                    <Label Content="ACTION TYPE" Style="{StaticResource Lbl}" />
                                    <ComboBox ItemsSource="{StaticResource ActionTypes}" SelectedItem="{Binding ActionTypeText}" Style="{StaticResource Cmb}" />
                                    <StackPanel Visibility="{Binding ActionTypeText, Converter={StaticResource ActionVis}, ConverterParameter=RunCommand|RunRemoteCommand}">
                                        <TextBlock Text="COMMAND SETTINGS" Style="{StaticResource Sec}" />
                                        <Label Content="COMMAND" Style="{StaticResource Lbl}" />
                                        <TextBox Text="{Binding Command, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Fld}" FontFamily="Consolas" />
                                        <Label Content="PARAMETERS" Style="{StaticResource Lbl}" />
                                        <TextBox Text="{Binding Parameters, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Fld}" FontFamily="Consolas"
                                                 TextWrapping="Wrap" AcceptsReturn="True" Height="52" VerticalScrollBarVisibility="Auto" />
                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <Label Content="TIMEOUT (sec)" Style="{StaticResource Lbl}" />
                                                <TextBox Text="{Binding Timeout, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Fld}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <Label Content="POLL INTERVAL (ms)" Style="{StaticResource Lbl}" />
                                                <TextBox Text="{Binding PollInterval, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Fld}" />
                                            </StackPanel>
                                        </Grid>
                                        <StackPanel Orientation="Horizontal" Margin="0,4">
                                            <CheckBox Content="FailAndContinue" IsChecked="{Binding FailAndContinue}" Foreground="{StaticResource TextP}" Margin="0,0,16,0" />
                                            <CheckBox Content="IsReboot" IsChecked="{Binding IsReboot}" Foreground="{StaticResource TextP}" />
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Visibility="{Binding ActionTypeText, Converter={StaticResource ActionVis}, ConverterParameter=RunRemoteCommand}">
                                        <TextBlock Text="REMOTE AGENT" Style="{StaticResource Sec}" />
                                        <Label Content="AGENT NAME" Style="{StaticResource Lbl}" />
                                        <TextBox Text="{Binding AgentName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Fld}" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <Label Content="USERNAME" Style="{StaticResource Lbl}" />
                                                <TextBox Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Fld}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <Label Content="PASSWORD" Style="{StaticResource Lbl}" />
                                                <TextBox Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Fld}" />
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                    <StackPanel Visibility="{Binding ActionTypeText, Converter={StaticResource ActionVis}, ConverterParameter=SendMail}">
                                        <TextBlock Text="MAIL SETTINGS" Style="{StaticResource Sec}" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <Label Content="FROM" Style="{StaticResource Lbl}" />
                                                <TextBox Text="{Binding From, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Fld}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <Label Content="TO" Style="{StaticResource Lbl}" />
                                                <TextBox Text="{Binding To, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Fld}" />
                                            </StackPanel>
                                        </Grid>
                                        <Label Content="SUBJECT" Style="{StaticResource Lbl}" />
                                        <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Fld}" />
                                        <Label Content="BODY" Style="{StaticResource Lbl}" />
                                        <TextBox Text="{Binding Body, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Fld}"
                                                 TextWrapping="Wrap" AcceptsReturn="True" Height="50" VerticalScrollBarVisibility="Auto" />
                                        <Label Content="ATTACHMENT" Style="{StaticResource Lbl}" />
                                        <TextBox Text="{Binding Attachment, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Fld}" />
                                        <Label Content="EMBED" Style="{StaticResource Lbl}" />
                                        <TextBox Text="{Binding Embed, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Fld}" />
                                        <Label Content="LARGE FILES SHARE" Style="{StaticResource Lbl}" />
                                        <TextBox Text="{Binding LargeFilesShare, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Fld}" />
                                    </StackPanel>
                                </StackPanel>

                                <!-- ===== Initialize ===== -->
                                <StackPanel Visibility="{Binding NodeKind, Converter={StaticResource VisWhen}, ConverterParameter=Initialize, FallbackValue=Collapsed}">
                                    <Label Content="TAG" Style="{StaticResource Lbl}" />
                                    <TextBox Text="{Binding Tag, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Fld}" />
                                    <Label Content="PARAMETER FILE" Style="{StaticResource Lbl}" />
                                    <TextBox Text="{Binding ParameterFile, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Fld}" FontFamily="Consolas" />
                                </StackPanel>

                                <!-- ===== Ref ===== -->
                                <StackPanel Visibility="{Binding NodeKind, Converter={StaticResource VisWhen}, ConverterParameter=Ref, FallbackValue=Collapsed}">
                                    <Label Content="TEMPLATE ID" Style="{StaticResource Lbl}" />
                                    <ComboBox ItemsSource="{Binding DataContext.AvailableTemplateIds, RelativeSource={RelativeSource AncestorType=Window}}"
                                              SelectedItem="{Binding TemplateID}" IsEditable="True"
                                              Text="{Binding TemplateID, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Cmb}" />
                                </StackPanel>

                                <!-- ===== Template ===== -->
                                <StackPanel Visibility="{Binding NodeKind, Converter={StaticResource VisWhen}, ConverterParameter=Template, FallbackValue=Collapsed}">
                                    <Label Content="TEMPLATE ID" Style="{StaticResource Lbl}" />
                                    <TextBox Text="{Binding TemplateName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Fld}" FontSize="14" FontWeight="Bold" />
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <GridSplitter Grid.Row="1" Height="3" HorizontalAlignment="Stretch" Background="{StaticResource BgSurface}" />

                <!-- Execution Log -->
                <Border Grid.Row="2" Margin="4" Background="{StaticResource BgPanel}" CornerRadius="6"
                        BorderBrush="{StaticResource Bdr}" BorderThickness="1">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Background="{StaticResource BgCard}" Padding="12,6" CornerRadius="6,6,0,0">
                            <TextBlock Text="Execution Log" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AccGreen}" />
                        </Border>
                        <ListBox x:Name="LogListBox" ItemsSource="{Binding LogEntries}" Background="Transparent"
                                 BorderThickness="0" Foreground="{StaticResource TextS}" FontFamily="Consolas" FontSize="11" Padding="4,2">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="6,1" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem"><ContentPresenter /></ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                    </DockPanel>
                </Border>
            </Grid>

            <GridSplitter Grid.Column="3" Width="4" Background="{StaticResource BgSurface}"
                          HorizontalAlignment="Center" VerticalAlignment="Stretch"
                          ResizeBehavior="PreviousAndNext" />

            <!-- RIGHT: Templates + Agents -->
            <Border Grid.Column="4" Background="{StaticResource BgPanel}" MinWidth="200">
                <DockPanel>
                    <Border DockPanel.Dock="Bottom" Background="{StaticResource BgCard}" Padding="10" Margin="6"
                            CornerRadius="6" BorderBrush="{StaticResource Bdr}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Agent Registration" FontSize="13" FontWeight="Bold" Foreground="{StaticResource AccPeach}" Margin="0,0,0,6" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <Label Content="Agent Name" Style="{StaticResource Lbl}" />
                                    <TextBox Text="{Binding NewAgentName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Fld}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <Label Content="gRPC Address" Style="{StaticResource Lbl}" />
                                    <TextBox Text="{Binding NewAgentAddress, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Fld}" FontFamily="Consolas" FontSize="11" />
                                </StackPanel>
                            </Grid>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,4">
                                <Button Content="Register + Test" Style="{StaticResource SmBtn}"
                                        Background="{StaticResource AccPeach}" Foreground="#FF1E1E2E"
                                        Command="{Binding RegisterAgentCommand}" />
                                <Button Content="Test All" Style="{StaticResource SmBtn}" Margin="6,0,0,0"
                                        Background="#3389B4FA" Foreground="{StaticResource Accent}"
                                        Command="{Binding TestAllAgentsCommand}" />
                                <Button Content="Test" Style="{StaticResource SmBtn}" Margin="6,0,0,0"
                                        Background="#33A6E3A1" Foreground="{StaticResource AccGreen}"
                                        Command="{Binding TestConnectionCommand}" />
                                <Button Content="Diagnose" Style="{StaticResource SmBtn}" Margin="6,0,0,0"
                                        Background="#33CBA6F7" Foreground="{StaticResource AccMauve}"
                                        Command="{Binding DiagnoseAgentCommand}" ToolTip="Run full connectivity diagnostic (DNS → TCP → HTTP → gRPC)" />
                                <Button Content="Remove" Style="{StaticResource DangerBtn}" Margin="6,0,0,0"
                                        Command="{Binding UnregisterAgentCommand}" />
                            </StackPanel>
                            <!-- Agent list with status indicators -->
                            <ListBox ItemsSource="{Binding RegisteredAgents}"
                                     SelectedItem="{Binding SelectedAgent}"
                                     Background="Transparent" BorderThickness="0"
                                     MaxHeight="140" Margin="0,2,0,0">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="4,3" />
                                        <Setter Property="Margin" Value="0,1" />
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="Foreground" Value="{StaticResource TextP}" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#15FFFFFF" CornerRadius="4" Padding="8,5">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <!-- Status icon -->
                                                <TextBlock Grid.Column="0" Text="{Binding StatusIcon}" FontSize="13" FontWeight="Bold" Margin="0,0,8,0" VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{StaticResource TextS}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding ConnectionStatus}" Value="Online">
                                                                    <Setter Property="Foreground" Value="{StaticResource AccGreen}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding ConnectionStatus}" Value="Testing">
                                                                    <Setter Property="Foreground" Value="{StaticResource Accent}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding ConnectionStatus}" Value="Offline">
                                                                    <Setter Property="Foreground" Value="{StaticResource AccRed}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding ConnectionStatus}" Value="Error">
                                                                    <Setter Property="Foreground" Value="{StaticResource AccPeach}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <!-- Agent name + address -->
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextP}">
                                                        <Run Text="{Binding Name, Mode=OneWay}" />
                                                        <Run Text="  " />
                                                        <Run Text="{Binding Address, Mode=OneWay}" FontFamily="Consolas" FontSize="10" Foreground="{StaticResource TextS}" />
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding DetailLine}" FontSize="9.5" FontFamily="Consolas" Margin="0,1,0,0">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{StaticResource TextS}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding ConnectionStatus}" Value="Online">
                                                                        <Setter Property="Foreground" Value="{StaticResource AccGreen}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding ConnectionStatus}" Value="Offline">
                                                                        <Setter Property="Foreground" Value="{StaticResource AccRed}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                                <!-- Last checked -->
                                                <TextBlock Grid.Column="2" Text="{Binding LastChecked}" FontSize="9" FontFamily="Consolas"
                                                           Foreground="{StaticResource TextS}" VerticalAlignment="Center" Margin="6,0,0,0" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </Border>
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Background="{StaticResource BgCard}" Padding="12,8"
                                BorderBrush="{StaticResource Bdr}" BorderThickness="0,0,0,1">
                            <TextBlock Text="Templates" FontSize="14" FontWeight="Bold" Foreground="{StaticResource AccMauve}" />
                        </Border>
                        <WrapPanel DockPanel.Dock="Top" Margin="6,6,6,2">
                            <Button Content="+ Template" Style="{StaticResource SmBtn}" Command="{Binding AddTemplateCommand}" />
                            <Button Content="+ Group" Style="{StaticResource SmBtn}" Command="{Binding AddGroupToTemplateCommand}" />
                            <Button Content="+ Action" Style="{StaticResource SmBtn}" Command="{Binding AddActionToTemplateCommand}" />
                            <Button Content="+ Ref" Style="{StaticResource SmBtn}" Command="{Binding AddRefToTemplateCommand}" />
                            <Button Content="+ Init" Style="{StaticResource SmBtn}" Command="{Binding AddInitializeToTemplateCommand}" />
                            <Button Content="Delete" Style="{StaticResource DangerBtn}" Command="{Binding DeleteTemplateCommand}" />
                        </WrapPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="6,2,6,4">
                            <Button Content="Up" Style="{StaticResource MoveBtn}" Command="{Binding MoveTemplateUpCommand}" />
                            <Button Content="Down" Style="{StaticResource MoveBtn}" Command="{Binding MoveTemplateDownCommand}" />
                        </StackPanel>
                        <TreeView x:Name="TemplateTreeView" ItemsSource="{Binding TemplateRoots}"
                                  Background="Transparent" Foreground="{StaticResource TextP}"
                                  BorderThickness="0" Margin="4,0,4,4" Padding="0,4"
                                  ItemContainerStyle="{StaticResource TVI}"
                                  ItemTemplate="{StaticResource TemplateTreeTemplate}" />
                    </DockPanel>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
