<Window x:Class="TestControllerGrpc.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        xmlns:vm="clr-namespace:TestControllerGrpc.ViewModels"
        xmlns:views="clr-namespace:TestControllerGrpc.Views"
        xmlns:aw="clr-namespace:TestControllerGrpc.Views.AgentWorkspace"
        xmlns:panels="clr-namespace:TestControllerGrpc.Views.Panels"
        xmlns:controls="clr-namespace:TestControllerGrpc.Controls"
        Title="TestController  -  WatchList Editor"
        Height="900" Width="1400" MinWidth="1000" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBg}">

    <Window.InputBindings>
        <!-- File operations -->
        <KeyBinding Key="O" Modifiers="Ctrl" Command="{Binding LoadVocabularyCommand}" />
        <KeyBinding Key="S" Modifiers="Ctrl" Command="{Binding SaveVocabularyCommand}" />
        <KeyBinding Key="S" Modifiers="Ctrl+Shift" Command="{Binding SaveVocabularyAsCommand}" />
        <KeyBinding Key="R" Modifiers="Ctrl" Command="{Binding RefreshWatchListCommand}" />

        <!-- Execution -->
        <KeyBinding Key="F5" Command="{Binding TriggerAllWatchItemsCommand}" />
        <KeyBinding Key="F5" Modifiers="Shift" Command="{Binding CancelExecutionCommand}" />
        <KeyBinding Key="R" Modifiers="Ctrl+Shift" Command="{Binding RetryFailedCommand}" />

        <!-- Log -->
        <KeyBinding Key="L" Modifiers="Ctrl" Command="{Binding FocusLogSearchCommand}" />
        <KeyBinding Key="L" Modifiers="Ctrl+Shift" Command="{Binding ClearLogCommand}" />
        <KeyBinding Key="E" Modifiers="Ctrl" Command="{Binding ExportLogCommand}" />
        <KeyBinding Key="P" Modifiers="Ctrl+Shift" Command="{Binding ToggleLogPauseCommand}" />
        <KeyBinding Key="C" Modifiers="Ctrl+Shift" Command="{Binding CopyLogCommand}" />

        <!-- Tree CRUD -->
        <KeyBinding Key="Delete" Command="{Binding ConfirmDeleteSelectedNodeCommand}" />
        <KeyBinding Key="A" Modifiers="Ctrl+Shift" Command="{Binding AddActionToGroupCommand}" />
        <KeyBinding Key="G" Modifiers="Ctrl+Shift" Command="{Binding AddActionGroupCommand}" />

        <!-- Help -->
        <KeyBinding Key="F1" Command="{Binding OpenHelpCommand}" />

        <!-- Panel toggles (Ctrl+1/2/3) -->
        <KeyBinding Key="D1" Modifiers="Ctrl" Command="{Binding ToggleTreePanePinCommand}" />
        <KeyBinding Key="D2" Modifiers="Ctrl" Command="{Binding ToggleAgentPanePinCommand}" />
        <KeyBinding Key="D3" Modifiers="Ctrl" Command="{Binding ToggleLogPanePinCommand}" />

        <!-- Multi-session Execution Dashboard (standalone window) -->
        <KeyBinding Key="F12" Command="{Binding ExecutionDashboard.OpenDashboardWindowCommand}" />
    </Window.InputBindings>

    <Window.Icon>
        <DrawingImage>
            <DrawingImage.Drawing>
                <GeometryDrawing Brush="#FF89B4FA" Geometry="M12,2 C6.48,2 2,6.48 2,12 C2,17.52 6.48,22 12,22 C17.52,22 22,17.52 22,12 C22,6.48 17.52,2 12,2 Z M10,17 L5,12 L6.41,10.59 L10,14.17 L17.59,6.58 L19,8 Z" />
            </DrawingImage.Drawing>
        </DrawingImage>
    </Window.Icon>

    <Window.Resources>
        <vm:NodeKindToVisibilityConverter x:Key="VisWhen" />
        <vm:ActionTypeFieldVisibilityConverter x:Key="ActionVis" />
        <vm:InverseBoolToVisibilityConverter x:Key="InvBoolVis" />
        <vm:NodeKindToIconBgConverter x:Key="IconBgConv" />
        <vm:StringEmptyToVisibilityConverter x:Key="EmptyVis" />
        <vm:EditingContextToVisibilityConverter x:Key="CtxVis" />
        <BooleanToVisibilityConverter x:Key="BoolVis" />
        <vm:ProgressPercentToWidthConverter x:Key="ProgressPercentToWidth" />
        <vm:IntToVisibilityConverter x:Key="IntToVis" />
        <vm:NonEmptyToVisibilityConverter x:Key="NonEmptyVis" />
        <views:HealthLevelToBrushConverter x:Key="HealthBrush" />

        <x:Array x:Key="EventTypes" Type="{x:Type sys:String}">
            <sys:String>Renamed</sys:String><sys:String>Created</sys:String><sys:String>Changed</sys:String>
        </x:Array>
        <x:Array x:Key="ExecModes" Type="{x:Type sys:String}">
            <sys:String>Sequential</sys:String><sys:String>Parallel</sys:String>
        </x:Array>
        <x:Array x:Key="ActionTypes" Type="{x:Type sys:String}">
            <sys:String>RunCommand</sys:String><sys:String>RunRemoteCommand</sys:String><sys:String>SendMail</sys:String>
        </x:Array>

        <!-- ── Base Styles ── -->
        <Style TargetType="Button" x:Key="Btn">
            <Setter Property="Background" Value="{DynamicResource Accent}" />
            <Setter Property="Foreground" Value="{DynamicResource TreeBadgeFg}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Margin" Value="3" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style TargetType="Button" x:Key="SmBtn" BasedOn="{StaticResource Btn}">
            <Setter Property="FontSize" Value="11" /><Setter Property="Padding" Value="8,4" /><Setter Property="Margin" Value="3" />
        </Style>
        <Style TargetType="Button" x:Key="DangerBtn" BasedOn="{StaticResource SmBtn}">
            <Setter Property="Background" Value="{DynamicResource DangerBtnBgAlt}" /><Setter Property="Foreground" Value="{DynamicResource AccRed}" />
        </Style>
        <Style TargetType="Button" x:Key="MoveBtn" BasedOn="{StaticResource SmBtn}">
            <Setter Property="Background" Value="{DynamicResource AccentBtnBg}" /><Setter Property="Foreground" Value="{DynamicResource Accent}" />
            <Setter Property="Padding" Value="7,3" /><Setter Property="MinWidth" Value="30" />
        </Style>
        <Style TargetType="Button" x:Key="TriggerBtn" BasedOn="{StaticResource SmBtn}">
            <Setter Property="Background" Value="{DynamicResource AccGreen}" /><Setter Property="Foreground" Value="{DynamicResource TreeBadgeFg}" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <!-- Secondary outline trigger button -->
        <Style TargetType="Button" x:Key="TriggerOutlineBtn" BasedOn="{StaticResource SmBtn}">
            <Setter Property="Background" Value="{DynamicResource GreenBtnBg}" />
            <Setter Property="Foreground" Value="{DynamicResource AccGreen}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style TargetType="TextBox" x:Key="Fld">
            <Setter Property="Background" Value="{DynamicResource FieldBg}" /><Setter Property="Foreground" Value="{DynamicResource TextP}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Bdr}" /><Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="6,4" /><Setter Property="FontSize" Value="12.5" /><Setter Property="Margin" Value="0,2,0,5" />
        </Style>
        <Style TargetType="Label" x:Key="Lbl">
            <Setter Property="Foreground" Value="{DynamicResource TextS}" /><Setter Property="FontSize" Value="11" />
            <Setter Property="Padding" Value="0,6,0,2" /><Setter Property="FontWeight" Value="Medium" />
        </Style>
        <!-- Cmb key kept for backward compat; inherits the implicit themed ComboBox style -->
        <Style TargetType="ComboBox" x:Key="Cmb" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Margin" Value="0,2,0,5" />
            <Setter Property="Height" Value="28" />
            <Setter Property="FontSize" Value="11" />
        </Style>
        <Style x:Key="Sec" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" /><Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource Accent}" /><Setter Property="Margin" Value="0,10,0,4" />
        </Style>
        <Style x:Key="TVI" TargetType="TreeViewItem">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
            <Setter Property="Visibility" Value="{Binding IsFilterVisible, Converter={StaticResource BoolVis}}" />
            <Setter Property="Foreground" Value="{DynamicResource TextP}" />
            <Setter Property="Padding" Value="2,3" /><Setter Property="Margin" Value="0,1" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TreeViewItem">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition />
                            </Grid.RowDefinitions>
                            <ToggleButton x:Name="Expander" Grid.Column="0" Grid.Row="0"
                                          IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press" Background="Transparent" BorderThickness="0"
                                          Width="16" Height="16" Padding="0" Cursor="Hand">
                                <ToggleButton.Style>
                                    <Style TargetType="ToggleButton">
                                        <Setter Property="Focusable" Value="False" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ToggleButton">
                                                    <Border Background="Transparent" Width="16" Height="16">
                                                        <Path x:Name="Arrow" Fill="{DynamicResource TextS}"
                                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                                              Data="M 4,0 L 8,4 L 4,8 Z" Width="10" Height="10"
                                                              Stretch="Uniform" />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsChecked" Value="True">
                                                            <Setter TargetName="Arrow" Property="Data" Value="M 0,4 L 8,4 L 4,8 Z" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ToggleButton.Style>
                            </ToggleButton>
                            <Border x:Name="Bd" Grid.Column="1" Grid.Row="0"
                                    Background="{TemplateBinding Background}"
                                    Padding="{TemplateBinding Padding}"
                                    CornerRadius="3" SnapsToDevicePixels="True">
                                <ContentPresenter x:Name="PART_Header" ContentSource="Header"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                            </Border>
                            <ItemsPresenter x:Name="ItemsHost" Grid.Column="1" Grid.Row="1" Margin="12,0,0,0" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="False">
                                <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="Expander" Property="Visibility" Value="Hidden" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SelectedItemBg}" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True" />
                                    <Condition Property="IsSelected" Value="False" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverItemBg}" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Left-panel tab style ── -->
        <Style x:Key="LeftPanelTab" TargetType="TabItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextS}" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBd" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                BorderThickness="0,0,0,2" BorderBrush="Transparent"
                                SnapsToDevicePixels="True" Cursor="Hand">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBd" Property="BorderBrush" Value="{DynamicResource Accent}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextP}" />
                                <Setter TargetName="TabBd" Property="Background" Value="{DynamicResource TabSelectedBg}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBd" Property="Background" Value="{DynamicResource TabHoverBg}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Collapsible section (Expander) style ── -->
        <Style x:Key="SectionExpander" TargetType="Expander">
            <Setter Property="IsExpanded" Value="True" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="Foreground" Value="{DynamicResource TextP}" />
        </Style>

        <!-- Slim ribbon ScrollViewer: thin scrollbar, only visible on hover -->
        <Style x:Key="RibbonScrollViewer" TargetType="ScrollViewer">
            <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
            <Setter Property="VerticalScrollBarVisibility" Value="Disabled" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <ScrollContentPresenter Grid.Row="0" CanContentScroll="{TemplateBinding CanContentScroll}" />
                            <ScrollBar x:Name="PART_HorizontalScrollBar" Grid.Row="1"
                                       Orientation="Horizontal" Height="3" Opacity="0"
                                       Maximum="{TemplateBinding ScrollableWidth}"
                                       ViewportSize="{TemplateBinding ViewportWidth}"
                                       Value="{TemplateBinding HorizontalOffset}"
                                       Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PART_HorizontalScrollBar" Property="Opacity" Value="0.6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Ribbon button styles ── -->
        <Style x:Key="RibbonBtn" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource BtnBg}" />
            <Setter Property="Foreground" Value="{DynamicResource TextP}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BtnBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="MinWidth" Value="52" />
            <Setter Property="Height" Value="52" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BtnHoverBg}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BtnPressedBg}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                                <Setter Property="Foreground" Value="{DynamicResource DisabledFg}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RibbonBtnAccent" TargetType="Button" BasedOn="{StaticResource RibbonBtn}">
            <Setter Property="Background" Value="{DynamicResource AccentBtnBg}" />
            <Setter Property="Foreground" Value="{DynamicResource Accent}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="RibbonBtnGreen" TargetType="Button" BasedOn="{StaticResource RibbonBtn}">
            <Setter Property="Background" Value="{DynamicResource GreenBtnBg}" />
            <Setter Property="Foreground" Value="{DynamicResource AccGreen}" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style x:Key="RibbonBtnDanger" TargetType="Button" BasedOn="{StaticResource RibbonBtn}">
            <Setter Property="Background" Value="{DynamicResource DangerBtnBg}" />
            <Setter Property="Foreground" Value="{DynamicResource AccRed}" />
        </Style>
        <Style x:Key="RibbonBtnMauve" TargetType="Button" BasedOn="{StaticResource RibbonBtn}">
            <Setter Property="Background" Value="{DynamicResource MauveBtnBg}" />
            <Setter Property="Foreground" Value="{DynamicResource AccMauve}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="RibbonBtnYellow" TargetType="Button" BasedOn="{StaticResource RibbonBtn}">
            <Setter Property="Background" Value="{DynamicResource YellowBtnBg}" />
            <Setter Property="Foreground" Value="{DynamicResource AccYellow}" />
        </Style>
        <Style x:Key="RibbonBtnLarge" TargetType="Button" BasedOn="{StaticResource RibbonBtn}">
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="MinWidth" Value="56" />
        </Style>

        <!-- ── Centralized Icon TextBlock styles (Segoe MDL2 Assets) ── -->
        <Style x:Key="IconText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Foreground" Value="{DynamicResource IconFg}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
        </Style>
        <Style x:Key="RibbonIconText" TargetType="TextBlock" BasedOn="{StaticResource IconText}">
            <Setter Property="FontSize" Value="20" />
        </Style>
        <Style x:Key="TreeIconText" TargetType="TextBlock" BasedOn="{StaticResource IconText}">
            <Setter Property="FontSize" Value="14" />
        </Style>

        <!-- ── Tree templates ── -->
        <HierarchicalDataTemplate x:Key="WatchTreeTemplate" DataType="{x:Type vm:TreeNodeViewModel}" ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal" Margin="0,1"
                        ToolTip="{Binding StatusTooltip}">
                <!-- Context menu is built dynamically in code-behind (MainWindow.xaml.cs) -->
                <!-- Icon container: semantic glyph + status overlay dot -->
                <Grid Width="24" Height="20" Margin="0,0,5,0">
                    <!-- Icon background -->
                    <Border CornerRadius="4" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Width="22" Height="18"
                            Background="{Binding NodeKind, Converter={StaticResource IconBgConv}}">
                        <TextBlock Text="{Binding NodeIconGlyph}" Style="{StaticResource TreeIconText}"
                                   Foreground="{DynamicResource TextP}" />
                    </Border>
                    <!-- Status overlay dot (bottom-right corner) -->
                    <Ellipse Width="8" Height="8"
                             HorizontalAlignment="Right" VerticalAlignment="Bottom"
                             Margin="0,0,-1,-1" StrokeThickness="1.5">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Setter Property="Fill" Value="Transparent" />
                                <Setter Property="Stroke" Value="{DynamicResource BgPanel}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ExecutionStatus}" Value="Success">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Setter Property="Fill" Value="{DynamicResource StatusGreen}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ExecutionStatus}" Value="Failed">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Setter Property="Fill" Value="{DynamicResource StatusRed}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ExecutionStatus}" Value="Running">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Setter Property="Fill" Value="{DynamicResource StatusBlue}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ExecutionStatus}" Value="PartialFailure">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Setter Property="Fill" Value="{DynamicResource StatusYellow}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ExecutionStatus}" Value="Cancelled">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Setter Property="Fill" Value="{DynamicResource StatusGray}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Setter Property="Fill" Value="{DynamicResource StatusGray}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <!-- HC status glyph overlay (visible only in High Contrast) -->
                    <TextBlock HorizontalAlignment="Right" VerticalAlignment="Bottom"
                               Margin="0,0,-2,-2" FontSize="8" FontWeight="Bold"
                               Foreground="{DynamicResource HcGlyphFg}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="" />
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ExecutionStatus}" Value="Running">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Setter Property="Text" Value="R" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ExecutionStatus}" Value="Success">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Setter Property="Text" Value="&#x2713;" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ExecutionStatus}" Value="Failed">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Setter Property="Text" Value="&#x2717;" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ExecutionStatus}" Value="PartialFailure">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Setter Property="Text" Value="!" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ExecutionStatus}" Value="Cancelled">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Setter Property="Text" Value="&#x2014;" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
                <!-- Node text with status-aware styling -->
                <TextBlock Text="{Binding ResolvedDisplayText}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="FontSize" Value="12" />
                            <Setter Property="Foreground" Value="{DynamicResource TextP}" />
                            <Setter Property="ToolTip" Value="{Binding StatusTooltip}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding NodeKind}" Value="WatchList">
                                    <Setter Property="FontWeight" Value="Bold" />
                                    <Setter Property="FontSize" Value="13" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ExecutionStatus}" Value="Failed">
                                    <Setter Property="Foreground" Value="{DynamicResource AccRed}" />
                                    <Setter Property="FontWeight" Value="Bold" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ExecutionStatus}" Value="Running">
                                    <Setter Property="Foreground" Value="{DynamicResource Accent}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ExecutionStatus}" Value="Success">
                                    <Setter Property="Foreground" Value="{DynamicResource AccGreen}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ExecutionStatus}" Value="PartialFailure">
                                    <Setter Property="Foreground" Value="{DynamicResource AccYellow}" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ExecutionStatus}" Value="Cancelled">
                                    <Setter Property="Foreground" Value="{DynamicResource TextS}" />
                                    <Setter Property="FontStyle" Value="Italic" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                    <Setter Property="Foreground" Value="{DynamicResource TextS}" />
                                    <Setter Property="FontStyle" Value="Italic" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding HasUnresolvedTokens}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource AccYellow}" />
                                    <Setter Property="ToolTip" Value="{Binding UnresolvedTokenTooltip}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <!-- Status indicator: animated spinner (Running) / MDL2 glyphs (terminal states) -->
                <Grid Margin="6,0,0,0" VerticalAlignment="Center" Width="14" Height="14">
                    <!-- Running: spinning sync glyph
                         Animation runs via Loaded EventTrigger (not DataTrigger.EnterActions)
                         to avoid "Cannot animate immutable object" crash when WPF freezes
                         the RotateTransform during HierarchicalDataTemplate instantiation. -->
                    <TextBlock x:Name="SpinnerGlyph" Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                               Foreground="{DynamicResource Accent}" RenderTransformOrigin="0.5,0.5"
                               HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock.RenderTransform>
                            <RotateTransform Angle="0" />
                        </TextBlock.RenderTransform>
                        <TextBlock.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever" Storyboard.DesiredFrameRate="30">
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                         From="0" To="360" Duration="0:0:1.2" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </TextBlock.Triggers>
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ExecutionStatus}" Value="Running">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <!-- Success: CheckMark -->
                    <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                               Foreground="{DynamicResource AccGreen}"
                               HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ExecutionStatus}" Value="Success">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <!-- Failed: Cancel/X -->
                    <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                               Foreground="{DynamicResource AccRed}"
                               HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ExecutionStatus}" Value="Failed">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <!-- PartialFailure: Warning -->
                    <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                               Foreground="{DynamicResource AccYellow}"
                               HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ExecutionStatus}" Value="PartialFailure">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <!-- Cancelled: Blocked -->
                    <TextBlock Text="&#xE25B;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                               Foreground="{DynamicResource StatusGray}"
                               HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ExecutionStatus}" Value="Cancelled">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </StackPanel>
        </HierarchicalDataTemplate>

        <HierarchicalDataTemplate x:Key="TemplateTreeTemplate" DataType="{x:Type vm:TreeNodeViewModel}" ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal" Margin="0,1"
                        ToolTip="{Binding StatusTooltip}">
                <!-- Icon container: semantic glyph + status overlay dot -->
                <Grid Width="24" Height="20" Margin="0,0,5,0">
                    <Border CornerRadius="4" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Width="22" Height="18"
                            Background="{Binding NodeKind, Converter={StaticResource IconBgConv}}">
                        <TextBlock Text="{Binding NodeIconGlyph}" Style="{StaticResource TreeIconText}"
                                   Foreground="{DynamicResource TextP}" />
                    </Border>
                    <!-- Status overlay dot -->
                    <Ellipse Width="8" Height="8"
                             HorizontalAlignment="Right" VerticalAlignment="Bottom"
                             Margin="0,0,-1,-1" StrokeThickness="1.5">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Setter Property="Fill" Value="Transparent" />
                                <Setter Property="Stroke" Value="{DynamicResource BgPanel}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ExecutionStatus}" Value="Success">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Setter Property="Fill" Value="{DynamicResource StatusGreen}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ExecutionStatus}" Value="Failed">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Setter Property="Fill" Value="{DynamicResource StatusRed}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ExecutionStatus}" Value="Running">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Setter Property="Fill" Value="{DynamicResource StatusBlue}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ExecutionStatus}" Value="PartialFailure">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Setter Property="Fill" Value="{DynamicResource StatusYellow}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ExecutionStatus}" Value="Cancelled">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Setter Property="Fill" Value="{DynamicResource StatusGray}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <!-- HC status glyph overlay (visible only in High Contrast) -->
                    <TextBlock HorizontalAlignment="Right" VerticalAlignment="Bottom"
                               Margin="0,0,-2,-2" FontSize="8" FontWeight="Bold"
                               Foreground="{DynamicResource HcGlyphFg}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="" />
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ExecutionStatus}" Value="Running">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Setter Property="Text" Value="R" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ExecutionStatus}" Value="Success">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Setter Property="Text" Value="&#x2713;" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ExecutionStatus}" Value="Failed">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Setter Property="Text" Value="&#x2717;" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ExecutionStatus}" Value="PartialFailure">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Setter Property="Text" Value="!" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ExecutionStatus}" Value="Cancelled">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Setter Property="Text" Value="&#x2014;" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
                <!-- Node text with status-aware styling -->
                <TextBlock Text="{Binding ResolvedDisplayText}" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource TextP}" />
                            <Setter Property="ToolTip" Value="{Binding StatusTooltip}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding NodeKind}" Value="TemplateList">
                                    <Setter Property="FontWeight" Value="Bold" />
                                    <Setter Property="FontSize" Value="13" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ExecutionStatus}" Value="Failed">
                                    <Setter Property="Foreground" Value="{DynamicResource AccRed}" />
                                    <Setter Property="FontWeight" Value="Bold" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ExecutionStatus}" Value="Running">
                                    <Setter Property="Foreground" Value="{DynamicResource Accent}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ExecutionStatus}" Value="Success">
                                    <Setter Property="Foreground" Value="{DynamicResource AccGreen}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding HasUnresolvedTokens}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource AccYellow}" />
                                    <Setter Property="ToolTip" Value="{Binding UnresolvedTokenTooltip}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <!-- Status indicator: animated spinner (Running) / MDL2 glyphs (terminal states) -->
                <Grid Margin="6,0,0,0" VerticalAlignment="Center" Width="14" Height="14">
                    <!-- Running: spinning sync glyph
                         Animation runs via Loaded EventTrigger (not DataTrigger.EnterActions)
                         to avoid "Cannot animate immutable object" crash when WPF freezes
                         the RotateTransform during HierarchicalDataTemplate instantiation. -->
                    <TextBlock x:Name="TplSpinnerGlyph" Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                               Foreground="{DynamicResource Accent}" RenderTransformOrigin="0.5,0.5"
                               HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock.RenderTransform>
                            <RotateTransform Angle="0" />
                        </TextBlock.RenderTransform>
                        <TextBlock.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever" Storyboard.DesiredFrameRate="30">
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                         From="0" To="360" Duration="0:0:1.2" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </TextBlock.Triggers>
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ExecutionStatus}" Value="Running">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <!-- Success: CheckMark -->
                    <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                               Foreground="{DynamicResource AccGreen}"
                               HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ExecutionStatus}" Value="Success">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <!-- Failed: Cancel/X -->
                    <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                               Foreground="{DynamicResource AccRed}"
                               HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ExecutionStatus}" Value="Failed">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <!-- PartialFailure: Warning -->
                    <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                               Foreground="{DynamicResource AccYellow}"
                               HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ExecutionStatus}" Value="PartialFailure">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <!-- Cancelled: Blocked -->
                    <TextBlock Text="&#xE25B;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                               Foreground="{DynamicResource StatusGray}"
                               HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ExecutionStatus}" Value="Cancelled">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </StackPanel>
        </HierarchicalDataTemplate>
    </Window.Resources>

    <DockPanel>
        <!-- ═══════════════════════════════════════════════════════════ -->
        <!-- DEFAULT MODE BANNER (visible only when RBAC disabled)     -->
        <!-- ═══════════════════════════════════════════════════════════ -->
        <controls:DefaultModeBanner DockPanel.Dock="Top"
            Visibility="{Binding IsDefaultMode, Converter={StaticResource BoolVis}, FallbackValue=Collapsed}" />

        <!-- ═══════════════════════════════════════════════════════════ -->
        <!-- RIBBON                                                    -->
        <!-- ═══════════════════════════════════════════════════════════ -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource RibbonBg}"
                BorderBrush="{DynamicResource Bdr}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Status + Active Sessions (right column) -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                            HorizontalAlignment="Right" Margin="8,0">
                    <!-- User Identity Badge -->
                    <controls:UserIdentityBadge VerticalAlignment="Center" Margin="0,0,12,0"
                                                 Role="{Binding DataContext.UserRole, RelativeSource={RelativeSource AncestorType=Window}}"
                                                 DisplayName="{Binding DataContext.UserDisplayName, RelativeSource={RelativeSource AncestorType=Window}}" />

                    <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource AccGreen}"
                               FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,16,0" />

                    <!-- Sessions dropdown button (replaces inline chips) -->
                    <ToggleButton x:Name="SessionsDropdownToggle" Margin="0,0,12,0"
                                  Visibility="{Binding IsExecuting, Converter={StaticResource BoolVis}}"
                                  Background="{DynamicResource RunningBadgeBg}"
                                  BorderBrush="{DynamicResource Bdr}" BorderThickness="1"
                                  Padding="8,3" Cursor="Hand">
                        <ToggleButton.Template>
                            <ControlTemplate TargetType="ToggleButton">
                                <Border Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="4" Padding="{TemplateBinding Padding}">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="7" Height="7" Fill="{DynamicResource Accent}" Margin="0,0,6,0"
                                                 VerticalAlignment="Center">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsExecuting}" Value="True">
                                                            <DataTrigger.EnterActions>
                                                                <BeginStoryboard>
                                                                    <Storyboard RepeatBehavior="Forever">
                                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                                         From="1" To="0.3" Duration="0:0:0.8"
                                                                                         AutoReverse="True"/>
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </DataTrigger.EnterActions>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <TextBlock FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextP}" VerticalAlignment="Center">
                                            <Run Text="Sessions "/>
                                            <Run Text="{Binding ActiveSessionCount, Mode=OneWay}"/>
                                        </TextBlock>
                                        <TextBlock Text=" ▾" FontSize="9" Foreground="{DynamicResource TextS}"
                                                   VerticalAlignment="Center" Margin="4,0,0,0"/>
                                    </StackPanel>
                                </Border>
                            </ControlTemplate>
                        </ToggleButton.Template>
                    </ToggleButton>

                    <!-- Sessions dropdown popup -->
                    <Popup IsOpen="{Binding IsChecked, ElementName=SessionsDropdownToggle}"
                           PlacementTarget="{Binding ElementName=SessionsDropdownToggle}"
                           Placement="Bottom" StaysOpen="False" AllowsTransparency="True"
                           PopupAnimation="Fade" HorizontalOffset="0" VerticalOffset="4">
                        <Border Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource Bdr}"
                                BorderThickness="1" CornerRadius="6" Padding="0"
                                MinWidth="420" MaxWidth="520" MaxHeight="440">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12" Opacity="0.3" ShadowDepth="4" Direction="270"/>
                            </Border.Effect>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Header -->
                                <Border Grid.Row="0" Padding="12,10" BorderBrush="{DynamicResource Bdr}"
                                        BorderThickness="0,0,0,1">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Left" FontSize="12" FontWeight="Bold"
                                                   Foreground="{DynamicResource TextP}" VerticalAlignment="Center">
                                            <Run Text="Active sessions ("/>
                                            <Run Text="{Binding ActiveSessionCount, Mode=OneWay}"/>
                                            <Run Text=")"/>
                                        </TextBlock>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                                    HorizontalAlignment="Right">
                                            <Button Content="+ New run" FontSize="10" FontWeight="SemiBold"
                                                    Background="Transparent" Foreground="{DynamicResource Accent}"
                                                    BorderThickness="0" Cursor="Hand" Padding="6,2" Margin="0,0,10,0"
                                                    Command="{Binding TriggerAllWatchItemsCommand}"
                                                    ToolTip="Start a new execution run"/>
                                            <Button Content="Cancel all" FontSize="10"
                                                    Background="Transparent" Foreground="{DynamicResource AccRed}"
                                                    BorderThickness="0" Cursor="Hand" Padding="6,2"
                                                    Command="{Binding CancelExecutionCommand}"
                                                    ToolTip="Cancel all running sessions"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>

                                <!-- Session list -->
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled" Padding="6,4">
                                    <ItemsControl ItemsSource="{Binding ActiveSessions}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <!-- Row container with colored left bar -->
                                                <Border Margin="4,3" Padding="10,8" CornerRadius="4"
                                                        Background="{DynamicResource StatusIdleBg}"
                                                        BorderThickness="2,0,0,0">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="BorderBrush" Value="#F0B070"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Status}" Value="Success">
                                                                    <Setter Property="BorderBrush" Value="#5DD0A8"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="Failed">
                                                                    <Setter Property="BorderBrush" Value="#D04848"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="Cancelled">
                                                                    <Setter Property="BorderBrush" Value="#A8ACB5"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <!-- Row 0, Col 0: Session ID -->
                                                        <TextBlock Grid.Row="0" Grid.Column="0"
                                                                   Text="{Binding SessionId}" FontFamily="Consolas"
                                                                   FontSize="10" Foreground="{DynamicResource Accent}"
                                                                   VerticalAlignment="Center" Margin="0,0,8,0"/>

                                                        <!-- Row 0, Col 1: Pipeline name -->
                                                        <TextBlock Grid.Row="0" Grid.Column="1"
                                                                   Text="{Binding WatchItemTag}" FontSize="11"
                                                                   FontWeight="Medium" Foreground="{DynamicResource TextP}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   VerticalAlignment="Center"/>

                                                        <!-- Row 0, Col 2: Status pill -->
                                                        <Border Grid.Row="0" Grid.Column="2" CornerRadius="3"
                                                                Padding="5,1" Margin="6,0" VerticalAlignment="Center">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Background" Value="{DynamicResource RunningBadgeBg}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Status}" Value="Success">
                                                                            <Setter Property="Background" Value="{DynamicResource StatusSuccessBg}"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Status}" Value="Failed">
                                                                            <Setter Property="Background" Value="{DynamicResource StatusFailedBg}"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Status}" Value="Cancelled">
                                                                            <Setter Property="Background" Value="{DynamicResource StatusIdleBg}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock FontSize="9" FontWeight="Bold"
                                                                       Text="{Binding Status}" VerticalAlignment="Center">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Status}" Value="Success">
                                                                                <Setter Property="Foreground" Value="{DynamicResource StatusSuccessFg}"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding Status}" Value="Failed">
                                                                                <Setter Property="Foreground" Value="{DynamicResource StatusFailedFg}"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding Status}" Value="Cancelled">
                                                                                <Setter Property="Foreground" Value="{DynamicResource TextS}"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Border>

                                                        <!-- Row 0, Col 3: Action buttons -->
                                                        <StackPanel Grid.Row="0" Grid.Column="3" Orientation="Horizontal"
                                                                    VerticalAlignment="Center">
                                                            <!-- Cancel (shown for Running) -->
                                                            <Button Content="⏹" FontSize="13" Padding="3,2"
                                                                    Background="Transparent" BorderThickness="0"
                                                                    Foreground="#8A8F99" Cursor="Hand"
                                                                    Command="{Binding DataContext.CancelSessionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}"
                                                                    ToolTip="Cancel this session">
                                                                <Button.Style>
                                                                    <Style TargetType="Button">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Status}" Value="Success">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding Status}" Value="Failed">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding Status}" Value="Cancelled">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Button.Style>
                                                            </Button>
                                                            <!-- Retry (shown for Failed) -->
                                                            <Button Content="↻" FontSize="13" Padding="3,2"
                                                                    Background="Transparent" BorderThickness="0"
                                                                    Foreground="#8A8F99" Cursor="Hand"
                                                                    Command="{Binding DataContext.TriggerAllWatchItemsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    ToolTip="Retry this pipeline">
                                                                <Button.Style>
                                                                    <Style TargetType="Button">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Status}" Value="Failed">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Button.Style>
                                                            </Button>
                                                            <!-- Open (always shown) -->
                                                            <Button Content="↗" FontSize="13" Padding="3,2"
                                                                    Background="Transparent" BorderThickness="0"
                                                                    Foreground="#8A8F99" Cursor="Hand"
                                                                    Command="{Binding DataContext.ExecutionDashboard.OpenDashboardWindowCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    ToolTip="Open execution dashboard"/>
                                                        </StackPanel>

                                                        <!-- Row 1: Progress bar + percent -->
                                                        <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="4"
                                                              Margin="0,6,0,0">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Grid Grid.Column="0" Height="4" Margin="0,0,8,0">
                                                                <Border Background="{DynamicResource Bdr}" CornerRadius="2"/>
                                                                <Border CornerRadius="2" HorizontalAlignment="Left"
                                                                        Background="{DynamicResource Accent}"
                                                                        Width="{Binding ProgressPercent, Converter={StaticResource ProgressPercentToWidth}, ConverterParameter=100}"/>
                                                            </Grid>
                                                            <TextBlock Grid.Column="1" FontFamily="Consolas" FontSize="10"
                                                                       Foreground="{DynamicResource TextS}"
                                                                       VerticalAlignment="Center">
                                                                <Run Text="{Binding ProgressPercent, StringFormat={}{0:F0}%, Mode=OneWay}"/>
                                                            </TextBlock>
                                                        </Grid>

                                                        <!-- Row 2: Metadata (agents, actions, elapsed) -->
                                                        <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="4"
                                                                    Orientation="Horizontal" Margin="0,4,0,0">
                                                            <TextBlock FontSize="9" Foreground="{DynamicResource TextS}">
                                                                <Run Text="{Binding AgentCount, Mode=OneWay}"/>
                                                                <Run Text=" agent(s) · "/>
                                                                <Run Text="{Binding ActionProgress, Mode=OneWay}"/>
                                                                <Run Text=" · ⏱ "/>
                                                                <Run Text="{Binding Elapsed, Mode=OneWay}"/>
                                                            </TextBlock>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>

                                <!-- Footer -->
                                <Border Grid.Row="2" Padding="12,8" BorderBrush="{DynamicResource Bdr}"
                                        BorderThickness="0,1,0,0">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" FontSize="10"
                                                   Foreground="{DynamicResource TextS}"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <Run Text="Total elapsed: "/>
                                            <Run Text="{Binding TotalSessionsElapsed, Mode=OneWay}"/>
                                        </TextBlock>
                                        <TextBlock FontSize="10" Foreground="{DynamicResource TextS}"
