<Window
    x:Class="TestControllerGrpc.Views.ExecutionDashboardWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:exec="clr-namespace:TestControllerGrpc.ViewModels.Execution"
    xmlns:controls="clr-namespace:TestControllerGrpc.Views.Controls"
    Title="Execution Dashboard"
    Height="800" Width="1300" MinWidth="800" MinHeight="500"
    WindowStartupLocation="CenterScreen"
    Background="{StaticResource DashboardBg}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ?????????????????????????????????????????????????????????? -->
        <!-- Shared Header: Summary Stats Bar                          -->
        <!-- ?????????????????????????????????????????????????????????? -->
        <UniformGrid Grid.Row="0" Rows="1" Margin="8">
            <Border Background="{StaticResource CardBg}" CornerRadius="4" Padding="8" Margin="2">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="{Binding ActiveSessionCount}" FontSize="18" FontWeight="Medium"
                               Foreground="{StaticResource StatusRunningFg}" HorizontalAlignment="Center"/>
                    <TextBlock Text="Active Sessions" FontSize="10"
                               Foreground="{StaticResource TextDim}" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
            <Border Background="{StaticResource CardBg}" CornerRadius="4" Padding="8" Margin="2">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="{Binding LockedAgentCount}" FontSize="18" FontWeight="Medium"
                               Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center"/>
                    <TextBlock Text="Agents Locked" FontSize="10"
                               Foreground="{StaticResource TextDim}" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
            <Border Background="{StaticResource CardBg}" CornerRadius="4" Padding="8" Margin="2">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="{Binding TotalPassedActions}" FontSize="18" FontWeight="Medium"
                               Foreground="{StaticResource StatusSuccessFg}" HorizontalAlignment="Center"/>
                    <TextBlock Text="Actions Passed" FontSize="10"
                               Foreground="{StaticResource TextDim}" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
            <Border Background="{StaticResource CardBg}" CornerRadius="4" Padding="8" Margin="2">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="{Binding TotalFailedActions}" FontSize="18" FontWeight="Medium"
                               Foreground="{StaticResource StatusFailedFg}" HorizontalAlignment="Center"/>
                    <TextBlock Text="Actions Failed" FontSize="10"
                               Foreground="{StaticResource TextDim}" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
            <Border Background="{StaticResource CardBg}" CornerRadius="4" Padding="8" Margin="2">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock FontSize="18" FontWeight="Medium"
                               Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center">
                        <Run Text="{Binding OverallProgressPercent, Mode=OneWay}"/><Run Text="%"/>
                    </TextBlock>
                    <TextBlock Text="Overall Progress" FontSize="10"
                               Foreground="{StaticResource TextDim}" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- ?????????????????????????????????????????????????????????? -->
        <!-- Three-Tab View: Pipeline | Timeline | Unified Log         -->
        <!-- ?????????????????????????????????????????????????????????? -->
        <TabControl Grid.Row="1" Margin="8,0,8,8"
                    Background="Transparent" BorderThickness="0"
                    Padding="0">
            <TabControl.Resources>
                <!-- Dark-themed tab header style -->
                <Style TargetType="TabItem">
                    <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
                    <Setter Property="FontSize" Value="12"/>
                    <Setter Property="FontWeight" Value="Medium"/>
                    <Setter Property="Padding" Value="14,6"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border x:Name="Bd" Background="Transparent"
                                        Padding="{TemplateBinding Padding}"
                                        BorderThickness="0,0,0,2"
                                        BorderBrush="Transparent"
                                        Cursor="Hand">
                                    <ContentPresenter ContentSource="Header"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Bd" Property="BorderBrush"
                                                Value="{StaticResource StatusRunningFg}"/>
                                        <Setter Property="Foreground"
                                                Value="{StaticResource StatusRunningFg}"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background"
                                                Value="#15FFFFFF"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.Resources>

            <!-- ??? TAB 1: Pipeline View ??????????????????????????? -->
            <TabItem Header="Pipeline">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Filter bar (text + status RadioButtons per spec) -->
                    <Border Grid.Row="0" Padding="8,6"
                            BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,0,0,1">
                        <DockPanel>
                            <!-- Status RadioButtons + Demo button (right side) -->
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Content="&#x1F504; Reload" FontSize="10" Padding="8,3" Margin="0,0,6,0"
                                        Foreground="{StaticResource AccentBlue}"
                                        Command="{Binding ReloadSnapshotsCommand}"
                                        ToolTip="Reload pipeline snapshots from disk (crash recovery)"/>
                                <Button Content="&#x25B6; Demo" FontSize="10" Padding="8,3" Margin="0,0,10,0"
                                        Foreground="{StaticResource AccentBlue}"
                                        Command="{Binding LoadDemoDataCommand}"
                                        ToolTip="Load demo data to test the dashboard UI"/>
                                <RadioButton x:Name="PipelineFilterAll" Content="All"
                                             GroupName="PipelineStatus" IsChecked="True"
                                             Style="{StaticResource FilterButtonStyle}"
                                             Checked="PipelineStatusFilter_Checked"
                                             Tag="All"/>
                                <RadioButton x:Name="PipelineFilterRunning" Content="Running"
                                             GroupName="PipelineStatus"
                                             Style="{StaticResource FilterButtonStyle}"
                                             Checked="PipelineStatusFilter_Checked"
                                             Tag="Running"/>
                                <RadioButton x:Name="PipelineFilterFailed" Content="Failed"
                                             GroupName="PipelineStatus"
                                             Style="{StaticResource FilterButtonStyle}"
                                             Checked="PipelineStatusFilter_Checked"
                                             Tag="Failed"/>
                            </StackPanel>

                            <!-- Free-text filter (fills remaining space) -->
                            <TextBlock Text="Filter:" FontSize="11"
                                       Foreground="{StaticResource SpecTextSecondary}"
                                       VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBox x:Name="PipelineFilterBox" FontSize="11" MinWidth="220"
                                     Background="{StaticResource BgCard}"
                                     Foreground="{StaticResource SpecTextPrimary}"
                                     BorderBrush="{StaticResource BorderSubtle}" Padding="6,3"
                                     TextChanged="PipelineFilterBox_TextChanged"/>
                        </DockPanel>
                    </Border>

                    <!-- Session cards -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="PipelineSessionList"
                                      ItemsSource="{Binding SessionsView}" Margin="8,4">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type exec:SessionCardVM}">
                                    <Border Background="{StaticResource CardBg}"
                                            BorderBrush="{StaticResource CardBorder}"
                                            BorderThickness="0.5" CornerRadius="6" Margin="0,0,0,6">
                                        <StackPanel>
                                            <!-- Session header -->
                                            <Border Padding="10,8" Cursor="Hand"
                                                    Background="Transparent"
                                                    MouseLeftButtonUp="SessionHeader_Click">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <!-- Expand arrow -->
                                                        <TextBlock FontSize="9" Foreground="{StaticResource TextDim}"
                                                                   Margin="0,0,6,0" VerticalAlignment="Center"
                                                                   RenderTransformOrigin="0.5,0.5">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Text" Value="&#x25B6;"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                                            <Setter Property="Text" Value="&#x25BC;"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <!-- Status badge -->
                                                        <Border CornerRadius="3" Padding="5,1" Margin="0,0,6,0">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Background" Value="{StaticResource StatusIdleBg}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Status}" Value="Running">
                                                                            <Setter Property="Background" Value="{StaticResource StatusRunningBg}"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Status}" Value="Success">
                                                                            <Setter Property="Background" Value="{StaticResource StatusSuccessBg}"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Status}" Value="Failed">
                                                                            <Setter Property="Background" Value="{StaticResource StatusFailedBg}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock Text="{Binding StatusBadge}" FontSize="10" FontWeight="Medium">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Status}" Value="Running">
                                                                                <Setter Property="Foreground" Value="{StaticResource StatusRunningFg}"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding Status}" Value="Success">
                                                                                <Setter Property="Foreground" Value="{StaticResource StatusSuccessFg}"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding Status}" Value="Failed">
                                                                                <Setter Property="Foreground" Value="{StaticResource StatusFailedFg}"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Border>
                                                        <!-- Pipeline name -->
                                                        <TextBlock Text="{Binding WatchItemTag}" FontSize="14" FontWeight="Medium"
                                                                   Foreground="{StaticResource TextPrimary}"
                                                                   VerticalAlignment="Center"/>
                                                        <!-- Build number -->
                                                        <TextBlock Text="{Binding BuildNumber}" FontSize="11"
                                                                   FontFamily="Consolas" Foreground="{StaticResource TextDim}"
                                                                   Margin="8,0,0,0" VerticalAlignment="Center"
                                                                   Visibility="{Binding BuildNumber, Converter={StaticResource NullToCollapsed}}"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <!-- User badge -->
                                                        <Border Background="{StaticResource StatusIdleBg}" CornerRadius="3"
                                                                Padding="4,1" Margin="4,0">
                                                            <TextBlock Text="{Binding UserId}" FontSize="9"
                                                                       FontFamily="Consolas"
                                                                       Foreground="{StaticResource TextSecondary}"/>
                                                        </Border>
                                                        <TextBlock Foreground="{StaticResource TextSecondary}" FontSize="11"
                                                                   Margin="8,0" VerticalAlignment="Center">
                                                            <Run Text="{Binding Agents.Count, Mode=OneWay}"/>
                                                            <Run Text="agents"/>
                                                        </TextBlock>
                                                        <TextBlock Text="{Binding Elapsed}" FontFamily="Consolas" FontSize="11"
                                                                   Foreground="{StaticResource TextSecondary}"
                                                                   VerticalAlignment="Center" Margin="8,0"/>
                                                        <TextBlock FontSize="11" FontWeight="Medium"
                                                                   Foreground="{StaticResource TextPrimary}"
                                                                   VerticalAlignment="Center" Margin="8,0">
                                                            <Run Text="{Binding ProgressPercent, Mode=OneWay}"/><Run Text="%"/>
                                                        </TextBlock>
                                                        <Button Content="Cancel"
                                                                Command="{Binding DataContext.CancelSessionCommand,
                                                                    RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                CommandParameter="{Binding SessionId}"
                                                                FontSize="10" Padding="6,2" Margin="8,0,0,0"
                                                                Foreground="{StaticResource StatusFailedFg}"
                                                                Visibility="{Binding Status, Converter={StaticResource RunningToVisible}}"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>

                                            <!-- Agent rows with action chip chains -->
                                            <ItemsControl ItemsSource="{Binding Agents}"
                                                          Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type exec:AgentRowVM}">
                                                        <Border BorderBrush="{StaticResource RowBorder}" BorderThickness="0,1,0,0">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="120"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>
                                                                <!-- Agent name column -->
                                                                <Border Grid.Column="0"
                                                                        Background="{StaticResource AgentColumnBg}"
                                                                        BorderBrush="{StaticResource RowBorder}"
                                                                        BorderThickness="0,0,0.5,0"
                                                                        Padding="8,6" Cursor="Hand"
                                                                        MouseLeftButtonUp="AgentName_Click">
                                                                    <StackPanel>
                                                                        <TextBlock Text="{Binding AgentName}"
                                                                                   FontFamily="Consolas" FontSize="11" FontWeight="Medium"
                                                                                   Foreground="{StaticResource TextPrimary}"/>
                                                                        <TextBlock Text="{Binding StatusText}" FontSize="9" Margin="0,2,0,0">
                                                                            <TextBlock.Style>
                                                                                <Style TargetType="TextBlock">
                                                                                    <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding Status}" Value="Executing">
                                                                                            <Setter Property="Foreground" Value="{StaticResource StatusRunningFg}"/>
                                                                                        </DataTrigger>
                                                                                        <DataTrigger Binding="{Binding Status}" Value="Success">
                                                                                            <Setter Property="Foreground" Value="{StaticResource StatusSuccessFg}"/>
                                                                                        </DataTrigger>
                                                                                        <DataTrigger Binding="{Binding Status}" Value="Failed">
                                                                                            <Setter Property="Foreground" Value="{StaticResource StatusFailedFg}"/>
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </TextBlock.Style>
                                                                        </TextBlock>
                                                                        <!-- Progress bar -->
                                                                        <Border Height="3" CornerRadius="1.5"
                                                                                Background="{StaticResource StatusIdleBg}"
                                                                                Margin="0,3,0,0">
                                                                            <Border CornerRadius="1.5" HorizontalAlignment="Left"
                                                                                    Width="{Binding ProgressPercent,
                                                                                        Converter={StaticResource PercentToWidth},
                                                                                        ConverterParameter=104}">
                                                                                <Border.Style>
                                                                                    <Style TargetType="Border">
                                                                                        <Setter Property="Background" Value="{StaticResource StatusRunningFg}"/>
                                                                                        <Style.Triggers>
                                                                                            <DataTrigger Binding="{Binding Status}" Value="Success">
                                                                                                <Setter Property="Background" Value="{StaticResource StatusSuccessFg}"/>
                                                                                            </DataTrigger>
                                                                                            <DataTrigger Binding="{Binding Status}" Value="Failed">
                                                                                                <Setter Property="Background" Value="{StaticResource StatusFailedFg}"/>
                                                                                            </DataTrigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </Border.Style>
                                                                            </Border>
                                                                        </Border>
                                                                    </StackPanel>
                                                                </Border>
                                                                <!-- Action chips with arrows -->
                                                                <Border Grid.Column="1" Padding="6,4">
                                                                    <ItemsControl ItemsSource="{Binding Actions}">
                                                                        <ItemsControl.ItemsPanel>
                                                                            <ItemsPanelTemplate>
                                                                                <WrapPanel Orientation="Horizontal"/>
                                                                            </ItemsPanelTemplate>
                                                                        </ItemsControl.ItemsPanel>
                                                                        <ItemsControl.ItemTemplate>
                                                                            <DataTemplate DataType="{x:Type exec:ActionPillVM}">
                                                                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                                                                    <Border ToolTip="{Binding Tooltip}">
                                                                                        <Border.Style>
                                                                                            <Style TargetType="Border" BasedOn="{StaticResource ActionPillBase}">
                                                                                                <Setter Property="Background" Value="{StaticResource StatusIdleBg}"/>
                                                                                                <Setter Property="BorderBrush" Value="{StaticResource CardBorder}"/>
                                                                                                <Style.Triggers>
                                                                                                    <DataTrigger Binding="{Binding Status}" Value="Running">
                                                                                                        <Setter Property="Background" Value="{StaticResource StatusRunningBg}"/>
                                                                                                        <Setter Property="BorderBrush" Value="{StaticResource StatusRunningFg}"/>
                                                                                                    </DataTrigger>
                                                                                                    <DataTrigger Binding="{Binding Status}" Value="Success">
                                                                                                        <Setter Property="Background" Value="{StaticResource StatusSuccessBg}"/>
                                                                                                        <Setter Property="BorderBrush" Value="{StaticResource StatusSuccessFg}"/>
                                                                                                    </DataTrigger>
                                                                                                    <DataTrigger Binding="{Binding Status}" Value="Failed">
                                                                                                        <Setter Property="Background" Value="{StaticResource StatusFailedBg}"/>
                                                                                                        <Setter Property="BorderBrush" Value="{StaticResource StatusFailedFg}"/>
                                                                                                    </DataTrigger>
                                                                                                </Style.Triggers>
                                                                                            </Style>
                                                                                        </Border.Style>
                                                                                        <StackPanel Orientation="Horizontal">
                                                                                            <TextBlock Text="{Binding StatusIcon}" FontSize="9" Margin="0,0,3,0"
                                                                                                       VerticalAlignment="Center">
                                                                                                <TextBlock.Style>
                                                                                                    <Style TargetType="TextBlock">
                                                                                                        <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
                                                                                                        <Style.Triggers>
                                                                                                            <DataTrigger Binding="{Binding Status}" Value="Running">
                                                                                                                <Setter Property="Foreground" Value="{StaticResource StatusRunningFg}"/>
                                                                                                            </DataTrigger>
                                                                                                            <DataTrigger Binding="{Binding Status}" Value="Success">
                                                                                                                <Setter Property="Foreground" Value="{StaticResource StatusSuccessFg}"/>
                                                                                                            </DataTrigger>
                                                                                                            <DataTrigger Binding="{Binding Status}" Value="Failed">
                                                                                                                <Setter Property="Foreground" Value="{StaticResource StatusFailedFg}"/>
                                                                                                            </DataTrigger>
                                                                                                        </Style.Triggers>
                                                                                                    </Style>
                                                                                                </TextBlock.Style>
                                                                                            </TextBlock>
                                                                                            <TextBlock Text="{Binding DisplayLabel}" FontSize="11"
                                                                                                       VerticalAlignment="Center"
                                                                                                       TextTrimming="CharacterEllipsis" MaxWidth="180">
                                                                                                <TextBlock.Style>
                                                                                                    <Style TargetType="TextBlock">
                                                                                                        <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
                                                                                                        <Style.Triggers>
                                                                                                            <DataTrigger Binding="{Binding Status}" Value="Running">
                                                                                                                <Setter Property="Foreground" Value="{StaticResource StatusRunningFg}"/>
                                                                                                            </DataTrigger>
                                                                                                            <DataTrigger Binding="{Binding Status}" Value="Success">
                                                                                                                <Setter Property="Foreground" Value="{StaticResource StatusSuccessFg}"/>
                                                                                                            </DataTrigger>
                                                                                                            <DataTrigger Binding="{Binding Status}" Value="Failed">
                                                                                                                <Setter Property="Foreground" Value="{StaticResource StatusFailedFg}"/>
                                                                                                            </DataTrigger>
                                                                                                        </Style.Triggers>
                                                                                                    </Style>
                                                                                                </TextBlock.Style>
                                                                                            </TextBlock>
                                                                                        </StackPanel>
                                                                                    </Border>
                                                                                    <!-- Arrow separator between chips -->
                                                                                    <TextBlock Text="&#x2192;" FontSize="9" Margin="4,0"
                                                                                               Foreground="{StaticResource TextDim}"
                                                                                               VerticalAlignment="Center"/>
                                                                                </StackPanel>
                                                                            </DataTemplate>
                                                                        </ItemsControl.ItemTemplate>
                                                                    </ItemsControl>
                                                                </Border>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- ??? TAB 2: Timeline View (Gantt Chart) ????????????? -->
            <TabItem Header="Timeline">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Time axis header -->
                    <Canvas Grid.Row="0" x:Name="TimeAxis" Height="24" Margin="130,0,8,0"
                            Background="{StaticResource CardBg}" ClipToBounds="True"/>

                    <!-- Gantt body -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Timeline.Lanes}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type exec:TimelineAgentLane}">
                                    <Grid Height="40" Margin="0,1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <!-- Agent label -->
                                        <Border Grid.Column="0" Background="{StaticResource AgentColumnBg}"
                                                BorderBrush="{StaticResource RowBorder}" BorderThickness="0,0,0.5,0"
                                                Padding="8,0">
                                            <TextBlock Text="{Binding AgentName}" FontFamily="Consolas" FontSize="11"
                                                       FontWeight="Medium" Foreground="{StaticResource TextPrimary}"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                        <!-- Action bars: rendered by the custom GanttRow control
                                             (single OnRender pass instead of a per-bar ItemsControl) -->
                                        <controls:GanttRow Grid.Column="1"
                                                           Actions="{Binding Bars}"
                                                           Background="{StaticResource BgCard}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- ??? TAB 3: Unified Log View ???????????????????????? -->
            <TabItem Header="Unified Log">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Log filter toolbar -->
                    <Border Grid.Row="0" Padding="8,6"
                            BorderBrush="{StaticResource RowBorder}" BorderThickness="0,0,0,0.5">
                        <WrapPanel>
                            <!-- Session filter -->
                            <TextBlock Text="Session:" FontSize="11"
                                       Foreground="{StaticResource TextSecondary}"
                                       VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <ComboBox x:Name="SessionFilter" MinWidth="140" FontSize="11"
                                      Background="{StaticResource CardBg}"
                                      Foreground="{StaticResource TextPrimary}"
                                      BorderBrush="{StaticResource CardBorder}"
                                      SelectionChanged="SessionFilter_Changed">
                                <ComboBoxItem Content="All Sessions" IsSelected="True"/>
                            </ComboBox>

                            <!-- Severity filter -->
                            <TextBlock Text="Level:" FontSize="11"
                                       Foreground="{StaticResource TextSecondary}"
                                       VerticalAlignment="Center" Margin="12,0,4,0"/>
                            <ComboBox x:Name="SeverityFilter" MinWidth="90" FontSize="11"
                                      Background="{StaticResource CardBg}"
                                      Foreground="{StaticResource TextPrimary}"
                                      BorderBrush="{StaticResource CardBorder}"
                                      SelectionChanged="SeverityFilter_Changed">
                                <ComboBoxItem Content="All" IsSelected="True"/>
                                <ComboBoxItem Content="Error"/>
                                <ComboBoxItem Content="Warning"/>
                                <ComboBoxItem Content="Success"/>
                                <ComboBoxItem Content="Info"/>
                            </ComboBox>

                            <!-- Agent toggle buttons -->
                            <TextBlock Text="Agents:" FontSize="11"
                                       Foreground="{StaticResource TextSecondary}"
                                       VerticalAlignment="Center" Margin="12,0,4,0"/>
                            <ItemsControl x:Name="AgentTogglePanel">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>

                            <!-- Search box -->
                            <TextBox x:Name="LogSearchBox" MinWidth="150" FontSize="11" Margin="12,0,0,0"
                                     Background="{StaticResource CardBg}"
                                     Foreground="{StaticResource TextPrimary}"
                                     BorderBrush="{StaticResource CardBorder}" Padding="6,3"
                                     TextChanged="LogSearch_TextChanged"/>

                            <!-- Entry count + clear -->
                            <TextBlock FontSize="10" Foreground="{StaticResource TextDim}"
                                       VerticalAlignment="Center" Margin="8,0">
                                <Run Text="{Binding LogEntries.Count, Mode=OneWay}"/>
                                <Run Text="entries"/>
                            </TextBlock>
                            <Button Content="Clear filter"
                                    Command="{Binding ClearSelectionCommand}"
                                    FontSize="10" Margin="4,0" Padding="6,2"
                                    Visibility="{Binding SelectedSessionId, Converter={StaticResource NullToCollapsed}}"/>
                            <Button Content="Clear" Command="{Binding ClearLogsCommand}"
                                    FontSize="10" Margin="4,0" Padding="6,2"/>
                        </WrapPanel>
                    </Border>

                    <!-- Virtualized log table -->
                    <ListBox Grid.Row="1" x:Name="LogListBox"
                             ItemsSource="{Binding LogEntries}"
                             Background="Transparent" BorderThickness="0"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type exec:LogEntryVM}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Timestamp}"
                                               FontFamily="Consolas" FontSize="10"
                                               Foreground="{StaticResource TextDim}"/>
                                    <Border Grid.Column="1" CornerRadius="2" Padding="3,0" Margin="2,1"
                                            Background="{StaticResource StatusIdleBg}"
                                            HorizontalAlignment="Left" Cursor="Hand"
                                            MouseLeftButtonUp="LogSessionBadge_Click">
                                        <TextBlock Text="{Binding SessionName}"
                                                   FontFamily="Consolas" FontSize="9" FontWeight="Medium"
                                                   Foreground="{StaticResource TextSecondary}"/>
                                    </Border>
                                    <TextBlock Grid.Column="2" Text="{Binding AgentName}"
                                               FontFamily="Consolas" FontSize="10"
                                               Foreground="{StaticResource MonoFont}"
                                               Cursor="Hand" MouseLeftButtonUp="LogAgentName_Click"/>
                                    <TextBlock Grid.Column="3" Text="{Binding Message}"
                                               FontFamily="Consolas" FontSize="10"
                                               TextTrimming="CharacterEllipsis">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Severity}" Value="Error">
                                                        <Setter Property="Foreground" Value="{StaticResource StatusFailedFg}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Severity}" Value="Warning">
                                                        <Setter Property="Foreground" Value="{StaticResource StatusWarningFg}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Severity}" Value="Success">
                                                        <Setter Property="Foreground" Value="{StaticResource StatusSuccessFg}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- ?????????????????????????????????????????????????????????? -->
        <!-- Connection status footer (per spec)                       -->
        <!-- ?????????????????????????????????????????????????????????? -->
        <Border Grid.Row="2" Background="{StaticResource BgCard}"
                BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,1,0,0"
                Padding="12,6">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse Style="{StaticResource ConnectionDotStyle}"/>
                <TextBlock VerticalAlignment="Center" FontSize="11"
                           Foreground="{StaticResource SpecTextSecondary}">
                    <Run Text="{Binding ConnectionStatus, Mode=OneWay}"/>
                    <Run Text=" - "/>
                    <Run Text="ControllerService"/>
                </TextBlock>
                <Border Width="1" Background="{StaticResource BorderSubtle}" Margin="14,2"/>
                <TextBlock VerticalAlignment="Center" FontSize="11"
                           Foreground="{StaticResource SpecTextMuted}">
                    <Run Text="{Binding Sessions.Count, Mode=OneWay}"/>
                    <Run Text="sessions |"/>
                    <Run Text="{Binding LogEntries.Count, Mode=OneWay}"/>
                    <Run Text="log entries"/>
                </TextBlock>
            </StackPanel>
        </Border>
    </Grid>
</Window>
