<Window x:Class="TestControllerGrpc.Views.TemplateXmlEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:avalonedit="http://icsharpcode.net/sharpdevelop/avalonedit"
        xmlns:vm="clr-namespace:TestControllerGrpc.ViewModels"
        Title="{Binding WindowTitle}"
        Height="750" Width="1100" MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBg}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis" />

        <Style x:Key="EditorBtn" TargetType="Button">
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Margin" Value="3" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource BtnBorder}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BtnHoverBg}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BtnPressedBg}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Preview tree item template -->
        <HierarchicalDataTemplate x:Key="PreviewTreeTemplate" DataType="{x:Type vm:TemplatePreviewNode}" ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal" Margin="0,1">
                <Border CornerRadius="3" Padding="3,1" Margin="0,0,4,0" MinWidth="18" HorizontalAlignment="Center"
                        Background="{DynamicResource AccMauve}">
                    <TextBlock Text="{Binding NodeIcon}" FontSize="9" FontWeight="Bold"
                               Foreground="{DynamicResource TreeBadgeFg}" HorizontalAlignment="Center" />
                </Border>
                <TextBlock Text="{Binding DisplayText}" FontSize="11" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextP}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </HierarchicalDataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ROW 0: Toolbar -->
        <Border Grid.Row="0" Background="{DynamicResource RibbonBg}" Padding="8,6"
                BorderBrush="{DynamicResource Bdr}" BorderThickness="0,0,0,1">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#x1F9E9;" FontSize="16" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBlock Text="Template XML Editor" FontSize="14" FontWeight="Bold"
                               Foreground="{DynamicResource AccMauve}" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource EditorBtn}"
                            Background="{DynamicResource AccentBtnBg}" Foreground="{DynamicResource Accent}"
                            Command="{Binding ValidateCommand}" ToolTip="Validate Template XML structure and rules">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#x2713;" FontSize="13" Margin="0,0,4,0" />
                            <TextBlock Text="Validate" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource EditorBtn}"
                            Background="{DynamicResource MauveBtnBg}" Foreground="{DynamicResource AccMauve}"
                            Command="{Binding AutoFormatCommand}" ToolTip="Auto-format and indent Template XML">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#x27F3;" FontSize="13" Margin="0,0,4,0" />
                            <TextBlock Text="Format" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource EditorBtn}"
                            Background="{DynamicResource GreenBtnBg}" Foreground="{DynamicResource AccGreen}"
                            Command="{Binding AutoFixCommand}" ToolTip="Auto-fix missing defaults and normalize booleans">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#x1F527;" FontSize="13" Margin="0,0,4,0" />
                            <TextBlock Text="Auto Fix" />
                        </StackPanel>
                    </Button>

                    <Border Width="1" Background="{DynamicResource Bdr}" Margin="6,4" />

                    <Button Style="{StaticResource EditorBtn}"
                            Background="{DynamicResource YellowBtnBg}" Foreground="{DynamicResource AccYellow}"
                            Command="{Binding RevertCommand}" ToolTip="Revert to original XML">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#x21BA;" FontSize="13" Margin="0,0,4,0" />
                            <TextBlock Text="Revert" />
                        </StackPanel>
                    </Button>

                    <Border Width="1" Background="{DynamicResource Bdr}" Margin="6,4" />

                    <Button Style="{StaticResource EditorBtn}"
                            Background="{DynamicResource TemplateRootBg}" Foreground="{DynamicResource AccMauve}"
                            Command="{Binding TogglePreviewCommand}" ToolTip="Toggle structure preview panel">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#x1F333;" FontSize="13" Margin="0,0,4,0" />
                            <TextBlock Text="Preview" />
                        </StackPanel>
                    </Button>

                    <Border Width="1" Background="{DynamicResource Bdr}" Margin="6,4" />

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Font:" FontSize="11"
                                   Foreground="{DynamicResource TextS}"
                                   VerticalAlignment="Center" Margin="0,0,4,0" />
                        <ComboBox x:Name="FontSizeCombo" Width="55"
                                  ItemsSource="{Binding AvailableFontSizes}"
                                  SelectedItem="{Binding EditorFontSize}"
                                  Background="{DynamicResource BgCard}"
                                  Foreground="{DynamicResource TextP}"
                                  BorderBrush="{DynamicResource Bdr}"
                                  BorderThickness="1" Padding="4,2"
                                  FontSize="11" />
                        <Button Content="A+" Padding="4,2" Margin="2,0"
                                Click="IncreaseFontSize_Click"
                                ToolTip="Increase font size (Ctrl+Plus)"
                                Background="Transparent" Foreground="{DynamicResource TextP}"
                                BorderThickness="0" FontWeight="Bold" Cursor="Hand" FontSize="11" />
                        <Button Content="A&#x2013;" Padding="4,2" Margin="2,0"
                                Click="DecreaseFontSize_Click"
                                ToolTip="Decrease font size (Ctrl+Minus)"
                                Background="Transparent" Foreground="{DynamicResource TextP}"
                                BorderThickness="0" FontWeight="Bold" Cursor="Hand" FontSize="11" />
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ROW 1: Summary Panel -->
        <Border Grid.Row="1" Background="{DynamicResource BgCard}" Padding="10,6"
                BorderBrush="{DynamicResource Bdr}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border CornerRadius="4" Padding="6,2" Margin="0,0,8,0"
                        Background="{DynamicResource TemplateRootBg}">
                    <TextBlock FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccMauve}">
                        <Run Text="Templates: " /><Run Text="{Binding TemplateCount, Mode=OneWay}" />
                    </TextBlock>
                </Border>
                <Border CornerRadius="4" Padding="6,2" Margin="0,0,8,0"
                        Background="{DynamicResource RunningBadgeBg}">
                    <TextBlock FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Accent}">
                        <Run Text="Actions: " /><Run Text="{Binding TotalActionCount, Mode=OneWay}" />
                    </TextBlock>
                </Border>
                <TextBlock Text="{Binding TemplateSummary}" FontSize="10" Foreground="{DynamicResource TextS}"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- ROW 2: Editor + Optional Preview -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition x:Name="PreviewColumn" Width="0" />
            </Grid.ColumnDefinitions>

            <!-- AvalonEdit XML Editor -->
            <avalonedit:TextEditor
                Grid.Column="0"
                x:Name="XmlEditor"
                FontFamily="Consolas"
                FontSize="{Binding EditorFontSize}"
                ShowLineNumbers="True"
                WordWrap="False"
                HorizontalScrollBarVisibility="Auto"
                VerticalScrollBarVisibility="Auto"
                Padding="4"
                BorderThickness="0" />

            <!-- Splitter (only visible with preview) -->
            <GridSplitter Grid.Column="1" Width="4" Background="{DynamicResource BgSurface}"
                          HorizontalAlignment="Center" VerticalAlignment="Stretch"
                          ResizeBehavior="PreviousAndNext"
                          Visibility="{Binding IsPreviewVisible, Converter={StaticResource BoolVis}}" />

            <!-- Structure Preview Panel -->
            <Border Grid.Column="2" Background="{DynamicResource BgPanel}"
                    BorderBrush="{DynamicResource Bdr}" BorderThickness="1,0,0,0"
                    Visibility="{Binding IsPreviewVisible, Converter={StaticResource BoolVis}}">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="{DynamicResource BgCard}" Padding="8,5"
                            BorderBrush="{DynamicResource Bdr}" BorderThickness="0,0,0,1">
                        <TextBlock Text="Structure Preview" FontSize="11" FontWeight="Bold"
                                   Foreground="{DynamicResource AccMauve}" />
                    </Border>
                    <TreeView ItemsSource="{Binding PreviewRoots}"
                              Background="Transparent" BorderThickness="0"
                              Margin="4" Padding="0,4"
                              ItemTemplate="{StaticResource PreviewTreeTemplate}">
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem">
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextP}" />
                                <Setter Property="Padding" Value="2,2" />
                            </Style>
                        </TreeView.ItemContainerStyle>
                    </TreeView>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ROW 3: Error Panel (collapsible) -->
        <Border Grid.Row="3" MaxHeight="180"
                Visibility="{Binding IsErrorPanelVisible, Converter={StaticResource BoolVis}}"
                BorderBrush="{DynamicResource Bdr}" BorderThickness="0,1,0,0">
            <DockPanel Background="{DynamicResource BgPanel}">
                <Border DockPanel.Dock="Top" Background="{DynamicResource FailedBadgeBg}" Padding="8,4">
                    <DockPanel>
                        <TextBlock Text="Validation Errors" FontSize="11" FontWeight="Bold"
                                   Foreground="{DynamicResource AccRed}" VerticalAlignment="Center" />
                        <TextBlock DockPanel.Dock="Right" HorizontalAlignment="Right" FontSize="10"
                                   Foreground="{DynamicResource AccRed}" VerticalAlignment="Center">
                            <Run Text="{Binding ValidationErrors.Count, Mode=OneWay}" FontWeight="Bold" />
                            <Run Text=" error(s)" />
                        </TextBlock>
                    </DockPanel>
                </Border>
                <DataGrid ItemsSource="{Binding ValidationErrors}"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserAddRows="False" CanUserDeleteRows="False"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                          Background="Transparent" Foreground="{DynamicResource TextP}"
                          BorderThickness="0" FontSize="11" FontFamily="Consolas"
                          RowBackground="Transparent"
                          AlternatingRowBackground="{DynamicResource InfoBoxBg}"
                          SelectionMode="Single"
                          SelectedItem="{Binding SelectedValidationError, Mode=TwoWay}">
                    <DataGrid.Resources>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="{DynamicResource BgCard}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextS}" />
                            <Setter Property="Padding" Value="6,3" />
                            <Setter Property="FontSize" Value="10" />
                            <Setter Property="FontWeight" Value="Bold" />
                            <Setter Property="BorderBrush" Value="{DynamicResource Bdr}" />
                            <Setter Property="BorderThickness" Value="0,0,1,1" />
                        </Style>
                        <Style TargetType="DataGridCell">
                            <Setter Property="Padding" Value="6,2" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="Foreground" Value="{DynamicResource TextP}" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="DataGridCell">
                                        <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                                            <ContentPresenter VerticalAlignment="Center" />
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource SelectedItemBg}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Cursor" Value="Hand" />
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource BtnHoverBg}" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource SelectedItemBg}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.Resources>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Line" Binding="{Binding Line}" Width="50" />
                        <DataGridTextColumn Header="Col" Binding="{Binding Column}" Width="45" />
                        <DataGridTextColumn Header="Type" Binding="{Binding ErrorType}" Width="80" />
                        <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <!-- ROW 4: Status Bar -->
        <Border Grid.Row="4" Padding="10,6"
                BorderBrush="{DynamicResource Bdr}" BorderThickness="0,1,0,0">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{DynamicResource BgCard}" />
                </Style>
            </Border.Style>
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="{Binding StatusMessage}" FontSize="11"
                           FontFamily="Consolas" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource TextS}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding StatusSeverity}" Value="Success">
                                    <Setter Property="Foreground" Value="{DynamicResource AccGreen}" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding StatusSeverity}" Value="Error">
                                    <Setter Property="Foreground" Value="{DynamicResource AccRed}" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock DockPanel.Dock="Right" FontSize="10" Foreground="{DynamicResource TextS}"
                           VerticalAlignment="Center" HorizontalAlignment="Right"
                           x:Name="CursorPositionText" />
            </DockPanel>
        </Border>

        <!-- ROW 5: Action Buttons (Save / Cancel) -->
        <Border Grid.Row="5" Background="{DynamicResource BgPanel}" Padding="10,8"
                BorderBrush="{DynamicResource Bdr}" BorderThickness="0,1,0,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource EditorBtn}" MinWidth="90"
                            Background="{DynamicResource GreenBtnBg}" Foreground="{DynamicResource AccGreen}"
                            Command="{Binding SaveCommand}" ToolTip="Validate and save Template XML changes">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#x1F4BE;" FontSize="13" Margin="0,0,4,0" />
                            <TextBlock Text="Save" FontWeight="Bold" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource EditorBtn}" MinWidth="90"
                            Background="{DynamicResource DangerBtnBg}" Foreground="{DynamicResource AccRed}"
                            Command="{Binding CancelCommand}" ToolTip="Discard changes and close">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#x2715;" FontSize="13" Margin="0,0,4,0" />
                            <TextBlock Text="Cancel" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <TextBlock/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
