<Window x:Class="TestControllerGrpc.Views.Dialogs.WhatChangedWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStartupLocation="CenterOwner"
        Width="1100" Height="700" MinWidth="700" MinHeight="400"
        Background="{DynamicResource WindowBg}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis" />
        <Style x:Key="DiffCell" TargetType="Border">
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="Background" Value="Transparent" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Removed">
                    <Setter Property="Background" Value="{DynamicResource StatusFailedBg}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Added">
                    <Setter Property="Background" Value="{DynamicResource StatusSuccessBg}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Changed">
                    <Setter Property="Background" Value="{DynamicResource StatusWarningBg}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Empty">
                    <Setter Property="Background" Value="{DynamicResource BgPanel}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <CheckBox x:Name="OnlyChanges" Content="Only changed lines" IsChecked="True" Margin="0,0,16,0"
                      VerticalAlignment="Center" Foreground="{DynamicResource TextP}" FontSize="{StaticResource FontSize10}"
                      Checked="OnlyChanges_Changed" Unchecked="OnlyChanges_Changed"
                      AutomationProperties.Name="Only changed lines" />
            <Button Content="Close" IsCancel="True" IsDefault="True" MinWidth="88" Padding="12,6"
                    Background="{DynamicResource BgCard}" Foreground="{DynamicResource TextP}"
                    BorderBrush="{DynamicResource Bdr}" BorderThickness="1"
                    AutomationProperties.Name="Close" />
        </StackPanel>
        <TextBlock DockPanel.Dock="Top" Text="Before (left) and after (right). Secret values are never shown."
                   FontSize="{StaticResource FontSize10}" Foreground="{DynamicResource TextS}" Margin="0,0,0,8" />
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
            <ItemsControl x:Name="Sections">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,0,14">
                            <TextBlock FontSize="{StaticResource FontSize12}" FontWeight="SemiBold" Foreground="{DynamicResource TextP}"
                                       Margin="0,0,0,4">
                                <Run Text="{Binding Title, Mode=OneWay}" />
                                <Run Text="  -  " />
                                <Run Text="{Binding ChangedLines, Mode=OneWay}" />
                                <Run Text=" line(s) differ" />
                            </TextBlock>
                            <Border BorderBrush="{DynamicResource Bdr}" BorderThickness="1">
                                <ItemsControl ItemsSource="{Binding Rows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Style="{StaticResource DiffCell}" Tag="{Binding BeforeKind}"
                                                        BorderBrush="{DynamicResource Bdr}" BorderThickness="0,0,1,0">
                                                    <TextBlock Text="{Binding Before}" FontFamily="Consolas" FontSize="{StaticResource FontSize10}"
                                                               Foreground="{DynamicResource TextP}" TextWrapping="NoWrap" />
                                                </Border>
                                                <Border Grid.Column="1" Style="{StaticResource DiffCell}" Tag="{Binding AfterKind}">
                                                    <TextBlock Text="{Binding After}" FontFamily="Consolas" FontSize="{StaticResource FontSize10}"
                                                               Foreground="{DynamicResource TextP}" TextWrapping="NoWrap" />
                                                </Border>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Window>
