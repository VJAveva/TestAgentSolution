<Window x:Class="TestControllerGrpc.Views.Dialogs.ApplyToAgentsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Apply to agents"
        Width="420" Height="480"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource BgPanel}">

    <DockPanel Margin="16">

        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,10"
                   Foreground="{DynamicResource TextP}">
            <Run Text="Create one copy of" />
            <Run Text="{Binding ActionTag, Mode=OneWay}" FontWeight="Bold" Foreground="{DynamicResource Accent}" />
            <Run Text="per selected agent, inside a new Parallel group." />
        </TextBlock>

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="Select all" Click="OnSelectAllClick"
                    Style="{DynamicResource SecondaryButtonStyle}" Margin="0,0,8,0"
                    AutomationProperties.Name="Select all agents" />
            <Button Content="Select none" Click="OnSelectNoneClick"
                    Style="{DynamicResource SecondaryButtonStyle}"
                    AutomationProperties.Name="Select no agents" />
        </StackPanel>

        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <Button DockPanel.Dock="Right" Content="Cancel" Click="OnCancelClick" IsCancel="True"
                    Style="{DynamicResource SecondaryButtonStyle}" MinWidth="90" />
            <Button DockPanel.Dock="Right" Content="Apply" Click="OnApplyClick" IsDefault="True"
                    Style="{DynamicResource PrimaryButtonStyle}" MinWidth="90" Margin="0,0,8,0"
                    IsEnabled="{Binding HasSelection}" />
            <TextBlock Text="{Binding CountSummary}" VerticalAlignment="Center"
                       TextWrapping="Wrap" Margin="0,0,12,0"
                       Foreground="{DynamicResource AccYellow}" />
        </DockPanel>

        <Border BorderBrush="{DynamicResource Bdr}" BorderThickness="1" CornerRadius="4">
            <ListBox ItemsSource="{Binding Agents}" BorderThickness="0"
                     Background="Transparent"
                     AutomationProperties.Name="Registered agents"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                  Content="{Binding Display}"
                                  Foreground="{DynamicResource TextP}"
                                  Margin="6,4" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

    </DockPanel>
</Window>
