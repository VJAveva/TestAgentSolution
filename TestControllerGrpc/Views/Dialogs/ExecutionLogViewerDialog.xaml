<Window x:Class="TestControllerGrpc.Views.Dialogs.ExecutionLogViewerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Execution Log Viewer"
        Height="780" Width="1100" MinHeight="500" MinWidth="800"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBg}">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextP}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource BgCard}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextP}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Bdr}"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="3,0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="ToggleButton">
            <Setter Property="Background" Value="{DynamicResource BgCard}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextS}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Bdr}"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="3,0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Execution Log Viewer" FontSize="18" FontWeight="Bold"/>
            <TextBlock Text="{Binding TestCaseName}" FontSize="12" Foreground="{DynamicResource TextS}" Margin="0,2,0,0"/>
        </StackPanel>

        <!-- Context strip -->
        <Border Grid.Row="1" Background="{DynamicResource BgPanel}" CornerRadius="6" Padding="12,8" Margin="0,0,0,10">
            <UniformGrid Rows="1" Columns="6">
                <StackPanel>
                    <TextBlock Text="BUILD" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextS}"/>
                    <TextBlock Text="{Binding BuildName}" FontWeight="SemiBold"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="AGENT" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextS}"/>
                    <TextBlock Text="{Binding Agent}" FontWeight="SemiBold"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="OUTCOME" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextS}"/>
                    <TextBlock Text="{Binding Outcome}" FontWeight="SemiBold"
                               Foreground="{Binding OutcomeBrush}"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="DURATION" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextS}"/>
                    <TextBlock Text="{Binding Duration}" FontWeight="SemiBold"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="STARTED" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextS}"/>
                    <TextBlock Text="{Binding StartTime}" FontSize="11"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="FAILED STEP" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextS}"/>
                    <TextBlock Text="{Binding FailedStepDisplay}" FontWeight="SemiBold"
                               Foreground="{DynamicResource AccRed}"/>
                </StackPanel>
            </UniformGrid>
        </Border>

        <!-- Source filter pills -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Source:" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="{DynamicResource TextS}"/>
            <ToggleButton Content="All" IsChecked="{Binding ShowAll}"/>
            <ToggleButton Content="TRX" IsChecked="{Binding ShowTrx}"/>
            <ToggleButton Content="Agent" IsChecked="{Binding ShowAgent}"/>
            <ToggleButton Content="Controller" IsChecked="{Binding ShowController}"/>
            <ToggleButton Content="Errors only" IsChecked="{Binding ErrorsOnly}" Margin="12,0,0,0"/>
        </StackPanel>

        <!-- Search box -->
        <TextBox Grid.Row="3" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                 Background="{DynamicResource BgPanel}" Foreground="{DynamicResource TextP}" BorderBrush="{DynamicResource Bdr}"
                 Padding="8,5" Margin="0,0,0,8"
                 ToolTip="Filter merged log lines by text"/>

        <!-- Merged log -->
        <Border Grid.Row="4" Background="{DynamicResource BgCard}" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource Bdr}">
            <ListView ItemsSource="{Binding FilteredTimeline}" Background="Transparent"
                      Foreground="{DynamicResource TextP}" BorderThickness="0"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Time" Width="100">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding TimeText}" FontFamily="Consolas" FontSize="11"
                                               Foreground="{DynamicResource TextS}"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Source" Width="80">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding SourceBrush}" CornerRadius="3"
                                            Padding="6,1" HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding Source}" FontSize="10" FontWeight="Bold"
                                                   Foreground="White"/>
                                    </Border>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Severity" Width="70">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Severity}" FontSize="11"
                                               Foreground="{Binding SeverityBrush}"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Message" Width="800">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Message}" FontFamily="Consolas" FontSize="11"
                                               TextWrapping="Wrap"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>

        <!-- Error block -->
        <Border Grid.Row="5" Background="{DynamicResource AlertErrorBg}" BorderBrush="{DynamicResource AlertErrorBdr}" BorderThickness="1"
                CornerRadius="6" Padding="12" Margin="0,10,0,10"
                Visibility="{Binding ErrorBlockVisibility}">
            <StackPanel>
                <TextBlock Text="ERROR" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccRed}"/>
                <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" Margin="0,4,0,0"
                           FontFamily="Consolas" FontSize="11"/>
                <TextBlock Text="{Binding StackTrace}" TextWrapping="Wrap" Margin="0,8,0,0"
                           FontFamily="Consolas" FontSize="10" Foreground="{DynamicResource TextS}"/>
            </StackPanel>
        </Border>

        <!-- Footer buttons -->
        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
            <TextBlock Text="{Binding TimelineCountText}" VerticalAlignment="Center"
                       Margin="0,0,12,0" Foreground="{DynamicResource TextS}" FontSize="11"/>
            <Button Content="Copy" Click="OnCopyClick"/>
            <Button Content="Close" Click="OnCloseClick"/>
        </StackPanel>
    </Grid>
</Window>
