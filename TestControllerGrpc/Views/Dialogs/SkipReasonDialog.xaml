<Window x:Class="TestControllerGrpc.Views.Dialogs.SkipReasonDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mi="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
        Title="Skip node"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" SizeToContent="Height" Width="440"
        Background="{DynamicResource WindowBg}">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <mi:MaterialIcon Kind="DebugStepOver" Width="22" Height="22"
                             Foreground="{DynamicResource CSkipBrush}" VerticalAlignment="Center" />
            <StackPanel Margin="8,0,0,0">
                <TextBlock x:Name="NodeLabel" FontSize="{StaticResource FontSize15}" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextDefaultBrush}" />
                <TextBlock Text="This node and everything under it will be skipped at run time."
                           FontSize="{StaticResource FontSize10}"
                           Foreground="{DynamicResource TextDimBrush}" Margin="0,2,0,0" />
            </StackPanel>
        </StackPanel>

        <TextBlock Grid.Row="1" Text="REASON (optional)" FontSize="{StaticResource FontSize9}"
                   FontWeight="SemiBold" Foreground="{DynamicResource TextDimBrush}" Margin="0,0,0,4" />

        <TextBox x:Name="ReasonBox" Grid.Row="2" MinHeight="64" MaxHeight="120"
                 TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                 FontSize="{StaticResource FontSize11}" Padding="8"
                 Background="{DynamicResource FieldBg}"
                 Foreground="{DynamicResource TextDefaultBrush}"
                 BorderBrush="{DynamicResource Bdr}"
                 ToolTip="Shown on the row so the next person knows why this is off."
                 AutomationProperties.Name="Skip reason" />

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" IsCancel="True" MinWidth="88" Padding="12,6" Margin="0,0,8,0"
                    Background="{DynamicResource BgCard}" Foreground="{DynamicResource TextDefaultBrush}"
                    BorderBrush="{DynamicResource Bdr}" BorderThickness="1"
                    AutomationProperties.Name="Cancel" />
            <Button x:Name="SkipButton" Content="Skip node" IsDefault="True" MinWidth="88" Padding="12,6"
                    Click="OnSkip" Cursor="Hand"
                    Background="{DynamicResource PillSkipBg}" Foreground="{DynamicResource CSkipBrush}"
                    BorderBrush="{DynamicResource CSkipBrush}" BorderThickness="1"
                    AutomationProperties.Name="Skip node" />
        </StackPanel>
    </Grid>
</Window>
