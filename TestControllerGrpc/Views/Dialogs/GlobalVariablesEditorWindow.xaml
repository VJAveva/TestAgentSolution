<Window x:Class="TestControllerGrpc.Views.Dialogs.GlobalVariablesEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Global Variables — Set Build for All Pipelines"
        Width="720" Height="520" MinWidth="550" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBg}">

    <Window.Resources>
        <Style x:Key="GvBtn" TargetType="Button">
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource TextP}"/>
            <Setter Property="Background" Value="{DynamicResource BtnBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Bdr}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BgPanel}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Row 0: Drop Location Browse -->
        <Border Grid.Row="0" Background="{DynamicResource BgCard}" CornerRadius="6" Padding="12,10" Margin="0,0,0,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Drop Location:" Foreground="{DynamicResource TextS}"
                           VerticalAlignment="Center" Margin="0,0,8,4" FontSize="12"/>
                <TextBox x:Name="DropLocationBox" Grid.Row="0" Grid.Column="1" 
                         Text="{Binding DropLocation, UpdateSourceTrigger=PropertyChanged}"
                         Foreground="{DynamicResource TextP}" Background="{DynamicResource BgPanel}"
                         BorderBrush="{DynamicResource Bdr}" Padding="6,4" Margin="0,0,8,4" FontSize="12"
                         ToolTip="Network path to the build drop folder"/>
                <Button Grid.Row="0" Grid.Column="2" Content="📂 Browse" Style="{StaticResource GvBtn}"
                        Click="BrowseDropLocation_Click" Margin="0,0,0,4"
                        ToolTip="Browse to select a build folder from the drop location"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Build Number:" Foreground="{DynamicResource TextS}"
                           VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12"/>
                <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                           Text="{Binding BuildNumber}" Foreground="{DynamicResource AccGreen}"
                           VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold"/>
            </Grid>
        </Border>

        <!-- Row 1: Apply button -->
        <Border Grid.Row="1" Margin="0,0,0,8">
            <Button Content="⚡ Apply Build to All Pipelines" Style="{StaticResource GvBtn}"
                    Click="ApplyToAll_Click" HorizontalAlignment="Left"
                    Background="{DynamicResource Accent}" Foreground="White" FontWeight="SemiBold"
                    IsEnabled="{Binding HasBuildSelected}"
                    ToolTip="Updates _BuildNumber and _DropLocation in ALL WatchItem parameter files"/>
        </Border>

        <!-- Row 2: Global variables file path -->
        <Border Grid.Row="2" Background="{DynamicResource BgCard}" CornerRadius="6" Padding="10,8" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Variables File:" Foreground="{DynamicResource TextS}"
                           VerticalAlignment="Center" Margin="0,0,8,0" FontSize="11"/>
                <TextBlock Grid.Column="1" Text="{Binding FilePath}" Foreground="{DynamicResource TextP}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FontSize="11"
                           ToolTip="{Binding FilePath}"/>
                <Button Grid.Column="2" Content="Browse…" Style="{StaticResource GvBtn}"
                        Click="BrowseFile_Click" FontSize="11"/>
            </Grid>
        </Border>

        <!-- Row 3: DataGrid for key-value entries (editable) -->
        <Border Grid.Row="3" Background="{DynamicResource BgCard}" CornerRadius="6" Padding="6">
            <DataGrid x:Name="EntriesGrid" ItemsSource="{Binding Entries}"
                      AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                      Background="Transparent" Foreground="{DynamicResource TextP}"
                      BorderThickness="0" RowBackground="Transparent"
                      AlternatingRowBackground="{DynamicResource BgPanel}"
                      HorizontalGridLinesBrush="{DynamicResource Bdr}"
                      SelectionMode="Single" SelectionUnit="FullRow">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="{DynamicResource BgPanel}"/>
                        <Setter Property="Foreground" Value="{DynamicResource TextS}"/>
                        <Setter Property="Padding" Value="8,4"/>
                        <Setter Property="FontSize" Value="11"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource Bdr}"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Foreground" Value="{DynamicResource TextP}"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Padding" Value="6,3"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridCell">
                                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{DynamicResource BgPanel}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.CellStyle>
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Background" Value="Transparent"/>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{DynamicResource BgPanel}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Key" Binding="{Binding Key, UpdateSourceTrigger=PropertyChanged}"
                                        Width="200" Foreground="{DynamicResource TextP}">
                        <DataGridTextColumn.EditingElementStyle>
                            <Style TargetType="TextBox">
                                <Setter Property="Background" Value="{DynamicResource BgPanel}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextP}"/>
                                <Setter Property="CaretBrush" Value="{DynamicResource TextP}"/>
                            </Style>
                        </DataGridTextColumn.EditingElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Value" Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                        Width="*" Foreground="{DynamicResource TextP}">
                        <DataGridTextColumn.EditingElementStyle>
                            <Style TargetType="TextBox">
                                <Setter Property="Background" Value="{DynamicResource BgPanel}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextP}"/>
                                <Setter Property="CaretBrush" Value="{DynamicResource TextP}"/>
                            </Style>
                        </DataGridTextColumn.EditingElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Row 4: Add/Remove + Status -->
        <Border Grid.Row="4" Margin="0,8,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="＋ Add" Style="{StaticResource GvBtn}" Click="Add_Click"/>
                <Button Grid.Column="1" Content="－ Remove" Style="{StaticResource GvBtn}" Click="Remove_Click"/>
                <TextBlock Grid.Column="2" Text="{Binding Status}" Foreground="{DynamicResource TextS}"
                           VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="11"/>
            </Grid>
        </Border>

        <!-- Row 5: Save / Close -->
        <Border Grid.Row="5" Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Save Variables File" Style="{StaticResource GvBtn}" Click="Save_Click"
                        Background="{DynamicResource Accent}" Foreground="White" FontWeight="SemiBold"/>
                <Button Content="Close" Style="{StaticResource GvBtn}" Click="Close_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
