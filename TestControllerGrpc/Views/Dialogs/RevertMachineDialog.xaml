<Window x:Class="TestControllerGrpc.Views.Dialogs.RevertMachineDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mi="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
        Title="Revert machine to snapshot"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" SizeToContent="Height" Width="460"
        Background="{DynamicResource WindowBg}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Header -->
            <RowDefinition Height="Auto" /> <!-- Busy warning (R9) -->
            <RowDefinition Height="Auto" /> <!-- Snapshot -->
            <RowDefinition Height="Auto" /> <!-- Options (R10) -->
            <RowDefinition Height="Auto" /> <!-- Reason -->
            <RowDefinition Height="Auto" /> <!-- Actions -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
            <mi:MaterialIcon Kind="BackupRestore" Width="24" Height="24" Foreground="{DynamicResource CEmailBrush}"
                             VerticalAlignment="Center" />
            <StackPanel Margin="8,0,0,0">
                <TextBlock FontSize="{StaticResource FontSize15}" FontWeight="SemiBold" Foreground="{DynamicResource TextDefaultBrush}">
                    <Run Text="Revert " /><Run Text="{Binding AgentName}" FontFamily="Consolas" />
                </TextBlock>
                <TextBlock Text="The agent is destroyed and rebuilt from the snapshot." FontSize="{StaticResource FontSize10}"
                           Foreground="{DynamicResource TextDimBrush}" Margin="0,2,0,0" />
            </StackPanel>
        </StackPanel>

        <!-- Busy warning (R9) -->
        <Border Grid.Row="1" CornerRadius="4" Padding="10" Margin="0,0,0,12"
                Background="#1AF0B070" BorderBrush="#44F0B070" BorderThickness="1"
                Visibility="{Binding IsBusyWarningVisible, Converter={StaticResource BoolVis}}">
            <TextBlock Text="{Binding BusyWarning}" FontSize="{StaticResource FontSize10}" TextWrapping="Wrap"
                       Foreground="{DynamicResource CEmailBrush}" />
        </Border>

        <!-- Snapshot -->
        <StackPanel Grid.Row="2" Margin="0,0,0,12">
            <TextBlock Text="Snapshot name" FontSize="{StaticResource FontSize10}" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
            <TextBox Text="{Binding SnapshotName, UpdateSourceTrigger=PropertyChanged}"
                     FontSize="{StaticResource FontSize11}" Padding="8"
                     Background="{DynamicResource FieldBg}"
                     Foreground="{DynamicResource TextDefaultBrush}"
                     BorderBrush="{DynamicResource Bdr}"  AutomationProperties.Name="Snapshot name" />
        </StackPanel>

        <!-- Options (R10) -->
        <StackPanel Grid.Row="3" Margin="0,0,0,12">
            <CheckBox Content="Wait until the agent reconnects" IsChecked="{Binding WaitForAgent}"
                      Foreground="{DynamicResource TextDefaultBrush}" Margin="0,0,0,6" />
            <CheckBox Content="Run agent prep after revert" IsChecked="{Binding RunPrep}"
                      IsEnabled="{Binding WaitForAgent}"
                      Foreground="{DynamicResource TextDefaultBrush}" Margin="16,0,0,6" />
            <CheckBox Content="Install build after prep" IsChecked="{Binding InstallBuild}"
                      IsEnabled="{Binding WaitForAgent}"
                      Foreground="{DynamicResource TextDefaultBrush}" Margin="16,0,0,6" />
            <CheckBox Content="Force revert busy agent" IsChecked="{Binding ForceIfBusy}"
                      Foreground="#FFE0857A" Margin="0,0,0,0" />
        </StackPanel>

        <!-- Reason -->
        <StackPanel Grid.Row="4" Margin="0,0,0,16">
            <TextBlock Text="Reason (optional)" FontSize="{StaticResource FontSize10}" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
            <TextBox Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}"
                     FontSize="{StaticResource FontSize11}" Padding="8"
                     Background="{DynamicResource FieldBg}"
                     Foreground="{DynamicResource TextDefaultBrush}"
                     BorderBrush="{DynamicResource Bdr}"  AutomationProperties.Name="Reason (optional)" />
        </StackPanel>

        <!-- Actions -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" IsCancel="True" MinWidth="90" Padding="10,6" Margin="0,0,8,0"
                    Background="{DynamicResource FieldBg}"
                    Foreground="{DynamicResource TextDefaultBrush}"
                    BorderBrush="{DynamicResource Bdr}" />
            <Button Content="{Binding ConfirmText}" MinWidth="120" Padding="10,6"
                    Command="{Binding ConfirmCommand}"
                    IsEnabled="{Binding CanConfirm}"
                    Background="{DynamicResource CEmailBrush}" Foreground="#FF1B1B1B" BorderThickness="0" FontWeight="SemiBold" />
        </StackPanel>
    </Grid>
</Window>
