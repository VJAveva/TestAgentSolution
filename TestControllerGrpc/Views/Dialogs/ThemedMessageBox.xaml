<Window x:Class="TestControllerGrpc.Views.Dialogs.ThemedMessageBox"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Caption}"
        SizeToContent="WidthAndHeight"
        MinWidth="340" MaxWidth="520" MinHeight="160"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True"
        ResizeMode="NoResize"
        Background="Transparent"
        ShowInTaskbar="False">

    <Border Background="{DynamicResource WindowBg}" BorderBrush="{DynamicResource Bdr}"
            BorderThickness="1" CornerRadius="{DynamicResource RadiusXl}" Padding="0"
            SnapsToDevicePixels="True"
            Effect="{DynamicResource ShadowDialog}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /> <!-- Title bar -->
                <RowDefinition Height="*" />    <!-- Content -->
                <RowDefinition Height="Auto" /> <!-- Buttons -->
            </Grid.RowDefinitions>

            <!-- Custom title bar -->
            <Border Grid.Row="0" Background="{DynamicResource BgCard}" Padding="14,10"
                    CornerRadius="12,12,0,0" MouseLeftButtonDown="TitleBar_MouseDown">
                <DockPanel>
                    <TextBlock Text="{Binding Caption}" FontSize="{StaticResource FontSize12}" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextP}" VerticalAlignment="Center" />
                </DockPanel>
            </Border>

            <!-- Message content -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="20,18,20,14">
                <!-- Icon -->
                <TextBlock x:Name="IconGlyph" FontFamily="Segoe MDL2 Assets" FontSize="28"
                           VerticalAlignment="Top" Margin="0,2,14,0" />

                <!-- Message text -->
                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" FontSize="{StaticResource FontSize12}"
                           Foreground="{DynamicResource TextP}" MaxWidth="380"
                           VerticalAlignment="Center" LineHeight="20" />
            </StackPanel>

            <!-- Button row -->
            <Border Grid.Row="2" Background="{DynamicResource BgCard}" Padding="14,10"
                    CornerRadius="0,0,12,12">
                <StackPanel x:Name="ButtonPanel" Orientation="Horizontal"
                            HorizontalAlignment="Right" />
            </Border>
        </Grid>
    </Border>
</Window>
