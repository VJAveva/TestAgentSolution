<Window x:Class="TestControllerGrpc.Views.Dialogs.FailureAnalysisDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Failure Pattern Analysis"
        Height="700" Width="950" MinHeight="500" MinWidth="700"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBg}">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextP}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource BgCard}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextP}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Bdr}"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Failure Pattern Analysis" FontSize="20" FontWeight="Bold"/>
            <TextBlock Text="{Binding TestCaseName}" FontSize="13" Foreground="{DynamicResource TextS}" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Verdict box -->
        <Border Grid.Row="1" Background="{DynamicResource BgPanel}" CornerRadius="8" Padding="16" Margin="0,0,0,12"
                BorderThickness="1" BorderBrush="{Binding VerdictBorderBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock>
                        <Run Text="Pattern: " FontWeight="Bold" Foreground="{DynamicResource TextS}"/>
                        <Run Text="{Binding PatternLabel, Mode=OneWay}" FontWeight="Bold" FontSize="14"
                             Foreground="{Binding VerdictForegroundBrush}"/>
                    </TextBlock>
                    <TextBlock Text="{Binding Verdict}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                </StackPanel>
                <Border Grid.Column="1" Background="{DynamicResource WindowBg}" CornerRadius="6" Padding="10,6"
                        VerticalAlignment="Top">
                    <TextBlock>
                        <Run Text="Confidence: " Foreground="{DynamicResource TextS}"/>
                        <Run Text="{Binding ConfidenceText, Mode=OneWay}" FontWeight="Bold"/>
                    </TextBlock>
                </Border>
            </Grid>
        </Border>

        <!-- Build timeline -->
        <Border Grid.Row="2" Background="{DynamicResource BgPanel}" CornerRadius="6" Padding="12" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="BUILD HISTORY (newest ? oldest)" FontSize="11" FontWeight="Bold"
                           Foreground="{DynamicResource TextS}" Margin="0,0,0,8"/>
                <ItemsControl ItemsSource="{Binding History}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{Binding OutcomeBrush}" CornerRadius="4"
                                    Width="24" Height="24" Margin="2"
                                    ToolTip="{Binding ToolTipText}">
                                <TextBlock Text="{Binding OutcomeChar}" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="White" FontSize="12"/>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- Signature comparison -->
        <Border Grid.Row="3" Background="{DynamicResource BgPanel}" CornerRadius="6" Padding="12">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="FAILURE SIGNATURES" FontSize="11" FontWeight="Bold"
                           Foreground="{DynamicResource TextS}" Margin="0,0,0,8"/>
                <DataGrid ItemsSource="{Binding FailureSignatures}" AutoGenerateColumns="False"
                          Background="Transparent" Foreground="{DynamicResource TextP}" GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="{DynamicResource Bdr}" RowBackground="Transparent"
                          AlternatingRowBackground="{DynamicResource BgCard}" BorderThickness="0"
                          HeadersVisibility="Column" CanUserAddRows="False" IsReadOnly="True">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="{DynamicResource BgCard}"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextS}"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="FontSize" Value="11"/>
                            <Setter Property="Padding" Value="8,6"/>
                            <Setter Property="BorderThickness" Value="0"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Build" Binding="{Binding BuildName}" Width="120"/>
                        <DataGridTextColumn Header="Step" Binding="{Binding FailedStepName}" Width="160"/>
                        <DataGridTextColumn Header="Error Type" Binding="{Binding ErrorType}" Width="160"/>
                        <DataGridTextColumn Header="Normalized Message" Binding="{Binding NormalizedMessage}" Width="*"/>
                        <DataGridTextColumn Header="Agent" Binding="{Binding Agent}" Width="80"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <!-- Suggested action -->
        <Border Grid.Row="4" Background="{DynamicResource BgPanel}" CornerRadius="6" Padding="12" Margin="0,12,0,12">
            <StackPanel>
                <TextBlock Text="SUGGESTED ACTION" FontSize="11" FontWeight="Bold"
                           Foreground="{DynamicResource TextS}" Margin="0,0,0,8"/>
                <TextBlock Text="{Binding SuggestedAction}" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- Buttons -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Copy" Click="OnCopyClick"/>
            <Button Content="View Latest Build Log ?" Click="OnViewLogClick"
                    Background="{DynamicResource Accent}" BorderBrush="{DynamicResource Accent}"/>
            <Button Content="Close" Click="OnCloseClick"/>
        </StackPanel>
    </Grid>
</Window>
