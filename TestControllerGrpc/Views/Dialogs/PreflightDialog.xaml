<Window x:Class="TestControllerGrpc.Views.Dialogs.PreflightDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:TestControllerGrpc.ViewModels.Converters"
        Title="Pre-flight"
        Width="1000" Height="680" MinWidth="720" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{DynamicResource WindowBg}"
        ShowInTaskbar="False">

    <Window.Resources>
        <conv:PreflightStatusBrushConverter x:Key="StatusBrush" />
        <conv:SourceLayerBrushConverter x:Key="SourceBrush" />
        <conv:StringToVisibilityConverter x:Key="StringVis" />
        <conv:EqualsToBoolConverter x:Key="EqBool" />

        <Style x:Key="Chip" TargetType="ToggleButton">
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Padding" Value="10,3" />
            <Setter Property="Foreground" Value="{DynamicResource TextS}" />
            <Setter Property="FontSize" Value="{StaticResource FontSize11}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" CornerRadius="10" Padding="{TemplateBinding Padding}"
                                Background="{DynamicResource BtnBg}"
                                BorderBrush="{DynamicResource Bdr}" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SelectedItemBg}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextP}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverItemBg}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource FocusRing}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Underlined tab headers, matching ExecutionDashboardWindow. Without this the default
             Windows chrome renders light headers that ignore the dark/HC themes. -->
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource TextS}" />
            <Setter Property="FontSize" Value="{StaticResource FontSize12}" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd" Background="Transparent" Cursor="Hand"
                                Padding="{TemplateBinding Padding}"
                                BorderThickness="0,0,0,2" BorderBrush="Transparent">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextP}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverItemBg}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource FocusRing}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="{DynamicResource BgPanel}" />
            <Setter Property="Foreground" Value="{DynamicResource TextP}" />
            <Setter Property="RowBackground" Value="{DynamicResource BgPanel}" />
            <Setter Property="AlternatingRowBackground" Value="{DynamicResource BgCard}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Bdr}" />
            <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource Bdr}" />
            <Setter Property="VerticalGridLinesBrush" Value="Transparent" />
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="RowHeaderWidth" Value="0" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="CanUserResizeRows" Value="False" />
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Foreground" Value="{DynamicResource TextP}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Top" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource BgSurface}" />
            <Setter Property="Foreground" Value="{DynamicResource TextS}" />
            <Setter Property="FontSize" Value="{StaticResource FontSize10}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="BorderBrush" Value="{DynamicResource Bdr}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header: which pipeline this is about -->
        <TextBlock Grid.Row="0" Margin="2,0,0,10"
                   FontSize="{StaticResource FontSize14}" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextP}" TextTrimming="CharacterEllipsis">
            <Run Text="Pre-flight &#183; " Foreground="{DynamicResource TextS}" /><Run Text="{Binding Target, Mode=OneWay}" />
        </TextBlock>

        <!-- Banner: the verdict, colour-coded -->
        <Border Grid.Row="1" CornerRadius="6" Padding="14,10" Margin="0,0,0,10"
                Background="{Binding BannerKind, Converter={StaticResource StatusBrush}, ConverterParameter=Bg}"
                BorderBrush="{Binding BannerKind, Converter={StaticResource StatusBrush}}"
                BorderThickness="1">
            <StackPanel>
                <TextBlock Text="{Binding BannerText}" FontSize="{StaticResource FontSize14}" FontWeight="Bold"
                           Foreground="{Binding BannerKind, Converter={StaticResource StatusBrush}}"
                           AutomationProperties.LiveSetting="Assertive" />
                <TextBlock Text="{Binding BannerDetail}" FontSize="{StaticResource FontSize11}"
                           Foreground="{DynamicResource TextS}" Margin="0,3,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <TabControl x:Name="Tabs" Grid.Row="2" Background="Transparent" BorderBrush="{DynamicResource Bdr}">
            <!-- ========================= CHECKS ========================= -->
            <TabItem Header="Checks">
                <Grid Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                        <ToggleButton Style="{StaticResource Chip}" AutomationProperties.Name="Show all checks"
                                      IsChecked="{Binding CheckFilter, Converter={StaticResource EqBool}, ConverterParameter=All}">
                            <TextBlock Text="All" />
                        </ToggleButton>
                        <ToggleButton Style="{StaticResource Chip}" AutomationProperties.Name="Show failed checks"
                                      IsChecked="{Binding CheckFilter, Converter={StaticResource EqBool}, ConverterParameter=Failed}">
                            <TextBlock Foreground="{DynamicResource AccRed}"><Run Text="Failed " /><Run Text="{Binding FailedCount, Mode=OneWay}" /></TextBlock>
                        </ToggleButton>
                        <ToggleButton Style="{StaticResource Chip}" AutomationProperties.Name="Show warnings"
                                      IsChecked="{Binding CheckFilter, Converter={StaticResource EqBool}, ConverterParameter=Warnings}">
                            <TextBlock Foreground="{DynamicResource AccYellow}"><Run Text="Warnings " /><Run Text="{Binding WarnCount, Mode=OneWay}" /></TextBlock>
                        </ToggleButton>
                        <ToggleButton Style="{StaticResource Chip}" AutomationProperties.Name="Show passed checks"
                                      IsChecked="{Binding CheckFilter, Converter={StaticResource EqBool}, ConverterParameter=Passed}">
                            <TextBlock Foreground="{DynamicResource AccGreen}"><Run Text="Passed " /><Run Text="{Binding PassCount, Mode=OneWay}" /></TextBlock>
                        </ToggleButton>
                    </StackPanel>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding ChecksView}"
                              AutomationProperties.Name="Pre-flight checks">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="STATUS" Width="86" SortMemberPath="SortKey">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="9" Padding="8,2" HorizontalAlignment="Left"
                                                Background="{Binding Status, Converter={StaticResource StatusBrush}, ConverterParameter=Bg}">
                                            <TextBlock Text="{Binding StatusText}" FontSize="{StaticResource FontSize10}"
                                                       FontWeight="Bold"
                                                       Foreground="{Binding Status, Converter={StaticResource StatusBrush}}" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="AREA" Binding="{Binding Area}" Width="140" SortMemberPath="Area">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource TextS}" />
                                        <Setter Property="TextWrapping" Value="Wrap" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="CHECK" Binding="{Binding Check}" Width="200" SortMemberPath="Check">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                        <Setter Property="TextWrapping" Value="Wrap" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTemplateColumn Header="DETAILS / HOW TO FIX" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Detail}" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextP}" />
                                            <TextBlock Text="{Binding FixHint}" TextWrapping="Wrap" Margin="0,3,0,0"
                                                       FontStyle="Italic"
                                                       Visibility="{Binding FixHint, Converter={StaticResource StringVis}}"
                                                       Foreground="{Binding Status, Converter={StaticResource StatusBrush}}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- ======================= PARAMETERS ======================= -->
            <TabItem>
                <TabItem.Header>
                    <TextBlock><Run Text="Parameters (" /><Run Text="{Binding TokenCount, Mode=OneWay}" /><Run Text=")" /></TextBlock>
                </TabItem.Header>
                <Grid Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,8" HorizontalAlignment="Left" Width="320">
                        <TextBox Padding="6,4" VerticalContentAlignment="Center"
                                 Text="{Binding TokenSearch, UpdateSourceTrigger=PropertyChanged}"
                                 Background="{DynamicResource FieldBg}" Foreground="{DynamicResource TextP}"
                                 BorderBrush="{DynamicResource Bdr}" BorderThickness="1"
                                 AutomationProperties.Name="Filter tokens" ToolTip="Filter by token name or value" />
                        <TextBlock Text="Filter tokens&#8230;" IsHitTestVisible="False"
                                   Margin="8,0,0,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource PlaceholderFg}"
                                   Visibility="{Binding TokenSearch, Converter={StaticResource StringVis}, ConverterParameter=Invert}" />
                    </Grid>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding TokensView}" CanUserSortColumns="True"
                              AutomationProperties.Name="Resolved parameters">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="TOKEN" Width="220" SortMemberPath="Token"
                                                Binding="{Binding Token, StringFormat='[{0}]'}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontFamily" Value="Cascadia Code, Consolas, monospace" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="VALUE" Binding="{Binding Value}" Width="*" SortMemberPath="Value">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontFamily" Value="Cascadia Code, Consolas, monospace" />
                                        <Setter Property="TextWrapping" Value="Wrap" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTemplateColumn Header="SOURCE" Width="110" SortMemberPath="Source">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="9" Padding="8,2" HorizontalAlignment="Left"
                                                Background="{Binding Source, Converter={StaticResource SourceBrush}, ConverterParameter=Bg}">
                                            <TextBlock Text="{Binding Source}" FontSize="{StaticResource FontSize10}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{Binding Source, Converter={StaticResource SourceBrush}}" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Footer -->
        <Grid Grid.Row="3" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button Content="Copy report" Click="CopyReport_Click" Margin="0,0,6,0"
                        Style="{StaticResource SecondaryButtonStyle}"
                        AutomationProperties.Name="Copy report to clipboard" />
                <Button Content="Save&#8230;" Click="SaveReport_Click" Margin="0,0,6,0"
                        Style="{StaticResource SecondaryButtonStyle}"
                        AutomationProperties.Name="Save report as markdown" />
                <Button Content="Re-check" Click="Recheck_Click"
                        Style="{StaticResource SecondaryButtonStyle}"
                        IsEnabled="{Binding CanRecheck}"
                        AutomationProperties.Name="Run the checks again" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelButton" Content="Cancel" Click="Cancel_Click" IsCancel="True"
                        Margin="0,0,6,0" Style="{StaticResource SecondaryButtonStyle}" />
                <Button x:Name="RunButton" Content="{Binding RunText}" Click="Run_Click" IsDefault="True"
                        Padding="18,6" IsEnabled="{Binding CanRun}"
                        Style="{StaticResource PrimaryButtonStyle}" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
