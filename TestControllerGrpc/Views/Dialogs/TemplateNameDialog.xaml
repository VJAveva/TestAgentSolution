<Window x:Class="TestControllerGrpc.Views.Dialogs.TemplateNameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Save group as template"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" SizeToContent="Height" Width="440"
        Background="{DynamicResource WindowBg}">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock x:Name="GroupLabel" FontSize="{StaticResource FontSize15}" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextDefaultBrush}" />
            <TextBlock Text="The group moves to the Library and this pipeline calls it with a Ref."
                       FontSize="{StaticResource FontSize10}" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextDimBrush}" Margin="0,2,0,0" />
        </StackPanel>

        <TextBlock Grid.Row="1" Text="TEMPLATE NAME" FontSize="{StaticResource FontSize9}"
                   FontWeight="SemiBold" Foreground="{DynamicResource TextDimBrush}" Margin="0,0,0,4" />

        <TextBox x:Name="NameBox" Grid.Row="2" FontSize="{StaticResource FontSize11}" Padding="8"
                 Background="{DynamicResource FieldBg}"
                 Foreground="{DynamicResource TextDefaultBrush}"
                 BorderBrush="{DynamicResource Bdr}"
                 TextChanged="NameBox_TextChanged"
                 AutomationProperties.Name="Template name" />

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" IsCancel="True" MinWidth="88" Padding="12,6" Margin="0,0,8,0"
                    Background="{DynamicResource BgCard}" Foreground="{DynamicResource TextDefaultBrush}"
                    BorderBrush="{DynamicResource Bdr}" BorderThickness="1"
                    AutomationProperties.Name="Cancel" />
            <Button x:Name="SaveButton" Content="Save as template" IsDefault="True" MinWidth="88" Padding="12,6"
                    Click="OnSave" Cursor="Hand"
                    Background="{DynamicResource AccentBtnBg}" Foreground="{DynamicResource Accent}"
                    BorderBrush="{DynamicResource Bdr}" BorderThickness="1"
                    AutomationProperties.Name="Save as template" />
        </StackPanel>
    </Grid>
</Window>
