<UserControl x:Class="TestControllerGrpc.Views.HealthMetricsStrip"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:TestControllerGrpc.Views"
             Height="50" VerticalAlignment="Center">

    <UserControl.Resources>
        <!-- Health-color converter -->
        <local:HealthLevelToBrushConverter x:Key="HealthBrush" />
        <BooleanToVisibilityConverter x:Key="BoolVis" />
        <local:PercentToWidthConverter x:Key="PercentToWidth" />
        <local:LatencyToWidthConverter x:Key="LatencyToWidth" />

        <Style x:Key="MetricBar" TargetType="Border">
            <Setter Property="Height" Value="4" />
            <Setter Property="Width" Value="40" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="Background" Value="#30FFFFFF" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="MetricLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="9" />
            <Setter Property="Foreground" Value="{DynamicResource TextS}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="MetricValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextP}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Pulsing animation for critical state -->
        <Storyboard x:Key="PulseAnimation" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="HealthDot"
                             Storyboard.TargetProperty="Opacity"
                             From="1" To="0.3" Duration="0:0:0.6"
                             AutoReverse="True" />
        </Storyboard>
    </UserControl.Resources>

    <Border x:Name="StripBorder" CornerRadius="6" Padding="10,4" Margin="4,0"
            Background="{DynamicResource GroupBg}" BorderThickness="1"
            BorderBrush="{DynamicResource Bdr}">
        <Border.Style>
            <Style TargetType="Border">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsCritical}" Value="True">
                        <Setter Property="Background" Value="#30FF4444" />
                        <Setter Property="BorderBrush" Value="#80FF4444" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

            <!-- Overall Health Dot + CONTROLLER label -->
            <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                <Ellipse x:Name="HealthDot" Width="10" Height="10" VerticalAlignment="Center"
                         Fill="{Binding OverallHealth, Converter={StaticResource HealthBrush}}" />
                <TextBlock Text="CONTROLLER" FontSize="9" FontWeight="Bold" Margin="5,0,0,0"
                           Foreground="{DynamicResource TextS}" VerticalAlignment="Center" />
            </StackPanel>

            <Rectangle Width="1" Fill="{DynamicResource Bdr}" Margin="0,6" />

            <!-- CPU -->
            <StackPanel Margin="10,0" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource MetricLabel}" Text="CPU" />
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource MetricValue}">
                        <Run Text="{Binding CpuPercent, StringFormat={}{0:F0}%}" />
                    </TextBlock>
                    <Border Style="{StaticResource MetricBar}" Margin="4,0,0,0">
                        <Border CornerRadius="2" HorizontalAlignment="Left"
                                Height="4" Width="{Binding CpuPercent, Converter={StaticResource PercentToWidth}}"
                                Background="{Binding CpuHealth, Converter={StaticResource HealthBrush}}" />
                    </Border>
                </StackPanel>
            </StackPanel>

            <Rectangle Width="1" Fill="{DynamicResource Bdr}" Margin="0,6" />

            <!-- Memory -->
            <StackPanel Margin="10,0" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource MetricLabel}" Text="MEM" />
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource MetricValue}">
                        <Run Text="{Binding MemoryUsedGb, StringFormat={}{0:F1}}" />
                        <Run Text="GB" FontSize="8" />
                    </TextBlock>
                    <Border Style="{StaticResource MetricBar}" Margin="4,0,0,0">
                        <Border CornerRadius="2" HorizontalAlignment="Left"
                                Height="4" Width="{Binding MemoryPercent, Converter={StaticResource PercentToWidth}}"
                                Background="{Binding MemoryHealth, Converter={StaticResource HealthBrush}}" />
                    </Border>
                </StackPanel>
            </StackPanel>

            <Rectangle Width="1" Fill="{DynamicResource Bdr}" Margin="0,6" />

            <!-- Disk -->
            <StackPanel Margin="10,0" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource MetricLabel}" Text="DISK" />
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource MetricValue}">
                        <Run Text="{Binding DiskPercent, StringFormat={}{0:F0}%}" />
                    </TextBlock>
                    <Border Style="{StaticResource MetricBar}" Margin="4,0,0,0">
                        <Border CornerRadius="2" HorizontalAlignment="Left"
                                Height="4" Width="{Binding DiskPercent, Converter={StaticResource PercentToWidth}}"
                                Background="{Binding DiskHealth, Converter={StaticResource HealthBrush}}" />
                    </Border>
                </StackPanel>
            </StackPanel>

            <Rectangle Width="1" Fill="{DynamicResource Bdr}" Margin="0,6" />

            <!-- Network Latency -->
            <StackPanel Margin="10,0" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource MetricLabel}" Text="NET" />
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource MetricValue}">
                        <Run Text="{Binding NetworkLatencyMs, StringFormat={}{0:F0}}" />
                        <Run Text="ms" FontSize="8" />
                    </TextBlock>
                    <Border Style="{StaticResource MetricBar}" Margin="4,0,0,0">
                        <Border CornerRadius="2" HorizontalAlignment="Left"
                                Height="4" Width="{Binding NetworkLatencyMs, Converter={StaticResource LatencyToWidth}}"
                                Background="{Binding NetworkHealth, Converter={StaticResource HealthBrush}}" />
                    </Border>
                </StackPanel>
            </StackPanel>

            <Rectangle Width="1" Fill="{DynamicResource Bdr}" Margin="0,6" />

            <!-- Agents Online -->
            <StackPanel Margin="10,0" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource MetricLabel}" Text="AGENTS" />
                <TextBlock Style="{StaticResource MetricValue}">
                    <Run Text="{Binding AgentsOnline, Mode=OneWay}" Foreground="{DynamicResource AccGreen}" />
                    <Run Text="/" FontSize="9" /><Run Text="{Binding AgentsTotal, Mode=OneWay}" />
                </TextBlock>
            </StackPanel>

            <Rectangle Width="1" Fill="{DynamicResource Bdr}" Margin="0,6" />

            <!-- Active Sessions -->
            <StackPanel Margin="10,0" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource MetricLabel}" Text="SESSIONS" />
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource MetricValue}">
                        <Run Text="{Binding ActiveSessionCount, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Text="{Binding SessionElapsed}" FontSize="9"
                               Foreground="{DynamicResource TextS}" Margin="4,0,0,0"
                               VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>

            <!-- Alert Summary (shown only in critical state) -->
            <TextBlock Text="{Binding AlertSummary}" FontSize="10" FontWeight="SemiBold"
                       Foreground="{DynamicResource AccRed}" Margin="12,0,0,0"
                       VerticalAlignment="Center"
                       Visibility="{Binding IsCritical, Converter={StaticResource BoolVis}}" />
        </StackPanel>
    </Border>
</UserControl>
