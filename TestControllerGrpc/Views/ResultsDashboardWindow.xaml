<Window x:Class="TestControllerGrpc.Views.ResultsDashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:TestControllerGrpc.ViewModels"
        Title="Results Dashboard - TestController"
        Height="800" Width="1400" MinWidth="1000" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBg}">

    <Window.Icon>
        <DrawingImage>
            <DrawingImage.Drawing>
                <GeometryDrawing Brush="#FF89B4FA" Geometry="M12,2 C6.48,2 2,6.48 2,12 C2,17.52 6.48,22 12,22 C17.52,22 22,17.52 22,12 C22,6.48 17.52,2 12,2 Z M10,17 L5,12 L6.41,10.59 L10,14.17 L17.59,6.58 L19,8 Z" />
            </DrawingImage.Drawing>
        </DrawingImage>
    </Window.Icon>

    <Window.Resources>
        <Style x:Key="Fld" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource FieldBg}" />
            <Setter Property="Foreground" Value="{DynamicResource TextP}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Bdr}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Margin" Value="0,2,0,5" />
        </Style>
        <Style x:Key="SmBtn" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource Accent}" />
            <Setter Property="Foreground" Value="{DynamicResource TreeBadgeFg}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Margin" Value="3" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <!-- ?? Ribbon button styles ?? -->
        <Style x:Key="RibbonBtn" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource BtnBg}" />
            <Setter Property="Foreground" Value="{DynamicResource TextP}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BtnBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="MinWidth" Value="52" />
            <Setter Property="Height" Value="52" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BtnHoverBg}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BtnPressedBg}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                                <Setter Property="Foreground" Value="{DynamicResource DisabledFg}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RibbonBtnAccent" TargetType="Button" BasedOn="{StaticResource RibbonBtn}">
            <Setter Property="Background" Value="{DynamicResource AccentBtnBg}" />
            <Setter Property="Foreground" Value="{DynamicResource Accent}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="RibbonBtnGreen" TargetType="Button" BasedOn="{StaticResource RibbonBtn}">
            <Setter Property="Background" Value="{DynamicResource GreenBtnBg}" />
            <Setter Property="Foreground" Value="{DynamicResource AccGreen}" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style x:Key="RibbonBtnDanger" TargetType="Button" BasedOn="{StaticResource RibbonBtn}">
            <Setter Property="Background" Value="{DynamicResource DangerBtnBg}" />
            <Setter Property="Foreground" Value="{DynamicResource AccRed}" />
        </Style>
        <Style x:Key="RibbonBtnMauve" TargetType="Button" BasedOn="{StaticResource RibbonBtn}">
            <Setter Property="Background" Value="{DynamicResource MauveBtnBg}" />
            <Setter Property="Foreground" Value="{DynamicResource AccMauve}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="RibbonBtnYellow" TargetType="Button" BasedOn="{StaticResource RibbonBtn}">
            <Setter Property="Background" Value="{DynamicResource YellowBtnBg}" />
            <Setter Property="Foreground" Value="{DynamicResource AccYellow}" />
        </Style>
        <Style x:Key="RibbonIconText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="Foreground" Value="{DynamicResource IconFg}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
        </Style>

        <!-- ?? Inline export button style ?? -->
        <Style x:Key="InlineExportBtn" TargetType="Button">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="3,1" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- ??????????????????????????????????????????????????????????? -->
        <!-- RIBBON                                                    -->
        <!-- ??????????????????????????????????????????????????????????? -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource RibbonBg}"
                BorderBrush="{DynamicResource Bdr}" BorderThickness="0,0,0,1" Padding="6,6">
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">

                <!-- ?? Navigation Group ?? -->
                <Border Background="{DynamicResource GroupBg}" CornerRadius="6" Padding="8,6" Margin="2">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource RibbonBtnGreen}" Command="{Binding RefreshBuildsCommand}"
                                    ToolTip="Scan results root path for build folders">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Style="{StaticResource RibbonIconText}" Text="&#xE72C;" Foreground="{DynamicResource AccGreen}" />
                                    <TextBlock Text="Builds" FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource RibbonBtnAccent}" Command="{Binding BrowseResultsPathCommand}"
                                    ToolTip="Change test results root folder">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Style="{StaticResource RibbonIconText}" Text="&#xE8DA;" Foreground="{DynamicResource Accent}" />
                                    <TextBlock Text="Browse" FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource RibbonBtnGreen}" Command="{Binding LoadBuildResultsCommand}"
                                    ToolTip="Load / reload the selected build">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Style="{StaticResource RibbonIconText}" Text="&#xE896;" Foreground="{DynamicResource AccGreen}" />
                                    <TextBlock Text="Load" FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource RibbonBtnAccent}" Command="{Binding LoadAllBuildsCommand}"
                                    ToolTip="Load ALL discovered builds simultaneously">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Style="{StaticResource RibbonIconText}" Text="&#xE8B7;" Foreground="{DynamicResource Accent}" />
                                    <TextBlock Text="Load All" FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <TextBlock Text="Navigation" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource TextS}"
                                   HorizontalAlignment="Center" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <Border Width="1" Background="{DynamicResource Bdr}" Margin="4,8" />

                <!-- ?? Threshold Group ?? -->
                <Border Background="{DynamicResource GroupBg}" CornerRadius="6" Padding="8,6" Margin="2">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Good:" FontSize="10" Foreground="#10B981" VerticalAlignment="Center" Margin="2,0,3,0" />
                            <TextBox Text="{Binding GoodThreshold, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource Fld}" Width="42" Margin="0" FontSize="11" VerticalAlignment="Center" />
                            <TextBlock Text="%" FontSize="10" Foreground="{DynamicResource TextS}" VerticalAlignment="Center" Margin="1,0,8,0" />
                            <TextBlock Text="Warn:" FontSize="10" Foreground="#F59E0B" VerticalAlignment="Center" Margin="0,0,3,0" />
                            <TextBox Text="{Binding WarningThreshold, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource Fld}" Width="42" Margin="0" FontSize="11" VerticalAlignment="Center" />
                            <TextBlock Text="%" FontSize="10" Foreground="{DynamicResource TextS}" VerticalAlignment="Center" Margin="1,0,4,0" />
                            <Button Content="Apply" Style="{StaticResource SmBtn}" Command="{Binding ApplyThresholdsCommand}"
                                    FontSize="10" Padding="6,3" Margin="2,0" />
                        </StackPanel>
                        <TextBlock Text="Thresholds" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource TextS}"
                                   HorizontalAlignment="Center" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <Border Width="1" Background="{DynamicResource Bdr}" Margin="4,8" />

                <!-- ?? Export Group ?? -->
                <Border Background="{DynamicResource GroupBg}" CornerRadius="6" Padding="8,6" Margin="2">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource RibbonBtnAccent}" Command="{Binding ExportToCsvCommand}"
                                    ToolTip="Export results to CSV">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Style="{StaticResource RibbonIconText}" Text="&#xE898;" Foreground="{DynamicResource Accent}" />
                                    <TextBlock Text="CSV" FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource RibbonBtnAccent}" Command="{Binding ExportToHtmlCommand}"
                                    ToolTip="Export results to HTML report">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Style="{StaticResource RibbonIconText}" Text="&#xE774;" Foreground="{DynamicResource Accent}" />
                                    <TextBlock Text="HTML" FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource RibbonBtnMauve}" Command="{Binding SendReportCommand}"
                                    ToolTip="Send HTML report via email">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Style="{StaticResource RibbonIconText}" Text="&#xE715;" Foreground="{DynamicResource AccMauve}" />
                                    <TextBlock Text="Send" FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource RibbonBtnDanger}" Command="{Binding CopyFailedTestsCommand}"
                                    ToolTip="Copy failed test names to clipboard">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Style="{StaticResource RibbonIconText}" Text="&#xE8C8;" Foreground="{DynamicResource AccRed}" />
                                    <TextBlock Text="Copy Fail" FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource RibbonBtnMauve}" Command="{Binding GenerateTrendReportCommand}"
                                    ToolTip="Generate weekly/monthly trend report with charts">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Style="{StaticResource RibbonIconText}" Text="&#xE9D9;" Foreground="{DynamicResource AccMauve}" />
                                    <TextBlock Text="Trends" FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource RibbonBtnDanger}" Command="{Binding DetectConsecutiveFailuresCommand}"
                                    ToolTip="Scan for tests failing across consecutive builds">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Style="{StaticResource RibbonIconText}" Text="&#xE7BA;" Foreground="{DynamicResource AccRed}" />
                                    <TextBlock Text="Alerts" FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource RibbonBtnYellow}" Command="{Binding LoadFlakyTestsCommand}"
                                    ToolTip="Detect tests that fail intermittently (flaky)">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Style="{StaticResource RibbonIconText}" Text="&#xE783;" Foreground="{DynamicResource AccYellow}" />
                                    <TextBlock Text="Flaky" FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource RibbonBtnMauve}" Command="{Binding LoadUseCaseTrendsCommand}"
                                    ToolTip="Per-UseCase pass rate trends across builds">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Style="{StaticResource RibbonIconText}" Text="&#xE8A1;" Foreground="{DynamicResource AccMauve}" />
                                    <TextBlock Text="UC Trends" FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <TextBlock Text="Export &amp; Analysis" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource Accent}"
                                   HorizontalAlignment="Center" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <Border Width="1" Background="{DynamicResource Bdr}" Margin="4,8" />

                <!-- ?? Statistics Group ?? -->
                <Border Background="{DynamicResource GroupBg}" CornerRadius="6" Padding="8,6" Margin="2"
                        x:Name="StatisticsGroup">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border CornerRadius="4" Padding="10,4" Margin="2"
                                    Background="{Binding PassRatePercent, Converter={StaticResource PassRateConv}}">
                                <TextBlock FontSize="13" FontWeight="Bold" Foreground="#FFFFFF">
                                    <Run Text="{Binding PassRatePercent, StringFormat='{}{0:F1}%', Mode=OneWay}" />
                                    <Run Text=" " />
                                    <Run Text="{Binding HealthLabel, Mode=OneWay}" />
                                </TextBlock>
                            </Border>
                            <Border Width="1" Background="{DynamicResource Bdr}" Margin="6,4" />
                            <TextBlock FontSize="11" Foreground="{DynamicResource TextP}" VerticalAlignment="Center" Margin="4,0">
                                <Run Text="Total: " Foreground="{DynamicResource TextS}" />
                                <Run Text="{Binding StatTotal, Mode=OneWay}" FontWeight="Bold" Foreground="#60A5FA" />
                                <Run Text="  Pass: " Foreground="{DynamicResource TextS}" />
                                <Run Text="{Binding StatPassed, Mode=OneWay}" FontWeight="Bold" Foreground="#10B981" />
                                <Run Text="  Fail: " Foreground="{DynamicResource TextS}" />
                                <Run Text="{Binding StatFailed, Mode=OneWay}" FontWeight="Bold" Foreground="#EF4444" />
                            </TextBlock>
                        </StackPanel>
                        <TextBlock Text="Statistics" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource TextS}"
                                   HorizontalAlignment="Center" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
            </WrapPanel>
        </Border>

        <!-- ??????????????????????????????????????????????????????????? -->
        <!-- STATUS BAR                                                -->
        <!-- ??????????????????????????????????????????????????????????? -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource BgPanel}" Padding="10,6"
                BorderBrush="{DynamicResource Bdr}" BorderThickness="0,1,0,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding AlertStatusText}" FontSize="11"
                           Foreground="#F59E0B" FontWeight="SemiBold" Margin="12,0,0,0" VerticalAlignment="Center" />
                <TextBlock Text="{Binding StatusMessage}" FontSize="11" FontFamily="Consolas"
                           Foreground="{DynamicResource TextS}" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>

        <!-- ??????????????????????????????????????????????????????????? -->
        <!-- MAIN CONTENT                                              -->
        <!-- ??????????????????????????????????????????????????????????? -->
        <Grid>
            <!-- Loading overlay -->
            <Border Background="#CC0F1629" Panel.ZIndex="10"
                    Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="28"
                               Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" FontWeight="Bold">
                        <TextBlock.RenderTransform>
                            <RotateTransform Angle="0" CenterX="14" CenterY="14" />
                        </TextBlock.RenderTransform>
                        <TextBlock.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                         From="0" To="360" Duration="0:0:1.5" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </TextBlock.Triggers>
                    </TextBlock>
                    <TextBlock Text="Parsing .trx files..." FontSize="12" Foreground="{DynamicResource Accent}"
                               HorizontalAlignment="Center" Margin="0,6,0,0" />
                </StackPanel>
            </Border>

            <DockPanel>
                <!-- ??? BUILD SELECTOR ??? -->
                <Border DockPanel.Dock="Top" Background="{DynamicResource BgCard}" Padding="10,8" Margin="8,8,8,0"
                        CornerRadius="6">
                    <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Path:" FontSize="11" Foreground="{DynamicResource TextS}"
                                   VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Text="{Binding ResultsRootPath, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource Fld}" Width="280" Margin="0,0,6,0"
                                 FontFamily="Consolas" FontSize="11" VerticalAlignment="Center" />
                        <TextBlock Text="Build:" FontSize="11" Foreground="{DynamicResource TextS}"
                                   VerticalAlignment="Center" Margin="8,0,6,0" />
                        <ComboBox ItemsSource="{Binding AvailableBuilds}" SelectedItem="{Binding SelectedBuild}"
                                  Width="320" Margin="0,0,8,0"
                                  Background="{DynamicResource BgCard}" Foreground="{DynamicResource TextP}"
                                  BorderBrush="{DynamicResource Bdr}" Padding="6,4" />
                    </WrapPanel>
                </Border>

                <!-- ??? ANALYSIS TABS (replaces 3 stacked panels) ??? -->
                <Border DockPanel.Dock="Bottom" Background="{DynamicResource BgPanel}" CornerRadius="6"
                        BorderBrush="{DynamicResource Bdr}" BorderThickness="1"
                        Margin="8,0,8,8" MinHeight="200">
                    <TabControl Background="Transparent" BorderThickness="0" Padding="0">
                        <TabControl.Resources>
                            <Style TargetType="TabItem">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Foreground" Value="{DynamicResource TextS}" />
                                <Setter Property="Padding" Value="12,6" />
                                <Setter Property="FontSize" Value="11" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="TabItem">
                                            <Border x:Name="TabBd" Background="{TemplateBinding Background}"
                                                    Padding="{TemplateBinding Padding}"
                                                    BorderThickness="0,0,0,2" BorderBrush="Transparent"
                                                    Cursor="Hand">
                                                <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="TabBd" Property="BorderBrush" Value="{DynamicResource Accent}" />
                                                    <Setter Property="Foreground" Value="{DynamicResource TextP}" />
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="TabBd" Property="Background" Value="{DynamicResource TabHoverBg}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </TabControl.Resources>

                        <!-- TAB 1: Per-UseCase Trends -->
                        <TabItem>
                            <TabItem.Header>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="UC Trends" />
                                    <TextBlock Text="{Binding UseCaseTrends.Count, StringFormat=' ({0})'}"
                                               Foreground="{DynamicResource TextS}" FontSize="10"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </TabItem.Header>
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,8,8,4">
                                    <TextBlock Text="Range:" FontSize="10" Foreground="{DynamicResource TextS}"
                                               VerticalAlignment="Center" Margin="0,0,4,0" />
                                    <Button Content="5" Style="{StaticResource SmBtn}" FontSize="9" Padding="6,2" Margin="1"
                                            Command="{Binding SetTrendRange5Command}" ToolTip="Last 5 builds" />
                                    <Button Content="10" Style="{StaticResource SmBtn}" FontSize="9" Padding="6,2" Margin="1"
                                            Command="{Binding SetTrendRange10Command}" ToolTip="Last 10 builds" />
                                    <Button Content="20" Style="{StaticResource SmBtn}" FontSize="9" Padding="6,2" Margin="1"
                                            Command="{Binding SetTrendRange20Command}" ToolTip="Last 20 builds" />
                                </StackPanel>
                                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8,4">
                                    <ItemsControl ItemsSource="{Binding UseCaseTrends}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#08FFFFFF" CornerRadius="3" Padding="8,4" Margin="0,1">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="30" />
                                                            <ColumnDefinition Width="160" />
                                                            <ColumnDefinition Width="60" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="50" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding TrendIcon}" FontSize="12" FontWeight="Bold"
                                                                   VerticalAlignment="Center" HorizontalAlignment="Center">
                                                            <TextBlock.Foreground>
                                                                <SolidColorBrush Color="{Binding TrendColor, Converter={x:Static vm:StringToColorConverter.Instance}}" />
                                                            </TextBlock.Foreground>
                                                        </TextBlock>
                                                        <TextBlock Grid.Column="1" Text="{Binding UseCaseName}" FontSize="11" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TextP}" VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Grid.Column="2" Text="{Binding LatestPassRateFormatted}" FontSize="11" FontWeight="Bold"
                                                                   VerticalAlignment="Center" HorizontalAlignment="Center">
                                                            <TextBlock.Foreground>
                                                                <SolidColorBrush Color="{Binding TrendColor, Converter={x:Static vm:StringToColorConverter.Instance}}" />
                                                            </TextBlock.Foreground>
                                                        </TextBlock>
                                                        <TextBlock Grid.Column="3" Text="{Binding SparklineText}" FontSize="9" FontFamily="Consolas"
                                                                   Foreground="{DynamicResource TextS}" VerticalAlignment="Center" Margin="8,0,0,0"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Grid.Column="4" FontSize="9" Foreground="{DynamicResource TextS}"
                                                                   VerticalAlignment="Center" HorizontalAlignment="Right">
                                                            <Run Text="{Binding BuildCount, Mode=OneWay}" /><Run Text=" builds" />
                                                        </TextBlock>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </DockPanel>
                        </TabItem>

                        <!-- TAB 2: Flaky Tests -->
                        <TabItem>
                            <TabItem.Header>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Flaky Tests" />
                                    <TextBlock Text="{Binding FlakyTests.Count, StringFormat=' ({0})'}"
                                               Foreground="{DynamicResource AccYellow}" FontSize="10"
                                               FontWeight="Bold" VerticalAlignment="Center" />
                                </StackPanel>
                            </TabItem.Header>
                            <DockPanel>
                                <Border DockPanel.Dock="Top" Background="{DynamicResource InfoBoxBg}"
                                        Padding="8,6" Margin="0,0,0,4">
                                    <TextBlock Text="{Binding FlakyTestSummary}" FontSize="11"
                                               Foreground="{DynamicResource AccYellow}" />
                                </Border>
                                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8,4">
                                    <ItemsControl ItemsSource="{Binding FlakyTests}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border CornerRadius="3" Padding="8,3" Margin="0,1">
                                                    <Border.Background>
                                                        <SolidColorBrush Color="{Binding Classification,
                                                            Converter={x:Static vm:FlakyClassificationColorConverter.Instance}}" Opacity="0.1" />
                                                    </Border.Background>
                                                    <DockPanel>
                                                        <TextBlock DockPanel.Dock="Left" FontSize="10" FontWeight="Bold" Width="85"
                                                                   VerticalAlignment="Center" Margin="0,0,8,0">
                                                            <TextBlock.Foreground>
                                                                <SolidColorBrush Color="{Binding Classification,
                                                                    Converter={x:Static vm:FlakyClassificationColorConverter.Instance}}" />
                                                            </TextBlock.Foreground>
                                                            <Run Text="{Binding Classification, Mode=OneWay}" />
                                                        </TextBlock>
                                                        <TextBlock DockPanel.Dock="Right" FontSize="9" Foreground="{DynamicResource TextS}"
                                                                   VerticalAlignment="Center" Margin="8,0,0,0">
                                                            <Run Text="{Binding FailureCount, Mode=OneWay}" /><Run Text="/" /><Run Text="{Binding TotalRuns, Mode=OneWay}" />
                                                            <Run Text=" (" /><Run Text="{Binding FlakyRate, StringFormat='{}{0:F0}%', Mode=OneWay}" /><Run Text=")" />
                                                        </TextBlock>
                                                        <TextBlock FontSize="11" TextTrimming="CharacterEllipsis"
                                                                   VerticalAlignment="Center" ToolTip="{Binding LastError}">
                                                            <TextBlock.Foreground>
                                                                <SolidColorBrush Color="{Binding Classification,
                                                                    Converter={x:Static vm:FlakyClassificationColorConverter.Instance}}" />
                                                            </TextBlock.Foreground>
                                                            <Run Text="{Binding TestName, Mode=OneWay}" FontWeight="SemiBold" />
                                                            <Run Text=" &#x2014; " Foreground="{DynamicResource TextS}" />
                                                            <Run Text="{Binding UseCaseName, Mode=OneWay}" Foreground="{DynamicResource TextS}" FontSize="10" />
                                                        </TextBlock>
                                                    </DockPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </DockPanel>
                        </TabItem>

                        <!-- TAB 3: Priority Investigation -->
                        <TabItem>
                            <TabItem.Header>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Priority" />
                                    <TextBlock Text="{Binding FailureAlerts.Count, StringFormat=' ({0})'}"
                                               Foreground="{DynamicResource AccRed}" FontSize="10"
                                               FontWeight="Bold" VerticalAlignment="Center" />
                                </StackPanel>
                            </TabItem.Header>
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,8,8,4">
                                    <TextBlock FontSize="11" FontWeight="Bold" Foreground="#EF4444"
                                               VerticalAlignment="Center" Margin="0,0,12,0">
                                        <Run Text="{Binding FailureAlerts.Count, Mode=OneWay}" />
                                        <Run Text=" tests failing consecutively" />
                                    </TextBlock>
                                    <Button Content="Send QA Alert" Style="{StaticResource SmBtn}" Command="{Binding SendQaAlertCommand}"
                                            Background="#EF4444" Foreground="#FFFFFF" FontSize="10" Padding="8,3" Margin="0,0,4,0" />
                                    <Button Content="Copy Alerts" Style="{StaticResource SmBtn}" Command="{Binding CopyAlertListCommand}"
                                            Background="{DynamicResource AccentBtnBg}" Foreground="{DynamicResource Accent}" FontSize="10" Padding="8,3" />
                                </StackPanel>
                                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8,4">
                                            <ItemsControl ItemsSource="{Binding FailureAlerts}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#10EF4444" CornerRadius="3" Padding="8,3" Margin="0,1">
                                                    <DockPanel>
                                                        <TextBlock DockPanel.Dock="Left" FontSize="10" FontWeight="Bold" Width="65" VerticalAlignment="Center"
                                                                   Margin="0,0,8,0">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="#F59E0B" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Priority}" Value="CRITICAL">
                                                                            <Setter Property="Foreground" Value="#EF4444" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Priority}" Value="HIGH">
                                                                            <Setter Property="Foreground" Value="#EA580C" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                            <Run Text="{Binding Priority, Mode=OneWay}" />
                                                        </TextBlock>
                                                        <TextBlock DockPanel.Dock="Right" FontSize="9" Foreground="{DynamicResource TextS}"
                                                                   VerticalAlignment="Center" Margin="8,0,0,0">
                                                            <Run Text="{Binding ConsecutiveFailCount, Mode=OneWay}" />
                                                            <Run Text=" builds" />
                                                        </TextBlock>
                                                        <Button DockPanel.Dock="Right" Content="Analyze ?"
                                                                ToolTip="Run failure pattern analysis across recent builds"
                                                                Command="{Binding DataContext.AnalyzeFailurePatternCommand,
                                                                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                CommandParameter="{Binding TestName}"
                                                                Background="#1E293B" Foreground="#60A5FA" BorderBrush="#334155"
                                                                FontSize="10" FontWeight="SemiBold" Padding="6,2" Margin="6,0,0,0"
                                                                Cursor="Hand" />
                                                        <TextBlock FontSize="11" Foreground="#EF4444" TextTrimming="CharacterEllipsis"
                                                                   VerticalAlignment="Center" ToolTip="{Binding LastError}">
                                                            <Run Text="{Binding TestName, Mode=OneWay}" FontWeight="SemiBold" />
                                                            <Run Text=" &#x2014; " Foreground="{DynamicResource TextS}" />
                                                            <Run Text="{Binding UseCaseName, Mode=OneWay}" Foreground="{DynamicResource TextS}" FontSize="10" />
                                                        </TextBlock>
                                                    </DockPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </DockPanel>
                        </TabItem>

                    </TabControl>
                </Border>

                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" MinWidth="400" />
                        <ColumnDefinition Width="5" />
                        <ColumnDefinition Width="*" MinWidth="250" />
                    </Grid.ColumnDefinitions>

                    <!-- ??????????????????????????????????????????????????? -->
                    <!-- LEFT: FLAT LISTVIEW GRID (proper column alignment) -->
                    <!-- ??????????????????????????????????????????????????? -->
                    <Border Grid.Column="0" Background="{DynamicResource BgCard}" CornerRadius="6" Padding="0">
                        <ListView ItemsSource="{Binding FlatResultsList}"
                                  SelectedItem="{Binding SelectedResultNode}"
                                  Background="Transparent" BorderThickness="0"
                                  Foreground="{DynamicResource TextP}"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  VirtualizingStackPanel.IsVirtualizing="True">
                            <ListView.Resources>
                                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#2289B4FA" />
                                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#1189B4FA" />
                            </ListView.Resources>
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Foreground" Value="{DynamicResource TextP}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource Bdr}" />
                                    <Setter Property="BorderThickness" Value="0,0,0,0.5" />
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#08FFFFFF" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.View>
                                <GridView>
                                    <GridView.ColumnHeaderContainerStyle>
                                        <Style TargetType="GridViewColumnHeader">
                                            <Setter Property="Background" Value="{DynamicResource BgPanel}" />
                                            <Setter Property="Foreground" Value="{DynamicResource TextS}" />
                                            <Setter Property="FontSize" Value="10" />
                                            <Setter Property="FontWeight" Value="Bold" />
                                            <Setter Property="Padding" Value="6,6" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource Bdr}" />
                                            <Setter Property="BorderThickness" Value="0,0,0,1" />
                                        </Style>
                                    </GridView.ColumnHeaderContainerStyle>

                                    <!-- NAME column -->
                                    <GridViewColumn Header="NAME" Width="300">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate DataType="{x:Type vm:ResultsFlatNode}">
                                                <StackPanel Orientation="Horizontal" Margin="{Binding IndentMargin}">
                                                    <!-- Expand/collapse toggle -->
                                                    <Button Content="{Binding ExpandIcon}" Command="{Binding ToggleExpandCommand}"
                                                            FontSize="10" Padding="2,0" Margin="0,0,4,0" MinWidth="14"
                                                            Background="Transparent" BorderThickness="0" Cursor="Hand"
                                                            Foreground="{DynamicResource TextS}">
                                                        <Button.Style>
                                                            <Style TargetType="Button">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding CanExpand}" Value="False">
                                                                        <Setter Property="Visibility" Value="Hidden" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>
                                                    <!-- Outcome icon for test results -->
                                                    <TextBlock FontSize="11" FontWeight="Bold" Margin="0,0,4,0" VerticalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding NodeLevel}" Value="TestResult">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                        <Setter Property="Text" Value="{Binding OutcomeIcon}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                        <TextBlock.Foreground>
                                                            <SolidColorBrush Color="{Binding PassRateColor, Converter={x:Static vm:StringToColorConverter.Instance}, FallbackValue=Gray}" />
                                                        </TextBlock.Foreground>
                                                    </TextBlock>
                                                    <!-- Name text -->
                                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="FontSize" Value="11.5" />
                                                                <Setter Property="Foreground" Value="{DynamicResource TextP}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding NodeLevel}" Value="AllBuilds">
                                                                        <Setter Property="FontWeight" Value="Bold" />
                                                                        <Setter Property="FontSize" Value="12.5" />
                                                                        <Setter Property="Foreground" Value="#60A5FA" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding NodeLevel}" Value="Build">
                                                                        <Setter Property="FontWeight" Value="Bold" />
                                                                        <Setter Property="FontSize" Value="12" />
                                                                        <Setter Property="Foreground" Value="#60A5FA" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Outcome}" Value="Failed">
                                                                        <Setter Property="Foreground" Value="#EF4444" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Outcome}" Value="Passed">
                                                                        <Setter Property="Foreground" Value="#10B981" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>

                                    <!-- TOTAL column -->
                                    <GridViewColumn Header="TOTAL" Width="60">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate DataType="{x:Type vm:ResultsFlatNode}">
                                                <TextBlock Text="{Binding Total}" FontSize="11" HorizontalAlignment="Center"
                                                           Foreground="{DynamicResource TextP}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding ShowStats}" Value="False">
                                                                    <Setter Property="Visibility" Value="Hidden" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>

                                    <!-- PASSED column -->
                                    <GridViewColumn Header="PASSED" Width="65">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate DataType="{x:Type vm:ResultsFlatNode}">
                                                <TextBlock Text="{Binding Passed}" FontSize="11" HorizontalAlignment="Center"
                                                           Foreground="#10B981">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding ShowStats}" Value="False">
                                                                    <Setter Property="Visibility" Value="Hidden" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>

                                    <!-- FAILED column -->
                                    <GridViewColumn Header="FAILED" Width="65">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate DataType="{x:Type vm:ResultsFlatNode}">
                                                <TextBlock FontSize="11" HorizontalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource TextP}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding ShowStats}" Value="False">
                                                                    <Setter Property="Visibility" Value="Hidden" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Failed, Converter={x:Static vm:GreaterThanZeroConverter.Instance}}" Value="True">
                                                                    <Setter Property="Foreground" Value="#EF4444" />
                                                                    <Setter Property="FontWeight" Value="Bold" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                    <Run Text="{Binding Failed, Mode=OneWay}" />
                                                </TextBlock>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>

                                    <!-- NOT EXE column -->
                                    <GridViewColumn Header="NOT EXE" Width="65">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate DataType="{x:Type vm:ResultsFlatNode}">
                                                <TextBlock Text="{Binding NotExecuted}" FontSize="11" HorizontalAlignment="Center"
                                                           Foreground="{DynamicResource TextS}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding ShowStats}" Value="False">
                                                                    <Setter Property="Visibility" Value="Hidden" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>

                                    <!-- RATE column -->
                                    <GridViewColumn Header="RATE" Width="80">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate DataType="{x:Type vm:ResultsFlatNode}">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <StackPanel.Style>
                                                        <Style TargetType="StackPanel">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding ShowStats}" Value="False">
                                                                    <Setter Property="Visibility" Value="Hidden" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </StackPanel.Style>
                                                    <Ellipse Width="8" Height="8" Margin="0,0,4,0" VerticalAlignment="Center">
                                                        <Ellipse.Fill>
                                                            <SolidColorBrush Color="{Binding PassRateColor, Converter={x:Static vm:StringToColorConverter.Instance}}" />
                                                        </Ellipse.Fill>
                                                    </Ellipse>
                                                    <TextBlock Text="{Binding PassRateFormatted}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center">
                                                        <TextBlock.Foreground>
                                                            <SolidColorBrush Color="{Binding PassRateColor, Converter={x:Static vm:StringToColorConverter.Instance}}" />
                                                        </TextBlock.Foreground>
                                                    </TextBlock>
                                                </StackPanel>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>

                                    <!-- EXPORT column -->
                                    <GridViewColumn Header="EXPORT" Width="70">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate DataType="{x:Type vm:ResultsFlatNode}">
                                                <StackPanel Orientation="Horizontal"
                                                            Visibility="{Binding ShowExportButtons, Converter={StaticResource BoolVis}}">
                                                    <Button Content="&#x1F4CA;" ToolTip="Export HTML Report"
                                                            Command="{Binding ExportHtmlCommand}"
                                                            Style="{StaticResource InlineExportBtn}"
                                                            FontFamily="Segoe UI Emoji"
                                                            Foreground="{DynamicResource Accent}" />
                                                    <Button Content="&#x1F4C4;" ToolTip="Export CSV"
                                                            Command="{Binding ExportCsvCommand}"
                                                            Style="{StaticResource InlineExportBtn}"
                                                            FontFamily="Segoe UI Emoji"
                                                            Foreground="{DynamicResource AccGreen}" Margin="4,0,0,0" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>

                                    <!-- EMAIL column -->
                                    <GridViewColumn Header="&#x2709;" Width="40">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate DataType="{x:Type vm:ResultsFlatNode}">
                                                <Button Style="{StaticResource InlineExportBtn}"
                                                        Command="{Binding SendEmailCommand}"
                                                        ToolTip="Send report via email"
                                                        Foreground="{DynamicResource AccMauve}"
                                                        Visibility="{Binding ShowEmailButton, Converter={StaticResource BoolVis}}">
                                                    <TextBlock Text="&#xE715;" FontFamily="Segoe MDL2 Assets" FontSize="14" />
                                                </Button>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </Border>

                    <!-- SPLITTER -->
                    <GridSplitter Grid.Column="1" Width="5"
                                  Background="{DynamicResource BgSurface}"
                                  HorizontalAlignment="Stretch" />

                    <!-- ??????????????????????????????????????????????????? -->
                    <!-- RIGHT: DETAIL PANEL                                -->
                    <!-- ??????????????????????????????????????????????????? -->
                    <Border Grid.Column="2" Background="{DynamicResource BgCard}" CornerRadius="6" Padding="0">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" Background="{DynamicResource BgPanel}" Padding="12,8" CornerRadius="6,6,0,0">
                                <TextBlock Text="Detail" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource Accent}" />
                            </Border>

                            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12,8">
                                <Grid>
                                    <!-- Detail content (visible when something is selected) -->
                                    <StackPanel Visibility="{Binding HasDetailSelected, Converter={StaticResource BoolVis}}">

                                        <!-- Test / Node Name -->
                                        <TextBlock Text="{Binding DetailTestName}" FontSize="15" FontWeight="Bold"
                                                   Foreground="{DynamicResource TextP}" TextWrapping="Wrap" Margin="0,0,0,8" />

                                        <!-- Metadata badges row -->
                                        <WrapPanel Margin="0,0,0,12">
                                            <Border CornerRadius="3" Padding="6,2" Margin="0,2,6,2">
                                                <Border.Background>
                                                    <SolidColorBrush Color="{Binding DetailOutcomeColor, Converter={x:Static vm:StringToColorConverter.Instance}}" />
                                                </Border.Background>
                                                <TextBlock Text="{Binding DetailOutcome}" FontSize="11" FontWeight="Bold" Foreground="White" />
                                            </Border>
                                            <TextBlock FontSize="11" Foreground="{DynamicResource TextS}" VerticalAlignment="Center">
                                                <Run Text="{Binding DetailUseCaseName, Mode=OneWay}" />
                                                <Run Text=" &#x00B7; " />
                                                <Run Text="{Binding DetailBuildNumber, Mode=OneWay}" />
                                            </TextBlock>
                                        </WrapPanel>

                                        <!-- Duration -->
                                        <TextBlock FontSize="10" Foreground="{DynamicResource TextS}" Margin="0,0,0,12"
                                                   Visibility="{Binding DetailDuration, Converter={x:Static vm:StringNotEmptyToVisConverter.Instance}}">
                                            <Run Text="Duration: " FontWeight="SemiBold" />
                                            <Run Text="{Binding DetailDuration, Mode=OneWay}" FontFamily="Consolas" />
                                        </TextBlock>

                                        <!-- Error Message -->
                                        <TextBlock Text="ERROR MESSAGE" FontSize="10" FontWeight="Bold"
                                                   Foreground="{DynamicResource TextS}" Margin="0,0,0,4" />
                                        <Border Background="#10FFFFFF" CornerRadius="4" Padding="10,8" Margin="0,0,0,12">
                                            <TextBox Text="{Binding DetailErrorMessage, Mode=OneWay}"
                                                     IsReadOnly="True" TextWrapping="Wrap"
                                                     Background="Transparent" BorderThickness="0"
                                                     Foreground="#EF4444" FontFamily="Consolas" FontSize="11"
                                                     MaxHeight="150" VerticalScrollBarVisibility="Auto" />
                                        </Border>

                                        <!-- Stack Trace -->
                                        <TextBlock Text="STACK TRACE" FontSize="10" FontWeight="Bold"
                                                   Foreground="{DynamicResource TextS}" Margin="0,0,0,4" />
                                        <Border Background="#10FFFFFF" CornerRadius="4" Padding="10,8" Margin="0,0,0,12">
                                            <TextBox Text="{Binding DetailStackTrace, Mode=OneWay}"
                                                     IsReadOnly="True" TextWrapping="Wrap"
                                                     Background="Transparent" BorderThickness="0"
                                                     Foreground="{DynamicResource TextS}" FontFamily="Consolas" FontSize="10"
                                                     MaxHeight="200" VerticalScrollBarVisibility="Auto" />
                                        </Border>

                                        <!-- Stdout -->
                                        <TextBlock Text="STDOUT" FontSize="10" FontWeight="Bold"
                                                   Foreground="{DynamicResource TextS}" Margin="0,0,0,4" />
                                        <Border Background="#10FFFFFF" CornerRadius="4" Padding="10,8" Margin="0,0,0,12">
                                            <TextBox Text="{Binding DetailStdOut, Mode=OneWay}"
                                                     IsReadOnly="True" TextWrapping="Wrap"
                                                     Background="Transparent" BorderThickness="0"
                                                     Foreground="{DynamicResource TextP}" FontFamily="Consolas" FontSize="10"
                                                     MaxHeight="200" VerticalScrollBarVisibility="Auto" />
                                        </Border>

                                        <!-- Debug Trace -->
                                        <TextBlock Text="DEBUG TRACE" FontSize="10" FontWeight="Bold"
                                                   Foreground="{DynamicResource AccMauve}" Margin="0,0,0,4" />
                                        <Border Background="{DynamicResource InfoBoxBg}" CornerRadius="4" Padding="10,8" Margin="0,0,0,12">
                                            <TextBox Text="{Binding DetailDebugTrace, Mode=OneWay}"
                                                     IsReadOnly="True" TextWrapping="Wrap"
                                                     Background="Transparent" BorderThickness="0"
                                                     Foreground="{DynamicResource TextP}" FontFamily="Consolas" FontSize="10"
                                                     MaxHeight="200" VerticalScrollBarVisibility="Auto" />
                                        </Border>

                                        <!-- Execution Steps (from TRX InnerResults) -->
                                        <TextBlock Text="EXECUTION STEPS" FontSize="10" FontWeight="Bold"
                                                   Foreground="{DynamicResource TextS}" Margin="0,0,0,4"
                                                   Visibility="{Binding HasExecutionSteps, Converter={StaticResource BoolVis}}" />
                                        <ItemsControl ItemsSource="{Binding DetailExecutionSteps}"
                                                      Margin="0,0,0,12"
                                                      Visibility="{Binding HasExecutionSteps, Converter={StaticResource BoolVis}}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Padding="6,3" Margin="0,1" CornerRadius="3"
                                                            Background="#08FFFFFF">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="18" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0"
                                                                       Text="{Binding OutcomeIcon}"
                                                                       FontSize="10" VerticalAlignment="Center" />
                                                            <TextBlock Grid.Column="1" Text="{Binding StepName}"
                                                                       FontSize="10.5" FontFamily="Consolas"
                                                                       Foreground="{DynamicResource TextP}"
                                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Grid.Column="2" Text="{Binding DurationText}"
                                                                       FontSize="9" FontFamily="Consolas"
                                                                       Foreground="{DynamicResource TextS}"
                                                                       VerticalAlignment="Center" Margin="8,0,0,0" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- TRX File link -->
                                        <TextBlock Text="TRX FILE" FontSize="10" FontWeight="Bold"
                                                   Foreground="{DynamicResource TextS}" Margin="0,0,0,4" />
                                        <DockPanel Margin="0,0,0,8">
                                            <Button Content="Open in Edge" DockPanel.Dock="Right"
                                                    Command="{Binding OpenTrxInExplorerCommand}"
                                                    Style="{StaticResource SmBtn}" Padding="8,3" />
                                            <TextBlock Text="{Binding DetailTrxFileName}" FontFamily="Consolas" FontSize="11"
                                                       Foreground="{DynamicResource Accent}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        </DockPanel>
                                    </StackPanel>

                                    <!-- Empty state -->
                                    <TextBlock Text="Select a test case to view details"
                                               FontSize="12" Foreground="{DynamicResource TextS}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Margin="0,40,0,0"
                                               Visibility="{Binding HasDetailSelected, Converter={StaticResource InvBoolVis}}" />
                                </Grid>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </Grid>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
