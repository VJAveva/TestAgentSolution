<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!--
        Typography.xaml
        
        Centralized font families, sizes, and reusable text styles.
        All text elements should reference these styles for consistency.
    -->

    <!-- ═══ Font Families ═══ -->
    <FontFamily x:Key="FontUI">Segoe UI</FontFamily>
    <FontFamily x:Key="FontMono">Consolas</FontFamily>
    <FontFamily x:Key="FontIcon">Segoe MDL2 Assets</FontFamily>

    <!-- ═══ Font Size Scale ═══ -->
    <!-- Small end nudged up +1 for readability (labels/captions were too small). -->
    <sys:Double x:Key="FontSize9">10</sys:Double>
    <sys:Double x:Key="FontSize10">11</sys:Double>
    <sys:Double x:Key="FontSize11">12</sys:Double>
    <sys:Double x:Key="FontSize12">13</sys:Double>
    <sys:Double x:Key="FontSize13">13</sys:Double>
    <sys:Double x:Key="FontSize14">14</sys:Double>
    <sys:Double x:Key="FontSize16">16</sys:Double>
    <sys:Double x:Key="FontSize20">20</sys:Double>
    <sys:Double x:Key="FontSize24">24</sys:Double>

    <!-- ═══ Text Styles ═══ -->

    <!-- Headings -->
    <Style x:Key="TextH1" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontUI}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize20}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource TextP}" />
    </Style>

    <Style x:Key="TextH2" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontUI}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize16}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource TextP}" />
    </Style>

    <Style x:Key="TextH3" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontUI}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize14}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource TextP}" />
    </Style>

    <Style x:Key="TextH4" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontUI}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize13}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextP}" />
    </Style>

    <!-- Body text -->
    <Style x:Key="TextBody" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontUI}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize12}" />
        <Setter Property="Foreground" Value="{DynamicResource TextP}" />
    </Style>

    <Style x:Key="TextBodySmall" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontUI}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize11}" />
        <Setter Property="Foreground" Value="{DynamicResource TextP}" />
    </Style>

    <!-- Secondary/muted text -->
    <Style x:Key="TextSecondaryStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontUI}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize11}" />
        <Setter Property="Foreground" Value="{DynamicResource TextS}" />
    </Style>

    <Style x:Key="TextCaption" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontUI}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize10}" />
        <Setter Property="Foreground" Value="{DynamicResource TextS}" />
    </Style>

    <Style x:Key="TextMicro" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontUI}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize9}" />
        <Setter Property="Foreground" Value="{DynamicResource TextS}" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <!-- Monospace -->
    <Style x:Key="TextMono" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontMono}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize11}" />
        <Setter Property="Foreground" Value="{DynamicResource TextP}" />
    </Style>

    <Style x:Key="TextMonoSmall" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontMono}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize10}" />
        <Setter Property="Foreground" Value="{DynamicResource TextS}" />
    </Style>

    <!-- Accent text -->
    <Style x:Key="TextAccent" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontUI}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize12}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Accent}" />
    </Style>

    <!-- Panel header -->
    <Style x:Key="TextPanelHeader" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontUI}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize13}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Section label (uppercase labels in property panels) -->
    <Style x:Key="TextSectionLabel" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontUI}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize12}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource Accent}" />
        <Setter Property="Margin" Value="0,10,0,4" />
    </Style>

    <!-- Badge text -->
    <Style x:Key="TextBadge" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontUI}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize10}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Status text -->
    <Style x:Key="TextStatus" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontUI}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize11}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Ribbon group label -->
    <Style x:Key="TextRibbonGroup" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontUI}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize9}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource TextS}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,4,0,0" />
    </Style>

</ResourceDictionary>
