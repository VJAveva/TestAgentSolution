<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!--
        SpecTokens.xaml

        Re-exposes the Execution Dashboard spec's design tokens (Section 4
        of the original net8.0 spec) as resources keyed exactly per spec
        (i.e. all brushes use the "Brush" suffix). Existing color brushes
        declared in ExecutionDashboardStyles.xaml are kept intact; this
        dictionary is purely additive so new templates that target the
        spec's keys can resolve them while the legacy XAML keeps working.

        Merge order matters: this file must be merged AFTER
        ExecutionDashboardStyles.xaml so x:Static-style references stay
        deterministic, but it does not redefine any existing keys.
    -->

    <!-- ?? Build Report Card palette ????????????????????????????????????
         The report-card surface/semantic colour brushes (BgCanvasBrush,
         BgPrimaryBrush, BgSecondaryBrush, BgChipBrush, BorderTertiaryBrush,
         the Border/Bg/Text Info/Success/Danger/Warning brushes, TextTertiaryBrush
         and the RcHeroBrush) are now defined per-theme in the theme dictionaries
         (DarkTheme/LightTheme/HighContrastTheme) so the Build Report Card adapts
         to the selected theme. They were removed from this shared token sheet so
         the theme dictionary (merged first) wins for DynamicResource lookups. -->

    <!-- ?? Border radii ?????????????????????????????????????????????????? -->
    <CornerRadius x:Key="RadiusSm">3</CornerRadius>
    <CornerRadius x:Key="RadiusMd">4</CornerRadius>
    <CornerRadius x:Key="RadiusLg">8</CornerRadius>

    <!-- ?? Typography ??????????????????????????????????????????????????? -->
    <FontFamily x:Key="FontSans">Segoe UI</FontFamily>
    <FontFamily x:Key="FontMono">Consolas</FontFamily>

    <sys:Double x:Key="Fs9">9</sys:Double>
    <sys:Double x:Key="Fs10">10</sys:Double>
    <sys:Double x:Key="Fs11">11</sys:Double>
    <sys:Double x:Key="Fs12">12</sys:Double>
    <sys:Double x:Key="Fs13">13</sys:Double>
    <sys:Double x:Key="Fs14">14</sys:Double>
    <sys:Double x:Key="Fs20">20</sys:Double>

    <!-- ?? Pulse animation (running-chip glyph) ?????????????????????????
         Apply via DataTrigger on ActionStatus = Running:
             <DataTrigger.EnterActions>
               <BeginStoryboard Storyboard="{StaticResource PulseAnim}"/>
             </DataTrigger.EnterActions>
         x:Shared="False" lets the same storyboard be applied per-chip
         without WPF complaining about a frozen instance.
         =============================================================== -->
    <Storyboard x:Key="PulseAnim" x:Shared="False" RepeatBehavior="Forever" AutoReverse="True">
        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                         From="1.0" To="0.4" Duration="0:0:0.75"/>
    </Storyboard>

</ResourceDictionary>
