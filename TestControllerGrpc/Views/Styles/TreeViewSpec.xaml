<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mi="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
                    xmlns:vm="clr-namespace:TestControllerGrpc.ViewModels"
                    xmlns:controls="clr-namespace:TestControllerGrpc.Controls"
                    xmlns:conv="clr-namespace:TestControllerGrpc.ViewModels.Converters">

    <!--
        TreeViewSpec.xaml
        Implements the Test Plan tree mockup: pills, Material icons, file pills,
        status dots with pulse animation, and clean row styling.
    -->

    <!-- ═══ Converters ═══ -->
    <BooleanToVisibilityConverter x:Key="BoolVis" />
    <conv:FileNameConverter x:Key="FileNameConv" />
    <conv:StripExecutionModeConverter x:Key="StripModeConv" />
    <conv:ActionLabelConverter x:Key="ActionLabelConv" />
    <conv:ActionFilePillConverter x:Key="ActionFilePillConv" />
    <conv:ActionFilePillTooltipConverter x:Key="ActionFilePillTipConv" />
    <conv:NodeTooltipConverter x:Key="NodeTooltipConv" />
    <conv:HasPathToVisibilityConverter x:Key="HasPathToVis" />
    <conv:NonZeroToVisibilityConverter x:Key="NonZeroVis" />
    <conv:PluralizeActionsConverter x:Key="PluralizeActions" />

    <!-- ═══ Status dot pulse animation (Running) ═══ -->
    <Storyboard x:Key="PulseDotAnimation" RepeatBehavior="Forever" AutoReverse="True">
        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                         From="1.0" To="0.4" Duration="0:0:0.7" />
    </Storyboard>

    <!-- ═══ Spinner rotation animation (Running status indicator) ═══ -->
    <Storyboard x:Key="SpinnerRotation" RepeatBehavior="Forever">
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                         From="0" To="360" Duration="0:0:1.2" />
    </Storyboard>

    <!-- ═══ Pill Style ═══ -->
    <Style x:Key="TreePillStyle" TargetType="Border">
        <Setter Property="Padding" Value="5,1" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="Margin" Value="4,0,0,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="TreePillText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="9.5" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextAlignment" Value="Center" />
    </Style>

    <!-- ═══ File Pill Style ═══ -->
    <Style x:Key="FilePillBorder" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource FilePillBgBrush}" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="Padding" Value="6,1" />
        <Setter Property="Margin" Value="4,0,0,0" />
        <Setter Property="MaxWidth" Value="200" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="FilePillText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Cascadia Code, Consolas, monospace" />
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ═══ Count Badge Style ═══ -->
    <Style x:Key="CountBadgeStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CountBgBrush}" />
        <Setter Property="CornerRadius" Value="9" />
        <Setter Property="Padding" Value="7,1" />
        <Setter Property="Margin" Value="6,0,0,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════════
         WatchTreeTemplate — HierarchicalDataTemplate for TreeNodeViewModel
         Replaces the old inline template in MainWindow.xaml.
         ═══════════════════════════════════════════════════════════════════ -->
    <HierarchicalDataTemplate x:Key="WatchTreeSpecTemplate"
                              DataType="{x:Type vm:TreeNodeViewModel}"
                              ItemsSource="{Binding Children}">
        <Grid Height="26" Margin="0,0,8,0">
            <Grid.ToolTip>
                <MultiBinding Converter="{StaticResource NodeTooltipConv}">
                    <Binding Path="NodeKind" />
                    <Binding Path="ActionTypeText" />
                    <Binding Path="Command" />
                    <Binding Path="Parameters" />
                    <Binding Path="AgentName" />
                    <Binding Path="StatusTooltip" />
                </MultiBinding>
            </Grid.ToolTip>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" /> <!-- Status dot -->
                <ColumnDefinition Width="Auto" /> <!-- Icon -->
                <ColumnDefinition Width="Auto" /> <!-- Label -->
                <ColumnDefinition Width="Auto" /> <!-- Pill(s) -->
                <ColumnDefinition Width="Auto" /> <!-- File pill -->
                <ColumnDefinition Width="Auto" /> <!-- Status spinner -->
                <ColumnDefinition Width="Auto" /> <!-- Lock badge -->
                <ColumnDefinition Width="Auto" /> <!-- Permission pill -->
                <ColumnDefinition Width="*" />    <!-- Spacer -->
                <ColumnDefinition Width="Auto" /> <!-- Count badge -->
            </Grid.ColumnDefinitions>

            <!-- Context menu is built in code-behind (OnWatchListContextMenuOpening) -->

            <!-- ── Column 0: Status Dot (8×8, only on WatchItem/Action nodes) ── -->
            <Ellipse Grid.Column="0" Width="8" Height="8"
                     Margin="0,0,5,0" VerticalAlignment="Center">
                <Ellipse.Style>
                    <Style TargetType="Ellipse">
                        <Setter Property="Fill" Value="{DynamicResource SIdleBrush}" />
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <!-- Show dot only for WatchItem nodes -->
                            <DataTrigger Binding="{Binding NodeKind}" Value="WatchItem">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <!-- Status-based fill -->
                            <DataTrigger Binding="{Binding ExecutionStatus}" Value="Running">
                                <Setter Property="Fill" Value="{DynamicResource SRunningBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding ExecutionStatus}" Value="Success">
                                <Setter Property="Fill" Value="{DynamicResource SPassedBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding ExecutionStatus}" Value="Failed">
                                <Setter Property="Fill" Value="{DynamicResource SFailedBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding ExecutionStatus}" Value="PartialFailure">
                                <Setter Property="Fill" Value="{DynamicResource SFailedBrush}" />
                            </DataTrigger>
                            <!-- Pulse animation for Running -->
                            <DataTrigger Binding="{Binding ExecutionStatus}" Value="Running">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard x:Name="PulseBegin">
                                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                             From="1.0" To="0.4" Duration="0:0:0.7" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <StopStoryboard BeginStoryboardName="PulseBegin" />
                                </DataTrigger.ExitActions>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Ellipse.Style>
            </Ellipse>

            <!-- HC glyph fallback (letter glyph visible only in High Contrast) -->
            <TextBlock Grid.Column="0" FontSize="9" FontWeight="Bold"
                       Foreground="{DynamicResource HcGlyphFg}"
                       VerticalAlignment="Center" Margin="0,0,5,0"
                       IsHitTestVisible="False">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Text" Value="" />
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding NodeKind}" Value="WatchItem">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding ExecutionStatus}" Value="Running">
                                <Setter Property="Text" Value="R" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding ExecutionStatus}" Value="Success">
                                <Setter Property="Text" Value="&#x2713;" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding ExecutionStatus}" Value="Failed">
                                <Setter Property="Text" Value="&#x2717;" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding ExecutionStatus}" Value="PartialFailure">
                                <Setter Property="Text" Value="&#x2717;" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <!-- ── Column 1: Material Icon (13px) ── -->
            <mi:MaterialIcon Grid.Column="1" Width="13" Height="13"
                             Margin="0,0,5,0" VerticalAlignment="Center">
                <mi:MaterialIcon.Style>
                    <Style TargetType="mi:MaterialIcon">
                        <Setter Property="Kind" Value="FileDocument" />
                        <Setter Property="Foreground" Value="{DynamicResource CRunBrush}" />
                        <Style.Triggers>
                            <!-- WatchList (Test Plan root) -->
                            <DataTrigger Binding="{Binding NodeKind}" Value="WatchList">
                                <Setter Property="Kind" Value="ClipboardListOutline" />
                                <Setter Property="Foreground" Value="{DynamicResource CRunBrush}" />
                            </DataTrigger>
                            <!-- WatchItem (Test Item) -->
                            <DataTrigger Binding="{Binding NodeKind}" Value="WatchItem">
                                <Setter Property="Kind" Value="TestTube" />
                                <Setter Property="Foreground" Value="{DynamicResource CRunBrush}" />
                            </DataTrigger>
                            <!-- Event Trigger -->
                            <DataTrigger Binding="{Binding NodeKind}" Value="Event">
                                <Setter Property="Kind" Value="LightningBolt" />
                                <Setter Property="Foreground" Value="{DynamicResource CEventBrush}" />
                            </DataTrigger>
                            <!-- ActionGroup default (SEQ) -->
                            <DataTrigger Binding="{Binding NodeKind}" Value="ActionGroup">
                                <Setter Property="Kind" Value="FormatListNumbered" />
                                <Setter Property="Foreground" Value="{DynamicResource CSeqBrush}" />
                            </DataTrigger>
                            <!-- ActionGroup PAR override: different icon + purple -->
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding NodeKind}" Value="ActionGroup" />
                                    <Condition Binding="{Binding ExecutionTypeText}" Value="Parallel" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Kind" Value="SourceBranch" />
                                <Setter Property="Foreground" Value="{DynamicResource CParBrush}" />
                            </MultiDataTrigger>
                            <!-- Action: Run Local Command -->
                            <DataTrigger Binding="{Binding ActionTypeText}" Value="RunCommand">
                                <Setter Property="Kind" Value="ConsoleLine" />
                                <Setter Property="Foreground" Value="{DynamicResource CRunBrush}" />
                            </DataTrigger>
                            <!-- Action: Run Remote Command -->
                            <DataTrigger Binding="{Binding ActionTypeText}" Value="RunRemoteCommand">
                                <Setter Property="Kind" Value="ServerNetwork" />
                                <Setter Property="Foreground" Value="{DynamicResource CRemoteBrush}" />
                            </DataTrigger>
                            <!-- Action: Send Email -->
                            <DataTrigger Binding="{Binding ActionTypeText}" Value="SendMail">
                                <Setter Property="Kind" Value="EmailOutline" />
                                <Setter Property="Foreground" Value="{DynamicResource CEmailBrush}" />
                            </DataTrigger>
                            <!-- Initialize -->
                            <DataTrigger Binding="{Binding NodeKind}" Value="Initialize">
                                <Setter Property="Kind" Value="CogOutline" />
                                <Setter Property="Foreground" Value="{DynamicResource CInitBrush}" />
                            </DataTrigger>
                            <!-- Reference -->
                            <DataTrigger Binding="{Binding NodeKind}" Value="Ref">
                                <Setter Property="Kind" Value="ArrowULeftTop" />
                                <Setter Property="Foreground" Value="{DynamicResource CRefBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </mi:MaterialIcon.Style>
            </mi:MaterialIcon>

            <!-- ── Column 2: Label ── -->
            <TextBlock Grid.Column="2" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis">
                <TextBlock.Text>
                    <MultiBinding Converter="{StaticResource ActionLabelConv}">
                        <Binding Path="Tag" />
                        <Binding Path="AgentName" />
                        <Binding Path="NodeKind" />
                        <Binding Path="ActionTypeText" />
                        <Binding Path="Command" />
                        <Binding Path="To" />
                        <Binding Path="Title" />
                        <Binding Path="ResolvedDisplayText" Converter="{StaticResource StripModeConv}" />
                    </MultiBinding>
                </TextBlock.Text>
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="FontSize" Value="12.5" />
                        <Setter Property="Foreground" Value="{DynamicResource TextDefaultBrush}" />
                        <Style.Triggers>
                            <!-- Strong label for WatchList/WatchItem -->
                            <DataTrigger Binding="{Binding NodeKind}" Value="WatchList">
                                <Setter Property="Foreground" Value="{DynamicResource TextStrongBrush}" />
                                <Setter Property="FontWeight" Value="Medium" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding NodeKind}" Value="WatchItem">
                                <Setter Property="Foreground" Value="{DynamicResource TextStrongBrush}" />
                                <Setter Property="FontWeight" Value="Medium" />
                            </DataTrigger>
                            <!-- Disabled style -->
                            <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource TextDimBrush}" />
                                <Setter Property="FontStyle" Value="Italic" />
                            </DataTrigger>
                            <!-- Failed highlight -->
                            <DataTrigger Binding="{Binding ExecutionStatus}" Value="Failed">
                                <Setter Property="Foreground" Value="{DynamicResource SFailedBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <!-- ── Column 3: Type Pills ── -->
            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">

                <!-- Event Trigger pill: EVT -->
                <Border>
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource TreePillStyle}">
                            <Setter Property="Background" Value="{DynamicResource PillEvtBg}" />
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding NodeKind}" Value="Event">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="EVT" Style="{StaticResource TreePillText}"
                               Foreground="{DynamicResource CEventBrush}" />
                </Border>

                <!-- Sequential pill: SEQ (only on ActionGroup) -->
                <Border Background="{DynamicResource PillSeqBg}">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource TreePillStyle}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding ExecutionTypeText}" Value="Sequential" />
                                        <Condition Binding="{Binding NodeKind}" Value="ActionGroup" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="SEQ" Style="{StaticResource TreePillText}"
                               Foreground="{DynamicResource CSeqBrush}" />
                </Border>

                <!-- Parallel pill: PAR -->
                <Border Background="{DynamicResource PillParBg}">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource TreePillStyle}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding ExecutionTypeText}" Value="Parallel" />
                                        <Condition Binding="{Binding NodeKind}" Value="ActionGroup" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="PAR" Style="{StaticResource TreePillText}"
                               Foreground="{DynamicResource CParBrush}" />
                </Border>

                <!-- Action type pills: RUN / RMT / EML / INIT / REF -->
                <Border Background="{DynamicResource PillRunBg}">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource TreePillStyle}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding ActionTypeText}" Value="RunCommand" />
                                        <Condition Binding="{Binding NodeKind}" Value="Action" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="RUN" Style="{StaticResource TreePillText}"
                               Foreground="{DynamicResource CRunBrush}" />
                </Border>

                <Border Background="{DynamicResource PillRmtBg}">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource TreePillStyle}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding ActionTypeText}" Value="RunRemoteCommand" />
                                        <Condition Binding="{Binding NodeKind}" Value="Action" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="RMT" Style="{StaticResource TreePillText}"
                               Foreground="{DynamicResource CRemoteBrush}" />
                </Border>

                <Border Background="{DynamicResource PillEmlBg}">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource TreePillStyle}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding ActionTypeText}" Value="SendMail" />
                                        <Condition Binding="{Binding NodeKind}" Value="Action" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="EML" Style="{StaticResource TreePillText}"
                               Foreground="{DynamicResource CEmailBrush}" />
                </Border>

                <Border Background="{DynamicResource PillInitBg}">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource TreePillStyle}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding NodeKind}" Value="Initialize">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="INIT" Style="{StaticResource TreePillText}"
                               Foreground="{DynamicResource CInitBrush}" />
                </Border>

                <Border Background="{DynamicResource PillRefBg}">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource TreePillStyle}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding NodeKind}" Value="Ref">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="REF" Style="{StaticResource TreePillText}"
                               Foreground="{DynamicResource CRefBrush}" />
                </Border>

            </StackPanel>

            <!-- ── Column 4: Script/Subject File Pill (Action nodes only) ── -->
            <Border Grid.Column="4">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource FilePillBorder}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding NodeKind}" Value="Action">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Border.ToolTip>
                    <MultiBinding Converter="{StaticResource ActionFilePillTipConv}">
                        <Binding Path="NodeKind" />
                        <Binding Path="ActionTypeText" />
                        <Binding Path="Command" />
                        <Binding Path="Title" />
                    </MultiBinding>
                </Border.ToolTip>
                <TextBlock Style="{StaticResource FilePillText}">
                    <TextBlock.Text>
                        <MultiBinding Converter="{StaticResource ActionFilePillConv}">
                            <Binding Path="NodeKind" />
                            <Binding Path="ActionTypeText" />
                            <Binding Path="Command" />
                            <Binding Path="Title" />
                        </MultiBinding>
                    </TextBlock.Text>
                </TextBlock>
            </Border>

            <!-- ── Column 5: Status Indicator (spinner for Running, glyphs for terminal) ── -->
            <Grid Grid.Column="5" Width="14" Height="14" Margin="6,0,0,0" VerticalAlignment="Center">
                <!-- Running: spinning icon -->
                <mi:MaterialIcon Kind="Loading" Width="12" Height="12"
                                 Foreground="{DynamicResource SRunningBrush}"
                                 RenderTransformOrigin="0.5,0.5">
                    <mi:MaterialIcon.RenderTransform>
                        <RotateTransform Angle="0" />
                    </mi:MaterialIcon.RenderTransform>
                    <mi:MaterialIcon.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard>
                                <Storyboard RepeatBehavior="Forever">
                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                     From="0" To="360" Duration="0:0:1.2" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </mi:MaterialIcon.Triggers>
                    <mi:MaterialIcon.Style>
                        <Style TargetType="mi:MaterialIcon">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ExecutionStatus}" Value="Running">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </mi:MaterialIcon.Style>
                </mi:MaterialIcon>
                <!-- Success: checkmark -->
                <mi:MaterialIcon Kind="CheckCircleOutline" Width="12" Height="12"
                                 Foreground="{DynamicResource SPassedBrush}">
                    <mi:MaterialIcon.Style>
                        <Style TargetType="mi:MaterialIcon">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ExecutionStatus}" Value="Success">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </mi:MaterialIcon.Style>
                </mi:MaterialIcon>
                <!-- Failed: X circle -->
                <mi:MaterialIcon Kind="CloseCircleOutline" Width="12" Height="12"
                                 Foreground="{DynamicResource SFailedBrush}">
                    <mi:MaterialIcon.Style>
                        <Style TargetType="mi:MaterialIcon">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ExecutionStatus}" Value="Failed">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </mi:MaterialIcon.Style>
                </mi:MaterialIcon>
                <!-- PartialFailure: warning -->
                <mi:MaterialIcon Kind="AlertCircleOutline" Width="12" Height="12"
                                 Foreground="{DynamicResource CEmailBrush}">
                    <mi:MaterialIcon.Style>
                        <Style TargetType="mi:MaterialIcon">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ExecutionStatus}" Value="PartialFailure">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </mi:MaterialIcon.Style>
                </mi:MaterialIcon>
                <!-- Cancelled: blocked -->
                <mi:MaterialIcon Kind="Cancel" Width="12" Height="12"
                                 Foreground="{DynamicResource TextDimBrush}">
                    <mi:MaterialIcon.Style>
                        <Style TargetType="mi:MaterialIcon">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ExecutionStatus}" Value="Cancelled">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </mi:MaterialIcon.Style>
                </mi:MaterialIcon>
            </Grid>

            <!-- ── Column 6: Lock Badge (Phase 3b) ── -->
            <controls:LockBadge Grid.Column="6" DataContext="{Binding LockBadge}"
                                Visibility="{Binding IsVisible, FallbackValue=Collapsed,
                                    Converter={StaticResource BoolVis}}" />

            <!-- ── Column 7: Permission Pill (Phase 2b) ── -->
            <Border Grid.Column="7" Margin="4,0,0,0" Padding="5,1" CornerRadius="3"
                    VerticalAlignment="Center">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <!-- Triggerable: teal "Assigned to you" pill (WatchItem nodes in Secured mode) -->
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding NodeKind}" Value="WatchItem" />
                                    <Condition Binding="{Binding ShowPermissionIndicator}" Value="True" />
                                    <Condition Binding="{Binding PipelinePermission}" Value="{x:Static vm:PipelinePermissionState.Triggerable}" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible" />
                                <Setter Property="Background" Value="{DynamicResource PillAssignedBg}" />
                            </MultiDataTrigger>
                            <!-- ViewOnly: grey "View only" pill (WatchItem nodes in Secured mode) -->
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding NodeKind}" Value="WatchItem" />
                                    <Condition Binding="{Binding ShowPermissionIndicator}" Value="True" />
                                    <Condition Binding="{Binding PipelinePermission}" Value="{x:Static vm:PipelinePermissionState.ViewOnly}" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible" />
                                <Setter Property="Background" Value="{DynamicResource PillViewOnlyBg}" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel Orientation="Horizontal">
                    <!-- Eye icon for ViewOnly -->
                    <mi:MaterialIcon Kind="EyeOutline" Width="10" Height="10" Margin="0,0,3,0"
                                     VerticalAlignment="Center">
                        <mi:MaterialIcon.Style>
                            <Style TargetType="mi:MaterialIcon">
                                <Setter Property="Foreground" Value="{DynamicResource PillViewOnlyFg}" />
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding PipelinePermission}" Value="{x:Static vm:PipelinePermissionState.ViewOnly}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </mi:MaterialIcon.Style>
                    </mi:MaterialIcon>
                    <TextBlock FontSize="10" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="Assigned to you" />
                                <Setter Property="Foreground" Value="{DynamicResource PillAssignedFg}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding PipelinePermission}" Value="{x:Static vm:PipelinePermissionState.ViewOnly}">
                                        <Setter Property="Text" Value="View only" />
                                        <Setter Property="Foreground" Value="{DynamicResource PillViewOnlyFg}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- ── Column 9: Child Count Badge ── -->
            <Border Grid.Column="9"
                    Visibility="{Binding Children.Count, Converter={StaticResource NonZeroVis}}">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource CountBadgeStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ExecutionStatus}" Value="Running">
                                <Setter Property="Background" Value="{DynamicResource CountRunningBg}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding ExecutionStatus}" Value="Failed">
                                <Setter Property="Background" Value="{DynamicResource CountFailedBg}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock FontSize="10.5" VerticalAlignment="Center">
                    <TextBlock.Text>
                        <MultiBinding Converter="{StaticResource PluralizeActions}">
                            <Binding Path="Children.Count" />
                            <Binding Path="NodeKind" />
                            <Binding />
                        </MultiBinding>
                    </TextBlock.Text>
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource TextDimBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ExecutionStatus}" Value="Running">
                                    <Setter Property="Foreground" Value="{DynamicResource SRunningBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ExecutionStatus}" Value="Failed">
                                    <Setter Property="Foreground" Value="{DynamicResource SFailedBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Border>

        </Grid>
    </HierarchicalDataTemplate>

    <!-- ═══════════════════════════════════════════════════════════════════
         TreeViewItem Style — Spec-aligned row with 26px height, guide rail,
         4px corner radius, hover/selected states.
         ═══════════════════════════════════════════════════════════════════ -->
    <Style x:Key="SpecTVI" TargetType="TreeViewItem">
        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
        <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
        <Setter Property="Visibility" Value="{Binding IsFilterVisible, Converter={StaticResource BoolVis}}" />
        <Setter Property="Foreground" Value="{DynamicResource TextDefaultBrush}" />
        <Setter Property="ItemTemplate" Value="{StaticResource WatchTreeSpecTemplate}" />
        <Setter Property="ItemContainerStyle" Value="{DynamicResource SpecTVI}" />
        <Setter Property="Padding" Value="0,0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TreeViewItem">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition />
                        </Grid.RowDefinitions>

                        <!-- Expand/Collapse toggle -->
                        <ToggleButton x:Name="Expander" Grid.Column="0" Grid.Row="0"
                                      IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"
                                      ClickMode="Press" Background="Transparent" BorderThickness="0"
                                      Width="14" Height="26" Padding="0" Cursor="Hand">
                            <ToggleButton.Style>
                                <Style TargetType="ToggleButton">
                                    <Setter Property="Focusable" Value="False" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border Background="Transparent" Width="14" Height="26">
                                                    <Path x:Name="Arrow" Fill="{DynamicResource TextDimBrush}"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                                          Data="M 4,0 L 8,4 L 4,8 Z" Width="8" Height="8"
                                                          Stretch="Uniform" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter TargetName="Arrow" Property="Data" Value="M 0,4 L 8,4 L 4,8 Z" />
                                                    </Trigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Arrow" Property="Fill" Value="{DynamicResource TextMutedBrush}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ToggleButton.Style>
                        </ToggleButton>

                        <!-- Row content with hover/selected backgrounds -->
                        <Border x:Name="Bd" Grid.Column="1" Grid.Row="0"
                                Background="Transparent"
                                Padding="0,0,8,0" Height="26"
                                CornerRadius="4" SnapsToDevicePixels="True">
                            <ContentPresenter x:Name="PART_Header" ContentSource="Header"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                        </Border>

                        <!-- Children container with vertical guide rail -->
                        <Border x:Name="RailBorder" Grid.Column="1" Grid.Row="1"
                                Margin="8,0,0,0"
                                BorderBrush="{DynamicResource RailIdleBrush}"
                                BorderThickness="2,0,0,0"
                                Padding="10,0,0,0">
                            <ItemsPresenter x:Name="ItemsHost" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="False">
                            <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="RailBorder" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="HasItems" Value="False">
                            <Setter TargetName="Expander" Property="Visibility" Value="Hidden" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BgRowSelectedBrush}" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsSelected" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BgRowHoverBrush}" />
                        </MultiTrigger>
                        <!-- Active rail when Running -->
                        <DataTrigger Binding="{Binding ExecutionStatus}" Value="Running">
                            <Setter TargetName="RailBorder" Property="BorderBrush" Value="{DynamicResource RailActiveBrush}" />
                        </DataTrigger>
                        <!-- Dim row for ViewOnly pipelines -->
                        <DataTrigger Binding="{Binding PipelinePermission}" Value="{x:Static vm:PipelinePermissionState.ViewOnly}">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.7" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
