<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        ControlStyles.xaml
        
        Reusable control templates and styles that reference theme brushes
        and design tokens. Provides consistent styling across all panels.
    -->

    <!-- ═══ Panel Border ═══ -->
    <Style x:Key="PanelBorder" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource BgPanel}" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="BorderBrush" Value="{DynamicResource Bdr}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Margin" Value="5" />
    </Style>

    <!-- ═══ Panel Header ═══ -->
    <Style x:Key="PanelHeaderBorder" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource BgCard}" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="CornerRadius" Value="6,6,0,0" />
    </Style>

    <!-- ═══ Panel Footer ═══ -->
    <Style x:Key="PanelFooterBorder" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource BgCard}" />
        <Setter Property="Padding" Value="8,5" />
        <Setter Property="CornerRadius" Value="0,0,6,6" />
        <Setter Property="BorderBrush" Value="{DynamicResource Bdr}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
    </Style>

    <!-- ═══ Card Border ═══ -->
    <Style x:Key="CardBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource BgCard}" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="BorderBrush" Value="{DynamicResource Bdr}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <!-- ═══ Section Expander ═══ -->
    <Style x:Key="SectionExpanderStyle" TargetType="Expander">
        <Setter Property="IsExpanded" Value="True" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Margin" Value="0,4,0,0" />
        <Setter Property="Foreground" Value="{DynamicResource TextP}" />
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <!-- ═══ GridSplitter ═══ -->
    <Style x:Key="VerticalSplitter" TargetType="GridSplitter">
        <Setter Property="Width" Value="4" />
        <Setter Property="Background" Value="{DynamicResource BgSurface}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="ResizeBehavior" Value="PreviousAndNext" />
    </Style>

    <Style x:Key="HorizontalSplitter" TargetType="GridSplitter">
        <Setter Property="Height" Value="4" />
        <Setter Property="Background" Value="{DynamicResource BgSurface}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="ResizeBehavior" Value="PreviousAndNext" />
    </Style>

    <!-- ═══ Status Badge ═══ -->
    <Style x:Key="StatusBadge" TargetType="Border">
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="6,2" />
        <Setter Property="Margin" Value="0,0,8,0" />
    </Style>

    <!-- ═══ Info Box ═══ -->
    <Style x:Key="InfoBox" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource InfoBoxBg}" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="BorderBrush" Value="{DynamicResource Bdr}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <!-- ═══ Error Box ═══ -->
    <Style x:Key="ErrorBox" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource AlertErrorBg}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AlertErrorBdr}" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Margin" Value="0,12,0,0" />
    </Style>

    <!-- ═══ Filter Bar ═══ -->
    <Style x:Key="FilterBar" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource InfoBoxBg}" />
        <Setter Property="Padding" Value="8,4" />
    </Style>

    <!-- ═══ Separator ═══ -->
    <Style x:Key="VerticalSeparator" TargetType="Border">
        <Setter Property="Width" Value="1" />
        <Setter Property="Background" Value="{DynamicResource Bdr}" />
        <Setter Property="Margin" Value="8,4" />
    </Style>

    <Style x:Key="HorizontalSeparator" TargetType="Border">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{DynamicResource Bdr}" />
        <Setter Property="Margin" Value="4,8" />
    </Style>

    <!-- ═══ Ribbon Group Container ═══ -->
    <Style x:Key="RibbonGroup" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource GroupBg}" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="Margin" Value="2" />
    </Style>

    <!-- ═══ Toggle Switch Template ═══ -->
    <Style x:Key="ToggleSwitch" TargetType="ToggleButton">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Track" Width="36" Height="18" CornerRadius="9"
                            Background="{DynamicResource BgSurface}" BorderThickness="1"
                            BorderBrush="{DynamicResource Bdr}">
                        <Ellipse x:Name="Thumb" Width="14" Height="14" Fill="{DynamicResource TextS}"
                                 HorizontalAlignment="Left" Margin="1,0,0,0" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource Accent}" />
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Accent}" />
                            <Setter TargetName="Thumb" Property="Fill" Value="White" />
                            <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="Thumb" Property="Margin" Value="0,0,1,0" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══ Pin/Unpin Toggle Button ═══ -->
    <Style x:Key="PinToggle" TargetType="ToggleButton">
        <Setter Property="Width" Value="20" />
        <Setter Property="Height" Value="20" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="ToolTip" Value="Pin / Auto-Hide" />
    </Style>

    <!-- ═══ Toolbar Icon Button (compact) ═══ -->
    <Style x:Key="ToolbarIconBtn" TargetType="Button">
        <Setter Property="Width" Value="22" />
        <Setter Property="Height" Value="22" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="2,0" />
    </Style>

    <!-- ═══ Search Box Container ═══ -->
    <Style x:Key="SearchBoxGrid" TargetType="Grid">
        <Setter Property="Margin" Value="6,5,6,2" />
    </Style>

    <!-- ═══ Context Menu ═══ -->
    <Style x:Key="ThemedContextMenu" TargetType="ContextMenu">
        <Setter Property="Background" Value="{DynamicResource BgCard}" />
        <Setter Property="Foreground" Value="{DynamicResource TextP}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Bdr}" />
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- THIN SCROLLBAR (VS Code / Visual Studio style)                    -->
    <!-- 6px track, rounded thumb, semi-transparent, expands on hover      -->
    <!-- Applies globally via implicit style — no per-control opt-in needed -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->

    <!-- Repeat Button (invisible — just moves the scroll position) -->
    <Style x:Key="ThinScrollRepeatButton" TargetType="RepeatButton">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Rectangle Fill="Transparent" Width="{TemplateBinding Width}" Height="{TemplateBinding Height}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Thumb (the draggable pill) -->
    <Style x:Key="ThinScrollThumb" TargetType="Thumb">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="ThumbBorder"
                            CornerRadius="3"
                            Background="{DynamicResource ScrollbarThumb}"
                            Margin="1" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ThumbBorder" Property="Background"
                                    Value="{DynamicResource ScrollbarThumbHover}" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="ThumbBorder" Property="Background"
                                    Value="{DynamicResource ScrollbarThumbDrag}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Vertical ScrollBar template -->
    <ControlTemplate x:Key="ThinVerticalScrollBar" TargetType="ScrollBar">
        <Grid x:Name="Root" Width="6">
            <Border CornerRadius="3" Background="{DynamicResource ScrollbarTrack}" />
            <Track x:Name="PART_Track" IsDirectionReversed="True">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Style="{StaticResource ThinScrollRepeatButton}" Command="ScrollBar.PageUpCommand" />
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                    <Thumb Style="{StaticResource ThinScrollThumb}" />
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Style="{StaticResource ThinScrollRepeatButton}" Command="ScrollBar.PageDownCommand" />
                </Track.IncreaseRepeatButton>
            </Track>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Root" Property="Width" Value="10" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- Horizontal ScrollBar template -->
    <ControlTemplate x:Key="ThinHorizontalScrollBar" TargetType="ScrollBar">
        <Grid x:Name="Root" Height="6">
            <Border CornerRadius="3" Background="{DynamicResource ScrollbarTrack}" />
            <Track x:Name="PART_Track" IsDirectionReversed="False">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Style="{StaticResource ThinScrollRepeatButton}" Command="ScrollBar.PageLeftCommand" />
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                    <Thumb Style="{StaticResource ThinScrollThumb}" />
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Style="{StaticResource ThinScrollRepeatButton}" Command="ScrollBar.PageRightCommand" />
                </Track.IncreaseRepeatButton>
            </Track>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Root" Property="Height" Value="10" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- Global implicit ScrollBar style (applies to ALL ScrollBars) -->
    <Style TargetType="ScrollBar">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Vertical">
                <Setter Property="Width" Value="10" />
                <Setter Property="Height" Value="Auto" />
                <Setter Property="Template" Value="{StaticResource ThinVerticalScrollBar}" />
            </Trigger>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="Height" Value="10" />
                <Setter Property="Template" Value="{StaticResource ThinHorizontalScrollBar}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Global implicit ScrollViewer style (overlay scrollbars over content) -->
    <Style TargetType="ScrollViewer">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollViewer">
                    <Grid>
                        <!-- Content fills the entire area (scrollbars overlay) -->
                        <ScrollContentPresenter x:Name="PART_ScrollContentPresenter"
                                                Margin="{TemplateBinding Padding}"
                                                CanContentScroll="{TemplateBinding CanContentScroll}"
                                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                                Content="{TemplateBinding Content}" />

                        <!-- Vertical scrollbar (right edge, overlaid) -->
                        <ScrollBar x:Name="PART_VerticalScrollBar"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Stretch"
                                   Orientation="Vertical"
                                   Maximum="{TemplateBinding ScrollableHeight}"
                                   ViewportSize="{TemplateBinding ViewportHeight}"
                                   Value="{TemplateBinding VerticalOffset}"
                                   Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
                                   Opacity="0" />

                        <!-- Horizontal scrollbar (bottom edge, overlaid) -->
                        <ScrollBar x:Name="PART_HorizontalScrollBar"
                                   HorizontalAlignment="Stretch"
                                   VerticalAlignment="Bottom"
                                   Orientation="Horizontal"
                                   Maximum="{TemplateBinding ScrollableWidth}"
                                   ViewportSize="{TemplateBinding ViewportWidth}"
                                   Value="{TemplateBinding HorizontalOffset}"
                                   Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"
                                   Opacity="0" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!-- Show scrollbars on mouse hover over the ScrollViewer -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="PART_VerticalScrollBar"
                                            Storyboard.TargetProperty="Opacity"
                                            To="1" Duration="0:0:0.15" />
                                        <DoubleAnimation
                                            Storyboard.TargetName="PART_HorizontalScrollBar"
                                            Storyboard.TargetProperty="Opacity"
                                            To="1" Duration="0:0:0.15" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="PART_VerticalScrollBar"
                                            Storyboard.TargetProperty="Opacity"
                                            To="0" Duration="0:0:0.4" />
                                        <DoubleAnimation
                                            Storyboard.TargetName="PART_HorizontalScrollBar"
                                            Storyboard.TargetProperty="Opacity"
                                            To="0" Duration="0:0:0.4" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- THEMED COMBOBOX                                                    -->
    <!-- Dark-fill, rounded, flat chevron, themed popup.                    -->
    <!-- Applied implicitly (no x:Key) so all ComboBoxes pick it up.        -->
    <!-- Uses DynamicResource throughout for Light / Dark / HC support.      -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->

    <!-- ComboBox toggle button (the closed-state chrome) -->
    <Style x:Key="ThemedComboToggle" TargetType="ToggleButton">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="ClickMode" Value="Press" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Border" CornerRadius="5"
                            Background="{DynamicResource FieldBg}"
                            BorderBrush="{DynamicResource Bdr}"
                            BorderThickness="1" SnapsToDevicePixels="True">
                        <!-- Chevron glyph (right side) -->
                        <Path x:Name="Chevron" HorizontalAlignment="Right" VerticalAlignment="Center"
                              Margin="0,0,10,0" Width="8" Height="5"
                              Fill="{DynamicResource TextS}" Stretch="Uniform"
                              Data="M 0,0 L 4,4 L 8,0 Z"
                              RenderTransformOrigin="0.5,0.5">
                            <Path.RenderTransform>
                                <RotateTransform Angle="0" />
                            </Path.RenderTransform>
                        </Path>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource FocusRing}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource Accent}" />
                            <Setter TargetName="Chevron" Property="RenderTransform">
                                <Setter.Value>
                                    <RotateTransform Angle="180" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ComboBox editable text box -->
    <Style x:Key="ThemedComboTextBox" TargetType="TextBox">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="AllowDrop" Value="True" />
        <Setter Property="MinWidth" Value="1" />
        <Setter Property="MinHeight" Value="1" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                  Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Implicit ComboBox style -->
    <Style TargetType="ComboBox">
        <Setter Property="Foreground" Value="{DynamicResource TextP}" />
        <Setter Property="Background" Value="{DynamicResource FieldBg}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Bdr}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="10,6,28,6" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="MaxDropDownHeight" Value="320" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <!-- Toggle fills the entire control -->
                        <ToggleButton x:Name="ToggleButton"
                                      Style="{StaticResource ThemedComboToggle}"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />

                        <!-- Selected content -->
                        <ContentPresenter x:Name="ContentSite"
                                          IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Left" />

                        <!-- Editable textbox (hidden unless IsEditable) -->
                        <TextBox x:Name="PART_EditableTextBox"
                                 Style="{StaticResource ThemedComboTextBox}"
                                 Margin="{TemplateBinding Padding}"
                                 HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                 Foreground="{TemplateBinding Foreground}"
                                 Background="Transparent"
                                 Focusable="True" Visibility="Hidden"
                                 IsReadOnly="{TemplateBinding IsReadOnly}" />

                        <!-- Dropdown popup -->
                        <Popup x:Name="Popup" Placement="Bottom"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               AllowsTransparency="True" Focusable="False"
                               PopupAnimation="Slide">
                            <Border x:Name="DropDownBorder"
                                    MinWidth="{TemplateBinding ActualWidth}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                    Background="{DynamicResource BgCard}"
                                    BorderBrush="{DynamicResource Bdr}"
                                    BorderThickness="1" CornerRadius="5"
                                    Margin="0,2,0,0" Padding="0,4"
                                    SnapsToDevicePixels="True">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="12" Opacity="0.35"
                                                      ShadowDepth="4" Direction="270" />
                                </Border.Effect>
                                <ScrollViewer SnapsToDevicePixels="True">
                                    <StackPanel IsItemsHost="True"
                                                KeyboardNavigation.DirectionalNavigation="Contained" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEditable" Value="True">
                            <Setter Property="IsTabStop" Value="False" />
                            <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible" />
                            <Setter TargetName="ContentSite" Property="Visibility" Value="Hidden" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Implicit ComboBoxItem style -->
    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource TextP}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bd" Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            CornerRadius="3" Margin="4,1">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverItemBg}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SelectedItemBg}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- THEMED TOOLTIP                                                     -->
    <!-- Dark fill, rounded corners, soft shadow, themed text.              -->
    <!-- Applied implicitly — all ToolTips pick this up automatically.      -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{DynamicResource BgCard}" />
        <Setter Property="Foreground" Value="{DynamicResource TextP}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Bdr}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="MaxWidth" Value="420" />
        <Setter Property="HasDropShadow" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="5" Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10" Opacity="0.30"
                                              ShadowDepth="3" Direction="270" />
                        </Border.Effect>
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
