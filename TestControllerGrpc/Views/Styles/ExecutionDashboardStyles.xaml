<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:exec="clr-namespace:TestControllerGrpc.ViewModels.Execution">

    <!-- ???????????????????????????????????????????????????????????????????????
         SPEC COLOR PALETTE (TestAgentSolution.ControllerService.Dashboard)
         These map the original .NET 8 standalone dashboard spec onto the
         existing .NET 10 in-process implementation. Old StatusXxxBg/Fg keys
         remain below for backward compatibility with the original styles.
         ??????????????????????????????????????????????????????????????????? -->

    <!-- Backgrounds -->
    <SolidColorBrush x:Key="BgCanvas"       Color="#111418"/>
    <SolidColorBrush x:Key="BgCard"         Color="#1A1F26"/>
    <SolidColorBrush x:Key="BgCardElevated" Color="#222831"/>
    <SolidColorBrush x:Key="BgChip"         Color="#2A313C"/>

    <!-- Borders -->
    <SolidColorBrush x:Key="BorderSubtle"   Color="#2D343F"/>
    <SolidColorBrush x:Key="BorderStrong"   Color="#3A4250"/>

    <!-- Text -->
    <SolidColorBrush x:Key="SpecTextPrimary"   Color="#E6E9EE"/>
    <SolidColorBrush x:Key="SpecTextSecondary" Color="#9098A4"/>
    <SolidColorBrush x:Key="SpecTextMuted"     Color="#6B7280"/>

    <!-- Accents -->
    <SolidColorBrush x:Key="AccentBlue"   Color="#4A9EFF"/>
    <SolidColorBrush x:Key="AccentGreen"  Color="#3DDC84"/>
    <SolidColorBrush x:Key="AccentRed"    Color="#FF5C6C"/>
    <SolidColorBrush x:Key="AccentYellow" Color="#E0B341"/>
    <SolidColorBrush x:Key="AccentPurple" Color="#B57BFF"/>

    <!-- Chip backgrounds (20% alpha versions) -->
    <SolidColorBrush x:Key="ChipDoneBg"    Color="#333DDC84"/>
    <SolidColorBrush x:Key="ChipRunningBg" Color="#334A9EFF"/>
    <SolidColorBrush x:Key="ChipFailedBg"  Color="#33FF5C6C"/>
    <SolidColorBrush x:Key="ChipPendingBg" Color="#222A313C"/>

    <!-- Typography -->
    <FontFamily x:Key="UiFont">Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFontFamily">Consolas</FontFamily>
    <system:Double x:Key="FontXs"  xmlns:system="clr-namespace:System;assembly=mscorlib">11</system:Double>
    <system:Double x:Key="FontSm"  xmlns:system="clr-namespace:System;assembly=mscorlib">12</system:Double>
    <system:Double x:Key="FontMd"  xmlns:system="clr-namespace:System;assembly=mscorlib">13</system:Double>
    <system:Double x:Key="FontLg"  xmlns:system="clr-namespace:System;assembly=mscorlib">15</system:Double>
    <system:Double x:Key="FontXl"  xmlns:system="clr-namespace:System;assembly=mscorlib">22</system:Double>
    <system:Double x:Key="FontXxl" xmlns:system="clr-namespace:System;assembly=mscorlib">28</system:Double>

    <!-- ???????????????????????????????????????????????????????????????????????
         LEGACY COLOR KEYS (used by existing dashboard XAML)
         ??????????????????????????????????????????????????????????????????? -->
    <!-- Color scheme (dark-theme tuned) -->
    <SolidColorBrush x:Key="StatusRunningBg" Color="#1A3A5C"/>
    <SolidColorBrush x:Key="StatusRunningFg" Color="#4D9CF5"/>
    <SolidColorBrush x:Key="StatusSuccessBg" Color="#1A3D2A"/>
    <SolidColorBrush x:Key="StatusSuccessFg" Color="#22C55E"/>
    <SolidColorBrush x:Key="StatusFailedBg"  Color="#3D1A1A"/>
    <SolidColorBrush x:Key="StatusFailedFg"  Color="#EF4444"/>
    <SolidColorBrush x:Key="StatusWarningBg" Color="#3D2E0A"/>
    <SolidColorBrush x:Key="StatusWarningFg" Color="#F59E0B"/>
    <SolidColorBrush x:Key="StatusIdleBg"    Color="#1E2130"/>
    <SolidColorBrush x:Key="StatusIdleFg"    Color="#6B7280"/>
    <SolidColorBrush x:Key="DashboardBg"     Color="#0F1119"/>
    <SolidColorBrush x:Key="CardBg"          Color="#171B27"/>
    <SolidColorBrush x:Key="CardBorder"      Color="#2A2F45"/>
    <SolidColorBrush x:Key="AgentColumnBg"   Color="#131620"/>
    <SolidColorBrush x:Key="RowBorder"       Color="#1E2235"/>
    <SolidColorBrush x:Key="TextPrimary"     Color="#E4E6F0"/>
    <SolidColorBrush x:Key="TextSecondary"   Color="#9099B8"/>
    <SolidColorBrush x:Key="TextDim"         Color="#5E6580"/>
    <SolidColorBrush x:Key="MonoFont"        Color="#06B6D4"/>

    <!-- Action pill base style -->
    <Style x:Key="ActionPillBase" TargetType="Border">
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Padding" Value="4,2"/>
        <Setter Property="Margin" Value="1,0"/>
        <Setter Property="BorderThickness" Value="0.5"/>
    </Style>

    <!-- Action pill DataTemplate -->
    <DataTemplate DataType="{x:Type exec:ActionPillVM}">
        <Border ToolTip="{Binding Tooltip}">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource ActionPillBase}">
                    <Setter Property="Background"  Value="{StaticResource StatusIdleBg}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource CardBorder}"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Status}" Value="Running">
                            <Setter Property="Background"  Value="{StaticResource StatusRunningBg}"/>
                            <Setter Property="BorderBrush" Value="{StaticResource StatusRunningFg}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Status}" Value="Success">
                            <Setter Property="Background"  Value="{StaticResource StatusSuccessBg}"/>
                            <Setter Property="BorderBrush" Value="{StaticResource StatusSuccessFg}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Status}" Value="Failed">
                            <Setter Property="Background"  Value="{StaticResource StatusFailedBg}"/>
                            <Setter Property="BorderBrush" Value="{StaticResource StatusFailedFg}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding StatusIcon}" FontSize="9" Margin="0,0,3,0"
                           VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Status}" Value="Running">
                                    <Setter Property="Foreground" Value="{StaticResource StatusRunningFg}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="Success">
                                    <Setter Property="Foreground" Value="{StaticResource StatusSuccessFg}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="Failed">
                                    <Setter Property="Foreground" Value="{StaticResource StatusFailedFg}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="{Binding DisplayLabel}" FontSize="11"
                           VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Status}" Value="Running">
                                    <Setter Property="Foreground" Value="{StaticResource StatusRunningFg}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="Success">
                                    <Setter Property="Foreground" Value="{StaticResource StatusSuccessFg}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="Failed">
                                    <Setter Property="Foreground" Value="{StaticResource StatusFailedFg}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </Border>
    </DataTemplate>

    <!-- ???????????????????????????????????????????????????????????????????????
         SPEC-ALIGNED STYLES (Dashboard window v2)
         ??????????????????????????????????????????????????????????????????? -->

    <!-- Pill-style RadioButton used for the top tab strip
         (Pipeline view / Timeline view / Unified log) -->
    <Style x:Key="TabButtonStyle" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource SpecTextSecondary}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="14,6"/>
        <Setter Property="Margin" Value="2,0"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" CornerRadius="14"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{StaticResource BgChip}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{StaticResource BgCardElevated}"/>
                            <Setter TargetName="Bd" Property="BorderBrush"
                                    Value="{StaticResource BorderStrong}"/>
                            <Setter Property="Foreground"
                                    Value="{StaticResource AccentBlue}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Filter strip RadioButton (smaller, square-ish) -->
    <Style x:Key="FilterButtonStyle" TargetType="RadioButton" BasedOn="{StaticResource TabButtonStyle}">
        <Setter Property="Padding" Value="10,4"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" CornerRadius="4"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{StaticResource BgChip}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{StaticResource BgCardElevated}"/>
                            <Setter TargetName="Bd" Property="BorderBrush"
                                    Value="{StaticResource AccentBlue}"/>
                            <Setter Property="Foreground"
                                    Value="{StaticResource AccentBlue}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Metric card (5 across the header) -->
    <Style x:Key="MetricCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource BgCard}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderSubtle}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="12,10"/>
        <Setter Property="Margin" Value="3"/>
    </Style>
    <Style x:Key="MetricValueStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="22"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="{StaticResource SpecTextPrimary}"/>
    </Style>
    <Style x:Key="MetricLabelStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{StaticResource SpecTextMuted}"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,2,0,0"/>
    </Style>

    <!-- Connection status dot -->
    <Style x:Key="ConnectionDotStyle" TargetType="Ellipse">
        <Setter Property="Width" Value="9"/>
        <Setter Property="Height" Value="9"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,0,6,0"/>
        <Setter Property="Fill" Value="{StaticResource AccentRed}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding ConnectionStatus}" Value="Connected">
                <Setter Property="Fill" Value="{StaticResource AccentGreen}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding ConnectionStatus}" Value="Connecting">
                <Setter Property="Fill" Value="{StaticResource AccentYellow}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
