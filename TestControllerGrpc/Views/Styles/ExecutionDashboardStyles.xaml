<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:exec="clr-namespace:TestControllerGrpc.ViewModels.Execution">

    <!-- ???????????????????????????????????????????????????????????????????????
         SPEC COLOR PALETTE (TestAgentSolution.ControllerService.Dashboard)
         These map the original .NET 8 standalone dashboard spec onto the
         existing .NET 10 in-process implementation. Old StatusXxxBg/Fg keys
         remain below for backward compatibility with the original styles.
         ??????????????????????????????????????????????????????????????????? -->

    <!-- Backgrounds -->

    <!-- Borders -->

    <!-- Text -->

    <!-- Accents -->

    <!-- Chip backgrounds (20% alpha versions) -->

    <!-- Typography -->
    <FontFamily x:Key="UiFont">Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFontFamily">Consolas</FontFamily>
    <system:Double x:Key="FontXs"  xmlns:system="clr-namespace:System;assembly=mscorlib">11</system:Double>
    <system:Double x:Key="FontSm"  xmlns:system="clr-namespace:System;assembly=mscorlib">12</system:Double>
    <system:Double x:Key="FontMd"  xmlns:system="clr-namespace:System;assembly=mscorlib">13</system:Double>
    <system:Double x:Key="FontLg"  xmlns:system="clr-namespace:System;assembly=mscorlib">15</system:Double>
    <system:Double x:Key="FontXl"  xmlns:system="clr-namespace:System;assembly=mscorlib">22</system:Double>
    <system:Double x:Key="FontXxl" xmlns:system="clr-namespace:System;assembly=mscorlib">28</system:Double>

    <!-- ???????????????????????????????????????????????????????????????????????
         LEGACY COLOR KEYS — now defined in theme dictionaries
         (Dark/Light/HighContrast) for proper theme switching.
         ??????????????????????????????????????????????????????????????????? -->

    <!-- Action pill base style -->
    <Style x:Key="ActionPillBase" TargetType="Border">
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Padding" Value="4,2"/>
        <Setter Property="Margin" Value="1,0"/>
        <Setter Property="BorderThickness" Value="0.5"/>
    </Style>

    <!-- Action pill DataTemplate -->
    <DataTemplate DataType="{x:Type exec:ActionPillVM}">
        <Border ToolTip="{Binding Tooltip}">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource ActionPillBase}">
                    <Setter Property="Background"  Value="{DynamicResource StatusIdleBg}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Status}" Value="Running">
                            <Setter Property="Background"  Value="{DynamicResource StatusRunningBg}"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource StatusRunningFg}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Status}" Value="Success">
                            <Setter Property="Background"  Value="{DynamicResource StatusSuccessBg}"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource StatusSuccessFg}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Status}" Value="Failed">
                            <Setter Property="Background"  Value="{DynamicResource StatusFailedBg}"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource StatusFailedFg}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding StatusIcon}" FontSize="{StaticResource FontSize9}" Margin="0,0,3,0"
                           VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource TextDim}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Status}" Value="Running">
                                    <Setter Property="Foreground" Value="{DynamicResource StatusRunningFg}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="Success">
                                    <Setter Property="Foreground" Value="{DynamicResource StatusSuccessFg}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="Failed">
                                    <Setter Property="Foreground" Value="{DynamicResource StatusFailedFg}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="{Binding DisplayLabel}" FontSize="{StaticResource FontSize10}"
                           VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource TextDim}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Status}" Value="Running">
                                    <Setter Property="Foreground" Value="{DynamicResource StatusRunningFg}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="Success">
                                    <Setter Property="Foreground" Value="{DynamicResource StatusSuccessFg}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="Failed">
                                    <Setter Property="Foreground" Value="{DynamicResource StatusFailedFg}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </Border>
    </DataTemplate>

    <!-- ???????????????????????????????????????????????????????????????????????
         SPEC-ALIGNED STYLES (Dashboard window v2)
         ??????????????????????????????????????????????????????????????????? -->

    <!-- Pill-style RadioButton used for the top tab strip
         (Pipeline view / Timeline view / Unified log) -->
    <Style x:Key="TabButtonStyle" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource SpecTextSecondary}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="14,6"/>
        <Setter Property="Margin" Value="2,0"/>
        <Setter Property="FontSize" Value="{StaticResource FontSize12}"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" CornerRadius="14"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{StaticResource BgChip}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{StaticResource BgCardElevated}"/>
                            <Setter TargetName="Bd" Property="BorderBrush"
                                    Value="{StaticResource BorderStrong}"/>
                            <Setter Property="Foreground"
                                    Value="{StaticResource AccentBlue}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Filter strip RadioButton (smaller, square-ish) -->
    <Style x:Key="FilterButtonStyle" TargetType="RadioButton" BasedOn="{StaticResource TabButtonStyle}">
        <Setter Property="Padding" Value="10,4"/>
        <Setter Property="FontSize" Value="{StaticResource FontSize10}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" CornerRadius="4"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{StaticResource BgChip}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{StaticResource BgCardElevated}"/>
                            <Setter TargetName="Bd" Property="BorderBrush"
                                    Value="{StaticResource AccentBlue}"/>
                            <Setter Property="Foreground"
                                    Value="{StaticResource AccentBlue}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Metric card (5 across the header) -->
    <Style x:Key="MetricCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource DashBgCard}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderSubtle}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="12,10"/>
        <Setter Property="Margin" Value="3"/>
    </Style>
    <Style x:Key="MetricValueStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="22"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="{StaticResource SpecTextPrimary}"/>
    </Style>
    <Style x:Key="MetricLabelStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSize10}"/>
        <Setter Property="Foreground" Value="{StaticResource SpecTextMuted}"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,2,0,0"/>
    </Style>

    <!-- Connection status dot -->
    <Style x:Key="ConnectionDotStyle" TargetType="Ellipse">
        <Setter Property="Width" Value="9"/>
        <Setter Property="Height" Value="9"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,0,6,0"/>
        <Setter Property="Fill" Value="{StaticResource AccentRed}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding ConnectionStatus}" Value="Connected">
                <Setter Property="Fill" Value="{StaticResource AccentGreen}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding ConnectionStatus}" Value="Connecting">
                <Setter Property="Fill" Value="{StaticResource AccentYellow}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
