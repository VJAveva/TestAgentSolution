<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:exec="clr-namespace:TestControllerGrpc.ViewModels.Execution">

    <!-- Color scheme (dark-theme tuned) -->
    <SolidColorBrush x:Key="StatusRunningBg" Color="#1A3A5C"/>
    <SolidColorBrush x:Key="StatusRunningFg" Color="#4D9CF5"/>
    <SolidColorBrush x:Key="StatusSuccessBg" Color="#1A3D2A"/>
    <SolidColorBrush x:Key="StatusSuccessFg" Color="#22C55E"/>
    <SolidColorBrush x:Key="StatusFailedBg"  Color="#3D1A1A"/>
    <SolidColorBrush x:Key="StatusFailedFg"  Color="#EF4444"/>
    <SolidColorBrush x:Key="StatusWarningBg" Color="#3D2E0A"/>
    <SolidColorBrush x:Key="StatusWarningFg" Color="#F59E0B"/>
    <SolidColorBrush x:Key="StatusIdleBg"    Color="#1E2130"/>
    <SolidColorBrush x:Key="StatusIdleFg"    Color="#6B7280"/>
    <SolidColorBrush x:Key="DashboardBg"     Color="#0F1119"/>
    <SolidColorBrush x:Key="CardBg"          Color="#171B27"/>
    <SolidColorBrush x:Key="CardBorder"      Color="#2A2F45"/>
    <SolidColorBrush x:Key="AgentColumnBg"   Color="#131620"/>
    <SolidColorBrush x:Key="RowBorder"       Color="#1E2235"/>
    <SolidColorBrush x:Key="TextPrimary"     Color="#E4E6F0"/>
    <SolidColorBrush x:Key="TextSecondary"   Color="#9099B8"/>
    <SolidColorBrush x:Key="TextDim"         Color="#5E6580"/>
    <SolidColorBrush x:Key="MonoFont"        Color="#06B6D4"/>

    <!-- Action pill base style -->
    <Style x:Key="ActionPillBase" TargetType="Border">
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Padding" Value="4,2"/>
        <Setter Property="Margin" Value="1,0"/>
        <Setter Property="BorderThickness" Value="0.5"/>
    </Style>

    <!-- Action pill DataTemplate -->
    <DataTemplate DataType="{x:Type exec:ActionPillVM}">
        <Border ToolTip="{Binding Tooltip}">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource ActionPillBase}">
                    <Setter Property="Background"  Value="{StaticResource StatusIdleBg}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource CardBorder}"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Status}" Value="Running">
                            <Setter Property="Background"  Value="{StaticResource StatusRunningBg}"/>
                            <Setter Property="BorderBrush" Value="{StaticResource StatusRunningFg}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Status}" Value="Success">
                            <Setter Property="Background"  Value="{StaticResource StatusSuccessBg}"/>
                            <Setter Property="BorderBrush" Value="{StaticResource StatusSuccessFg}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Status}" Value="Failed">
                            <Setter Property="Background"  Value="{StaticResource StatusFailedBg}"/>
                            <Setter Property="BorderBrush" Value="{StaticResource StatusFailedFg}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding StatusIcon}" FontSize="9" Margin="0,0,3,0"
                           VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Status}" Value="Running">
                                    <Setter Property="Foreground" Value="{StaticResource StatusRunningFg}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="Success">
                                    <Setter Property="Foreground" Value="{StaticResource StatusSuccessFg}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="Failed">
                                    <Setter Property="Foreground" Value="{StaticResource StatusFailedFg}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="{Binding DisplayLabel}" FontSize="11"
                           VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Status}" Value="Running">
                                    <Setter Property="Foreground" Value="{StaticResource StatusRunningFg}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="Success">
                                    <Setter Property="Foreground" Value="{StaticResource StatusSuccessFg}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="Failed">
                                    <Setter Property="Foreground" Value="{StaticResource StatusFailedFg}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </Border>
    </DataTemplate>
</ResourceDictionary>
