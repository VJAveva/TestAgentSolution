<UserControl x:Class="TestControllerGrpc.Views.AgentWorkspace.FleetView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mi="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
    xmlns:vm="clr-namespace:TestControllerGrpc.ViewModels.AgentWorkspace"
    xmlns:conv="clr-namespace:TestControllerGrpc.ViewModels"
    xmlns:beh="clr-namespace:TestControllerGrpc.Views.Behaviors"
    beh:LayoutBreakpoint.IsEnabled="True">

    <UserControl.Resources>
        <conv:StringEmptyToVisibilityConverter x:Key="EmptyVis" />
    </UserControl.Resources>

    <DockPanel>
        <!-- Summary bar -->
        <Border DockPanel.Dock="Top" Padding="10,6">
            <DockPanel>
                <!-- R16: notification bell + unread badge + flyout -->
                <Grid DockPanel.Dock="Right" Margin="8,0,0,0"
                      Visibility="{Binding Updates.HasNotifications, Converter={StaticResource BoolVis}, FallbackValue=Collapsed}">
                    <ToggleButton x:Name="BellToggle" Padding="6,3" Cursor="Hand"
                                  Background="Transparent" BorderThickness="0"
                                  ToolTip="Fleet update notifications">
                        <StackPanel Orientation="Horizontal">
                            <mi:MaterialIcon Kind="BellOutline" Width="14" Height="14"
                                             Foreground="{DynamicResource TextP}"/>
                            <Border Margin="3,0,0,0" CornerRadius="7" Padding="4,0" MinWidth="14"
                                    Background="{DynamicResource AccRed}" VerticalAlignment="Center"
                                    Visibility="{Binding Updates.HasUnread, Converter={StaticResource BoolVis}}">
                                <TextBlock Text="{Binding Updates.UnreadCount}" FontSize="{StaticResource FontSize9}" FontWeight="Bold"
                                           HorizontalAlignment="Center" Foreground="{DynamicResource TreeBadgeFg}"/>
                            </Border>
                        </StackPanel>
                    </ToggleButton>
                    <Popup IsOpen="{Binding IsChecked, ElementName=BellToggle}" StaysOpen="False"
                           Placement="Bottom" HorizontalOffset="-260" AllowsTransparency="True">
                        <Border Width="320" MaxHeight="360" CornerRadius="5" Padding="8"
                                Background="{DynamicResource BgPanel}"
                                BorderBrush="{DynamicResource Bdr}" BorderThickness="1">
                            <DockPanel>
                                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                                    <Button DockPanel.Dock="Right" Content="Mark all read" FontSize="{StaticResource FontSize9}"
                                            Padding="6,2" Cursor="Hand"
                                            Background="Transparent" Foreground="{DynamicResource Accent}"
                                            BorderThickness="0"
                                            Command="{Binding Updates.MarkAllReadCommand}"/>
                                    <TextBlock Text="Notifications" FontSize="{StaticResource FontSize10}" FontWeight="SemiBold"
                                               VerticalAlignment="Center" Foreground="{DynamicResource TextP}"/>
                                </DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="Nothing to report." FontSize="{StaticResource FontSize9}"
                                           Foreground="{DynamicResource TextS}"
                                           Visibility="{Binding Updates.HasUnread, Converter={StaticResource InvBoolVis}}"/>
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding Updates.Notifications}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:FleetNotificationVM}">
                                                <Border Padding="6,4" Margin="0,0,0,3" CornerRadius="3"
                                                        Background="{DynamicResource BgCard}">
                                                    <StackPanel>
                                                        <TextBlock FontSize="{StaticResource FontSize9}" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TextP}">
                                                            <Run Text="{Binding NodeId, Mode=OneWay}"/>
                                                            <Run Text=" — "/>
                                                            <Run Text="{Binding Title, Mode=OneWay}"/>
                                                        </TextBlock>
                                                        <TextBlock Text="{Binding Description}" FontSize="{StaticResource FontSize9}"
                                                                   TextWrapping="Wrap"
                                                                   Foreground="{DynamicResource TextS}"/>
                                                        <TextBlock FontSize="{StaticResource FontSize9}" Foreground="{DynamicResource TextS}">
                                                            <Run Text="{Binding SourceText, Mode=OneWay}"/>
                                                            <Run Text=" · "/>
                                                            <Run Text="{Binding RelativeTime, Mode=OneWay}"/>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>
                    </Popup>
                </Grid>
                <!-- Register Agent button -->
                <Button DockPanel.Dock="Right" Margin="8,0,0,0" Padding="10,4"
                        VerticalAlignment="Center"
                        FontSize="{StaticResource FontSize9}" Cursor="Hand"
                        Command="{Binding RequestRegisterAgentCommand}"
                        Background="{DynamicResource AccentBtnBg}"
                        Foreground="{DynamicResource Accent}"
                        BorderBrush="{DynamicResource Accent}"
                        BorderThickness="1">
                    <TextBlock Text="+ Register Agent" FontWeight="SemiBold"/>
                </Button>
                <!-- Filter textbox -->
                <!-- Centred, not stretched: the KPI cards set this row's height, so without this the
                     text box rendered ~50px tall. -->
                <Grid DockPanel.Dock="Right" Width="150" Margin="8,0,0,0" VerticalAlignment="Center">
                    <!-- FieldBg, not BgCard: BgCard is the raised card surface, which made this read as a
                         pale block instead of an inset field like every other text box. -->
                    <TextBox Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                             Background="{DynamicResource FieldBg}"
                             Foreground="{DynamicResource TextP}"
                             BorderBrush="{DynamicResource Bdr}"
                             BorderThickness="1"
                             FontSize="{StaticResource FontSize10}" Padding="6,4" VerticalContentAlignment="Center" AutomationProperties.Name="Filter agents" />
                    <TextBlock Text="Filter agents..." IsHitTestVisible="False"
                               FontSize="{StaticResource FontSize10}" Margin="7,0,0,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource PlaceholderFg}"
                               Visibility="{Binding FilterText, Converter={StaticResource EmptyVis}}" />
                </Grid>
                <!-- Stats: KPI cards per the UI kit's "Agents (Fleet)" view -->
                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                    <Border Style="{DynamicResource KpiCardStyle}"
                            ToolTip="Total registered agents. Bar shows fleet utilisation (busy/total)."
                            AutomationProperties.AutomationId="Fleet.Kpi.Agents">
                        <StackPanel>
                            <TextBlock Style="{DynamicResource KpiValueStyle}" Text="{Binding TotalCount, Mode=OneWay}"/>
                            <TextBlock Style="{DynamicResource KpiLabelStyle}" Text="AGENTS"/>
                            <!-- Track stays 80px wide: FleetVM scales UtilizationBarWidth against that maximum. -->
                            <Border Width="80" Height="3" CornerRadius="2" Margin="0,4,0,1"
                                    HorizontalAlignment="Left" Background="{DynamicResource Bdr}"
                                    AutomationProperties.AutomationId="Fleet.UtilizationBar">
                                <Border HorizontalAlignment="Left" Height="3" CornerRadius="2"
                                        Background="{DynamicResource Accent}"
                                        Width="{Binding UtilizationBarWidth, Mode=OneWay}"/>
                            </Border>
                        </StackPanel>
                    </Border>
                    <Border Style="{DynamicResource KpiCardStyle}" ToolTip="Agents currently executing"
                            AutomationProperties.AutomationId="Fleet.Kpi.Busy">
                        <StackPanel>
                            <TextBlock Style="{DynamicResource KpiValueStyle}" Text="{Binding BusyCount, Mode=OneWay}"
                                       Foreground="{DynamicResource Accent}"/>
                            <TextBlock Style="{DynamicResource KpiLabelStyle}" Text="BUSY"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{DynamicResource KpiCardStyle}" ToolTip="Agents idle and available"
                            AutomationProperties.AutomationId="Fleet.Kpi.Free">
                        <StackPanel>
                            <TextBlock Style="{DynamicResource KpiValueStyle}" Text="{Binding FreeCount, Mode=OneWay}"
                                       Foreground="{DynamicResource AccGreen}"/>
                            <TextBlock Style="{DynamicResource KpiLabelStyle}" Text="FREE"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{DynamicResource KpiCardSecondaryStyle}" ToolTip="Agents whose last run failed"
                            AutomationProperties.AutomationId="Fleet.Kpi.Failed">
                        <StackPanel>
                            <TextBlock Style="{DynamicResource KpiValueStyle}" Text="{Binding FailedCount, Mode=OneWay}"
                                       Foreground="{DynamicResource AccRed}"/>
                            <TextBlock Style="{DynamicResource KpiLabelStyle}" Text="FAILED"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{DynamicResource KpiCardSecondaryStyle}" ToolTip="Agents not reporting a heartbeat"
                            AutomationProperties.AutomationId="Fleet.Kpi.Offline">
                        <StackPanel>
                            <TextBlock Style="{DynamicResource KpiValueStyle}" Text="{Binding OfflineCount, Mode=OneWay}"
                                       Foreground="{DynamicResource AccRed}"/>
                            <TextBlock Style="{DynamicResource KpiLabelStyle}" Text="OFFLINE"/>
                        </StackPanel>
                    </Border>
                    <TextBlock VerticalAlignment="Center" FontSize="{StaticResource FontSize10}" Margin="6,0,0,0"
                               Foreground="{DynamicResource StatusMaintenanceFg}"
                               Visibility="{Binding HasReverting, Converter={StaticResource BoolVis}}">
                        <Run Text="·"/>
                        <Run Text="{Binding RevertingCount, Mode=OneWay}" FontWeight="SemiBold"/>
                        <Run Text=" reverting"/>
                    </TextBlock>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Windows Update banner stack (R15): one banner per severity, not per node -->
        <ItemsControl DockPanel.Dock="Top" Margin="10,0,10,6"
                      ItemsSource="{Binding Updates.Banners}"
                      Visibility="{Binding Updates.HasBanners, Converter={StaticResource BoolVis}, FallbackValue=Collapsed}">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:UpdateBannerVM}">
                    <Border CornerRadius="4" Padding="10,6" Margin="0,0,0,4"
                            Background="{DynamicResource StatusRunningBg}" BorderBrush="{DynamicResource StatusRunningFg}" BorderThickness="1">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsWarning}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource StatusRebootBg}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource StatusRebootFg}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="&#x2715;" Padding="6,1" FontSize="{StaticResource FontSize10}"
                                    Margin="6,0,0,0" Cursor="Hand" VerticalAlignment="Center"
                                    Background="Transparent" Foreground="{DynamicResource TextS}"
                                    BorderThickness="0"
                                    AutomationProperties.Name="Dismiss. Returns if the affected agents change." ToolTip="Dismiss. Returns if the affected agents change."
                                    Command="{Binding DataContext.Updates.DismissBannerCommand,
                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}"/>
                            <Button DockPanel.Dock="Right" Content="Review" Padding="10,3" FontSize="{StaticResource FontSize9}"
                                    Cursor="Hand" VerticalAlignment="Center"
                                    Background="Transparent" Foreground="{DynamicResource TextP}"
                                    BorderBrush="{DynamicResource Bdr}" BorderThickness="1"
                                    Command="{Binding DataContext.Updates.ReviewCommand,
                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                            <StackPanel>
                                <TextBlock Text="{Binding Title}" FontSize="{StaticResource FontSize10}" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextP}"/>
                                <TextBlock Text="{Binding Detail}" FontSize="{StaticResource FontSize9}" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextS}"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Grouped agent panel -->
        <Grid>
            <!-- Empty state -->
            <TextBlock Text="No agents registered"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       FontSize="{StaticResource FontSize11}" Foreground="{DynamicResource TextS}"
                       Visibility="{Binding IsEmpty, Converter={StaticResource BoolVis}}"/>

            <!-- Grouped list (outer uses VirtualizingStackPanel for scalability) -->
            <ListBox ItemsSource="{Binding Groups}" Padding="6"
                     Visibility="{Binding IsEmpty, Converter={StaticResource InvBoolVis}}"
                     Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingStackPanel.IsVirtualizing="True"
                     VirtualizingStackPanel.VirtualizationMode="Recycling">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:FleetGroupVM}">
                            <StackPanel Margin="0,0,0,4">

                                <!-- GROUP HEADER -->
                                <Border Background="{DynamicResource BgPanel}"
                                        BorderBrush="{DynamicResource Bdr}"
                                        BorderThickness="0,0,0,0.5"
                                        Padding="12,7">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Group status dot -->
                                        <Ellipse Grid.Column="0" Width="8" Height="8"
                                                 Margin="0,0,8,0" VerticalAlignment="Center">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="{DynamicResource Accent}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding AccentKind}" Value="Idle">
                                                            <Setter Property="Fill" Value="{DynamicResource AccGreen}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>

                                        <!-- Title + Owner -->
                                        <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                    VerticalAlignment="Center"
                                                    ToolTip="{Binding OwnerTooltip}">
                                            <TextBlock Text="{Binding Title}" FontSize="{StaticResource FontSize11}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextP}"/>
                                            <TextBlock Text="{Binding OwnerRoleIcon}" FontSize="{StaticResource FontSize9}"
                                                       Margin="6,0,0,0" VerticalAlignment="Center"
                                                       Visibility="{Binding HasOwnerRole, Converter={StaticResource BoolVis}}"/>
                                            <TextBlock Text="{Binding OwnerDisplay}" FontSize="{StaticResource FontSize9}"
                                                       Margin="3,0,0,0"
                                                       Foreground="{DynamicResource TextS}"/>
                                            <TextBlock Text="{Binding OwnerRoleLabel}" FontSize="{StaticResource FontSize9}"
                                                       Margin="4,0,0,0"
                                                       Foreground="{DynamicResource TextS}"
                                                       Visibility="{Binding HasOwnerRole, Converter={StaticResource BoolVis}}"/>
                                        </StackPanel>

                                        <!-- Agent count -->
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding Count}" FontSize="{StaticResource FontSize10}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextS}"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>

                                <!-- CARD GRID: Virtualized for 200-agent scale -->
                                <ListBox ItemsSource="{Binding Agents}" Margin="6,4,6,6"
                                         Visibility="{Binding HasAgents, Converter={StaticResource BoolVis}}"
                                         Background="Transparent" BorderThickness="0"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                         VirtualizingStackPanel.IsVirtualizing="True"
                                         VirtualizingStackPanel.VirtualizationMode="Recycling">
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="2"/>
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            <Setter Property="Padding" Value="0"/>
                                            <Setter Property="Margin" Value="0"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <ContentPresenter/>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:FleetCardVM}">
                                            <Border Width="Auto" Height="50" Margin="3" CornerRadius="5"
                                                    Padding="7,5" Cursor="Hand"
                                                    MouseLeftButtonUp="Card_Click"
                                                    Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}">
                                                <Border.ContextMenu>
                                                    <ContextMenu Style="{DynamicResource ThemedContextMenu}">
                                                        <MenuItem Header="Revert to snapshot…"
                                                                  Command="{Binding PlacementTarget.Tag.RevertCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                                            <MenuItem.Icon>
                                                                <mi:MaterialIcon Kind="BackupRestore" Width="15" Height="15" Foreground="{DynamicResource TextP}"/>
                                                            </MenuItem.Icon>
                                                        </MenuItem>
                                                        <MenuItem Header="Reboot machine…"
                                                                  Command="{Binding PlacementTarget.Tag.RebootCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                                            <MenuItem.Icon>
                                                                <mi:MaterialIcon Kind="Restart" Width="15" Height="15" Foreground="{DynamicResource TextP}"/>
                                                            </MenuItem.Icon>
                                                        </MenuItem>
                                                        <MenuItem Header="Cancel revert"
                                                                  Command="{Binding PlacementTarget.Tag.CancelRevertCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                                            <MenuItem.Icon>
                                                                <mi:MaterialIcon Kind="CloseCircleOutline" Width="15" Height="15" Foreground="{DynamicResource TextP}"/>
                                                            </MenuItem.Icon>
                                                        </MenuItem>
                                                        <Separator/>
                                                        <MenuItem Header="Open remote desktop"
                                                                  Command="{Binding PlacementTarget.Tag.OpenRemoteDesktopCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                                            <MenuItem.Icon>
                                                                <mi:MaterialIcon Kind="RemoteDesktop" Width="15" Height="15" Foreground="{DynamicResource TextP}"/>
                                                            </MenuItem.Icon>
                                                        </MenuItem>
                                                        <Separator/>
                                                        <MenuItem Header="Return to rotation (clear quarantine)"
                                                                  Command="{Binding PlacementTarget.Tag.ClearQuarantineCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                                            <MenuItem.Icon>
                                                                <mi:MaterialIcon Kind="ShieldCheckOutline" Width="15" Height="15" Foreground="{DynamicResource TextP}"/>
                                                            </MenuItem.Icon>
                                                        </MenuItem>
                                                    </ContextMenu>
                                                </Border.ContextMenu>
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{DynamicResource StatusSuccessBg}"/>
                                                        <Setter Property="BorderBrush" Value="{DynamicResource StatusSuccessFg}"/>
                                                        <Setter Property="BorderThickness" Value="1"/>
                                                        <Setter Property="Opacity" Value="0.65"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="Busy">
                                                                <Setter Property="Background" Value="{DynamicResource StatusRunningBg}"/>
                                                                <Setter Property="BorderBrush" Value="{DynamicResource StatusRunningFg}"/>
                                                                <Setter Property="Opacity" Value="1.0"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Failed">
                                                                <Setter Property="Background" Value="{DynamicResource StatusFailedBg}"/>
                                                                <Setter Property="BorderBrush" Value="{DynamicResource StatusFailedFg}"/>
                                                                <Setter Property="Opacity" Value="1.0"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Offline">
                                                                <Setter Property="Background" Value="{DynamicResource StatusFailedBg}"/>
                                                                <Setter Property="BorderBrush" Value="{DynamicResource StatusFailedFg}"/>
                                                                <Setter Property="Opacity" Value="0.7"/>
                                                            </DataTrigger>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="BorderBrush" Value="{DynamicResource AccPeach}"/>
                                                                <Setter Property="Opacity" Value="1.0"/>
                                                            </Trigger>
                                                            <DataTrigger Binding="{Binding IsUnderMaintenance}" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource StatusMaintenanceBg}"/>
                                                                <Setter Property="BorderBrush" Value="{DynamicResource StatusMaintenanceFg}"/>
                                                                <Setter Property="Opacity" Value="1.0"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsQuarantined}" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource StatusFailedBg}"/>
                                                                <Setter Property="BorderBrush" Value="{DynamicResource StatusFailedFg}"/>
                                                                <Setter Property="Opacity" Value="1.0"/>
                                                            </DataTrigger>
                                                            <!-- Amber, not red: the node is flagged for review but the machine is answering. -->
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding IsQuarantined}" Value="True"/>
                                                                    <Condition Binding="{Binding IsError}" Value="False"/>
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Background" Value="{DynamicResource StatusMaintenanceBg}"/>
                                                                <Setter Property="BorderBrush" Value="{DynamicResource StatusMaintenanceFg}"/>
                                                                <Setter Property="Opacity" Value="1.0"/>
                                                            </MultiDataTrigger>
                                                            <DataTrigger Binding="{Binding IsDraining}" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource StatusDrainingBg}"/>
                                                                <Setter Property="BorderBrush" Value="{DynamicResource StatusDrainingFg}"/>
                                                                <Setter Property="Opacity" Value="1.0"/>
                                                            </DataTrigger>
                                                            <!-- R17: must stay AFTER IsDraining. The update policy drains a node BECAUSE a reboot
                                                                 is pending, so an earlier trigger here would always be overridden by the drain
                                                                 colour and the actionable state would never be shown. -->
                                                            <DataTrigger Binding="{Binding IsRebootRequired}" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource StatusRebootBg}"/>
                                                                <Setter Property="BorderBrush" Value="{DynamicResource StatusRebootFg}"/>
                                                                <Setter Property="BorderThickness" Value="2"/>
                                                                <Setter Property="Opacity" Value="1.0"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="*"/>
                                                    </Grid.RowDefinitions>
                                                    <!-- Row 1: dot + agent name -->
                                                    <StackPanel Grid.Row="0" Orientation="Horizontal">
                                                        <Ellipse Width="7" Height="7" Margin="0,0,5,0"
                                                                 VerticalAlignment="Center">
                                                            <Ellipse.Style>
                                                                <Style TargetType="Ellipse">
                                                                    <Setter Property="Fill" Value="{DynamicResource AccGreen}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Status}" Value="Busy">
                                                                            <Setter Property="Fill" Value="{DynamicResource Accent}"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Status}" Value="Failed">
                                                                            <Setter Property="Fill" Value="{DynamicResource AccRed}"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Status}" Value="Offline">
                                                                            <Setter Property="Fill" Value="{DynamicResource AccRed}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Ellipse.Style>
                                                        </Ellipse>
                                                        <!-- HC glyph fallback -->
                                                        <TextBlock FontSize="8" FontWeight="Bold" Margin="0,0,3,0"
                                                                   VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource HcGlyphFg}">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Text" Value="&#x2713;"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Status}" Value="Busy">
                                                                            <Setter Property="Text" Value="R"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Status}" Value="Failed">
                                                                            <Setter Property="Text" Value="&#x2717;"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Status}" Value="Offline">
                                                                            <Setter Property="Text" Value="&#x2717;"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <TextBlock Text="{Binding AgentName}" FontSize="{StaticResource FontSize10}"
                                                                   FontWeight="SemiBold" FontFamily="Consolas"
                                                                   Foreground="{DynamicResource TextP}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   MaxWidth="120"/>
                                                        <!-- R17: Windows Update shield badge -->
                                                        <Border Margin="5,0,0,0" CornerRadius="3" Padding="4,1"
                                                                VerticalAlignment="Center"
                                                                ToolTip="{Binding UpdateTooltip}"
                                                                Visibility="{Binding HasUpdateBadge, Converter={StaticResource BoolVis}}"
                                                                Background="{DynamicResource StatusRunningBg}" BorderBrush="{DynamicResource StatusRunningFg}" BorderThickness="0.5">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsRebootRequired}" Value="True">
                                                                            <Setter Property="Background" Value="{DynamicResource StatusRebootBg}"/>
                                                                            <Setter Property="BorderBrush" Value="{DynamicResource StatusRebootFg}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <StackPanel Orientation="Horizontal">
                                                                <mi:MaterialIcon Kind="ShieldAlertOutline" Width="9" Height="9"
                                                                                 VerticalAlignment="Center" Margin="0,0,3,0"
                                                                                 Foreground="{DynamicResource TextS}"/>
                                                                <TextBlock Text="{Binding UpdateBadgeText}" FontSize="{StaticResource FontSize9}"
                                                                           VerticalAlignment="Center"
                                                                           Foreground="{DynamicResource TextP}"/>
                                                            </StackPanel>
                                                        </Border>
                                                        <!-- Pipeline tag pill (visible when busy) -->
                                                        <Border Margin="6,0,0,0" CornerRadius="3"
                                                                Padding="5,1" VerticalAlignment="Center"
                                                                Background="{DynamicResource AccentBtnBg}"
                                                                BorderBrush="{DynamicResource Accent}"
                                                                BorderThickness="0.5">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Status}" Value="Busy">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock FontSize="{StaticResource FontSize9}"
                                                                       Foreground="{DynamicResource Accent}"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       MaxWidth="160"
                                                                       Text="{Binding PipelinePillText}"/>
                                                        </Border>
                                                    </StackPanel>
                                                    <!-- Row 2: status detail -->
                                                    <TextBlock Grid.Row="1" Text="{Binding StatusDetail}"
                                                               FontSize="{StaticResource FontSize9}" FontFamily="Consolas"
                                                               Foreground="{DynamicResource TextS}"
                                                               VerticalAlignment="Bottom"
                                                               TextTrimming="CharacterEllipsis"
                                                               Margin="12,2,0,0">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsUnderMaintenance}" Value="True">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsQuarantined}" Value="True">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <!-- Row 2 (quarantined): why it is flagged, and whether the agent is answering -->
                                                    <TextBlock Grid.Row="1" Text="{Binding QuarantineHint}"
                                                               FontSize="{StaticResource FontSize9}" FontFamily="Consolas"
                                                               VerticalAlignment="Bottom"
                                                               TextTrimming="CharacterEllipsis"
                                                               Margin="12,2,0,0"
                                                               Visibility="{Binding IsQuarantined, Converter={StaticResource BoolVis}}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{DynamicResource StatusFailedFg}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsQuarantinedAndOnline}" Value="True">
                                                                        <Setter Property="Foreground" Value="{DynamicResource StatusMaintenanceFg}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <!-- Row 2 (maintenance): phase message + progress bar -->
                                                    <StackPanel Grid.Row="1" Margin="12,2,0,0" VerticalAlignment="Bottom"
                                                                Visibility="{Binding IsUnderMaintenance, Converter={StaticResource BoolVis}}">
                                                        <TextBlock Text="{Binding MaintenanceLine}" FontSize="8"
                                                                   FontFamily="Consolas" Foreground="{DynamicResource StatusMaintenanceFg}"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <ProgressBar Height="3" Margin="0,2,0,0" Minimum="0" Maximum="100"
                                                                     Value="{Binding MaintenanceProgressPercent, Mode=OneWay}"
                                                                     Background="Transparent" BorderThickness="0"
                                                                     Foreground="{DynamicResource StatusMaintenanceFg}"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
        </Grid>
    </DockPanel>
</UserControl>
