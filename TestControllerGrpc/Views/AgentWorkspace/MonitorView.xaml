<UserControl x:Class="TestControllerGrpc.Views.AgentWorkspace.MonitorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:TestControllerGrpc.ViewModels.AgentWorkspace">

    <DockPanel>
        <!-- Header -->
        <Border DockPanel.Dock="Top" Padding="10,8" Background="{DynamicResource BgCard}"
                BorderBrush="{DynamicResource Bdr}" BorderThickness="0,0,0,1">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Test" Style="{DynamicResource SmBtn}"
                            Background="{DynamicResource GreenBtnBg}" Foreground="{DynamicResource AccGreen}"
                            Command="{Binding TestConnectionCommand}" Margin="0,0,4,0"/>
                    <Button Content="Force Release" Style="{DynamicResource SmBtn}"
                            Background="{DynamicResource DangerBtnBg}" Foreground="{DynamicResource AccRed}"
                            Command="{Binding ForceReleaseCommand}"
                            Visibility="{Binding IsBusy, Converter={StaticResource BoolVis}}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="← Fleet" FontSize="10" Padding="6,3" Margin="0,0,10,0"
                            Background="Transparent" BorderThickness="0" Cursor="Hand"
                            Foreground="{DynamicResource Accent}"
                            Command="{Binding GoBackCommand}"/>
                    <TextBlock Text="{Binding AgentName}" FontSize="14" FontWeight="Bold"
                               Foreground="{DynamicResource TextP}" VerticalAlignment="Center"/>
                    <Border Margin="8,0,0,0" Padding="6,2" CornerRadius="3" VerticalAlignment="Center">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource GreenBtnBg}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Status}" Value="Busy">
                                        <Setter Property="Background" Value="{DynamicResource AccentBtnBg}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="Offline">
                                        <Setter Property="Background" Value="{DynamicResource DangerBtnBg}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding Status}" FontSize="10" FontWeight="SemiBold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource AccGreen}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Status}" Value="Busy">
                                            <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status}" Value="Offline">
                                            <Setter Property="Foreground" Value="{DynamicResource AccRed}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                    <TextBlock Text="{Binding AgentAddress}" FontSize="10" FontFamily="Consolas"
                               Foreground="{DynamicResource TextS}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Session info (visible when busy) -->
        <Border DockPanel.Dock="Top" Padding="10,5" Background="{DynamicResource AccentBtnBg}"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolVis}}">
            <TextBlock FontSize="11" Foreground="{DynamicResource Accent}">
                <Run Text="▶" FontWeight="Bold"/>
                <Run Text="{Binding SessionPipeline, Mode=OneWay}"/>
                <Run Text=" · elapsed:"/>
                <Run Text="{Binding SessionElapsed, Mode=OneWay}" FontFamily="Consolas"/>
            </TextBlock>
        </Border>

        <!-- Live log -->
        <DockPanel>
            <Border DockPanel.Dock="Top" Padding="8,4">
                <TextBlock Text="Live Output" FontSize="11" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextS}"/>
            </Border>
            <Border Background="{DynamicResource BgCanvas}" Margin="6" CornerRadius="4"
                    BorderBrush="{DynamicResource Bdr}" BorderThickness="1">
                <ListBox ItemsSource="{Binding LiveLog}" Background="Transparent"
                         BorderThickness="0" FontFamily="Consolas" FontSize="10"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="4,1"/>
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextP}"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:LogLineVM}">
                            <TextBlock>
                                <Run Text="{Binding Timestamp, Mode=OneWay}" Foreground="{DynamicResource TextS}"/>
                                <Run Text=" "/>
                                <Run Text="{Binding Kind, Mode=OneWay}" FontWeight="Bold">
                                    <Run.Style>
                                        <Style TargetType="Run">
                                            <Setter Property="Foreground" Value="{DynamicResource TextS}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Kind}" Value="ERR">
                                                    <Setter Property="Foreground" Value="{DynamicResource AccRed}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Run.Style>
                                </Run>
                                <Run Text=" "/>
                                <Run Text="{Binding Line, Mode=OneWay}"/>
                            </TextBlock>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </DockPanel>
    </DockPanel>
</UserControl>
