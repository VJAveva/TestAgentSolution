<UserControl x:Class="TestControllerGrpc.Views.AgentWorkspace.MonitorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:TestControllerGrpc.ViewModels.AgentWorkspace"
    Background="{DynamicResource DashboardBg}">

    <UserControl.Resources>
        <!-- Tab radio style -->
        <Style x:Key="MonitorTab" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Padding="{TemplateBinding Padding}"
                                BorderThickness="0,0,0,2" BorderBrush="Transparent">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource StatusRunningFg}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                <Setter Property="FontWeight" Value="Medium"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <DockPanel>

        <!-- ═══════════════ HEADER ═══════════════ -->
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource CardBg}"
                BorderBrush="{DynamicResource RowBorder}"
                BorderThickness="0,0,0,0.5"
                Padding="18,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Agent icon -->
                <Border Grid.Column="0" Width="42" Height="42" CornerRadius="8"
                        Background="{DynamicResource StatusRunningBg}" VerticalAlignment="Center">
                    <TextBlock Text="{Binding AgentInitials}"
                               FontSize="16" FontWeight="Medium" FontFamily="Consolas"
                               Foreground="{DynamicResource StatusRunningFg}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <!-- Name + meta -->
                <StackPanel Grid.Column="1" Margin="14,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding AgentName}" FontFamily="Consolas"
                               FontSize="18" FontWeight="Medium"
                               Foreground="{DynamicResource TextPrimary}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                        <TextBlock Text="{Binding AgentAddress}" FontSize="11"
                                   Foreground="{DynamicResource TextSecondary}"/>
                        <TextBlock Text=" · " FontSize="11" Foreground="{DynamicResource TextDim}"/>
                        <TextBlock Text="{Binding AgentVersion}" FontSize="11"
                                   Foreground="{DynamicResource TextSecondary}"/>
                        <TextBlock Text=" · up " FontSize="11" Foreground="{DynamicResource TextDim}"/>
                        <TextBlock Text="{Binding UptimeDisplay}" FontSize="11"
                                   Foreground="{DynamicResource TextSecondary}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Status badge -->
                <Border Grid.Column="2" CornerRadius="99" Padding="10,4" Margin="0,0,8,0"
                        VerticalAlignment="Center">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{DynamicResource StatusIdleBg}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding StatusKind}" Value="Busy">
                                    <Setter Property="Background" Value="{DynamicResource StatusRunningBg}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding StatusKind}" Value="Free">
                                    <Setter Property="Background" Value="{DynamicResource StatusSuccessBg}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding StatusKind}" Value="Offline">
                                    <Setter Property="Background" Value="{DynamicResource StatusIdleBg}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Margin="0,0,5,0" VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{DynamicResource TextDim}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding StatusKind}" Value="Busy">
                                            <Setter Property="Fill" Value="{DynamicResource StatusRunningFg}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding StatusKind}" Value="Free">
                                            <Setter Property="Fill" Value="{DynamicResource StatusSuccessFg}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding StatusText}" FontSize="11" FontWeight="Medium">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource TextDim}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding StatusKind}" Value="Busy">
                                            <Setter Property="Foreground" Value="{DynamicResource StatusRunningFg}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding StatusKind}" Value="Free">
                                            <Setter Property="Foreground" Value="{DynamicResource StatusSuccessFg}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- Action buttons -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="← Back" Command="{Binding BackCommand}"
                            Padding="10,6" FontSize="11" Margin="2,0"
                            Background="Transparent" BorderThickness="0.5"
                            BorderBrush="{DynamicResource RowBorder}"
                            Foreground="{DynamicResource TextSecondary}" Cursor="Hand"/>
                    <Button Content="Force release" Command="{Binding ForceReleaseCommand}"
                            Padding="10,6" FontSize="11" Margin="2,0"
                            Background="Transparent" BorderThickness="0.5"
                            BorderBrush="{DynamicResource RowBorder}"
                            Foreground="{DynamicResource StatusWarningFg}" Cursor="Hand"/>
                    <Button Content="Reboot" Command="{Binding RebootCommand}"
                            Padding="10,6" FontSize="11" Margin="2,0"
                            Background="Transparent" BorderThickness="0.5"
                            BorderBrush="{DynamicResource RowBorder}"
                            Foreground="{DynamicResource StatusFailedFg}" Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══════════════ BODY (2 columns) ═══════════════ -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ─── LEFT SIDE PANEL ─── -->
            <ScrollViewer Grid.Column="0"
                          Background="{DynamicResource CardBg}"
                          BorderBrush="{DynamicResource RowBorder}"
                          BorderThickness="0,0,0.5,0"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="14">

                    <!-- Current Session -->
                    <TextBlock Text="CURRENT SESSION" FontSize="9" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextDim}" Margin="0,0,0,6"/>
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Pipeline" FontSize="10"
                                   Foreground="{DynamicResource TextDim}" Padding="0,3"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SessionPipeline}"
                                   FontFamily="Consolas" FontSize="11" FontWeight="Medium"
                                   Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis" Padding="0,3"/>
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Owner" FontSize="10"
                                   Foreground="{DynamicResource TextDim}" Padding="0,3"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SessionOwner}"
                                   FontFamily="Consolas" FontSize="11"
                                   Foreground="{DynamicResource TextPrimary}" Padding="0,3"/>
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Started" FontSize="10"
                                   Foreground="{DynamicResource TextDim}" Padding="0,3"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SessionStarted}"
                                   FontFamily="Consolas" FontSize="11"
                                   Foreground="{DynamicResource TextPrimary}" Padding="0,3"/>
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Elapsed" FontSize="10"
                                   Foreground="{DynamicResource TextDim}" Padding="0,3"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SessionElapsed}"
                                   FontFamily="Consolas" FontSize="11"
                                   Foreground="{DynamicResource TextPrimary}" Padding="0,3"/>
                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Step" FontSize="10"
                                   Foreground="{DynamicResource TextDim}" Padding="0,3"/>
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SessionStep}"
                                   FontFamily="Consolas" FontSize="11"
                                   Foreground="{DynamicResource TextPrimary}" Padding="0,3"/>
                    </Grid>

                    <!-- Current Action -->
                    <TextBlock Text="CURRENT ACTION" FontSize="9" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextDim}" Margin="0,0,0,6"/>
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Command" FontSize="10"
                                   Foreground="{DynamicResource TextDim}" Padding="0,3"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ActionCommand}"
                                   FontFamily="Consolas" FontSize="11"
                                   Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis" Padding="0,3"/>
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Progress" FontSize="10"
                                   Foreground="{DynamicResource TextDim}" Padding="0,3"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ActionProgress}"
                                   FontFamily="Consolas" FontSize="11"
                                   Foreground="{DynamicResource TextPrimary}" Padding="0,3"/>
                    </Grid>

                    <!-- System Info -->
                    <TextBlock Text="SYSTEM" FontSize="9" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextDim}" Margin="0,0,0,6"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="OS" FontSize="10"
                                   Foreground="{DynamicResource TextDim}" Padding="0,3"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SystemOs}"
                                   FontFamily="Consolas" FontSize="11"
                                   Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis" Padding="0,3"/>
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="RAM" FontSize="10"
                                   Foreground="{DynamicResource TextDim}" Padding="0,3"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SystemRamTotal}"
                                   FontFamily="Consolas" FontSize="11"
                                   Foreground="{DynamicResource TextPrimary}" Padding="0,3"/>
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Disk free" FontSize="10"
                                   Foreground="{DynamicResource TextDim}" Padding="0,3"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SystemDiskFree}"
                                   FontFamily="Consolas" FontSize="11"
                                   Foreground="{DynamicResource TextPrimary}" Padding="0,3"/>
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Address" FontSize="10"
                                   Foreground="{DynamicResource TextDim}" Padding="0,3"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding AgentAddress}"
                                   FontFamily="Consolas" FontSize="11"
                                   Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis" Padding="0,3"/>
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <!-- ─── RIGHT MAIN PANEL ─── -->
            <DockPanel Grid.Column="1" Margin="14">

                <!-- Metrics frozen notice (visible only during active execution) -->
                <Border DockPanel.Dock="Top" Margin="0,0,0,8" Padding="8,5" CornerRadius="4"
                        Background="{DynamicResource StatusWarningBg}"
                        Visibility="{Binding MetricsFrozenNotice, Converter={StaticResource NullToCollapsed}}">
                    <TextBlock Text="{Binding MetricsFrozenNotice}"
                               FontSize="10" FontStyle="Italic"
                               Foreground="{DynamicResource StatusWarningFg}"/>
                </Border>

                <!-- Telemetry cards (2x2 grid) -->
                <UniformGrid DockPanel.Dock="Top" Rows="2" Columns="2" Margin="0,0,0,12">

                    <!-- CPU -->
                    <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource RowBorder}"
                            BorderThickness="0.5" CornerRadius="6" Padding="12,10" Margin="0,0,4,4">
                        <StackPanel>
                            <TextBlock Text="CPU USAGE" FontSize="9" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextDim}" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding CpuDisplay}" FontFamily="Consolas"
                                       FontSize="20" FontWeight="Medium">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CpuLevel}" Value="Busy">
                                                <Setter Property="Foreground" Value="{DynamicResource StatusRunningFg}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding CpuLevel}" Value="Warn">
                                                <Setter Property="Foreground" Value="{DynamicResource StatusWarningFg}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding CpuLevel}" Value="Empty">
                                                <Setter Property="Foreground" Value="{DynamicResource TextDim}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <Border Height="3" Margin="0,5,0,0" CornerRadius="2"
                                    Background="{DynamicResource StatusIdleBg}">
                                <Border CornerRadius="2" HorizontalAlignment="Left"
                                        Width="{Binding CpuPercent, Converter={StaticResource PercentToWidth}, ConverterParameter=200}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource StatusSuccessFg}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CpuLevel}" Value="Busy">
                                                    <Setter Property="Background" Value="{DynamicResource StatusRunningFg}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding CpuLevel}" Value="Warn">
                                                    <Setter Property="Background" Value="{DynamicResource StatusWarningFg}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding CpuLevel}" Value="Empty">
                                                    <Setter Property="Background" Value="{DynamicResource TextDim}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                            </Border>
                            <TextBlock Text="{Binding CpuSub}" FontFamily="Consolas" FontSize="9"
                                       Foreground="{DynamicResource TextDim}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Memory -->
                    <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource RowBorder}"
                            BorderThickness="0.5" CornerRadius="6" Padding="12,10" Margin="4,0,0,4">
                        <StackPanel>
                            <TextBlock Text="MEMORY" FontSize="9" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextDim}" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding MemDisplay}" FontFamily="Consolas"
                                       FontSize="20" FontWeight="Medium">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding MemLevel}" Value="Busy">
                                                <Setter Property="Foreground" Value="{DynamicResource StatusRunningFg}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding MemLevel}" Value="Warn">
                                                <Setter Property="Foreground" Value="{DynamicResource StatusWarningFg}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding MemLevel}" Value="Empty">
                                                <Setter Property="Foreground" Value="{DynamicResource TextDim}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <Border Height="3" Margin="0,5,0,0" CornerRadius="2"
                                    Background="{DynamicResource StatusIdleBg}">
                                <Border CornerRadius="2" HorizontalAlignment="Left"
                                        Width="{Binding MemPercent, Converter={StaticResource PercentToWidth}, ConverterParameter=200}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource StatusSuccessFg}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding MemLevel}" Value="Busy">
                                                    <Setter Property="Background" Value="{DynamicResource StatusRunningFg}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding MemLevel}" Value="Warn">
                                                    <Setter Property="Background" Value="{DynamicResource StatusWarningFg}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding MemLevel}" Value="Empty">
                                                    <Setter Property="Background" Value="{DynamicResource TextDim}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                            </Border>
                            <TextBlock Text="{Binding MemSub}" FontFamily="Consolas" FontSize="9"
                                       Foreground="{DynamicResource TextDim}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Disk -->
                    <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource RowBorder}"
                            BorderThickness="0.5" CornerRadius="6" Padding="12,10" Margin="0,4,4,0">
                        <StackPanel>
                            <TextBlock Text="DISK" FontSize="9" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextDim}" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding DiskDisplay}" FontFamily="Consolas"
                                       FontSize="20" FontWeight="Medium">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DiskLevel}" Value="Warn">
                                                <Setter Property="Foreground" Value="{DynamicResource StatusWarningFg}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding DiskLevel}" Value="Empty">
                                                <Setter Property="Foreground" Value="{DynamicResource TextDim}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <Border Height="3" Margin="0,5,0,0" CornerRadius="2"
                                    Background="{DynamicResource StatusIdleBg}">
                                <Border CornerRadius="2" HorizontalAlignment="Left"
                                        Width="{Binding DiskPercent, Converter={StaticResource PercentToWidth}, ConverterParameter=200}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource StatusSuccessFg}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DiskLevel}" Value="Warn">
                                                    <Setter Property="Background" Value="{DynamicResource StatusWarningFg}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding DiskLevel}" Value="Empty">
                                                    <Setter Property="Background" Value="{DynamicResource TextDim}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                            </Border>
                            <TextBlock Text="{Binding DiskSub}" FontFamily="Consolas" FontSize="9"
                                       Foreground="{DynamicResource TextDim}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Processes -->
                    <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource RowBorder}"
                            BorderThickness="0.5" CornerRadius="6" Padding="12,10" Margin="4,4,0,0">
                        <StackPanel>
                            <TextBlock Text="PROCESSES" FontSize="9" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextDim}" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding NetDisplay}" FontFamily="Consolas"
                                       FontSize="20" FontWeight="Medium">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding NetLevel}" Value="Ok">
                                                <Setter Property="Foreground" Value="{DynamicResource StatusSuccessFg}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding NetLevel}" Value="Warn">
                                                <Setter Property="Foreground" Value="{DynamicResource StatusWarningFg}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding NetLevel}" Value="Empty">
                                                <Setter Property="Foreground" Value="{DynamicResource TextDim}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <Border Height="3" Margin="0,5,0,0" CornerRadius="2"
                                    Background="{DynamicResource StatusIdleBg}">
                                <Border CornerRadius="2" HorizontalAlignment="Left"
                                        Width="{Binding NetHealthPercent, Converter={StaticResource PercentToWidth}, ConverterParameter=200}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource StatusSuccessFg}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding NetLevel}" Value="Warn">
                                                    <Setter Property="Background" Value="{DynamicResource StatusWarningFg}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding NetLevel}" Value="Empty">
                                                    <Setter Property="Background" Value="{DynamicResource TextDim}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                            </Border>
                            <TextBlock Text="{Binding NetSub}" FontFamily="Consolas" FontSize="9"
                                       Foreground="{DynamicResource TextDim}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- Tab strip -->
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                    <RadioButton Content="Live log" GroupName="MonTab" Style="{StaticResource MonitorTab}"
                                 IsChecked="True"
                                 Command="{Binding SwitchTabCommand}" CommandParameter="LiveLog"/>
                    <RadioButton Content="Diagnostics" GroupName="MonTab" Style="{StaticResource MonitorTab}"
                                 Command="{Binding SwitchTabCommand}" CommandParameter="Diagnostics"/>
                    <RadioButton Content="History" GroupName="MonTab" Style="{StaticResource MonitorTab}"
                                 Command="{Binding SwitchTabCommand}" CommandParameter="History"/>
                    <Button Content="Run diagnostics" Command="{Binding RunDiagnosticsCommand}"
                            Margin="14,0,0,0" Padding="10,4" FontSize="11"
                            Background="Transparent" BorderBrush="{DynamicResource RowBorder}"
                            BorderThickness="0.5" Foreground="{DynamicResource TextSecondary}" Cursor="Hand"/>
                </StackPanel>

                <!-- Tab content -->
                <Border BorderBrush="{DynamicResource RowBorder}" BorderThickness="0.5"
                        CornerRadius="6" Background="{DynamicResource CardBg}">
                    <Grid>
                        <!-- LIVE LOG TAB -->
                        <ListBox ItemsSource="{Binding LiveLog}"
                                 Background="Transparent" BorderThickness="0"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.Style>
                                <Style TargetType="ListBox">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ActiveTab}" Value="LiveLog">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ListBox.Style>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:LiveLogEntryVM}">
                                    <Grid Margin="8,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="58"/>
                                            <ColumnDefinition Width="38"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Timestamp}"
                                                   FontFamily="Consolas" FontSize="10"
                                                   Foreground="{DynamicResource TextDim}"/>
                                        <Border Grid.Column="1" CornerRadius="2" Padding="3,0"
                                                Margin="0,0,4,0" HorizontalAlignment="Left">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{DynamicResource StatusRunningBg}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Tag}" Value="ERR">
                                                            <Setter Property="Background" Value="{DynamicResource StatusFailedBg}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding Tag}" FontSize="8"
                                                       FontFamily="Consolas" FontWeight="Medium">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource StatusRunningFg}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Tag}" Value="ERR">
                                                                <Setter Property="Foreground" Value="{DynamicResource StatusFailedFg}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                        <TextBlock Grid.Column="2" Text="{Binding Message}"
                                                   FontFamily="Consolas" FontSize="10"
                                                   Foreground="{DynamicResource TextSecondary}"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- DIAGNOSTICS TAB -->
                        <ScrollViewer>
                            <ScrollViewer.Style>
                                <Style TargetType="ScrollViewer">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ActiveTab}" Value="Diagnostics">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ScrollViewer.Style>
                            <ItemsControl ItemsSource="{Binding Diagnostics}" Padding="10">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:DiagnosticVM}">
                                        <Border Background="{DynamicResource StatusIdleBg}"
                                                BorderBrush="{DynamicResource RowBorder}"
                                                BorderThickness="0.5" CornerRadius="4"
                                                Padding="8,6" Margin="0,2">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="22"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Width="18" Height="18"
                                                        CornerRadius="3" HorizontalAlignment="Left">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="{DynamicResource StatusSuccessBg}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Status}" Value="warn">
                                                                    <Setter Property="Background" Value="{DynamicResource StatusWarningBg}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="err">
                                                                    <Setter Property="Background" Value="{DynamicResource StatusFailedBg}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               FontSize="11" FontWeight="Medium">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="✓"/>
                                                                <Setter Property="Foreground" Value="{DynamicResource StatusSuccessFg}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Status}" Value="warn">
                                                                        <Setter Property="Text" Value="!"/>
                                                                        <Setter Property="Foreground" Value="{DynamicResource StatusWarningFg}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Status}" Value="err">
                                                                        <Setter Property="Text" Value="✗"/>
                                                                        <Setter Property="Foreground" Value="{DynamicResource StatusFailedFg}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                                <TextBlock Grid.Column="1" Text="{Binding Name}"
                                                           FontWeight="Medium" FontSize="11"
                                                           Foreground="{DynamicResource TextPrimary}"
                                                           Margin="8,0,0,0" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="2" Text="{Binding Result}"
                                                           FontFamily="Consolas" FontSize="10"
                                                           Foreground="{DynamicResource TextSecondary}"
                                                           VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- HISTORY TAB -->
                        <ScrollViewer>
                            <ScrollViewer.Style>
                                <Style TargetType="ScrollViewer">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ActiveTab}" Value="History">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ScrollViewer.Style>
                            <ItemsControl ItemsSource="{Binding History}" Padding="10">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:HistoryEntryVM}">
                                        <Border Background="{DynamicResource StatusIdleBg}"
                                                CornerRadius="4" Padding="8,6" Margin="0,2">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="110"/>
                                                    <ColumnDefinition Width="70"/>
                                                    <ColumnDefinition Width="70"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding PipelineName}" FontWeight="Medium"
                                                           FontSize="11" Foreground="{DynamicResource TextPrimary}"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Date}"
                                                           FontFamily="Consolas" FontSize="10"
                                                           Foreground="{DynamicResource TextDim}"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="2" Text="{Binding Duration}"
                                                           FontFamily="Consolas" FontSize="10"
                                                           Foreground="{DynamicResource TextDim}"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="3" Text="{Binding Outcome}"
                                                           FontFamily="Consolas" FontSize="10" FontWeight="Medium"
                                                           VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource TextDim}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Outcome}" Value="Completed">
                                                                    <Setter Property="Foreground" Value="{DynamicResource StatusSuccessFg}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Outcome}" Value="Failed">
                                                                    <Setter Property="Foreground" Value="{DynamicResource StatusFailedFg}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </DockPanel>
        </Grid>
    </DockPanel>
</UserControl>
