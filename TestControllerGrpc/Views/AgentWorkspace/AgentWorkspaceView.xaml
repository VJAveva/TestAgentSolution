<UserControl x:Class="TestControllerGrpc.Views.AgentWorkspace.AgentWorkspaceView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="clr-namespace:TestControllerGrpc.Views.AgentWorkspace"
    xmlns:vm="clr-namespace:TestControllerGrpc.ViewModels.AgentWorkspace"
    xmlns:conv="clr-namespace:TestControllerGrpc.Converters">

    <UserControl.Resources>
        <conv:EnumToBoolConverter x:Key="EnumToBool"/>

        <Style x:Key="ModeRadio" TargetType="RadioButton">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Padding="10,5" CornerRadius="4" Cursor="Hand"
                                Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentBtnBg}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource TabHoverBg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground" Value="{DynamicResource TextP}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="1"/>
        </Style>
    </UserControl.Resources>

    <DockPanel>
        <!-- Mode switcher bar -->
        <Border DockPanel.Dock="Top" Padding="8,6" Background="{DynamicResource BgCard}"
                BorderBrush="{DynamicResource Bdr}" BorderThickness="0,0,0,1">
            <DockPanel>
                <StackPanel Orientation="Horizontal">
                    <Border Background="{DynamicResource BgPanel}" CornerRadius="5" Padding="2">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton GroupName="AgentMode" Style="{StaticResource ModeRadio}"
                                         Content="▦ Fleet"
                                         IsChecked="{Binding CurrentMode, Converter={StaticResource EnumToBool}, ConverterParameter=Fleet}"/>
                            <RadioButton GroupName="AgentMode" Style="{StaticResource ModeRadio}"
                                         Content="● Monitor"
                                         IsChecked="{Binding CurrentMode, Converter={StaticResource EnumToBool}, ConverterParameter=Monitor}"/>
                            <RadioButton GroupName="AgentMode" Style="{StaticResource ModeRadio}"
                                         Content="⚙ Registry"
                                         IsChecked="{Binding CurrentMode, Converter={StaticResource EnumToBool}, ConverterParameter=Registry}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Content area: switches based on CurrentMode -->
        <Grid x:Name="ContentGrid">
            <views:FleetView DataContext="{Binding Fleet}">
                <views:FleetView.Style>
                    <Style TargetType="UserControl">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DataContext.CurrentMode, ElementName=ContentGrid}" Value="Fleet">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </views:FleetView.Style>
            </views:FleetView>
            <views:MonitorView DataContext="{Binding Monitor}">
                <views:MonitorView.Style>
                    <Style TargetType="UserControl">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DataContext.CurrentMode, ElementName=ContentGrid}" Value="Monitor">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </views:MonitorView.Style>
            </views:MonitorView>
            <views:RegistryView DataContext="{Binding Registry}">
                <views:RegistryView.Style>
                    <Style TargetType="UserControl">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DataContext.CurrentMode, ElementName=ContentGrid}" Value="Registry">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </views:RegistryView.Style>
            </views:RegistryView>
        </Grid>
    </DockPanel>
</UserControl>
