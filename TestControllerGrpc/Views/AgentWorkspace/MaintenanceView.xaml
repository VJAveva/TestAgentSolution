<UserControl x:Class="TestControllerGrpc.Views.AgentWorkspace.MaintenanceView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:TestControllerGrpc.ViewModels.AgentWorkspace">

    <UserControl.Resources>
        <!-- This was the only view with DataGrids and no DataGrid styling, so both grids fell back to the
             default WPF chrome: white rows and full gridlines. Implicit styles, so both pick them up. -->
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextP}"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="RowBackground" Value="Transparent"/>
            <Setter Property="AlternatingRowBackground" Value="{DynamicResource TabHoverBg}"/>
            <Setter Property="AlternationCount" Value="2"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource BgPanel}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextS}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSize9}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Bdr}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Foreground" Value="{DynamicResource TextP}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="DataGridRow">
            <Setter Property="Foreground" Value="{DynamicResource TextP}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource FieldBg}"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentBtnBg}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Bottom margin matters: without it the cards touch once the panel is narrow enough to wrap. -->
        <Style x:Key="UpdateKpiCard" TargetType="Border">
            <Setter Property="Margin" Value="0,0,6,6"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
        </Style>
        <Style x:Key="UpdateKpiValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource FontSize16}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="UpdateKpiLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource FontSize9}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextS}"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
    </UserControl.Resources>

    <DockPanel>
        <!-- Header -->
        <Border DockPanel.Dock="Top" Padding="10,6" Background="{DynamicResource BgCard}"
                BorderBrush="{DynamicResource Bdr}" BorderThickness="0,0,0,1">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="↻ Refresh" Padding="10,4" FontSize="{StaticResource FontSize9}" Cursor="Hand"
                        Command="{Binding RefreshHistoryCommand}"
                        Background="{DynamicResource AccentBtnBg}" Foreground="{DynamicResource Accent}"
                        BorderBrush="{DynamicResource Accent}" BorderThickness="1"/>
                <TextBlock VerticalAlignment="Center" FontSize="{StaticResource FontSize10}" Foreground="{DynamicResource TextS}">
                    <Run Text="{Binding ActiveCount, Mode=OneWay}" FontWeight="SemiBold" Foreground="{DynamicResource TextP}"/>
                    <Run Text=" active ·"/>
                    <Run Text="{Binding History.Count, Mode=OneWay}" Foreground="{DynamicResource TextP}"/>
                    <Run Text=" in history"/>
                </TextBlock>
            </DockPanel>
        </Border>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- R19: Windows updates rollup + per-node grid -->
            <Expander Grid.Row="0" IsExpanded="True" Margin="10,8,10,0"
                      Foreground="{DynamicResource TextP}"
                      Visibility="{Binding HasUpdates, Converter={StaticResource BoolVis}}">
                <Expander.Header>
                    <TextBlock Text="Windows updates" FontSize="{StaticResource FontSize10}" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextP}"/>
                </Expander.Header>
                <StackPanel Margin="0,6,0,0">
                    <!-- One wrapping row holding two groups: the cards, then the filter + action cluster.
                         This was a DockPanel, which gives docked children their width FIRST and leaves the
                         cards the remainder - in a narrow pane that collapsed them into a single column. -->
                    <WrapPanel>
                        <!-- ItemWidth keeps every card the same width so wrapped rows line up as columns. -->
                        <WrapPanel ItemWidth="112" VerticalAlignment="Top">
                            <Border Style="{StaticResource UpdateKpiCard}"
                                    Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Bdr}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Updates.ReportingCount}" Style="{StaticResource UpdateKpiValue}"
                                               Foreground="{DynamicResource TextP}"/>
                                    <TextBlock Text="agents reporting" Style="{StaticResource UpdateKpiLabel}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource UpdateKpiCard}"
                                    Background="{DynamicResource StatusRebootBg}" BorderBrush="{DynamicResource StatusRebootFg}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Updates.RebootRequiredCount}" Style="{StaticResource UpdateKpiValue}"
                                               Foreground="{DynamicResource StatusRebootFg}"/>
                                    <TextBlock Text="reboot required" Style="{StaticResource UpdateKpiLabel}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource UpdateKpiCard}"
                                    Background="{DynamicResource StatusRunningBg}" BorderBrush="{DynamicResource StatusRunningFg}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Updates.PendingCount}" Style="{StaticResource UpdateKpiValue}"
                                               Foreground="{DynamicResource Accent}"/>
                                    <TextBlock Text="updates pending" Style="{StaticResource UpdateKpiLabel}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource UpdateKpiCard}"
                                    Background="{DynamicResource StatusWarningBg}" BorderBrush="{DynamicResource StatusWarningFg}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Updates.ScanUnknownCount}" Style="{StaticResource UpdateKpiValue}"
                                               Foreground="{DynamicResource StatusWarningFg}"/>
                                    <TextBlock Text="scan not proven" Style="{StaticResource UpdateKpiLabel}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource UpdateKpiCard}"
                                    Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Bdr}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Updates.FailedCount}" Style="{StaticResource UpdateKpiValue}"
                                               Foreground="{DynamicResource AccRed}"/>
                                    <TextBlock Text="install failed" Style="{StaticResource UpdateKpiLabel}"/>
                                </StackPanel>
                            </Border>
                        </WrapPanel>

                        <!-- At 50+ nodes the grid is unreadable unbounded: filter first. Filter and action
                             travel together so they wrap onto their own line as a unit. Top-aligned with a
                             nudge so they sit level with the first row of cards however the panel wraps. -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Top" Margin="0,8,0,6">
                            <TextBlock VerticalAlignment="Center" FontSize="{StaticResource FontSize9}" Margin="0,0,6,0"
                                       Foreground="{DynamicResource TextS}" Text="Show"/>
                            <ComboBox Width="150" FontSize="{StaticResource FontSize9}" VerticalAlignment="Center"
                                      ItemsSource="{Binding Updates.RowFilters}"
                                      DisplayMemberPath="Label"
                                      SelectedValuePath="Value"
                                      SelectedValue="{Binding Updates.RowFilter, Mode=TwoWay}"
                                      ToolTip="Narrow the grid to the agents that need action" AutomationProperties.Name="Show" />
                            <TextBlock VerticalAlignment="Center" FontSize="{StaticResource FontSize9}" Margin="8,0,10,0"
                                       Foreground="{DynamicResource TextS}"
                                       Text="{Binding Updates.FilterSummary}"/>
                            <Button Content="Reboot all ready" Padding="10,4" FontSize="{StaticResource FontSize9}"
                                    Cursor="Hand" VerticalAlignment="Center"
                                    Command="{Binding Updates.RebootAllReadyCommand}"
                                    IsEnabled="{Binding Updates.CanRebootAllReady}"
                                    ToolTip="Queues a reboot for every node reporting Reboot required that is not draining."
                                    Background="{DynamicResource StatusRebootBg}" Foreground="{DynamicResource StatusRebootFg}"
                                    BorderBrush="{DynamicResource StatusRebootFg}" BorderThickness="1"/>
                        </StackPanel>
                    </WrapPanel>

                    <DataGrid ItemsSource="{Binding Updates.FilteredRows}" MaxHeight="420"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              HeadersVisibility="Column"
                              Background="Transparent" BorderThickness="0" FontSize="{StaticResource FontSize9}"
                              FrozenColumnCount="1"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Agent" Binding="{Binding AgentName}" Width="130" MinWidth="120"/>
                            <DataGridTextColumn Header="Update state" Binding="{Binding StateText}" Width="110" MinWidth="110"/>
                            <DataGridTextColumn x:Name="LastInstallColumn" Header="Last install" Binding="{Binding LastInstall}" Width="120" MinWidth="110"/>
                                <DataGridTextColumn Header="Pending" Binding="{Binding PendingText}" Width="60" MinWidth="70"/>
                            <DataGridTextColumn x:Name="DetectedByColumn" Header="Detected by" Binding="{Binding DetectedBy}" Width="100" MinWidth="130"/>
                            <DataGridTextColumn Header="Last report" Binding="{Binding LastReport}" Width="90" MinWidth="100">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsStale}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource StatusMaintenanceFg}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Dispatch" Binding="{Binding DispatchText}" Width="80" MinWidth="90"/>
                            <!-- Auto, never *: a star column absorbs the deficit and collapses, which is what made these buttons unreachable. -->
                            <DataGridTemplateColumn Header="Actions" Width="Auto" MinWidth="160">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <!-- Patches the LIVE node only; a later revert discards the updates. -->
                                            <Button Content="{Binding Action.Label}" Padding="6,2" FontSize="{StaticResource FontSize9}" Margin="0,0,4,0"
                                                    Cursor="Hand" MinWidth="104"
                                                    IsEnabled="{Binding Action.CanAct}"
                                                    ToolTip="{Binding Action.Detail}"
                                                    Command="{Binding DataContext.Updates.UpdateActionCommand,
                                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding AgentName}"/>
                                            <Button Content="Reboot now" Padding="6,2" FontSize="{StaticResource FontSize9}" Margin="0,0,4,0"
                                                    Cursor="Hand" IsEnabled="{Binding IsRebootRequired}"
                                                    ToolTip="{Binding Provenance}"
                                                    Command="{Binding DataContext.Updates.RebootNodeCommand,
                                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding AgentName}"/>
                                            <Button Content="Snooze 4h" Padding="6,2" FontSize="{StaticResource FontSize9}"
                                                    Cursor="Hand" IsEnabled="{Binding HasBadge}"
                                                    Command="{Binding DataContext.Updates.SnoozeCommand,
                                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding AgentName}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Expander>

            <!-- R7 + R14: Active operations with live phase, progress and provenance -->
            <ItemsControl Grid.Row="1" ItemsSource="{Binding ActiveOperations}" Margin="8,8,8,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:MaintenanceOpVM}">
                        <Border Margin="0,0,0,8" Padding="12" CornerRadius="6"
                                Background="{DynamicResource StatusMaintenanceBg}" BorderBrush="{DynamicResource StatusMaintenanceFg}" BorderThickness="1">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Elapsed}" FontSize="{StaticResource FontSize10}"
                                               VerticalAlignment="Center" Foreground="{DynamicResource TextS}"/>
                                    <TextBlock FontSize="{StaticResource FontSize12}" FontWeight="SemiBold" Foreground="{DynamicResource TextP}">
                                        <Run Text="{Binding NodeId, Mode=OneWay}" FontFamily="Consolas"/>
                                        <Run Text=" · "/>
                                        <Run Text="{Binding KindText, Mode=OneWay}"/>
                                        <Run Text=" · "/>
                                        <Run Text="{Binding StateText, Mode=OneWay}" Foreground="{DynamicResource StatusMaintenanceFg}"/>
                                    </TextBlock>
                                </DockPanel>

                                <TextBlock Text="{Binding Message}" FontSize="{StaticResource FontSize10}" Margin="0,5,0,5"
                                           Foreground="{DynamicResource TextS}" TextWrapping="Wrap"/>

                                <ProgressBar Height="4" Minimum="0" Maximum="100"
                                             Value="{Binding ProgressPercent, Mode=OneWay}"
                                             Foreground="{DynamicResource StatusMaintenanceFg}" Background="{DynamicResource Bdr}" BorderThickness="0"/>
                                <TextBlock Margin="0,3,0,0" FontSize="{StaticResource FontSize9}" Foreground="{DynamicResource TextS}">
                                    <Run Text="Step"/><Run Text="{Binding StepNumber, Mode=OneWay}"/>
                                    <Run Text="of"/><Run Text="{Binding StepCount, Mode=OneWay}"/>
                                    <Run Text=" · "/><Run Text="{Binding PhaseText, Mode=OneWay}"/>
                                </TextBlock>

                                <!-- R14: provenance strip -->
                                <Border Margin="0,8,0,0" Padding="8" CornerRadius="4" Background="{DynamicResource BgPanel}">
                                    <WrapPanel>
                                        <StackPanel Margin="0,0,18,4">
                                            <TextBlock Text="Triggered from" FontSize="{StaticResource FontSize9}" Foreground="{DynamicResource TextS}"/>
                                            <TextBlock Text="{Binding TriggerSourceText}" FontSize="{StaticResource FontSize10}" Foreground="{DynamicResource TextP}"/>
                                        </StackPanel>
                                        <StackPanel Margin="0,0,18,4">
                                            <TextBlock Text="By" FontSize="{StaticResource FontSize9}" Foreground="{DynamicResource TextS}"/>
                                            <TextBlock Text="{Binding TriggeredBy}" FontSize="{StaticResource FontSize10}" Foreground="{DynamicResource TextP}"/>
                                        </StackPanel>
                                        <StackPanel Margin="0,0,18,4">
                                            <TextBlock Text="Reason" FontSize="{StaticResource FontSize9}" Foreground="{DynamicResource TextS}"/>
                                            <TextBlock Text="{Binding Reason}" FontSize="{StaticResource FontSize10}" Foreground="{DynamicResource TextP}"/>
                                        </StackPanel>
                                        <StackPanel Margin="0,0,18,4">
                                            <TextBlock Text="Snapshot" FontSize="{StaticResource FontSize9}" Foreground="{DynamicResource TextS}"/>
                                            <TextBlock Text="{Binding SnapshotName}" FontSize="{StaticResource FontSize10}" Foreground="{DynamicResource TextP}"/>
                                        </StackPanel>
                                        <StackPanel Margin="0,0,18,4">
                                            <TextBlock Text="Script" FontSize="{StaticResource FontSize9}" Foreground="{DynamicResource TextS}"/>
                                            <TextBlock Text="{Binding ScriptPath}" FontSize="{StaticResource FontSize10}" Foreground="{DynamicResource TextP}"
                                                       TextTrimming="CharacterEllipsis" MaxWidth="220"/>
                                        </StackPanel>
                                        <StackPanel Margin="0,0,0,4">
                                            <TextBlock Text="Linked run" FontSize="{StaticResource FontSize9}" Foreground="{DynamicResource TextS}"/>
                                            <TextBlock Text="{Binding LinkedRun}" FontSize="{StaticResource FontSize10}" Foreground="{DynamicResource TextP}"/>
                                        </StackPanel>
                                    </WrapPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- R11: completed-operation history -->
            <DockPanel Grid.Row="2" Margin="8">
                <!-- Labelled: without it the second grid's header reads as another header row of the one above. -->
                <TextBlock DockPanel.Dock="Top" Text="HISTORY" FontSize="{StaticResource FontSize9}"
                           FontWeight="SemiBold" Foreground="{DynamicResource TextS}" Margin="0,0,0,4"/>
                <DataGrid ItemsSource="{Binding History}" AutoGenerateColumns="False"
                          IsReadOnly="True" CanUserAddRows="False"
                          HeadersVisibility="Column" Background="Transparent" BorderThickness="0"
                          Foreground="{DynamicResource TextP}"
                          HorizontalScrollBarVisibility="Auto" FontSize="{StaticResource FontSize10}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Agent" Binding="{Binding NodeId, Mode=OneWay}" Width="120"/>
                    <DataGridTextColumn Header="Operation" Binding="{Binding KindText, Mode=OneWay}" Width="90"/>
                    <DataGridTextColumn Header="Snapshot" Binding="{Binding SnapshotName, Mode=OneWay}" Width="150"/>
                    <DataGridTextColumn Header="Source" Binding="{Binding TriggerSourceText, Mode=OneWay}" Width="90"/>
                    <DataGridTextColumn Header="By" Binding="{Binding TriggeredBy, Mode=OneWay}" Width="120"/>
                    <DataGridTextColumn Header="Started" Binding="{Binding StartedText, Mode=OneWay}" Width="120"/>
                    <DataGridTextColumn Header="Duration" Binding="{Binding DurationText, Mode=OneWay}" Width="80"/>
                    <DataGridTextColumn Header="Result" Binding="{Binding ResultText, Mode=OneWay}" Width="90"/>
                </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Grid>
    </DockPanel>
</UserControl>
