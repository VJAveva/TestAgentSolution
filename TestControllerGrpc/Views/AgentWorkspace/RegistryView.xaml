<UserControl x:Class="TestControllerGrpc.Views.AgentWorkspace.RegistryView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:TestControllerGrpc.ViewModels.AgentWorkspace">

    <UserControl.Resources>
        <!-- View-local styles used throughout the registry view.
             These are referenced by both DynamicResource *and* (critically)
             StaticResource (see the ToolBtn "BasedOn" below), which must
             resolve at XAML parse time — so they must be defined in scope. -->

        <!-- Compact, flat, themed button. Honors the per-button Background /
             Foreground supplied at each call site. -->
        <Style x:Key="SmBtn" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource BgSurface}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextP}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="4"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True"
                                TextElement.Foreground="{TemplateBinding Foreground}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.70"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.40"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Field caption label -->
        <Style x:Key="Lbl" TargetType="Label">
            <Setter Property="Foreground" Value="{DynamicResource TextS}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
        </Style>

        <!-- Single-line text field -->
        <Style x:Key="Fld" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource FieldBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextP}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Bdr}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition>
                <ColumnDefinition.Style>
                    <Style TargetType="ColumnDefinition">
                        <Setter Property="Width" Value="0"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                <Setter Property="Width" Value="320"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ColumnDefinition.Style>
            </ColumnDefinition>
        </Grid.ColumnDefinitions>

        <!-- Left: Agent table -->
        <DockPanel Grid.Column="0" Margin="6">
            <!-- Title row: heading + primary action -->
            <Border DockPanel.Dock="Top" Padding="8,6,8,2">
                <DockPanel>
                    <Button Content="+ Add Agent" FontSize="10" DockPanel.Dock="Right" Height="26" Margin="0"
                            Style="{DynamicResource SmBtn}" VerticalAlignment="Center"
                            Background="{DynamicResource AccPeach}" Foreground="{DynamicResource TreeBadgeFg}"
                            Command="{Binding AddNewCommand}"
                            ToolTip="Register a new agent"/>
                    <TextBlock Text="Registered Agents" FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextP}" VerticalAlignment="Center"/>
                </DockPanel>
            </Border>

            <!-- Toolbar row: grouped bulk operations (captions on top baseline, buttons on one baseline) -->
            <Border DockPanel.Dock="Top" Padding="8,4,8,6">
                <Border.Resources>
                    <!-- Uniform toolbar button: fixed height + consistent spacing so every button aligns -->
                    <Style x:Key="ToolBtn" TargetType="Button" BasedOn="{StaticResource SmBtn}">
                        <Setter Property="Height" Value="26"/>
                        <Setter Property="Margin" Value="0,0,4,0"/>
                        <Setter Property="VerticalAlignment" Value="Center"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                    </Style>
                    <Style x:Key="ToolCaption" TargetType="TextBlock">
                        <Setter Property="FontSize" Value="8"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Opacity" Value="0.6"/>
                        <Setter Property="Foreground" Value="{DynamicResource TextS}"/>
                        <Setter Property="Margin" Value="2,0,0,3"/>
                    </Style>
                    <Style x:Key="ToolGroup" TargetType="StackPanel">
                        <Setter Property="Orientation" Value="Vertical"/>
                        <Setter Property="VerticalAlignment" Value="Top"/>
                        <Setter Property="Margin" Value="0,0,0,0"/>
                    </Style>
                </Border.Resources>
                <WrapPanel Orientation="Horizontal">
                    <!-- Group: Diagnostics -->
                    <StackPanel Style="{StaticResource ToolGroup}">
                        <TextBlock Text="DIAGNOSTICS" Style="{StaticResource ToolCaption}"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource ToolBtn}"
                                    Background="{DynamicResource GreenBtnBg}" Foreground="{DynamicResource AccGreen}"
                                    Command="{Binding TestAllCommand}"
                                    ToolTip="Test connectivity for all registered agents">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8AF;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <TextBlock Text="Test All" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>

                    <Border Width="1" Height="26" VerticalAlignment="Bottom" Margin="8,0,12,0" Background="{DynamicResource Bdr}"/>

                    <!-- Group: Backup -->
                    <StackPanel Style="{StaticResource ToolGroup}">
                        <TextBlock Text="BACKUP" Style="{StaticResource ToolCaption}"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource ToolBtn}"
                                    Command="{Binding ExportAgentsCommand}"
                                    ToolTip="Export all registered agents to a JSON file">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <TextBlock Text="Export" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource ToolBtn}"
                                    Command="{Binding ImportAgentsCommand}"
                                    ToolTip="Import a JSON agent list and register all entries">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE898;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <TextBlock Text="Import" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>

                    <Border Width="1" Height="26" VerticalAlignment="Bottom" Margin="8,0,12,0" Background="{DynamicResource Bdr}"/>

                    <!-- Group: Fleet (bulk register/unregister) -->
                    <StackPanel Style="{StaticResource ToolGroup}">
                        <TextBlock Text="FLEET" Style="{StaticResource ToolCaption}"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource ToolBtn}"
                                    Background="{DynamicResource GreenBtnBg}" Foreground="{DynamicResource AccGreen}"
                                    Command="{Binding RegisterAllCommand}"
                                    ToolTip="Re-register all listed agents simultaneously">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <TextBlock Text="Register All" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource ToolBtn}" Margin="0"
                                    Background="{DynamicResource DangerBtnBg}" Foreground="{DynamicResource AccRed}"
                                    Command="{Binding UnregisterAllCommand}"
                                    ToolTip="Unregister all agents simultaneously">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <TextBlock Text="Unregister All" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </WrapPanel>
            </Border>

            <!-- Diagnostic results banner -->
            <Border DockPanel.Dock="Bottom" Padding="8,4" CornerRadius="4" Margin="0,4,0,0"
                    Background="{DynamicResource InfoBoxBg}"
                    BorderBrush="{DynamicResource Bdr}" BorderThickness="1">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasDiagnosticResult}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="?" FontSize="9" Padding="4,2"
                            Background="Transparent" BorderThickness="0" Cursor="Hand"
                            Foreground="{DynamicResource TextS}"
                            Command="{Binding ClearDiagnosticCommand}" ToolTip="Dismiss"/>
                    <TextBlock Text="{Binding DiagnosticResult}" FontSize="10" FontFamily="Consolas"
                               Foreground="{DynamicResource TextS}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                </DockPanel>
            </Border>

            <DataGrid ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}"
                      AutoGenerateColumns="False" IsReadOnly="True"
                      Background="Transparent" BorderThickness="0"
                      RowBackground="{DynamicResource BgCard}"
                      AlternatingRowBackground="{DynamicResource BgPanel}"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="{DynamicResource Bdr}"
                      HeadersVisibility="Column" CanUserResizeRows="False"
                      SelectionMode="Single" SelectionUnit="FullRow"
                      FontSize="11">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="{DynamicResource BgPanel}"/>
                        <Setter Property="Foreground" Value="{DynamicResource TextS}"/>
                        <Setter Property="FontSize" Value="10"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Padding" Value="8,4"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource Bdr}"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Foreground" Value="{DynamicResource TextP}"/>
                        <Setter Property="Padding" Value="6,3"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridCell">
                                    <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                                        <ContentPresenter VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </DataGrid.CellStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="NAME" Binding="{Binding Name}" Width="*"/>
                    <DataGridTextColumn Header="ADDRESS" Binding="{Binding Address}" Width="2*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontFamily" Value="Consolas"/>
                                <Setter Property="FontSize" Value="10"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="STATUS" Binding="{Binding Status}" Width="60"/>
                    <DataGridTemplateColumn Header="LATENCY" Width="60">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock FontSize="10" FontFamily="Consolas" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="{Binding LatencyMs, StringFormat={}{0}ms}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource AccGreen}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding LatencyMs}" Value="-1">
                                                    <Setter Property="Text" Value="—"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource TextS}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>

        <!-- Right: Edit form (only visible when editing) -->
        <Border Grid.Column="1" Margin="0,6,6,6" Padding="12,10" CornerRadius="6"
                Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Bdr}" BorderThickness="1"
                Visibility="{Binding IsEditing, Converter={StaticResource BoolVis}}">
            <StackPanel>
                <DockPanel Margin="0,0,0,10">
                    <Button DockPanel.Dock="Right" Content="?" FontSize="12" Padding="4,2"
                            Background="Transparent" BorderThickness="0" Cursor="Hand"
                            Foreground="{DynamicResource TextS}"
                            Command="{Binding CancelCommand}" ToolTip="Close"/>
                    <TextBlock Text="Agent Details" FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextP}" VerticalAlignment="Center"/>
                </DockPanel>

                <Label Content="Hostname / Agent Name" Style="{DynamicResource Lbl}"/>
                <TextBox Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}"
                         Style="{DynamicResource Fld}" Margin="0,0,0,8"/>

                <Label Content="gRPC Address" Style="{DynamicResource Lbl}"/>
                <TextBox Text="{Binding EditAddress, UpdateSourceTrigger=PropertyChanged}"
                         Style="{DynamicResource Fld}" FontFamily="Consolas" FontSize="11" Margin="0,0,0,12"/>

                <StackPanel Orientation="Vertical">
                    <WrapPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <Button Style="{DynamicResource SmBtn}"
                                Background="{DynamicResource AccGreen}" Foreground="{DynamicResource TreeBadgeFg}"
                                Command="{Binding SaveCommand}" Margin="0,0,4,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBlock Text="Save" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{DynamicResource SmBtn}"
                                Background="{DynamicResource AccentBtnBg}" Foreground="{DynamicResource Accent}"
                                Command="{Binding TestConnectionCommand}" Margin="0,0,4,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE839;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBlock Text="Test" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{DynamicResource SmBtn}"
                                Background="{DynamicResource YellowBtnBg}" Foreground="{DynamicResource AccYellow}"
                                Command="{Binding DiagnoseAgentCommand}" Margin="0,0,4,0"
                                ToolTip="Run full connectivity diagnostic (DNS, TCP, HTTP/2, gRPC)">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBlock Text="Diagnose" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Content="Cancel" Style="{DynamicResource SmBtn}"
                                Background="{DynamicResource BgSurface}" Foreground="{DynamicResource TextS}"
                                Command="{Binding CancelCommand}"/>
                    </WrapPanel>
                    <Button
                            Command="{Binding UnregisterCommand}" HorizontalAlignment="Left"
                            ToolTip="Remove this agent from the registry">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                <Setter Property="Background" Value="{DynamicResource DangerBtnBgAlt}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccRed}"/>
                                <Setter Property="FontSize" Value="11"/>
                                <Setter Property="Padding" Value="8,4"/>
                                <Setter Property="Margin" Value="0,4,0,0"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEditingExisting}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock Text="Unregister Agent" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Test/Diagnose result output -->
                <Border Margin="0,8,0,0" Padding="6" CornerRadius="4"
                        Background="{DynamicResource BgCanvas}"
                        BorderBrush="{DynamicResource Bdr}" BorderThickness="1">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding TestResult}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <DockPanel>
                        <Button DockPanel.Dock="Top" HorizontalAlignment="Right"
                                Style="{DynamicResource SmBtn}" Margin="0,0,0,4"
                                Background="{DynamicResource AccentBtnBg}" Foreground="{DynamicResource Accent}"
                                Command="{Binding CopyDetailsCommand}"
                                ToolTip="Copy diagnostic details to clipboard">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBlock Text="Copy" FontSize="10" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <TextBlock Text="{Binding TestResult}" FontSize="10" FontFamily="Consolas"
                                   Foreground="{DynamicResource TextS}" TextWrapping="Wrap"/>
                    </DockPanel>
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
