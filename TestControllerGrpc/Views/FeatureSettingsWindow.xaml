<Window x:Class="TestControllerGrpc.Views.FeatureSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Features - TestController"
        Height="760" Width="980" MinWidth="720" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBg}">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBlock Text="Features on this controller" FontSize="{StaticResource FontSize15}" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextP}" />
            <TextBlock FontSize="{StaticResource FontSize10}" Foreground="{DynamicResource TextS}" TextWrapping="Wrap" Margin="0,4,0,0">
                <Run Text="Team: " /><Run Text="{Binding TeamName, Mode=OneWay}" FontWeight="SemiBold" />
                <Run Text="  |  File: " /><Run Text="{Binding ConfigPath, Mode=OneWay}" />
            </TextBlock>
            <TextBlock Text="Pipelines, Agents, Library, Pre-flight and Admin are always on."
                       FontSize="{StaticResource FontSize10}" Foreground="{DynamicResource TextS}" Margin="0,2,0,0" />
        </StackPanel>

        <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0" LastChildFill="True">
            <Button DockPanel.Dock="Right" Content="Save" MinWidth="90" Padding="12,4"
                    Style="{DynamicResource PrimaryButtonStyle}" Command="{Binding SaveCommand}"
                    AutomationProperties.Name="Save features" />
            <TextBlock Text="{Binding Status}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0"
                       FontSize="{StaticResource FontSize10}" AutomationProperties.Name="Feature save status">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{DynamicResource TextS}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource AccRed}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </DockPanel>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="150" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" MinHeight="160" />
            </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Rows}" AutomationProperties.Name="Feature list">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="{DynamicResource RowBorder}" BorderThickness="0,0,0,1" Padding="4,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <CheckBox IsChecked="{Binding IsOn}" VerticalAlignment="Top" Margin="0,2,10,0"
                                          AutomationProperties.Name="{Binding Key}" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Key}" FontWeight="SemiBold" Foreground="{DynamicResource TextP}"
                                               FontSize="{StaticResource FontSize12}" />
                                    <TextBlock Text="{Binding Description}" Foreground="{DynamicResource TextS}" TextWrapping="Wrap"
                                               FontSize="{StaticResource FontSize10}" />
                                    <TextBlock Text="{Binding Note}" Foreground="{DynamicResource AccYellow}" TextWrapping="Wrap"
                                               FontSize="{StaticResource FontSize10}"
                                               Visibility="{Binding Note, Converter={StaticResource StringToVisConverter}}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

            <DockPanel Grid.Row="1" Margin="0,12,0,4" LastChildFill="True">
                <Button DockPanel.Dock="Right" Content="Remove" Padding="10,2" Margin="6,0,0,0"
                        Command="{Binding RemoveRepositoryCommand}" AutomationProperties.Name="Remove Code Churn repository" />
                <Button DockPanel.Dock="Right" Content="Add repository" Padding="10,2"
                        Command="{Binding AddRepositoryCommand}" AutomationProperties.Name="Add Code Churn repository" />
                <StackPanel>
                    <TextBlock Text="Code Churn repositories" FontWeight="SemiBold" Foreground="{DynamicResource TextP}"
                               FontSize="{StaticResource FontSize12}" />
                    <TextBlock Foreground="{DynamicResource TextS}" TextWrapping="Wrap" FontSize="{StaticResource FontSize10}"
                               Text="Branches and paths are comma-separated. Paths are folder prefixes (src/) or globs (*.cs); Exclude wins. CredentialRef is the NAME of an environment variable on this controller, never the token." />
                    <TextBlock Text="{Binding RepositoriesNote}" Foreground="{DynamicResource AccYellow}" TextWrapping="Wrap"
                               FontSize="{StaticResource FontSize10}"
                               Visibility="{Binding RepositoriesNote, Converter={StaticResource StringToVisConverter}}" />
                </StackPanel>
            </DockPanel>

            <DataGrid Grid.Row="2" ItemsSource="{Binding Repositories}" SelectedItem="{Binding SelectedRepository}"
                      AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                      HeadersVisibility="Column" AutomationProperties.Name="Code Churn repositories">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Name" Width="130" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                    <DataGridTextColumn Header="Url" Width="2*" Binding="{Binding Url, UpdateSourceTrigger=PropertyChanged}" />
                    <DataGridTextColumn Header="Branches" Width="2*" Binding="{Binding Branches, UpdateSourceTrigger=PropertyChanged}" />
                    <DataGridTextColumn Header="Include paths" Width="*" Binding="{Binding IncludePaths, UpdateSourceTrigger=PropertyChanged}" />
                    <DataGridTextColumn Header="Exclude paths" Width="*" Binding="{Binding ExcludePaths, UpdateSourceTrigger=PropertyChanged}" />
                    <DataGridTextColumn Header="CredentialRef" Width="110" Binding="{Binding CredentialRef, UpdateSourceTrigger=PropertyChanged}" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </DockPanel>
</Window>
