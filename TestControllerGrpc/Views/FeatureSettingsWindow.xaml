<Window x:Class="TestControllerGrpc.Views.FeatureSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Features - TestController"
        Height="520" Width="720" MinWidth="560" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBg}">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBlock Text="Features on this controller" FontSize="{StaticResource FontSize15}" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextP}" />
            <TextBlock FontSize="{StaticResource FontSize10}" Foreground="{DynamicResource TextS}" TextWrapping="Wrap" Margin="0,4,0,0">
                <Run Text="Team: " /><Run Text="{Binding TeamName, Mode=OneWay}" FontWeight="SemiBold" />
                <Run Text="  |  File: " /><Run Text="{Binding ConfigPath, Mode=OneWay}" />
            </TextBlock>
            <TextBlock Text="Pipelines, Agents, Library, Pre-flight and Admin are always on."
                       FontSize="{StaticResource FontSize10}" Foreground="{DynamicResource TextS}" Margin="0,2,0,0" />
        </StackPanel>

        <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0" LastChildFill="True">
            <Button DockPanel.Dock="Right" Content="Save" MinWidth="90" Padding="12,4"
                    Style="{DynamicResource PrimaryButtonStyle}" Command="{Binding SaveCommand}"
                    AutomationProperties.Name="Save features" />
            <TextBlock Text="{Binding Status}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0"
                       FontSize="{StaticResource FontSize10}" AutomationProperties.Name="Feature save status">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{DynamicResource TextS}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource AccRed}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </DockPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Rows}" AutomationProperties.Name="Feature list">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="{DynamicResource RowBorder}" BorderThickness="0,0,0,1" Padding="4,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <CheckBox IsChecked="{Binding IsOn}" VerticalAlignment="Top" Margin="0,2,10,0"
                                          AutomationProperties.Name="{Binding Key}" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Key}" FontWeight="SemiBold" Foreground="{DynamicResource TextP}"
                                               FontSize="{StaticResource FontSize12}" />
                                    <TextBlock Text="{Binding Description}" Foreground="{DynamicResource TextS}" TextWrapping="Wrap"
                                               FontSize="{StaticResource FontSize10}" />
                                    <TextBlock Text="{Binding Note}" Foreground="{DynamicResource AccYellow}" TextWrapping="Wrap"
                                               FontSize="{StaticResource FontSize10}"
                                               Visibility="{Binding Note, Converter={StaticResource StringToVisConverter}}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Window>
