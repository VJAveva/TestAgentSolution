<Window x:Class="TestControllerGrpc.Views.Login.ChangePasswordPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Test Controller — Change Password"
        Height="460" Width="380"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{DynamicResource WindowBg}">

    <Grid Margin="32">
        <StackPanel VerticalAlignment="Center">
            <!-- Brand mark -->
            <Border Width="48" Height="48" CornerRadius="24" Margin="0,0,0,12"
                    Background="#1AF0B070" HorizontalAlignment="Center">
                <TextBlock Text="🔒" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

            <TextBlock Text="Change password" FontSize="18" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center"/>
            <TextBlock Text="You must change your password before continuing" FontSize="11"
                       Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center"
                       TextWrapping="Wrap" TextAlignment="Center" Margin="0,4,0,24"/>

            <!-- Current password -->
            <TextBlock Text="Current password" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4"/>
            <PasswordBox x:Name="CurrentPasswordBox" Padding="8,6" FontSize="13" Margin="0,0,0,12"
                         IsEnabled="{Binding IsLoading, Converter={StaticResource InvertBoolConverter}}"/>

            <!-- New password -->
            <TextBlock Text="New password" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4"/>
            <PasswordBox x:Name="NewPasswordBox" Padding="8,6" FontSize="13" Margin="0,0,0,12"
                         IsEnabled="{Binding IsLoading, Converter={StaticResource InvertBoolConverter}}"/>

            <!-- Confirm new password -->
            <TextBlock Text="Confirm new password" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4"/>
            <PasswordBox x:Name="ConfirmPasswordBox" Padding="8,6" FontSize="13" Margin="0,0,0,12"
                         IsEnabled="{Binding IsLoading, Converter={StaticResource InvertBoolConverter}}"/>

            <!-- Error message -->
            <TextBlock Text="{Binding ErrorMessage}" FontSize="11" Foreground="#F87171"
                       Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisConverter}}"
                       Margin="0,0,0,8" TextWrapping="Wrap"/>

            <!-- Change password button -->
            <Button Content="{Binding IsLoading, Converter={StaticResource BoolToChangePasswordTextConverter}}"
                    Command="{Binding ChangePasswordCommand}"
                    Padding="8,10" FontSize="13" FontWeight="Medium"
                    Background="#74ACEA" Foreground="White"
                    HorizontalAlignment="Stretch" Margin="0,4,0,0"/>

            <!-- Hint -->
            <TextBlock Text="Requirements: 12+ characters, uppercase, lowercase, and a digit"
                       FontSize="9" Foreground="{DynamicResource TextSecondary}"
                       HorizontalAlignment="Center" Margin="0,16,0,0" TextWrapping="Wrap" TextAlignment="Center"/>
        </StackPanel>
    </Grid>
</Window>
