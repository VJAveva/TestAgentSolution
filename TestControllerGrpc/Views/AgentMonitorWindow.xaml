<Window x:Class="TestControllerGrpc.Views.AgentMonitorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle}" Height="550" Width="800"
        MinWidth="600" MinHeight="350"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBg}">

    <Window.Icon>
        <DrawingImage>
            <DrawingImage.Drawing>
                <GeometryDrawing Brush="#FF89B4FA" Geometry="M12,2 C6.48,2 2,6.48 2,12 C2,17.52 6.48,22 12,22 C17.52,22 22,17.52 22,12 C22,6.48 17.52,2 12,2 Z M10,17 L5,12 L6.41,10.59 L10,14.17 L17.59,6.58 L19,8 Z" />
            </DrawingImage.Drawing>
        </DrawingImage>
    </Window.Icon>

    <DockPanel>
        <!-- Status bar -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource BgCard}" Padding="10,8"
                BorderBrush="{DynamicResource Bdr}" BorderThickness="0,0,0,1">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Clear" Padding="10,3"
                        FontSize="10" Margin="6,0,0,0"
                        Command="{Binding ClearHistoryCommand}"
                        Background="{DynamicResource AccentBtnBg}" Foreground="{DynamicResource Accent}"
                        BorderThickness="0" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="4"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <StackPanel Orientation="Horizontal">
                    <!-- Connection indicator -->
                    <Ellipse Width="10" Height="10" Margin="0,0,4,0" VerticalAlignment="Center">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{DynamicResource AccYellow}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ConnectionStatusText}" Value="Connected">
                                        <Setter Property="Fill" Value="{DynamicResource AccGreen}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ConnectionStatusText}" Value="Reconnecting">
                                        <Setter Property="Fill" Value="{DynamicResource AccYellow}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <!-- HC glyph fallback (visible only in High Contrast) -->
                    <TextBlock Margin="0,0,8,0" VerticalAlignment="Center" FontSize="10"
                               FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource HcGlyphFg}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="&#xE783;" /> <!-- Warning -->
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ConnectionStatusText}" Value="Connected">
                                        <Setter Property="Text" Value="&#xE73E;" /> <!-- Checkmark -->
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding MonitorAgentName}" FontWeight="Bold"
                               Foreground="{DynamicResource TextP}" FontSize="13" VerticalAlignment="Center" />
                    <TextBlock Foreground="{DynamicResource TextS}" Margin="12,0,0,0"
                               FontSize="11" VerticalAlignment="Center">
                        <Run Text="{Binding MonitorAgentState, Mode=OneWay}" />
                        <Run Text=" &#x00B7; " />
                        <Run Text="{Binding ConnectionStatusText, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Text="{Binding LiveActionName}" Foreground="{DynamicResource AccGreen}"
                               FontFamily="Consolas" FontSize="11" Margin="20,0,0,0"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               MaxWidth="350" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Health metrics strip -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource BgCard}" Padding="10,6"
                BorderBrush="{DynamicResource Bdr}" BorderThickness="0,0,0,1">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasMetrics}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel Orientation="Horizontal">
                <TextBlock Foreground="{DynamicResource TextS}" FontSize="10" VerticalAlignment="Center"
                           Margin="0,0,12,0" Text="HEALTH" FontWeight="SemiBold" />
                <!-- CPU -->
                <TextBlock FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"
                           Foreground="{DynamicResource TextS}" Text="CPU" />
                <TextBlock FontSize="11" VerticalAlignment="Center" FontFamily="Consolas"
                           Foreground="{DynamicResource Accent}"
                           Text="{Binding CpuUsagePct, StringFormat='{}{0:F1}%'}" />
                <TextBlock Foreground="{DynamicResource TextS}" Margin="12,0,6,0"
                           FontSize="11" VerticalAlignment="Center" Text="MEM" />
                <TextBlock FontSize="11" VerticalAlignment="Center" FontFamily="Consolas"
                           Foreground="{DynamicResource Accent}">
                    <TextBlock.Text>
                        <MultiBinding StringFormat="{}{0:F0} / {1:F0} MB">
                            <Binding Path="MemoryUsedMb" />
                            <Binding Path="MemoryTotalMb" />
                        </MultiBinding>
                    </TextBlock.Text>
                </TextBlock>
                <TextBlock Foreground="{DynamicResource TextS}" Margin="12,0,6,0"
                           FontSize="11" VerticalAlignment="Center" Text="DISK FREE" />
                <TextBlock FontSize="11" VerticalAlignment="Center" FontFamily="Consolas"
                           Foreground="{DynamicResource Accent}"
                           Text="{Binding DiskFreeGb, StringFormat='{}{0:F1} GB'}" />
                <TextBlock Foreground="{DynamicResource TextS}" Margin="12,0,6,0"
                           FontSize="11" VerticalAlignment="Center" Text="PROCS" />
                <TextBlock FontSize="11" VerticalAlignment="Center" FontFamily="Consolas"
                           Foreground="{DynamicResource Accent}"
                           Text="{Binding ActiveProcessCount}" />
                <TextBlock Foreground="{DynamicResource TextS}" Margin="16,0,0,0"
                           FontSize="10" VerticalAlignment="Center" FontStyle="Italic"
                           Text="{Binding LastHeartbeatTime, StringFormat='Last: {0}'}" />
            </StackPanel>
        </Border>

        <!-- Action history grid -->
        <DataGrid ItemsSource="{Binding ActionHistory}" AutoGenerateColumns="False"
                  IsReadOnly="True" Background="Transparent"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                  BorderThickness="0" CanUserSortColumns="True"
                  Foreground="{DynamicResource TextP}" FontSize="11.5"
                  RowBackground="Transparent" AlternatingRowBackground="{DynamicResource BgRowHoverBrush}"
                  Margin="6">
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="{DynamicResource BgCard}" />
                    <Setter Property="Foreground" Value="{DynamicResource TextS}" />
                    <Setter Property="Padding" Value="8,5" />
                    <Setter Property="FontSize" Value="10" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="BorderBrush" Value="{DynamicResource Bdr}" />
                    <Setter Property="BorderThickness" Value="0,0,0,1" />
                </Style>
            </DataGrid.ColumnHeaderStyle>
            <DataGrid.CellStyle>
                <Style TargetType="DataGridCell">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="Padding" Value="8,4" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="DataGridCell">
                                <Border Background="{TemplateBinding Background}"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter VerticalAlignment="Center" />
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </DataGrid.CellStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="TIME" Width="100"
                    Binding="{Binding StartTime, StringFormat='HH:mm:ss'}"
                    FontFamily="Consolas" />
                <DataGridTextColumn Header="COMMAND" Width="*"
                    Binding="{Binding Command}" />
                <DataGridTemplateColumn Header="STATUS" Width="80">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource TextS}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding StatusText}" Value="Success">
                                                <Setter Property="Foreground" Value="{DynamicResource AccGreen}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding StatusText}" Value="Failed">
                                                <Setter Property="Foreground" Value="{DynamicResource AccRed}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding StatusText}" Value="Killed">
                                                <Setter Property="Foreground" Value="{DynamicResource AccRed}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding StatusText}" Value="Running">
                                                <Setter Property="Foreground" Value="{DynamicResource AccPeach}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="EXIT" Width="50"
                    Binding="{Binding ExitCode}" FontFamily="Consolas" />
                <DataGridTextColumn Header="DURATION" Width="85"
                    Binding="{Binding Duration, StringFormat='mm\\:ss'}" FontFamily="Consolas" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
