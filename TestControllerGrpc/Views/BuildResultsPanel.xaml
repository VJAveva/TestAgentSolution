<UserControl x:Class="TestControllerGrpc.Views.BuildResultsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:TestControllerGrpc.ViewModels"
             Background="{DynamicResource WindowBg}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis" />

        <Style x:Key="Fld" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource FieldBg}" />
            <Setter Property="Foreground" Value="{DynamicResource TextP}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Bdr}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Margin" Value="0,2,0,5" />
        </Style>
        <Style x:Key="SmBtn" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource Accent}" />
            <Setter Property="Foreground" Value="{DynamicResource TreeBadgeFg}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Margin" Value="3" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style x:Key="InlineExportBtn" TargetType="Button">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="3,1" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- ?? Ribbon group styles ?? -->
        <Style x:Key="RibbonGroupBorder" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource BgCard}" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Margin" Value="3,0" />
            <Setter Property="BorderBrush" Value="{DynamicResource Bdr}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style x:Key="RibbonGroupLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="9" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource TextS}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="TextAlignment" Value="Center" />
        </Style>
        <!-- Toggle button style for segmented controls -->
        <Style x:Key="SegBtn" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource BtnBg}" />
            <Setter Property="Foreground" Value="{DynamicResource TextS}" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource Bdr}" />
        </Style>
        <!-- Ribbon action button style -->
        <Style x:Key="RibbonActionBtn" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource BtnBg}" />
            <Setter Property="Foreground" Value="{DynamicResource TextP}" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource BtnBorder}" />
            <Setter Property="MinWidth" Value="80" />
            <Setter Property="Height" Value="48" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <!-- High-contrast green Generate button -->
        <Style x:Key="RibbonGenerateBtn" TargetType="Button" BasedOn="{StaticResource RibbonActionBtn}">
            <Setter Property="Background" Value="{DynamicResource GreenBtnBg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccGreen}" />
            <Setter Property="MinWidth" Value="100" />
        </Style>
        <!-- Subtle blue Email button -->
        <Style x:Key="RibbonEmailBtn" TargetType="Button" BasedOn="{StaticResource RibbonActionBtn}">
            <Setter Property="Background" Value="{DynamicResource BlueBtnBg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccBlue}" />
            <Setter Property="MinWidth" Value="100" />
        </Style>
        <Style x:Key="ThresholdInput" TargetType="TextBox" BasedOn="{StaticResource Fld}">
            <Setter Property="Width" Value="50" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Padding" Value="4,3" />
            <Setter Property="Margin" Value="4,0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- Loading overlay -->
        <Border Background="#CC0F1629" Panel.ZIndex="10"
                Visibility="{Binding IsLoading, Converter={StaticResource BoolVis}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="28"
                           Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" FontWeight="Bold">
                    <TextBlock.RenderTransform>
                        <RotateTransform Angle="0" CenterX="14" CenterY="14" />
                    </TextBlock.RenderTransform>
                    <TextBlock.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard>
                                <Storyboard RepeatBehavior="Forever">
                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                     From="0" To="360" Duration="0:0:1.5" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </TextBlock.Triggers>
                </TextBlock>
                <TextBlock Text="Parsing .trx files..." FontSize="12" Foreground="{DynamicResource Accent}"
                           HorizontalAlignment="Center" Margin="0,6,0,0" />
            </StackPanel>
        </Border>

        <DockPanel>
            <!-- ?? STATUS BAR ?? -->
            <Border DockPanel.Dock="Bottom" Background="{DynamicResource BgCard}" Padding="10,6"
                    BorderBrush="{DynamicResource Bdr}" BorderThickness="0,1,0,0">
                <TextBlock Text="{Binding StatusMessage}" FontSize="11" FontFamily="Consolas"
                           Foreground="{DynamicResource TextS}" TextTrimming="CharacterEllipsis" />
            </Border>

            <DockPanel>
                <!-- ??????????????????????????????????????????????????????????? -->
                <!-- ?  RIBBON: 4 Functional Groups                           ? -->
                <!-- ??????????????????????????????????????????????????????????? -->
                <Border DockPanel.Dock="Top" Background="{DynamicResource BgPanel}" Padding="6,6" Margin="0,0,0,2"
                        BorderBrush="{DynamicResource Bdr}" BorderThickness="0,0,0,1">
                    <DockPanel>
                        <!-- Path bar (always visible, compact) -->
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4,0,4,6">
                            <TextBlock Text="Path:" FontSize="10.5" Foreground="{DynamicResource TextS}"
                                       VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBox Text="{Binding ResultsRootPath, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource Fld}" Width="320" Margin="0" FontFamily="Consolas"
                                     FontSize="10.5" VerticalAlignment="Center" Padding="4,3" />
                            <Button Content="??" Style="{StaticResource SmBtn}" Command="{Binding BrowseResultsPathCommand}"
                                    FontSize="12" Padding="6,3" Margin="4,0,2,0" ToolTip="Browse for results folder" />
                            <Button Content="?" Style="{StaticResource SmBtn}" Command="{Binding RefreshBuildsCommand}"
                                    Background="{DynamicResource AccGreen}" FontSize="12" Padding="6,3" Margin="2,0"
                                    ToolTip="Refresh build list" />
                        </StackPanel>

                        <!-- Ribbon groups row -->
                        <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">

                            <!-- ?? GROUP 1: DATA SCOPE ?? -->
                            <Border Style="{StaticResource RibbonGroupBorder}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <!-- Scope toggle: Single Build | Consolidated -->
                                        <Border CornerRadius="4" BorderBrush="{DynamicResource Bdr}" BorderThickness="1"
                                                SnapsToDevicePixels="True">
                                            <StackPanel Orientation="Horizontal">
                                                <Button Content="Single Build" Command="{Binding SetScopeSingleCommand}"
                                                        Margin="0">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource SegBtn}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsSingleBuildMode}" Value="True">
                                                                    <Setter Property="Background" Value="{DynamicResource AccentBtnBg}" />
                                                                    <Setter Property="Foreground" Value="{DynamicResource Accent}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                                <Button Content="Consolidated" Command="{Binding SetScopeConsolidatedCommand}"
                                                        Margin="0">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource SegBtn}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsConsolidatedMode}" Value="True">
                                                                    <Setter Property="Background" Value="{DynamicResource AccentBtnBg}" />
                                                                    <Setter Property="Foreground" Value="{DynamicResource Accent}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                    <!-- Build dropdown: single-build selector or consolidated folder list summary -->
                                    <ComboBox ItemsSource="{Binding AvailableBuilds}" SelectedItem="{Binding SelectedBuild}"
                                              IsEnabled="{Binding IsSingleBuildMode}"
                                              Width="180" Margin="0,6,0,0"
                                              Background="{DynamicResource BgCard}" Foreground="{DynamicResource TextP}"
                                              BorderBrush="{DynamicResource Bdr}" Padding="4,3" FontSize="10.5">
                                        <ComboBox.Style>
                                            <Style TargetType="ComboBox">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsConsolidatedMode}" Value="True">
                                                        <Setter Property="ToolTip" Value="{Binding ConsolidatedFolderSummary}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ComboBox.Style>
                                    </ComboBox>
                                    <!-- Consolidated folder count badge (visible only in consolidated mode) -->
                                    <TextBlock FontSize="9.5" Foreground="{DynamicResource Accent}"
                                               HorizontalAlignment="Center" Margin="0,2,0,0"
                                               Visibility="{Binding IsConsolidatedMode, Converter={StaticResource BoolVis}}"
                                               Text="{Binding FilteredBuildCount, StringFormat='? {0} folder(s) in range'}" />
                                    <TextBlock Text="DATA SCOPE" Style="{StaticResource RibbonGroupLabel}" />
                                </StackPanel>
                            </Border>

                            <!-- ?? Vertical separator ?? -->
                            <Rectangle Width="1" Height="60" Fill="{DynamicResource Bdr}" Margin="2,4" VerticalAlignment="Center" />

                            <!-- ?? GROUP 2: TIME FILTER ?? -->
                            <Border Style="{StaticResource RibbonGroupBorder}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Border CornerRadius="4" BorderBrush="{DynamicResource Bdr}" BorderThickness="1"
                                                SnapsToDevicePixels="True">
                                            <StackPanel Orientation="Horizontal">
                                                <Button Content="1 Day" Command="{Binding SetRange1DCommand}">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource SegBtn}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding SelectedTimeRange}" Value="OneDay">
                                                                    <Setter Property="Background" Value="{DynamicResource AccentBtnBg}" />
                                                                    <Setter Property="Foreground" Value="{DynamicResource Accent}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                                <Button Content="1 Week" Command="{Binding SetRange1WCommand}">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource SegBtn}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding SelectedTimeRange}" Value="OneWeek">
                                                                    <Setter Property="Background" Value="{DynamicResource AccentBtnBg}" />
                                                                    <Setter Property="Foreground" Value="{DynamicResource Accent}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                                <Button Content="1 Month" Command="{Binding SetRange1MCommand}">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource SegBtn}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding SelectedTimeRange}" Value="OneMonth">
                                                                    <Setter Property="Background" Value="{DynamicResource AccentBtnBg}" />
                                                                    <Setter Property="Foreground" Value="{DynamicResource Accent}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                    <!-- Filtered build count summary -->
                                    <TextBlock FontSize="10" Foreground="{DynamicResource TextS}"
                                               HorizontalAlignment="Center" Margin="0,6,0,0"
                                               TextTrimming="CharacterEllipsis" MaxWidth="180">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="{Binding FilteredBuildCount, StringFormat='{}{0} build(s) match'}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding FilteredBuildCount}" Value="0">
                                                        <Setter Property="Text" Value="No filter applied" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="REPORT RANGE" Style="{StaticResource RibbonGroupLabel}" />
                                </StackPanel>
                            </Border>

                            <!-- ?? Vertical separator ?? -->
                            <Rectangle Width="1" Height="60" Fill="{DynamicResource Bdr}" Margin="2,4" VerticalAlignment="Center" />

                            <!-- ?? GROUP 3: REPORT CONFIG ?? -->
                            <Border Style="{StaticResource RibbonGroupBorder}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,2">
                                        <TextBlock Text="Good ?" FontSize="10" Foreground="{DynamicResource AccGreen}"
                                                   VerticalAlignment="Center" Margin="0,0,2,0" FontWeight="SemiBold" />
                                        <TextBox Text="{Binding GoodThreshold, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource ThresholdInput}" />
                                        <TextBlock Text="%" FontSize="10" Foreground="{DynamicResource TextS}"
                                                   VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <TextBlock Text="Warn ?" FontSize="10" Foreground="{DynamicResource AccYellow}"
                                                   VerticalAlignment="Center" Margin="0,0,2,0" FontWeight="SemiBold" />
                                        <TextBox Text="{Binding WarningThreshold, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource ThresholdInput}" />
                                        <TextBlock Text="%" FontSize="10" Foreground="{DynamicResource TextS}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                    <Button Content="Apply" Command="{Binding ApplyThresholdsCommand}"
                                            Style="{StaticResource SmBtn}" FontSize="10" Padding="12,3"
                                            HorizontalAlignment="Center" Margin="0,2,0,0" />
                                    <TextBlock Text="REPORT CONFIG" Style="{StaticResource RibbonGroupLabel}" />
                                </StackPanel>
                            </Border>

                            <!-- ?? Vertical separator ?? -->
                            <Rectangle Width="1" Height="60" Fill="{DynamicResource Bdr}" Margin="2,4" VerticalAlignment="Center" />

                            <!-- ?? GROUP 4: REPORT ACTIONS ?? -->
                            <Border Style="{StaticResource RibbonGroupBorder}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <!-- Primary: Generate Consolidated HTML (high-contrast green) -->
                                        <Button Command="{Binding GenerateConsolidatedHtmlCommand}"
                                                ToolTip="Generate consolidated HTML report"
                                                Style="{StaticResource RibbonGenerateBtn}">
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="&#xE9F9;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                                                           HorizontalAlignment="Center" Foreground="{DynamicResource AccGreen}" />
                                                <TextBlock Text="Generate" FontSize="9" FontWeight="Bold"
                                                           HorizontalAlignment="Center"
                                                           Foreground="{DynamicResource AccGreen}" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </Button>
                                        <!-- Secondary: Send Email Summary (subtle blue) -->
                                        <Button Command="{Binding SendEmailSummaryCommand}"
                                                ToolTip="Send email summary report"
                                                Style="{StaticResource RibbonEmailBtn}">
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="&#xE715;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                                                           HorizontalAlignment="Center" Foreground="{DynamicResource AccBlue}" />
                                                <TextBlock Text="Email" FontSize="9" FontWeight="SemiBold"
                                                           HorizontalAlignment="Center"
                                                           Foreground="{DynamicResource AccBlue}" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </Button>
                                        <!-- Trends (merged into this group) -->
                                        <Button Command="{Binding GenerateTrendReportCommand}"
                                                ToolTip="View trend analysis across builds"
                                                Style="{StaticResource RibbonActionBtn}">
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="&#xE9D2;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                                                           HorizontalAlignment="Center" Foreground="{DynamicResource AccMauve}" />
                                                <TextBlock Text="Trends" FontSize="9" HorizontalAlignment="Center"
                                                           Foreground="{DynamicResource TextS}" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                    <TextBlock Text="REPORT ACTIONS" Style="{StaticResource RibbonGroupLabel}" />
                                </StackPanel>
                            </Border>

                        </WrapPanel>
                    </DockPanel>
                </Border>

                <!-- ?? HEALTH INDICATOR BAR ?? -->
                <Border DockPanel.Dock="Top" Background="{DynamicResource BgCard}" CornerRadius="6" Padding="12" Margin="8,4,8,4">
                    <Grid>
                        <Border CornerRadius="4" Background="#1E293B" Height="36" />
                        <Border CornerRadius="4" Height="36" HorizontalAlignment="Left">
                            <Border.Width>
                                <MultiBinding Converter="{x:Static vm:PercentToWidthConverter.Instance}">
                                    <Binding Path="PassRatePercent" />
                                    <Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType=Grid}" />
                                </MultiBinding>
                            </Border.Width>
                            <Border.Background>
                                <SolidColorBrush Color="{Binding HealthColor, Converter={x:Static vm:StringToColorConverter.Instance}}" />
                            </Border.Background>
                        </Border>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock FontSize="18" FontWeight="Bold" Foreground="#FFFFFF"
                                       Text="{Binding PassRatePercent, StringFormat='{}{0:F1}%'}" />
                            <TextBlock FontSize="14" FontWeight="Bold" Foreground="#FFFFFF" Margin="12,0,0,0"
                                       Text="{Binding HealthLabel}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ??? HIERARCHICAL TREE GRID ??? -->
                <Border Margin="8,4" Background="{DynamicResource BgCard}" CornerRadius="6" Padding="0">
                    <DockPanel>
                        <!-- Column Headers -->
                        <Border DockPanel.Dock="Top" Background="{DynamicResource BgPanel}" Padding="4,6"
                                CornerRadius="6,6,0,0" BorderBrush="{DynamicResource Bdr}" BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" MinWidth="200" />
                                    <ColumnDefinition Width="55" />
                                    <ColumnDefinition Width="55" />
                                    <ColumnDefinition Width="55" />
                                    <ColumnDefinition Width="60" />
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition Width="56" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="NAME" FontSize="10" FontWeight="Bold"
                                           Foreground="{DynamicResource TextS}" Margin="28,0,0,0" />
                                <TextBlock Grid.Column="1" Text="TOTAL" FontSize="10" FontWeight="Bold"
                                           Foreground="{DynamicResource TextS}" HorizontalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="PASS" FontSize="10" FontWeight="Bold"
                                           Foreground="#10B981" HorizontalAlignment="Center" />
                                <TextBlock Grid.Column="3" Text="FAIL" FontSize="10" FontWeight="Bold"
                                           Foreground="#EF4444" HorizontalAlignment="Center" />
                                <TextBlock Grid.Column="4" Text="NOT EXE" FontSize="9" FontWeight="Bold"
                                           Foreground="{DynamicResource TextS}" HorizontalAlignment="Center" />
                                <TextBlock Grid.Column="5" Text="RATE" FontSize="10" FontWeight="Bold"
                                           Foreground="{DynamicResource TextS}" HorizontalAlignment="Center" />
                                <TextBlock Grid.Column="6" Text="EXPORT" FontSize="9" FontWeight="Bold"
                                           Foreground="{DynamicResource TextS}" HorizontalAlignment="Center" />
                            </Grid>
                        </Border>

                        <TreeView ItemsSource="{Binding ResultsTree}" Background="Transparent"
                                  BorderThickness="0" Padding="0"
                                  VirtualizingStackPanel.IsVirtualizing="True"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <TreeView.Resources>
                                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="Transparent" />
                                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="Transparent" />
                            </TreeView.Resources>
                            <TreeView.ItemContainerStyle>
                                <Style TargetType="TreeViewItem">
                                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="Foreground" Value="{DynamicResource TextP}" />
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#08FFFFFF" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </TreeView.ItemContainerStyle>
                            <TreeView.ItemTemplate>
                                <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                    <Border Padding="4,3" BorderBrush="{DynamicResource Bdr}" BorderThickness="0,0,0,0.5">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="Transparent" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding NodeLevel}" Value="TestResult">
                                                        <Setter Property="Background" Value="#10EF4444" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" MinWidth="180" />
                                                <ColumnDefinition Width="55" />
                                                <ColumnDefinition Width="55" />
                                                <ColumnDefinition Width="55" />
                                                <ColumnDefinition Width="60" />
                                                <ColumnDefinition Width="70" />
                                                <ColumnDefinition Width="56" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Name -->
                                            <StackPanel Grid.Column="0" Orientation="Vertical">
                                                <TextBlock FontSize="11" TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource TextP}" />
                                                            <Setter Property="FontWeight" Value="Normal" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding NodeLevel}" Value="Build">
                                                                    <Setter Property="FontWeight" Value="Bold" />
                                                                    <Setter Property="FontSize" Value="12" />
                                                                    <Setter Property="Foreground" Value="#60A5FA" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding NodeLevel}" Value="TestResult">
                                                                    <Setter Property="Foreground" Value="#EF4444" />
                                                                    <Setter Property="FontSize" Value="10" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                    <Run Text="{Binding Name, Mode=OneWay}" />
                                                </TextBlock>
                                                <TextBlock Text="{Binding ErrorMessage}" FontSize="9" FontFamily="Consolas"
                                                           Foreground="{DynamicResource TextS}" TextWrapping="NoWrap"
                                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding FullError}"
                                                           Margin="0,1,0,0" MaxHeight="14">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding NodeLevel}" Value="TestResult">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>

                                            <!-- Total -->
                                            <TextBlock Grid.Column="1" Text="{Binding Total}" FontSize="11"
                                                       Foreground="{DynamicResource TextP}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding NodeLevel}" Value="TestResult">
                                                                <Setter Property="Visibility" Value="Hidden" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>

                                            <!-- Passed -->
                                            <TextBlock Grid.Column="2" Text="{Binding Passed}" FontSize="11"
                                                       Foreground="#10B981" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding NodeLevel}" Value="TestResult">
                                                                <Setter Property="Visibility" Value="Hidden" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>

                                            <!-- Failed -->
                                            <TextBlock Grid.Column="3" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource TextP}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Failed, Converter={x:Static vm:GreaterThanZeroConverter.Instance}}" Value="True">
                                                                <Setter Property="Foreground" Value="#EF4444" />
                                                                <Setter Property="FontWeight" Value="Bold" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding NodeLevel}" Value="TestResult">
                                                                <Setter Property="Visibility" Value="Hidden" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                                <Run Text="{Binding Failed, Mode=OneWay}" />
                                            </TextBlock>

                                            <!-- NotExecuted -->
                                            <TextBlock Grid.Column="4" Text="{Binding NotExecuted}" FontSize="11"
                                                       Foreground="{DynamicResource TextS}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding NodeLevel}" Value="TestResult">
                                                                <Setter Property="Visibility" Value="Hidden" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>

                                            <!-- Pass Rate -->
                                            <StackPanel Grid.Column="5" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding NodeLevel}" Value="TestResult">
                                                                <Setter Property="Visibility" Value="Hidden" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>
                                                <Ellipse Width="7" Height="7" Margin="0,0,3,0" VerticalAlignment="Center">
                                                    <Ellipse.Fill>
                                                        <SolidColorBrush Color="{Binding PassRateColor, Converter={x:Static vm:StringToColorConverter.Instance}}" />
                                                    </Ellipse.Fill>
                                                </Ellipse>
                                                <TextBlock Text="{Binding PassRateFormatted}" FontSize="10.5" FontWeight="Bold" VerticalAlignment="Center">
                                                    <TextBlock.Foreground>
                                                        <SolidColorBrush Color="{Binding PassRateColor, Converter={x:Static vm:StringToColorConverter.Instance}}" />
                                                    </TextBlock.Foreground>
                                                </TextBlock>
                                            </StackPanel>

                                            <!-- Export buttons (build-level only) -->
                                            <StackPanel Grid.Column="6" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                        Visibility="{Binding ShowExportButtons, Converter={StaticResource BoolVis}}">
                                                <Button Style="{StaticResource InlineExportBtn}" Command="{Binding ExportHtmlCommand}"
                                                        ToolTip="Generate HTML report" Foreground="{DynamicResource Accent}">
                                                    <TextBlock Text="&#xE774;" FontFamily="Segoe MDL2 Assets" FontSize="13" />
                                                </Button>
                                                <Button Style="{StaticResource InlineExportBtn}" Command="{Binding ExportCsvCommand}"
                                                        ToolTip="Export to CSV" Foreground="{DynamicResource AccGreen}">
                                                    <TextBlock Text="&#xE898;" FontFamily="Segoe MDL2 Assets" FontSize="13" />
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </HierarchicalDataTemplate>
                            </TreeView.ItemTemplate>
                        </TreeView>
                    </DockPanel>
                </Border>
            </DockPanel>
        </DockPanel>
    </Grid>
</UserControl>
