<UserControl x:Class="TestControllerGrpc.Views.Panels.ExecutionHistoryPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Tab strip: Sessions / Live Feed -->
        <Border Grid.Row="0" Padding="6,4" Background="{DynamicResource BgPanel}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="⟳" FontSize="12" Padding="6,2" Margin="4,0,0,0"
                            Background="Transparent" BorderThickness="0" Cursor="Hand"
                            Foreground="{DynamicResource TextS}"
                            Command="{Binding RefreshSessionsCommand}" ToolTip="Refresh history" />
                    <Button Content="✕" FontSize="10" Padding="6,2" Margin="2,0,0,0"
                            Background="Transparent" BorderThickness="0" Cursor="Hand"
                            Foreground="{DynamicResource TextS}"
                            Command="{Binding ClearLiveLogCommand}" ToolTip="Clear live log" />
                </StackPanel>
                <TextBlock Text="Execution History" FontSize="11" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextP}" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <!-- Content: 3-row split -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="2*" MinHeight="60"/>
                <RowDefinition Height="3"/>
                <RowDefinition Height="3*" MinHeight="60"/>
                <RowDefinition Height="3"/>
                <RowDefinition Height="2*" MinHeight="60"/>
            </Grid.RowDefinitions>

            <!-- TOP: Session list -->
            <DataGrid Grid.Row="0" ItemsSource="{Binding Sessions}"
                      SelectedItem="{Binding SelectedSession}"
                      AutoGenerateColumns="False" IsReadOnly="True"
                      HeadersVisibility="Column" GridLinesVisibility="None"
                      Background="Transparent" BorderThickness="0"
                      Foreground="{DynamicResource TextDefaultBrush}"
                      RowBackground="Transparent"
                      AlternatingRowBackground="{DynamicResource BgRowHoverBrush}"
                      FontSize="10" FontFamily="Consolas"
                      SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="" Binding="{Binding StateIcon}" Width="20"/>
                    <DataGridTextColumn Header="Tag" Binding="{Binding WatchItemTag}" Width="*"/>
                    <DataGridTextColumn Header="Event" Binding="{Binding EventType}" Width="55"/>
                    <DataGridTextColumn Header="Actions" Binding="{Binding TotalActions}" Width="48"/>
                    <DataGridTextColumn Header="Fail" Binding="{Binding FailedCount}" Width="35"/>
                    <DataGridTextColumn Header="Time" Binding="{Binding DurationDisplay}" Width="55"/>
                    <DataGridTextColumn Header="At" Binding="{Binding TimeDisplay}" Width="60"/>
                </DataGrid.Columns>
            </DataGrid>

            <GridSplitter Grid.Row="1" Height="3" HorizontalAlignment="Stretch"
                          Background="{DynamicResource BgSurface}" />

            <!-- MIDDLE: Action details for selected session -->
            <DataGrid Grid.Row="2" ItemsSource="{Binding SessionActions}"
                      AutoGenerateColumns="False" IsReadOnly="True"
                      HeadersVisibility="Column" GridLinesVisibility="None"
                      Background="Transparent" BorderThickness="0"
                      Foreground="{DynamicResource TextDefaultBrush}"
                      RowBackground="Transparent"
                      AlternatingRowBackground="{DynamicResource BgRowHoverBrush}"
                      FontSize="10" FontFamily="Consolas">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="" Binding="{Binding OutcomeIcon}" Width="20"/>
                    <DataGridTextColumn Header="Action" Binding="{Binding ActionTag}" Width="*"/>
                    <DataGridTextColumn Header="Type" Binding="{Binding ActionType}" Width="60"/>
                    <DataGridTextColumn Header="Agent" Binding="{Binding AgentName}" Width="75"/>
                    <DataGridTextColumn Header="Cmd" Binding="{Binding Command}" Width="100"/>
                    <DataGridTextColumn Header="Time" Binding="{Binding Duration}" Width="55"/>
                    <DataGridTextColumn Header="Exit" Binding="{Binding ExitCode}" Width="32"/>
                </DataGrid.Columns>
            </DataGrid>

            <GridSplitter Grid.Row="3" Height="3" HorizontalAlignment="Stretch"
                          Background="{DynamicResource BgSurface}" />

            <!-- BOTTOM: Live action feed (current commands & status & health) -->
            <DockPanel Grid.Row="4">
                <Border DockPanel.Dock="Top" Padding="6,2"
                        Background="{DynamicResource BgHeaderBrush}">
                    <TextBlock Text="Live Feed" FontSize="9" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextMutedBrush}"/>
                </Border>
                <DataGrid ItemsSource="{Binding LiveActions}"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          HeadersVisibility="Column" GridLinesVisibility="None"
                          Background="Transparent" BorderThickness="0"
                          Foreground="{DynamicResource TextDefaultBrush}"
                          RowBackground="Transparent"
                          FontSize="9.5" FontFamily="Consolas">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="" Binding="{Binding StatusIcon}" Width="18"/>
                        <DataGridTextColumn Header="Time" Binding="{Binding TimeDisplay}" Width="75"/>
                        <DataGridTextColumn Header="Agent" Binding="{Binding AgentName}" Width="70"/>
                        <DataGridTextColumn Header="Action" Binding="{Binding NodeTag}" Width="*"/>
                        <DataGridTextColumn Header="Cmd" Binding="{Binding Command}" Width="90"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="55"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Grid>
    </Grid>
</UserControl>
