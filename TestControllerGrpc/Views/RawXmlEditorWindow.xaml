<Window x:Class="TestControllerGrpc.Views.RawXmlEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:avalonedit="http://icsharpcode.net/sharpdevelop/avalonedit"
        xmlns:vm="clr-namespace:TestControllerGrpc.ViewModels"
        Title="{Binding WindowTitle}"
        Height="750" Width="1100" MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBg}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis" />
        <vm:IntToVisibilityConverter x:Key="CountVis" />

        <Style x:Key="EditorBtn" TargetType="Button">
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Margin" Value="3" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="{StaticResource FontSize10}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource BtnBorder}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BtnHoverBg}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BtnPressedBg}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Structure tree item: kind badge, name, skipped pill, error / warning counts -->
        <HierarchicalDataTemplate x:Key="StructureTreeTemplate" DataType="{x:Type vm:PipelineStructureNode}" ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal" Margin="0,1">
                <Border CornerRadius="3" Padding="3,1" Margin="0,0,4,0" MinWidth="30"
                        Background="{DynamicResource AccGreen}">
                    <TextBlock Text="{Binding KindBadge}" FontSize="{StaticResource FontSize9}" FontWeight="Bold"
                               Foreground="{DynamicResource TreeBadgeFg}" HorizontalAlignment="Center" />
                </Border>
                <TextBlock Text="{Binding Name}" FontSize="{StaticResource FontSize10}" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextP}" TextTrimming="CharacterEllipsis" />
                <Border CornerRadius="3" Padding="4,0" Margin="6,0,0,0" Background="{DynamicResource PillSkipBg}"
                        Visibility="{Binding IsSkipped, Converter={StaticResource BoolVis}}">
                    <TextBlock Text="Skipped" FontSize="{StaticResource FontSize9}" Foreground="{DynamicResource TextP}" />
                </Border>
                <Border CornerRadius="3" Padding="4,0" Margin="6,0,0,0" Background="{DynamicResource StatusFailedBg}"
                        ToolTip="Errors on this node" Visibility="{Binding ErrorCount, Converter={StaticResource CountVis}}">
                    <TextBlock Text="{Binding ErrorCount}" FontSize="{StaticResource FontSize9}" FontWeight="Bold"
                               Foreground="{DynamicResource StatusFailedFg}" />
                </Border>
                <Border CornerRadius="3" Padding="4,0" Margin="4,0,0,0" Background="{DynamicResource StatusWarningBg}"
                        ToolTip="Warnings on this node" Visibility="{Binding WarningCount, Converter={StaticResource CountVis}}">
                    <TextBlock Text="{Binding WarningCount}" FontSize="{StaticResource FontSize9}" FontWeight="Bold"
                               Foreground="{DynamicResource StatusWarningFg}" />
                </Border>
            </StackPanel>
        </HierarchicalDataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ??????????????????????????????????????????????????????? -->
        <!-- ROW 0: Toolbar / Ribbon                                -->
        <!-- ??????????????????????????????????????????????????????? -->
        <Border Grid.Row="0" Background="{DynamicResource RibbonBg}" Padding="8,6"
                BorderBrush="{DynamicResource Bdr}" BorderThickness="0,0,0,1">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#x1F4DD;" FontSize="{StaticResource FontSize16}" FontFamily="Segoe UI Emoji" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBlock Text="Pipeline Editor" FontSize="{StaticResource FontSize14}" FontWeight="Bold"
                               Foreground="{DynamicResource AccPeach}" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource EditorBtn}"
                            Background="{DynamicResource AccentBtnBg}" Foreground="{DynamicResource Accent}"
                            Command="{Binding ValidateCommand}" ToolTip="Validate WatchItem XML structure and rules">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#x2713;" FontSize="{StaticResource FontSize12}" Margin="0,0,4,0" />
                            <TextBlock Text="Validate" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource EditorBtn}"
                            Background="{DynamicResource AccentBtnBg}" Foreground="{DynamicResource Accent}"
                            Click="BrowseParameterFile_Click" ToolTip="Browse for a file under Parameters">
                        <TextBlock Text="Browse Parameter File" />
                    </Button>
                    <Button Style="{StaticResource EditorBtn}"
                            Background="{DynamicResource MauveBtnBg}" Foreground="{DynamicResource AccMauve}"
                            Command="{Binding AutoFormatCommand}" ToolTip="Auto-format and indent WatchItem XML">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#x27F3;" FontSize="{StaticResource FontSize12}" Margin="0,0,4,0" />
                            <TextBlock Text="Format" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource EditorBtn}"
                            Background="{DynamicResource GreenBtnBg}" Foreground="{DynamicResource AccGreen}"
                            Command="{Binding AutoFixCommand}" ToolTip="Auto-fix missing defaults and normalize booleans">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#x1F527;" FontSize="{StaticResource FontSize12}" FontFamily="Segoe UI Emoji" Margin="0,0,4,0" />
                            <TextBlock Text="Auto Fix" />
                        </StackPanel>
                    </Button>

                    <Border Width="1" Background="{DynamicResource Bdr}" Margin="6,4" />

                    <Button Style="{StaticResource EditorBtn}"
                            Background="{DynamicResource YellowBtnBg}" Foreground="{DynamicResource AccYellow}"
                            Command="{Binding RevertCommand}" ToolTip="Revert to original XML">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#x21BA;" FontSize="{StaticResource FontSize12}" Margin="0,0,4,0" />
                            <TextBlock Text="Revert" />
                        </StackPanel>
                    </Button>

                    <Border Width="1" Background="{DynamicResource Bdr}" Margin="6,4" />

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Font:" FontSize="{StaticResource FontSize10}"
                                   Foreground="{DynamicResource TextS}"
                                   VerticalAlignment="Center" Margin="0,0,4,0" />
                        <ComboBox x:Name="FontSizeCombo" Width="55"
                                  ItemsSource="{Binding AvailableFontSizes}"
                                  SelectedItem="{Binding EditorFontSize}"
                                  Background="{DynamicResource BgCard}"
                                  Foreground="{DynamicResource TextP}"
                                  BorderBrush="{DynamicResource Bdr}"
                                  BorderThickness="1" Padding="4,2"
                                  FontSize="{StaticResource FontSize10}"  AutomationProperties.Name="Font" />
                        <Button Content="A+" Padding="4,2" Margin="2,0"
                                Click="IncreaseFontSize_Click"
                                ToolTip="Increase font size (Ctrl+Plus)"
                                Background="Transparent" Foreground="{DynamicResource TextP}"
                                BorderThickness="0" FontWeight="Bold" Cursor="Hand" FontSize="{StaticResource FontSize10}" />
                        <Button Content="A&#x2013;" Padding="4,2" Margin="2,0"
                                Click="DecreaseFontSize_Click"
                                ToolTip="Decrease font size (Ctrl+Minus)"
                                Background="Transparent" Foreground="{DynamicResource TextP}"
                                BorderThickness="0" FontWeight="Bold" Cursor="Hand" FontSize="{StaticResource FontSize10}" />
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ??????????????????????????????????????????????????????? -->
        <!-- ROW 1: Summary Panel                                   -->
        <!-- ??????????????????????????????????????????????????????? -->
        <Border Grid.Row="1" Background="{DynamicResource BgCard}" Padding="10,6"
                BorderBrush="{DynamicResource Bdr}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border CornerRadius="4" Padding="6,2" Margin="0,0,8,0"
                        Background="{DynamicResource WatchRootBg}">
                    <TextBlock FontSize="{StaticResource FontSize9}" FontWeight="Bold" Foreground="{DynamicResource AccGreen}">
                        <Run Text="Tag: " /><Run Text="{Binding WatchItemTag, Mode=OneWay}" />
                    </TextBlock>
                </Border>
                <Border CornerRadius="4" Padding="6,2" Margin="0,0,8,0"
                        Background="{DynamicResource RunningBadgeBg}">
                    <TextBlock FontSize="{StaticResource FontSize9}" FontWeight="Bold" Foreground="{DynamicResource Accent}">
                        <Run Text="Events: " /><Run Text="{Binding EventCount, Mode=OneWay}" />
                    </TextBlock>
                </Border>
                <Border CornerRadius="4" Padding="6,2" Margin="0,0,8,0"
                        Background="{DynamicResource RunningBadgeBg}">
                    <TextBlock FontSize="{StaticResource FontSize9}" FontWeight="Bold" Foreground="{DynamicResource Accent}">
                        <Run Text="Actions: " /><Run Text="{Binding TotalActionCount, Mode=OneWay}" />
                    </TextBlock>
                </Border>
                <TextBlock Text="{Binding WatchItemSummary}" FontSize="{StaticResource FontSize9}" Foreground="{DynamicResource TextS}"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- ??????????????????????????????????????????????????????? -->
        <!-- ROW 2: Editor + Optional Preview                       -->
        <!-- ??????????????????????????????????????????????????????? -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" MinWidth="160" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="300" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="260" MinWidth="160" />
            </Grid.ColumnDefinitions>

            <!-- Structure: the pipeline as a tree; selection is shared with the XML caret -->
            <Border Grid.Column="0" Background="{DynamicResource BgPanel}"
                    BorderBrush="{DynamicResource Bdr}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="{DynamicResource BgCard}" Padding="8,5"
                            BorderBrush="{DynamicResource Bdr}" BorderThickness="0,0,0,1">
                        <StackPanel>
                            <TextBlock Text="Structure" FontSize="{StaticResource FontSize10}" FontWeight="Bold"
                                       Foreground="{DynamicResource AccGreen}" />
                            <TextBox Margin="0,4,0,0" Padding="4,2" FontSize="{StaticResource FontSize10}"
                                     Text="{Binding StructureFilter, UpdateSourceTrigger=PropertyChanged}"
                                     Background="{DynamicResource BgCard}" Foreground="{DynamicResource TextP}"
                                     BorderBrush="{DynamicResource Bdr}"
                                     ToolTip="Search by name, agent or command"
                                     AutomationProperties.Name="Search structure" />
                            <TextBlock Margin="0,4,0,0" FontSize="{StaticResource FontSize9}" TextWrapping="Wrap"
                                       Foreground="{DynamicResource AccYellow}"
                                       Text="XML is not well-formed - the tree shows the last good state.">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsStructureAvailable}" Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                    <TreeView x:Name="StructureTree" ItemsSource="{Binding StructureRoots}"
                              AutomationProperties.Name="Pipeline structure"
                              Background="Transparent" BorderThickness="0"
                              Margin="4" Padding="0,4"
                              ItemTemplate="{StaticResource StructureTreeTemplate}"
                              SelectedItemChanged="StructureTree_SelectedItemChanged"
                              ContextMenuOpening="StructureTree_ContextMenuOpening">
                        <TreeView.ContextMenu>
                            <ContextMenu />
                        </TreeView.ContextMenu>
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem">
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                                <Setter Property="Visibility" Value="{Binding IsVisible, Converter={StaticResource BoolVis}}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextP}" />
                                <Setter Property="Padding" Value="2,2" />
                            </Style>
                        </TreeView.ItemContainerStyle>
                    </TreeView>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" Width="4" Background="{DynamicResource BgSurface}"
                          HorizontalAlignment="Center" VerticalAlignment="Stretch"
                          ResizeBehavior="PreviousAndNext" />

            <!-- AvalonEdit XML Editor -->
            <avalonedit:TextEditor
                Grid.Column="2"
                x:Name="XmlEditor"
                FontFamily="Consolas"
                FontSize="{Binding EditorFontSize}"
                ShowLineNumbers="True"
                WordWrap="False"
                HorizontalScrollBarVisibility="Auto"
                VerticalScrollBarVisibility="Auto"
                Padding="4"
                BorderThickness="0" />

            <GridSplitter Grid.Column="3" Width="4" Background="{DynamicResource BgSurface}"
                          HorizontalAlignment="Center" VerticalAlignment="Stretch"
                          ResizeBehavior="PreviousAndNext" />

            <!-- Properties of the selected node (read-only in Part 1; secret values masked) -->
            <Border Grid.Column="4" Background="{DynamicResource BgPanel}"
                    BorderBrush="{DynamicResource Bdr}" BorderThickness="1,0,0,0">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="{DynamicResource BgCard}" Padding="8,5"
                            BorderBrush="{DynamicResource Bdr}" BorderThickness="0,0,0,1">
                        <StackPanel>
                            <TextBlock Text="Properties" FontSize="{StaticResource FontSize10}" FontWeight="Bold"
                                       Foreground="{DynamicResource AccGreen}" />
                            <TextBlock Text="{Binding SelectedNodeTitle}" FontSize="{StaticResource FontSize9}"
                                       Foreground="{DynamicResource TextS}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8,4">
                        <ItemsControl ItemsSource="{Binding SelectedProperties}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,6">
                                        <TextBlock Text="{Binding Name}" FontSize="{StaticResource FontSize9}" FontWeight="Bold"
                                                   Foreground="{DynamicResource TextS}" />
                                        <TextBlock Text="{Binding Value}" FontSize="{StaticResource FontSize10}" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextP}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ??????????????????????????????????????????????????????? -->
        <!-- ROW 3: Error Panel (collapsible)                       -->
        <!-- ??????????????????????????????????????????????????????? -->
        <Border Grid.Row="3" MaxHeight="180"
                Visibility="{Binding IsErrorPanelVisible, Converter={StaticResource BoolVis}}"
                BorderBrush="{DynamicResource Bdr}" BorderThickness="0,1,0,0">
            <DockPanel Background="{DynamicResource BgPanel}">
                <Border DockPanel.Dock="Top" Background="{DynamicResource FailedBadgeBg}" Padding="8,4">
                    <DockPanel>
                        <TextBlock Text="Validation Errors" FontSize="{StaticResource FontSize10}" FontWeight="Bold"
                                   Foreground="{DynamicResource AccRed}" VerticalAlignment="Center" />
                        <TextBlock DockPanel.Dock="Right" HorizontalAlignment="Right" FontSize="{StaticResource FontSize9}"
                                   Foreground="{DynamicResource AccRed}" VerticalAlignment="Center">
                            <Run Text="{Binding ValidationErrors.Count, Mode=OneWay}" FontWeight="Bold" />
                            <Run Text=" error(s)" />
                        </TextBlock>
                    </DockPanel>
                </Border>
                <DataGrid ItemsSource="{Binding ValidationErrors}"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserAddRows="False" CanUserDeleteRows="False"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                          Background="Transparent" Foreground="{DynamicResource TextP}"
                          BorderThickness="0" FontSize="{StaticResource FontSize10}" FontFamily="Consolas"
                          RowBackground="Transparent"
                          AlternatingRowBackground="{DynamicResource InfoBoxBg}"
                          SelectionMode="Single"
                          SelectedItem="{Binding SelectedValidationError, Mode=TwoWay}">
                    <DataGrid.Resources>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="{DynamicResource BgCard}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextS}" />
                            <Setter Property="Padding" Value="6,3" />
                            <Setter Property="FontSize" Value="{StaticResource FontSize9}" />
                            <Setter Property="FontWeight" Value="Bold" />
                            <Setter Property="BorderBrush" Value="{DynamicResource Bdr}" />
                            <Setter Property="BorderThickness" Value="0,0,1,1" />
                        </Style>
                        <Style TargetType="DataGridCell">
                            <Setter Property="Padding" Value="6,2" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="Foreground" Value="{DynamicResource TextP}" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="DataGridCell">
                                        <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                                            <ContentPresenter VerticalAlignment="Center" />
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource SelectedItemBg}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Cursor" Value="Hand" />
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource BtnHoverBg}" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource SelectedItemBg}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.Resources>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Line" Binding="{Binding Line}" Width="50" />
                        <DataGridTextColumn Header="Col" Binding="{Binding Column}" Width="45" />
                        <DataGridTextColumn Header="Severity" Binding="{Binding Severity}" Width="75" />
                        <DataGridTextColumn Header="Node" Binding="{Binding NodeLabel}" Width="140" />
                        <DataGridTextColumn Header="Rule" Binding="{Binding ErrorType}" Width="85" />
                        <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*" />
                        <DataGridTemplateColumn Header="Quick fix" Width="220">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ItemsControl ItemsSource="{Binding QuickFixes}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Content="{Binding Title}" Margin="2"
                                                        Padding="5,2"
                                                        Background="{DynamicResource AccentBtnBg}"
                                                        Foreground="{DynamicResource Accent}"
                                                        Command="{Binding DataContext.ApplyQuickFixCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                                                        CommandParameter="{Binding}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <!-- ??????????????????????????????????????????????????????? -->
        <!-- ROW 4: Status Bar                                      -->
        <!-- ??????????????????????????????????????????????????????? -->
        <Border Grid.Row="4" Padding="10,6"
                BorderBrush="{DynamicResource Bdr}" BorderThickness="0,1,0,0">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{DynamicResource BgCard}" />
                </Style>
            </Border.Style>
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="{Binding StatusMessage}" FontSize="{StaticResource FontSize10}"
                           FontFamily="Consolas" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource TextS}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding StatusSeverity}" Value="Success">
                                    <Setter Property="Foreground" Value="{DynamicResource AccGreen}" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding StatusSeverity}" Value="Error">
                                    <Setter Property="Foreground" Value="{DynamicResource AccRed}" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock DockPanel.Dock="Right" FontSize="{StaticResource FontSize9}" Foreground="{DynamicResource TextS}"
                           VerticalAlignment="Center" HorizontalAlignment="Right"
                           x:Name="CursorPositionText" />
            </DockPanel>
        </Border>

        <!-- ??????????????????????????????????????????????????????? -->
        <!-- ROW 5: Action Buttons (Save / Cancel)                  -->
        <!-- ??????????????????????????????????????????????????????? -->
        <Border Grid.Row="5" Background="{DynamicResource BgPanel}" Padding="10,8"
                BorderBrush="{DynamicResource Bdr}" BorderThickness="0,1,0,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource EditorBtn}" MinWidth="90"
                            Background="{DynamicResource GreenBtnBg}" Foreground="{DynamicResource AccGreen}"
                            Command="{Binding SaveCommand}" ToolTip="Validate and save WatchItem XML changes">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#x1F4BE;" FontSize="{StaticResource FontSize12}" FontFamily="Segoe UI Emoji" Margin="0,0,4,0" />
                            <TextBlock Text="Save" FontWeight="Bold" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource EditorBtn}" MinWidth="90"
                            Background="{DynamicResource DangerBtnBg}" Foreground="{DynamicResource AccRed}"
                            Command="{Binding CancelCommand}" ToolTip="Discard changes and close">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#x2715;" FontSize="{StaticResource FontSize12}" Margin="0,0,4,0" />
                            <TextBlock Text="Cancel" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <TextBlock/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
