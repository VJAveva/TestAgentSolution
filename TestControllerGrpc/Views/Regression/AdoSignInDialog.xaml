<Window x:Class="TestControllerGrpc.Views.Regression.AdoSignInDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AVEVA · Azure DevOps Sign-In"
        Height="340" Width="470" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgCanvasBrush}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>
    <Border Padding="24">
        <StackPanel>
            <TextBlock Text="AVEVA" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextTertiaryBrush}" />
            <TextBlock Text="Azure DevOps Sign-In" FontSize="20" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2,0,4" />
            <TextBlock Text="Uses your Microsoft (Entra) identity — no PAT to rotate."
                       FontSize="11.5" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,0,0,18" TextWrapping="Wrap" />

            <!-- Current account / status -->
            <Border Background="{DynamicResource BgSecondaryBrush}" CornerRadius="6" Padding="14,12"
                    BorderBrush="{DynamicResource BorderTertiaryBrush}" BorderThickness="1" Margin="0,0,0,18">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="9" Height="9" VerticalAlignment="Center" Margin="0,0,8,0">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="#C0392B" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSignedIn}" Value="True">
                                            <Setter Property="Fill" Value="#3FBE86" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding AccountText}" FontSize="13" FontWeight="Medium"
                                   Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{Binding StatusText}" FontSize="11" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextTertiaryBrush}" Margin="17,6,0,0" />
                </StackPanel>
            </Border>

            <!-- Sign in with Microsoft -->
            <Button Command="{Binding SignInCommand}" Height="40" Cursor="Hand" HorizontalAlignment="Left"
                    Background="#2F2F2F" Foreground="White" BorderThickness="0" Padding="14,0">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Grid Width="18" Height="18" Margin="0,0,10,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition />
                                        <RowDefinition />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <Rectangle Grid.Row="0" Grid.Column="0" Fill="#F25022" Margin="0,0,1,1" />
                                    <Rectangle Grid.Row="0" Grid.Column="1" Fill="#7FBA00" Margin="1,0,0,1" />
                                    <Rectangle Grid.Row="1" Grid.Column="0" Fill="#00A4EF" Margin="0,1,1,0" />
                                    <Rectangle Grid.Row="1" Grid.Column="1" Fill="#FFB900" Margin="1,1,0,0" />
                                </Grid>
                                <TextBlock Text="Sign in with Microsoft" FontSize="13" VerticalAlignment="Center" Foreground="White" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#3A3A3A" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- Actions -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                <Button Content="Sign out" Command="{Binding SignOutCommand}" Padding="14,6" Margin="0,0,8,0" Cursor="Hand"
                        Visibility="{Binding IsSignedIn, Converter={StaticResource BoolToVis}}" />
                <Button Content="Close" Click="OnClose" Padding="14,6" Cursor="Hand" IsCancel="True" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
