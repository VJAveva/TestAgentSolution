<UserControl x:Class="TestControllerGrpc.Views.Regression.ImpactMappingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             mc:Ignorable="d"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             d:DesignHeight="640" d:DesignWidth="900">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Toolbar: scope (tier) + run + status -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Scope:" VerticalAlignment="Center" Margin="0,0,6,0" />
            <ComboBox Width="120" ItemsSource="{Binding Tiers}" SelectedItem="{Binding SelectedTier}" />
            <Button Content="Map Impact" Command="{Binding RunCommand}" Margin="8,0,0,0" Padding="10,2" />
            <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" Margin="12,0,0,0" Opacity="0.8" />
        </StackPanel>

        <!-- Early-exit banner -->
        <Border Grid.Row="1" Background="#FFEFF7E6" BorderBrush="#FF7CB342" BorderThickness="1" CornerRadius="3"
                Padding="8,4" Margin="0,0,0,8" Visibility="{Binding EarlyExit, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{Binding EarlyExitReason}" FontWeight="SemiBold" Foreground="#FF33691E" />
        </Border>

        <!-- Coverage Gaps panel (pinned at the top, most actionable) -->
        <GroupBox Grid.Row="2" Header="Coverage Gaps" Margin="0,0,0,8">
            <DataGrid ItemsSource="{Binding Gaps}" AutoGenerateColumns="False" IsReadOnly="True"
                      HeadersVisibility="Column" MaxHeight="140">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Risk" Binding="{Binding RiskTier}" Width="90" />
                    <DataGridTextColumn Header="Area / Feature" Binding="{Binding RegressionArea}" Width="240" />
                    <DataGridTextColumn Header="Reason" Binding="{Binding Reason}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>

        <!-- Selected test cases -->
        <GroupBox Grid.Row="3" Header="Selected Test Cases">
            <DataGrid ItemsSource="{Binding SelectedTestCases}" SelectedItem="{Binding SelectedTestCase}"
                      AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="70" />
                    <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="*" />
                    <DataGridTextColumn Header="Feature" Binding="{Binding FeatureId}" Width="80" />
                    <DataGridTextColumn Header="Grade" Binding="{Binding Grade}" Width="60" />
                    <DataGridTextColumn Header="Confidence" Binding="{Binding Confidence}" Width="90" />
                    <DataGridTextColumn Header="Score" Binding="{Binding FinalScore, StringFormat=F3}" Width="70" />
                    <DataGridTextColumn Header="Anchor" Binding="{Binding Anchor}" Width="120" />
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>

        <!-- Provenance strip: audit the selected result backwards -->
        <GroupBox Grid.Row="4" Header="Provenance" Margin="0,8,0,0">
            <ItemsControl ItemsSource="{Binding Provenance}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#FFF2F2F2" BorderBrush="#FFCCCCCC" BorderThickness="1" CornerRadius="3"
                                Padding="6,3" Margin="0,0,6,0">
                            <StackPanel>
                                <TextBlock Text="{Binding Stage}" FontWeight="SemiBold" FontSize="11" />
                                <TextBlock Text="{Binding Detail}" FontSize="11" TextTrimming="CharacterEllipsis" MaxWidth="160" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </GroupBox>

        <!-- Diagnostics footer -->
        <Border Grid.Row="5" Background="#FFF7F7F7" BorderBrush="#FFDDDDDD" BorderThickness="1" Padding="8,4" Margin="0,8,0,0">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding BudgetSummary}" Margin="0,0,16,0" />
                <TextBlock Text="Dropped —" Margin="0,0,6,0" Opacity="0.7" />
                <TextBlock Text="{Binding DroppedByBudget, StringFormat=budget {0}}" Margin="0,0,10,0" />
                <TextBlock Text="{Binding DroppedByGrade, StringFormat=grade {0}}" Margin="0,0,10,0" />
                <TextBlock Text="{Binding DroppedByDiversity, StringFormat=diversity {0}}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
