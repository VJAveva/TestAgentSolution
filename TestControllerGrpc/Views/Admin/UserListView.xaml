<UserControl x:Class="TestControllerGrpc.Views.Admin.UserListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <DockPanel>
        <!-- Header: Search + Add button -->
        <StackPanel DockPanel.Dock="Top" Margin="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=300}"
                         Padding="6,4" FontSize="12" Margin="0,0,6,0"/>
                <Button Grid.Column="1" Content="+ Add" Padding="8,4" FontSize="11"
                        Command="{Binding LoadUsersCommand}" ToolTip="Add user"
                        Background="#74ACEA" Foreground="White"/>
            </Grid>

            <!-- Role filter pills -->
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <RadioButton Content="All" IsChecked="True" GroupName="RoleFilter" Margin="0,0,6,0"
                             Style="{DynamicResource FilterPillStyle}"/>
                <RadioButton Content="Admin" GroupName="RoleFilter" Margin="0,0,6,0"
                             Style="{DynamicResource FilterPillStyle}"/>
                <RadioButton Content="Sr.Mgr" GroupName="RoleFilter" Margin="0,0,6,0"
                             Style="{DynamicResource FilterPillStyle}"/>
                <RadioButton Content="Engineer" GroupName="RoleFilter"
                             Style="{DynamicResource FilterPillStyle}"/>
            </StackPanel>
        </StackPanel>

        <!-- User list -->
        <ListBox DockPanel.Dock="Bottom"
                 ItemsSource="{Binding Users}"
                 SelectedItem="{Binding SelectedUser}"
                 BorderThickness="0" Background="Transparent">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" Margin="4,6">
                        <!-- Avatar circle with initials -->
                        <Border Width="28" Height="28" CornerRadius="14" Background="#2274ACEA" Margin="0,0,8,0">
                            <TextBlock Text="{Binding Username[0]}" FontSize="12" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextPrimary}"/>
                        </Border>
                        <StackPanel>
                            <TextBlock Text="{Binding Username}" FontSize="12" FontWeight="Medium"
                                       Foreground="{DynamicResource TextPrimary}"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Role}" FontSize="10"
                                           Foreground="{DynamicResource TextSecondary}"/>
                                <TextBlock Text=" · " FontSize="10" Foreground="{DynamicResource TextSecondary}"/>
                                <TextBlock FontSize="10" Foreground="{DynamicResource TextSecondary}">
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="{}{0} pipelines">
                                            <Binding Path="PipelineCount"/>
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</UserControl>
