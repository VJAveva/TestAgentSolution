<Window x:Class="TestControllerGrpc.Views.Admin.ResetPasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Password Reset" Height="260" Width="400"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource WindowBg}">

    <Grid Margin="24">
        <StackPanel>
            <TextBlock Text="Password reset successful" FontSize="16" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,8"/>

            <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,16" TextWrapping="Wrap">
                <TextBlock.Text>
                    <Binding Path="Username" StringFormat="A new password has been generated for {0}. Copy it now — it will not be shown again."/>
                </TextBlock.Text>
            </TextBlock>

            <!-- Password display -->
            <Border BorderBrush="{DynamicResource BorderDefault}" BorderThickness="1" CornerRadius="4" Padding="10,8" Margin="0,0,0,16">
                <TextBlock Text="{Binding NewPassword}" FontFamily="Consolas" FontSize="14"
                           Foreground="{DynamicResource TextPrimary}" TextWrapping="NoWrap"/>
            </Border>

            <!-- Buttons -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="I've noted it" Padding="12,8" FontSize="12" Margin="0,0,8,0"
                        Command="{Binding ExplicitCancelCommand}"
                        Foreground="{DynamicResource TextSecondary}"/>
                <Button Padding="12,8" FontSize="12" FontWeight="Medium"
                        Command="{Binding CopyToClipboardCommand}"
                        Background="#74ACEA" Foreground="White">
                    <Button.Content>
                        <TextBlock Text="{Binding HasCopied, Converter={StaticResource BoolToCopiedTextConverter}}"/>
                    </Button.Content>
                </Button>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
