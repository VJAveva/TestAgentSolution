<Window x:Class="TestControllerGrpc.Views.Admin.AddUserDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add User" Height="360" Width="400"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource WindowBg}">

    <Grid Margin="24">
        <StackPanel>
            <TextBlock Text="Create new user" FontSize="{StaticResource FontSize16}" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,16"/>

            <!-- Username -->
            <TextBlock Text="Username" FontSize="{StaticResource FontSize10}" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4"/>
            <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                     Padding="8,6" FontSize="{StaticResource FontSize12}" Margin="0,0,0,2" AutomationProperties.Name="Username" />
            <TextBlock Text="{Binding UsernameError}" FontSize="{StaticResource FontSize9}" Foreground="{DynamicResource LogErrorBrush}" Margin="0,0,0,8"
                       Visibility="{Binding UsernameError, Converter={StaticResource StringToVisConverter}}"/>

            <!-- Email -->
            <TextBlock Text="Email" FontSize="{StaticResource FontSize10}" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4"/>
            <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                     Padding="8,6" FontSize="{StaticResource FontSize12}" Margin="0,0,0,12" AutomationProperties.Name="Email" />

            <!-- Role -->
            <TextBlock Text="Role" FontSize="{StaticResource FontSize10}" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4"/>
            <ComboBox ItemsSource="{Binding AvailableRoles}" SelectedItem="{Binding SelectedRole}"
                      Padding="8,6" FontSize="{StaticResource FontSize12}" Margin="0,0,0,12" AutomationProperties.Name="Role" />

            <!-- Error -->
            <TextBlock Text="{Binding ErrorMessage}" FontSize="{StaticResource FontSize10}" Foreground="{DynamicResource LogErrorBrush}" Margin="0,0,0,8"
                       Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisConverter}}"
                       TextWrapping="Wrap"/>

            <!-- Buttons -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                <Button Content="Cancel" Padding="12,8" FontSize="{StaticResource FontSize11}" Margin="0,0,8,0"
                        IsCancel="True"/>
                <Button Content="Create user" Padding="12,8" FontSize="{StaticResource FontSize11}" FontWeight="Medium"
                        Command="{Binding CreateCommand}"
                        Background="{DynamicResource CRunBrush}" Foreground="White"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
