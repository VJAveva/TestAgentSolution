<UserControl x:Class="TestControllerGrpc.Views.Admin.UserManagementPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:admin="clr-namespace:TestControllerGrpc.Views.Admin"
             Background="{DynamicResource WindowBg}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" MinWidth="200"/>
            <ColumnDefinition Width="1"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left pane: User list -->
        <admin:UserListView Grid.Column="0" DataContext="{Binding}"/>

        <!-- Divider -->
        <Rectangle Grid.Column="1" Fill="{DynamicResource BorderDefault}" Width="1"/>

        <!-- Right pane: User detail -->
        <admin:UserDetailView Grid.Column="2" DataContext="{Binding}"/>
    </Grid>
</UserControl>
