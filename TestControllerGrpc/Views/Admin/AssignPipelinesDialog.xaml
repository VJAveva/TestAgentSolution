<Window x:Class="TestControllerGrpc.Views.Admin.AssignPipelinesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:TestControllerGrpc.ViewModels"
        Title="Assign Pipelines" Height="450" Width="400"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource WindowBg}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>
        <vm:InverseBoolToVisibilityConverter x:Key="InvBoolVis"/>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock FontSize="{StaticResource FontSize16}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}">
                <TextBlock.Text>
                    <Binding Path="Username" StringFormat="Assign pipelines to {0}"/>
                </TextBlock.Text>
            </TextBlock>
            <TextBlock Text="Check pipelines to assign; uncheck to revoke." FontSize="{StaticResource FontSize10}"
                       Foreground="{DynamicResource TextSecondary}" Margin="0,4,0,0"
                       Visibility="{Binding IsFullAccessRole, Converter={StaticResource InvBoolVis}}"/>
            <TextBlock Text="Administrators and Senior Managers have full access to all pipelines to trigger and cancel."
                       FontSize="{StaticResource FontSize10}" Foreground="{DynamicResource TextSecondary}" Margin="0,4,0,0"
                       Visibility="{Binding IsFullAccessRole, Converter={StaticResource BoolVis}}"/>
        </StackPanel>

        <!-- Pipeline checkboxes -->
        <ListBox Grid.Row="1" ItemsSource="{Binding Pipelines}" BorderThickness="1"
                 BorderBrush="{DynamicResource Bdr}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <CheckBox IsChecked="{Binding IsChecked}" IsEnabled="{Binding IsSelectable}" Content="{Binding PipelineId}"
                              FontSize="{StaticResource FontSize11}" Margin="4,3"/>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Error -->
        <TextBlock Grid.Row="2" Text="{Binding ErrorMessage}" FontSize="{StaticResource FontSize10}" Foreground="{DynamicResource LogErrorBrush}"
                   Margin="0,8,0,0" TextWrapping="Wrap"
                   Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisConverter}}"/>

        <!-- Buttons -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Cancel" Padding="12,8" FontSize="{StaticResource FontSize11}" Margin="0,0,8,0" IsCancel="True"/>
            <Button Content="Save" Padding="12,8" FontSize="{StaticResource FontSize11}" FontWeight="Medium"
                    Command="{Binding SaveCommand}"
                    Background="{DynamicResource CRunBrush}" Foreground="White"/>
        </StackPanel>
    </Grid>
</Window>
