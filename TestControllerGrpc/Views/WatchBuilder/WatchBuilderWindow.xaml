<Window x:Class="TestControllerGrpc.Views.WatchBuilder.WatchBuilderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        xmlns:vm="clr-namespace:TestControllerGrpc.ViewModels.WatchBuilder"
        xmlns:model="clr-namespace:TestControllerGrpc.Models;assembly=TestControllerGrpc.Core"
        Title="WatchItem Builder - TestController"
        Height="860" Width="1400" MinWidth="1000" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgCanvasBrush}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <FontFamily x:Key="Mono">Consolas</FontFamily>

        <ObjectDataProvider x:Key="ExecutionModes" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="model:ExecutionMode" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
        <ObjectDataProvider x:Key="ActionTypes" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="model:ActionType" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>

        <Style x:Key="ToolBtn" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource BgSecondaryBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderTertiaryBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Margin" Value="4,0,0,0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
            <Setter Property="FontSize" Value="{StaticResource FontSize10}" />
            <Setter Property="Margin" Value="0,8,0,2" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="4,3" />
            <Setter Property="Margin" Value="0,0,0,2" />
        </Style>

        <!-- ================= Detail templates (implicit, by VM type) ============= -->
        <DataTemplate DataType="{x:Type vm:WatchItemNodeViewModel}">
            <StackPanel Margin="12">
                <TextBlock Text="WatchItem" FontSize="{StaticResource FontSize14}" FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Style="{StaticResource FieldLabel}" Text="Tag" />
                <TextBox Text="{Binding Tag, UpdateSourceTrigger=PropertyChanged}"  AutomationProperties.Name="Tag" />
                <TextBlock Style="{StaticResource FieldLabel}" Text="Path (folder to watch)" />
                <TextBox Text="{Binding Path, UpdateSourceTrigger=PropertyChanged}"  AutomationProperties.Name="Path (folder to watch)" />
                <TextBlock Style="{StaticResource FieldLabel}" Text="Filter" />
                <TextBox Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}"  AutomationProperties.Name="Filter" />
                <CheckBox Content="Enabled" Margin="0,8,0,0"
                          Foreground="{DynamicResource TextPrimaryBrush}"
                          IsChecked="{Binding IsEnabled}" />
                <TextBlock Style="{StaticResource FieldLabel}" Text="Build Number Field" />
                <TextBox Text="{Binding BuildNumberField, UpdateSourceTrigger=PropertyChanged}"  AutomationProperties.Name="Build Number Field" />
                <TextBlock Style="{StaticResource FieldLabel}" Text="Drop Location Field" />
                <TextBox Text="{Binding DropLocationField, UpdateSourceTrigger=PropertyChanged}"  AutomationProperties.Name="Drop Location Field" />
                <TextBlock Style="{StaticResource FieldLabel}" Text="Build Base Path" />
                <TextBox Text="{Binding BuildBasePath, UpdateSourceTrigger=PropertyChanged}"  AutomationProperties.Name="Build Base Path" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:EventNodeViewModel}">
            <StackPanel Margin="12">
                <TextBlock Text="Event" FontSize="{StaticResource FontSize14}" FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Style="{StaticResource FieldLabel}" Text="Type" />
                <ComboBox ItemsSource="{Binding EventTypes}"
                          SelectedItem="{Binding Type, UpdateSourceTrigger=PropertyChanged}"  AutomationProperties.Name="Type" />
                <TextBlock Style="{StaticResource FieldLabel}" Text="Execution Type" />
                <ComboBox ItemsSource="{Binding Source={StaticResource ExecutionModes}}"
                          SelectedItem="{Binding ExecutionType}"  AutomationProperties.Name="Execution Type" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:ActionGroupNodeViewModel}">
            <StackPanel Margin="12">
                <TextBlock Text="Action Group" FontSize="{StaticResource FontSize14}" FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Style="{StaticResource FieldLabel}" Text="Tag" />
                <TextBox Text="{Binding Tag, UpdateSourceTrigger=PropertyChanged}"  AutomationProperties.Name="Tag" />
                <TextBlock Style="{StaticResource FieldLabel}" Text="Execution Type" />
                <ComboBox ItemsSource="{Binding Source={StaticResource ExecutionModes}}"
                          SelectedItem="{Binding ExecutionType}"  AutomationProperties.Name="Execution Type" />
                <CheckBox Content="Fail and continue" Margin="0,8,0,0"
                          Foreground="{DynamicResource TextPrimaryBrush}"
                          IsChecked="{Binding FailAndContinue}" />
                <CheckBox Content="Skip evaluator" Margin="0,8,0,0"
                          Foreground="{DynamicResource TextPrimaryBrush}"
                          ToolTip="Skip this action group and its descendants during execution"
                          IsChecked="{Binding Skip}" />
                <TextBlock Style="{StaticResource FieldLabel}" Text="Skip reason" />
                <TextBox Text="{Binding SkipReason, UpdateSourceTrigger=PropertyChanged}"  AutomationProperties.Name="Skip reason" />
                <TextBlock Style="{StaticResource FieldLabel}" Text="Comment" />
                <TextBox Text="{Binding Comment, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True" TextWrapping="Wrap" MinHeight="45"  AutomationProperties.Name="Comment" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:ActionNodeViewModel}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="12">
                    <TextBlock Text="Action" FontSize="{StaticResource FontSize14}" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Type" />
                    <ComboBox ItemsSource="{Binding Source={StaticResource ActionTypes}}"
                              SelectedItem="{Binding Type}"  AutomationProperties.Name="Type" />
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Tag" />
                    <TextBox Text="{Binding Tag, UpdateSourceTrigger=PropertyChanged}"  AutomationProperties.Name="Tag" />

                    <!-- Command fields (RunCommand / RunRemoteCommand) -->
                    <StackPanel Visibility="{Binding IsCommand, Converter={StaticResource BoolToVis}}">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Agent Name" />
                        <TextBox Text="{Binding AgentName, UpdateSourceTrigger=PropertyChanged}"  AutomationProperties.Name="Agent Name" />
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Command" />
                        <TextBox Text="{Binding Command, UpdateSourceTrigger=PropertyChanged}"  AutomationProperties.Name="Command" />
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Parameters" />
                        <TextBox Text="{Binding Parameters, UpdateSourceTrigger=PropertyChanged}"  AutomationProperties.Name="Parameters" />
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Timeout (seconds, 0 = infinite)" />
                        <TextBox Text="{Binding Timeout, UpdateSourceTrigger=PropertyChanged}"  AutomationProperties.Name="Timeout (seconds, 0 = infinite)" />
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Poll Interval (ms)" />
                        <TextBox Text="{Binding PollInterval, UpdateSourceTrigger=PropertyChanged}"  AutomationProperties.Name="Poll Interval (ms)" />
                        <CheckBox Content="Is reboot" Margin="0,8,0,0"
                                  Foreground="{DynamicResource TextPrimaryBrush}"
                                  IsChecked="{Binding IsReboot}" />
                    </StackPanel>

                    <!-- Credentials (RunRemoteCommand) -->
                    <StackPanel Visibility="{Binding IsRemoteCommand, Converter={StaticResource BoolToVis}}">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="User Name" />
                        <TextBox Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}"  AutomationProperties.Name="User Name" />
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Password" />
                        <TextBox Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}"  AutomationProperties.Name="Password" />
                    </StackPanel>

                    <!-- SendMail fields -->
                    <StackPanel Visibility="{Binding IsSendMail, Converter={StaticResource BoolToVis}}">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="From" />
                        <TextBox Text="{Binding From, UpdateSourceTrigger=PropertyChanged}"  AutomationProperties.Name="From" />
                        <TextBlock Style="{StaticResource FieldLabel}" Text="To" />
                        <TextBox Text="{Binding To, UpdateSourceTrigger=PropertyChanged}"  AutomationProperties.Name="To" />
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Title" />
                        <TextBox Text="{Binding EmailTitle, UpdateSourceTrigger=PropertyChanged}"  AutomationProperties.Name="Title" />
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Body" />
                        <TextBox Text="{Binding Body, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60"  AutomationProperties.Name="Body" />
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Attachment" />
                        <TextBox Text="{Binding Attachment, UpdateSourceTrigger=PropertyChanged}"  AutomationProperties.Name="Attachment" />
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Embed" />
                        <TextBox Text="{Binding Embed, UpdateSourceTrigger=PropertyChanged}"  AutomationProperties.Name="Embed" />
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Large Files Share" />
                        <TextBox Text="{Binding LargeFilesShare, UpdateSourceTrigger=PropertyChanged}"  AutomationProperties.Name="Large Files Share" />
                    </StackPanel>

                    <CheckBox Content="Fail and continue" Margin="0,8,0,0"
                              Foreground="{DynamicResource TextPrimaryBrush}"
                              IsChecked="{Binding FailAndContinue}" />
                    <CheckBox Content="Skip evaluator" Margin="0,8,0,0"
                              Foreground="{DynamicResource TextPrimaryBrush}"
                              ToolTip="Skip this action and its execution"
                              IsChecked="{Binding Skip}" />
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Skip reason" />
                    <TextBox Text="{Binding SkipReason, UpdateSourceTrigger=PropertyChanged}"  AutomationProperties.Name="Skip reason" />
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Comment" />
                    <TextBox Text="{Binding Comment, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True" TextWrapping="Wrap" MinHeight="45"  AutomationProperties.Name="Comment" />
                </StackPanel>
            </ScrollViewer>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:InitializeNodeViewModel}">
            <StackPanel Margin="12">
                <TextBlock Text="Initialize" FontSize="{StaticResource FontSize14}" FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Style="{StaticResource FieldLabel}" Text="Tag" />
                <TextBox Text="{Binding Tag, UpdateSourceTrigger=PropertyChanged}"  AutomationProperties.Name="Tag" />
                <TextBlock Style="{StaticResource FieldLabel}" Text="Parameter File" />
                <TextBox Text="{Binding ParameterFile, UpdateSourceTrigger=PropertyChanged}"  AutomationProperties.Name="Parameter File" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:RefNodeViewModel}">
            <StackPanel Margin="12">
                <TextBlock Text="Template Reference" FontSize="{StaticResource FontSize14}" FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Style="{StaticResource FieldLabel}" Text="Template ID" />
                <TextBox Text="{Binding TemplateID, UpdateSourceTrigger=PropertyChanged}"  AutomationProperties.Name="Template ID" />
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <Button Style="{StaticResource ToolBtn}" Content="Reload" Command="{Binding LoadCommand}" />
            <Button Style="{StaticResource ToolBtn}" Content="+ WatchItem" Command="{Binding AddWatchItemCommand}" />
            <Button Style="{StaticResource ToolBtn}" Content="+ Event" Command="{Binding AddEventCommand}" />
            <Button Style="{StaticResource ToolBtn}" Content="+ Group" Command="{Binding AddGroupCommand}" />
            <Button Style="{StaticResource ToolBtn}" Content="+ Action" Command="{Binding AddActionCommand}" />
            <Button Style="{StaticResource ToolBtn}" Content="+ Initialize" Command="{Binding AddInitializeCommand}" />
            <Button Style="{StaticResource ToolBtn}" Content="+ Ref" Command="{Binding AddRefCommand}" />
            <Button Style="{StaticResource ToolBtn}" Content="Delete" Command="{Binding DeleteSelectedCommand}" />
            <Button Style="{StaticResource ToolBtn}" Content="Save" Command="{Binding SaveCommand}"
                    FontWeight="Bold" Margin="16,0,0,0" />
        </StackPanel>

        <!-- Body: tree | detail | xml+validation -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" MinWidth="220" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" MinWidth="280" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="460" MinWidth="300" />
            </Grid.ColumnDefinitions>

            <!-- Tree -->
            <Border Grid.Column="0" BorderThickness="1"
                    BorderBrush="{DynamicResource BorderTertiaryBrush}"
                    Background="{DynamicResource BgPrimaryBrush}">
                <TreeView x:Name="Tree" ItemsSource="{Binding Roots}"
                          Background="Transparent" BorderThickness="0"
                          SelectedItemChanged="Tree_SelectedItemChanged">
                    <TreeView.ItemContainerStyle>
                        <Style TargetType="TreeViewItem">
                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                        </Style>
                    </TreeView.ItemContainerStyle>
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                            <TextBlock Text="{Binding Title}" Padding="2,1" />
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
            </Border>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"
                          Background="{DynamicResource BorderTertiaryBrush}" />

            <!-- Detail -->
            <Border Grid.Column="2" BorderThickness="1"
                    BorderBrush="{DynamicResource BorderTertiaryBrush}"
                    Background="{DynamicResource BgPrimaryBrush}">
                <ContentControl Content="{Binding SelectedNode}" />
            </Border>

            <GridSplitter Grid.Column="3" Width="5" HorizontalAlignment="Stretch"
                          Background="{DynamicResource BorderTertiaryBrush}" />

            <!-- XML + validation -->
            <Grid Grid.Column="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="5" />
                    <RowDefinition Height="240" MinHeight="120" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" BorderThickness="1"
                        BorderBrush="{DynamicResource BorderTertiaryBrush}"
                        Background="{DynamicResource BgPrimaryBrush}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Live XML" Margin="8,6"
                                   Foreground="{DynamicResource TextTertiaryBrush}" FontSize="{StaticResource FontSize10}" />
                        <TextBox Text="{Binding LiveXml, Mode=OneWay}" IsReadOnly="True"
                                 FontFamily="{StaticResource Mono}" FontSize="{StaticResource FontSize10}"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                 Background="Transparent" BorderThickness="0"
                                 Foreground="{DynamicResource TextPrimaryBrush}"  AutomationProperties.Name="Live XML" />
                    </DockPanel>
                </Border>

                <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch"
                              Background="{DynamicResource BorderTertiaryBrush}" />

                <Border Grid.Row="2" BorderThickness="1"
                        BorderBrush="{DynamicResource BorderTertiaryBrush}"
                        Background="{DynamicResource BgPrimaryBrush}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Validation" Margin="8,6"
                                   Foreground="{DynamicResource TextTertiaryBrush}" FontSize="{StaticResource FontSize10}" />
                        <ListView ItemsSource="{Binding Issues}" Background="Transparent" BorderThickness="0">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Severity" Width="70"
                                                    DisplayMemberBinding="{Binding Severity}" />
                                    <GridViewColumn Header="Node" Width="150"
                                                    DisplayMemberBinding="{Binding NodePath}" />
                                    <GridViewColumn Header="Message" Width="200"
                                                    DisplayMemberBinding="{Binding Message}" />
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="2" Margin="0,8,0,0" Padding="8,5"
                Background="{DynamicResource BgSecondaryBrush}">
            <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="{StaticResource FontSize10}" />
        </Border>
    </Grid>
</Window>
