<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>TestControllerGrpc</RootNamespace>
    <AssemblyName>TestControllerGrpc</AssemblyName>
    <ApplicationIcon>Assets\testcontroller.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TestControllerGrpc.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Tray icon (loaded via pack URI by TrayIconService) and copied next to
         the exe so the file-path fallback also works without rebuild. -->
    <Resource Include="Assets\dashboard.ico" />
    <None Update="Assets\dashboard.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- Application / Task Manager icon: "TC" badge matching the tray + window icon. -->
    <Resource Include="Assets\testcontroller.ico" />
    <None Update="Assets\testcontroller.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <!-- Required for hosting gRPC server (Kestrel) alongside WPF -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WindowsForms" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TestControllerGrpc.Core\TestControllerGrpc.Core.csproj" />
    <ProjectReference Include="..\TestController.Api\TestController.Api.csproj" />
    <ProjectReference Include="..\TestController.Reporting\TestController.Reporting.csproj" />
    <ProjectReference Include="..\TestController.Impact\TestController.Impact.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AvalonEdit" Version="6.3.1.120" />
    <PackageReference Include="BCrypt.Net-Next" Version="4.2.0" />
    <PackageReference Include="coverlet.collector" Version="10.0.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Grpc.Net.Client" Version="2.80.0" />
    <PackageReference Include="Grpc.Core.Api" Version="2.80.0" />
    <PackageReference Include="Grpc.AspNetCore" Version="2.80.0" />
    <PackageReference Include="Google.Protobuf" Version="3.35.1" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Material.Icons.WPF" Version="3.0.2" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.9">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Polly.Core" Version="8.7.0" />
    <PackageReference Include="Svg.Skia" Version="5.1.1" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.9" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\XmlSyntaxHighlighting.xshd" />
    <EmbeddedResource Include="Resources\chart.umd.min.js" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\nextgen_watermark.png" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\Icons\**\*.svg" Link="Icons\%(RecursiveDir)%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Controllers\**" />
    <Compile Remove="Hubs\**" />
    <EmbeddedResource Remove="Controllers\**" />
    <EmbeddedResource Remove="Hubs\**" />
    <None Remove="Controllers\**" />
    <None Remove="Hubs\**" />
    <Page Remove="Controllers\**" />
    <Page Remove="Hubs\**" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Help\TestController_Help.html">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Protos\" />
  </ItemGroup>

</Project>
