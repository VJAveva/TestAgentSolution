<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>TestControllerGrpc</RootNamespace>
    <AssemblyName>TestControllerGrpc</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TestControllerGrpc.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Required for hosting gRPC server (Kestrel) alongside WPF -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WindowsForms" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TestControllerGrpc.Core\TestControllerGrpc.Core.csproj" />
    <ProjectReference Include="..\TestController.Api\TestController.Api.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Grpc.Net.Client" Version="2.62.0" />
    <PackageReference Include="Grpc.Core.Api" Version="2.62.0" />
    <PackageReference Include="Grpc.AspNetCore" Version="2.62.0" />
    <PackageReference Include="Google.Protobuf" Version="3.26.1" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
    <PackageReference Include="AvalonEdit" Version="6.2.0.78" />
    <PackageReference Include="Polly.Core" Version="8.5.2" />
    <PackageReference Include="Svg.Skia" Version="2.0.0.4" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\XmlSyntaxHighlighting.xshd" />
    <EmbeddedResource Include="Resources\chart.umd.min.js" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\nextgen_watermark.png" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\Icons\**\*.svg" Link="Icons\%(RecursiveDir)%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Controllers\**" />
    <Compile Remove="Hubs\**" />
    <EmbeddedResource Remove="Controllers\**" />
    <EmbeddedResource Remove="Hubs\**" />
    <None Remove="Controllers\**" />
    <None Remove="Hubs\**" />
    <Page Remove="Controllers\**" />
    <Page Remove="Hubs\**" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Help\TestController_Help.html">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
