{
  "VocabularyFile": "C:\\TestControllerService\\WatchList.xml",
  "ControllerGrpcPort": 5100,
  "ControllerGrpcKeepAliveHours": 24,
  "WebApiPort": 5200,
  "Logging": {
    "CentralSink": {
      "Enabled": false,
      "SeqUrl": "http://localhost:5341",
      "ApiKey": "",
      "BatchSize": 100,
      "FlushIntervalSeconds": 2,
      "MaxBufferedEvents": 10000,
      "MinimumLevel": ""
    }
  },
  "Agents": [
    { "Name": "JVGR1",   "Address": "http://JVGR1:5200" },
    { "Name": "JVGR2",   "Address": "http://JVGR2:5200" },
    { "Name": "JVKPRI",  "Address": "http://JVKPRI:5200" },
    { "Name": "JVKBAK",  "Address": "http://JVKBAK:5200" },
    { "Name": "JVHIST",  "Address": "http://JVHIST:5200" }
  ],
  "Controller": {
    "Timeouts": {
      "TestConnectionTimeoutSeconds": 5,
      "PingTimeoutSeconds": 3,
      "DiagnosticsTcpTimeoutSeconds": 3,
      "DiagnosticsHttpTimeoutSeconds": 3,
      "DiagnosticsGrpcTimeoutSeconds": 5,
      "WaitForAgentFreeMaxSeconds": 30,
      "BusyRecoveryMaxSeconds": 120,
      "BusyRecoveryIntervalSeconds": 10,
      "ChannelConnectTimeoutSeconds": 30,
      "KeepAlivePingDelaySeconds": 60,
      "KeepAlivePingTimeoutSeconds": 30,
      "PooledConnectionIdleMinutes": 5,
      "MaxReceiveMessageSizeBytes": 16777216,
      "MaxSendMessageSizeBytes": 16777216,
      "CircuitBreakerBreakSeconds": 15,
      "AutoResetFailureThreshold": 10,
      "TelemetryPollIntervalMs": 2000,
      "SessionElapsedTimerMs": 1000,
      "OuterSafetyNetTimeoutHours": 24,
      "RetryMaxAttempts": 3,
      "RetryDelaySeconds": 1,
      "UnavailableRecoverySeconds": 180,
      "UnavailableRecoveryPollIntervalSeconds": 10,
      "AutoRebootOnUnavailable": true,
      "AutoRebootRecoverySeconds": 300,
      "RebootWaitReadySeconds": 300,
      "RebootRecoveryPollIntervalSeconds": 10,
      "RecoveryControlRpcTimeoutSeconds": 5,
      "TerminateSettleSeconds": 6,
      "OutOfBandRebootCommandTimeoutSeconds": 30
    }
  },
  "BuildResults": {
    "ResultsRootPath": "C:\\TestResults",
    "GoodThreshold": 95.0,
    "WarningThreshold": 85.0,
    "ReportRecipients": "vinodkumar.Javvadi@aveva.com",
    "SmtpServer": "smtp",
    "SmtpPort": 25,
    "FromAddress": "wwapps@magellandev2000.dev.wonderware.com",
    "QaAlertRecipients": "vinodkumar.Javvadi@aveva.com",
    "ConsecutiveFailThreshold": 2,
    "AlertOnLoad": true
  },
  "BuildReportCard": {
    "ReportResultsRoot": "C:\\ReportResults",
    "CiFolders": [
      "SmokeTestResults",
      "LegacyCI",
      "ChangePropagation",
      "WizardPropagation",
      "ObjectWizard",
      "SymbolWizard"
    ],
    "PsrFolderName": "PSR",
    "UseDummyPsr": true,
    "GreenThreshold": 98.0,
    "BlueThreshold": 95.0,
    "AmberThreshold": 90.0,
    "TrendWindow": 10,
    "Grade": {
      "RegressionPenalty": 2.0,
      "PsrFailurePenalty": 3.0,
      "PsrWarningPenalty": 0.5,
      "CiBelow90Penalty": 1.0,
      "AThreshold": 97.0,
      "BThreshold": 93.0,
      "CThreshold": 88.0,
      "DThreshold": 80.0
    },
    "Owners": {
      "SmokeTestResults": { "Team": "platform-team", "Email": "vinodkumar.Javvadi@aveva.com" },
      "LegacyCI": { "Team": "platform-team", "Email": "vinodkumar.Javvadi@aveva.com" },
      "ChangePropagation": { "Team": "galaxy-team", "Email": "vinodkumar.Javvadi@aveva.com" },
      "WizardPropagation": { "Team": "ide-team", "Email": "vinodkumar.Javvadi@aveva.com" },
      "ObjectWizard": { "Team": "ide-team", "Email": "vinodkumar.Javvadi@aveva.com" },
      "SymbolWizard": { "Team": "symbol-team", "Email": "vinodkumar.Javvadi@aveva.com" }
    }
  },
  "HealthThresholds": {
    "CpuAmber": 60,
    "CpuRed": 85,
    "MemoryAmber": 70,
    "MemoryRed": 85,
    "DiskAmber": 70,
    "DiskRed": 85,
    "NetworkAmberMs": 50,
    "NetworkRedMs": 150
  },
  "RBAC": {
    "Enabled": false
  }
