<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- Window -->
    <SolidColorBrush x:Key="WindowBg"    Color="#FFF5F5F5" />
    <SolidColorBrush x:Key="RibbonBg"    Color="#FFE8E8EC" />
    <SolidColorBrush x:Key="RibbonTabBg" Color="#FFF0F0F4" />

    <!-- Surfaces -->
    <SolidColorBrush x:Key="BgPanel"   Color="#FFFAFAFA" />
    <SolidColorBrush x:Key="BgCard"    Color="#FFEAEAEE" />
    <SolidColorBrush x:Key="BgSurface" Color="#FFD0D0D8" />

    <!-- Accents -->
    <SolidColorBrush x:Key="Accent"    Color="#FF2563EB" />
    <SolidColorBrush x:Key="AccGreen"  Color="#FF16A34A" />
    <SolidColorBrush x:Key="AccPeach"  Color="#FFEA580C" />
    <SolidColorBrush x:Key="AccRed"    Color="#FFDC2626" />
    <SolidColorBrush x:Key="AccMauve"  Color="#FF9333EA" />
    <SolidColorBrush x:Key="AccYellow" Color="#FFCA8A04" />

    <!-- Text -->
    <SolidColorBrush x:Key="TextP"     Color="#FF1E1E2E" />
    <SolidColorBrush x:Key="TextS"     Color="#FF64748B" />
    <SolidColorBrush x:Key="Bdr"       Color="#FFCBD5E1" />

    <!-- Controls -->
    <SolidColorBrush x:Key="BtnBg"          Color="#11000000" />
    <SolidColorBrush x:Key="BtnBorder"      Color="#22000000" />
    <SolidColorBrush x:Key="BtnHoverBg"     Color="#18000000" />
    <SolidColorBrush x:Key="BtnPressedBg"   Color="#222563EB" />
    <SolidColorBrush x:Key="FieldBg"        Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="TabSelectedBg"  Color="#11000000" />
    <SolidColorBrush x:Key="TabHoverBg"     Color="#08000000" />
    <SolidColorBrush x:Key="GroupBg"        Color="#08000000" />
    <SolidColorBrush x:Key="SelectedItemBg" Color="#222563EB" />
    <SolidColorBrush x:Key="HoverItemBg"    Color="#112563EB" />
    <SolidColorBrush x:Key="TreeBadgeFg"    Color="#FFFFFFFF" />

    <!-- Accent button backgrounds -->
    <SolidColorBrush x:Key="AccentBtnBg"    Color="#222563EB" />
    <SolidColorBrush x:Key="GreenBtnBg"     Color="#2216A34A" />
    <SolidColorBrush x:Key="BlueBtnBg"      Color="#222563EB" />
    <SolidColorBrush x:Key="AccBlue"        Color="#FF2563EB" />
    <SolidColorBrush x:Key="DangerBtnBg"    Color="#22DC2626" />
    <SolidColorBrush x:Key="MauveBtnBg"     Color="#229333EA" />
    <SolidColorBrush x:Key="YellowBtnBg"    Color="#22CA8A04" />
    <SolidColorBrush x:Key="DangerBtnBgAlt" Color="#33DC2626" />

    <!-- Badge overlays -->
    <SolidColorBrush x:Key="RunningBadgeBg" Color="#222563EB" />
    <SolidColorBrush x:Key="SuccessBadgeBg" Color="#2216A34A" />
    <SolidColorBrush x:Key="FailedBadgeBg"  Color="#22DC2626" />
    <SolidColorBrush x:Key="InfoBoxBg"      Color="#0A000000" />
    <SolidColorBrush x:Key="WatchRootBg"    Color="#2216A34A" />
    <SolidColorBrush x:Key="TemplateRootBg" Color="#229333EA" />

    <!-- Status indicator dot colors -->
    <SolidColorBrush x:Key="StatusGreen"   Color="#FF16A34A" />
    <SolidColorBrush x:Key="StatusRed"     Color="#FFDC2626" />
    <SolidColorBrush x:Key="StatusYellow"  Color="#FFCA8A04" />
    <SolidColorBrush x:Key="StatusGray"    Color="#FFCBD5E1" />
    <SolidColorBrush x:Key="StatusBlue"    Color="#FF2563EB" />

    <!-- Node icon backgrounds by kind -->
    <SolidColorBrush x:Key="IconBgFolder"    Color="#222563EB" />
    <SolidColorBrush x:Key="IconBgWatch"     Color="#2216A34A" />
    <SolidColorBrush x:Key="IconBgEvent"     Color="#22CA8A04" />
    <SolidColorBrush x:Key="IconBgTemplate"  Color="#229333EA" />
    <SolidColorBrush x:Key="IconBgGroup"     Color="#222563EB" />
    <SolidColorBrush x:Key="IconBgAction"    Color="#22EA580C" />
    <SolidColorBrush x:Key="IconBgInit"      Color="#22CBD5E1" />
    <SolidColorBrush x:Key="IconBgRef"       Color="#229333EA" />

    <!-- Expander section header -->
    <SolidColorBrush x:Key="ExpanderHeaderBg" Color="#08000000" />
    <SolidColorBrush x:Key="ExpanderHeaderFg" Color="#FF64748B" />

    <!-- Alert/error highlight -->
    <SolidColorBrush x:Key="AlertErrorBg"   Color="#22DC2626" />
    <SolidColorBrush x:Key="AlertErrorBdr"  Color="#44DC2626" />

    <!-- Placeholder text -->
    <SolidColorBrush x:Key="PlaceholderFg"  Color="#44000000" />

    <!-- Icon foreground (for Segoe MDL2 Assets) -->
    <SolidColorBrush x:Key="IconFg"         Color="#FF333333" />
    <SolidColorBrush x:Key="DisabledFg"     Color="#FFB0B0B0" />

    <!-- Execution overlay -->
    <SolidColorBrush x:Key="OverlayBg"      Color="#44FFFFFF" />

    <!-- Watermark -->
    <sys:Double x:Key="WatermarkOpacity">0.04</sys:Double>

    <!-- Agent latency indicator -->
    <SolidColorBrush x:Key="LatencyGood"    Color="#FF16A34A" />
    <SolidColorBrush x:Key="LatencyWarn"    Color="#FFCA8A04" />
    <SolidColorBrush x:Key="LatencyBad"     Color="#FFDC2626" />

    <!-- Panel focus indicator -->
    <SolidColorBrush x:Key="FocusRing"      Color="#442563EB" />

    <!-- Scrollbar track -->
    <SolidColorBrush x:Key="ScrollbarTrack"      Color="#08000000" />
    <SolidColorBrush x:Key="ScrollbarThumb"      Color="#22000000" />
    <SolidColorBrush x:Key="ScrollbarThumbHover" Color="#44000000" />
    <SolidColorBrush x:Key="ScrollbarThumbDrag"  Color="#66000000" />

    <!-- Badge pill backgrounds -->
    <SolidColorBrush x:Key="CancelledBadgeBg" Color="#22CBD5E1" />
    <SolidColorBrush x:Key="PartialBadgeBg"   Color="#22EA580C" />

    <!-- ═══ TreeView Spec — Light theme design tokens ═══ -->

    <!-- Surfaces -->
    <SolidColorBrush x:Key="BgWindowBrush"      Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="BgPanelBrush"       Color="#FFF8F9FA" />
    <SolidColorBrush x:Key="BgHeaderBrush"      Color="#FFF1F3F5" />
    <SolidColorBrush x:Key="BgRowHoverBrush"    Color="#08000000" />
    <SolidColorBrush x:Key="BgRowSelectedBrush" Color="#1A2563EB" />

    <!-- Borders & rails -->
    <SolidColorBrush x:Key="BorderSoftBrush"    Color="#0A000000" />
    <SolidColorBrush x:Key="BorderMediumBrush"  Color="#1A000000" />
    <SolidColorBrush x:Key="RailIdleBrush"      Color="#0F000000" />
    <SolidColorBrush x:Key="RailActiveBrush"    Color="#662563EB" />

    <!-- Text -->
    <SolidColorBrush x:Key="TextStrongBrush"    Color="#FF1A1A2E" />
    <SolidColorBrush x:Key="TextDefaultBrush"   Color="#FF374151" />
    <SolidColorBrush x:Key="TextMutedBrush"     Color="#FF6B7280" />
    <SolidColorBrush x:Key="TextDimBrush"       Color="#FF9CA3AF" />

    <!-- Action-type accent colors -->
    <SolidColorBrush x:Key="CRunBrush"          Color="#FF2563EB" />
    <SolidColorBrush x:Key="CRemoteBrush"       Color="#FF7C3AED" />
    <SolidColorBrush x:Key="CEmailBrush"        Color="#FFD97706" />
    <SolidColorBrush x:Key="CInitBrush"         Color="#FF059669" />
    <SolidColorBrush x:Key="CRefBrush"          Color="#FF6B7280" />

    <!-- Group accent colors -->
    <SolidColorBrush x:Key="CSeqBrush"          Color="#FF2563EB" />
    <SolidColorBrush x:Key="CParBrush"          Color="#FF7C3AED" />
    <SolidColorBrush x:Key="CEventBrush"        Color="#FFD97706" />

    <!-- Pill backgrounds (semi-transparent) -->
    <SolidColorBrush x:Key="PillSeqBg"          Color="#1A2563EB" />
    <SolidColorBrush x:Key="PillParBg"          Color="#1A7C3AED" />
    <SolidColorBrush x:Key="PillEvtBg"          Color="#1AD97706" />
    <SolidColorBrush x:Key="PillRunBg"          Color="#1A2563EB" />
    <SolidColorBrush x:Key="PillRmtBg"          Color="#1A7C3AED" />
    <SolidColorBrush x:Key="PillEmlBg"          Color="#1AD97706" />
    <SolidColorBrush x:Key="PillInitBg"         Color="#1A059669" />
    <SolidColorBrush x:Key="PillRefBg"          Color="#1A6B7280" />

    <!-- Status dot fills -->
    <SolidColorBrush x:Key="SReadyBrush"        Color="#FF16A34A" />
    <SolidColorBrush x:Key="SRunningBrush"      Color="#FFD97706" />
    <SolidColorBrush x:Key="SPassedBrush"       Color="#FF16A34A" />
    <SolidColorBrush x:Key="SFailedBrush"       Color="#FFDC2626" />
    <SolidColorBrush x:Key="SIdleBrush"         Color="#FFD1D5DB" />

    <!-- File pill background -->
    <SolidColorBrush x:Key="FilePillBgBrush"    Color="#08000000" />

    <!-- Count badge -->
    <SolidColorBrush x:Key="CountBgBrush"       Color="#08000000" />
    <SolidColorBrush x:Key="CountRunningBg"     Color="#1AD97706" />
    <SolidColorBrush x:Key="CountFailedBg"      Color="#1ADC2626" />

    <!-- High-Contrast glyph (invisible in Dark/Light, visible in HC) -->
    <SolidColorBrush x:Key="HcGlyphFg"          Color="#00000000" />

    <!-- Dashboard legacy tokens (theme-aware) -->
    <SolidColorBrush x:Key="StatusRunningBg" Color="#1A2563EB" />
    <SolidColorBrush x:Key="StatusRunningFg" Color="#FF2563EB" />
    <SolidColorBrush x:Key="StatusSuccessBg" Color="#1A16A34A" />
    <SolidColorBrush x:Key="StatusSuccessFg" Color="#FF16A34A" />
    <SolidColorBrush x:Key="StatusFailedBg"  Color="#1ADC2626" />
    <SolidColorBrush x:Key="StatusFailedFg"  Color="#FFDC2626" />
    <SolidColorBrush x:Key="StatusWarningBg" Color="#1AD97706" />
    <SolidColorBrush x:Key="StatusWarningFg" Color="#FFD97706" />
    <SolidColorBrush x:Key="StatusIdleBg"    Color="#FFF3F4F6" />
    <SolidColorBrush x:Key="StatusIdleFg"    Color="#FF9CA3AF" />
    <SolidColorBrush x:Key="DashboardBg"     Color="#FFF8FAFC" />
    <SolidColorBrush x:Key="CardBg"          Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="CardBorder"      Color="#FFE5E7EB" />
    <SolidColorBrush x:Key="AgentColumnBg"   Color="#FFF1F5F9" />
    <SolidColorBrush x:Key="RowBorder"       Color="#FFE5E7EB" />
    <SolidColorBrush x:Key="TextPrimary"     Color="#FF1F2937" />
    <SolidColorBrush x:Key="TextSecondary"   Color="#FF6B7280" />
    <SolidColorBrush x:Key="TextDim"         Color="#FF9CA3AF" />
    <SolidColorBrush x:Key="MonoFont"        Color="#FF0891B2" />

</ResourceDictionary>
