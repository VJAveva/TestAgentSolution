<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- Window -->
    <SolidColorBrush x:Key="WindowBg"    Color="#FF000000" />
    <SolidColorBrush x:Key="RibbonBg"    Color="#FF000000" />
    <SolidColorBrush x:Key="RibbonTabBg" Color="#FF1A1A1A" />

    <!-- Surfaces -->
    <SolidColorBrush x:Key="BgPanel"   Color="#FF000000" />
    <SolidColorBrush x:Key="BgCard"    Color="#FF1A1A1A" />
    <SolidColorBrush x:Key="BgSurface" Color="#FF333333" />

    <!-- Accents -->
    <SolidColorBrush x:Key="Accent"    Color="#FF00FFFF" />
    <SolidColorBrush x:Key="AccGreen"  Color="#FF00FF00" />
    <SolidColorBrush x:Key="AccPeach"  Color="#FFFFAA00" />
    <SolidColorBrush x:Key="AccRed"    Color="#FFFF0000" />
    <SolidColorBrush x:Key="AccMauve"  Color="#FFFF00FF" />
    <SolidColorBrush x:Key="AccYellow" Color="#FFFFFF00" />

    <!-- Text -->
    <SolidColorBrush x:Key="TextP"     Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="TextS"     Color="#FFCCCCCC" />
    <SolidColorBrush x:Key="Bdr"       Color="#FFFFFFFF" />

    <!-- Controls -->
    <SolidColorBrush x:Key="BtnBg"          Color="#FF1A1A1A" />
    <SolidColorBrush x:Key="BtnBorder"      Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="BtnHoverBg"     Color="#FF333333" />
    <SolidColorBrush x:Key="BtnPressedBg"   Color="#FF005555" />
    <SolidColorBrush x:Key="FieldBg"        Color="#FF1A1A1A" />
    <SolidColorBrush x:Key="TabSelectedBg"  Color="#FF333333" />
    <SolidColorBrush x:Key="TabHoverBg"     Color="#FF222222" />
    <SolidColorBrush x:Key="GroupBg"        Color="#FF1A1A1A" />
    <SolidColorBrush x:Key="SelectedItemBg" Color="#FF005555" />
    <SolidColorBrush x:Key="HoverItemBg"    Color="#FF003333" />
    <SolidColorBrush x:Key="TreeBadgeFg"    Color="#FF000000" />

    <!-- Accent button backgrounds -->
    <SolidColorBrush x:Key="AccentBtnBg"    Color="#FF003333" />
    <SolidColorBrush x:Key="GreenBtnBg"     Color="#FF003300" />
    <SolidColorBrush x:Key="BlueBtnBg"      Color="#FF003333" />
    <SolidColorBrush x:Key="AccBlue"        Color="#FF00FFFF" />
    <SolidColorBrush x:Key="DangerBtnBg"    Color="#FF330000" />
    <SolidColorBrush x:Key="MauveBtnBg"     Color="#FF330033" />
    <SolidColorBrush x:Key="YellowBtnBg"    Color="#FF333300" />
    <SolidColorBrush x:Key="DangerBtnBgAlt" Color="#FF440000" />

    <!-- Badge overlays -->
    <SolidColorBrush x:Key="RunningBadgeBg" Color="#FF003333" />
    <SolidColorBrush x:Key="SuccessBadgeBg" Color="#FF003300" />
    <SolidColorBrush x:Key="FailedBadgeBg"  Color="#FF330000" />
    <SolidColorBrush x:Key="InfoBoxBg"      Color="#FF1A1A1A" />
    <SolidColorBrush x:Key="WatchRootBg"    Color="#FF003300" />
    <SolidColorBrush x:Key="TemplateRootBg" Color="#FF330033" />

    <!-- Status indicator dot colors -->
    <SolidColorBrush x:Key="StatusGreen"   Color="#FF00FF00" />
    <SolidColorBrush x:Key="StatusRed"     Color="#FFFF0000" />
    <SolidColorBrush x:Key="StatusYellow"  Color="#FFFFFF00" />
    <SolidColorBrush x:Key="StatusGray"    Color="#FF666666" />
    <SolidColorBrush x:Key="StatusBlue"    Color="#FF00FFFF" />

    <!-- Node icon backgrounds by kind -->
    <SolidColorBrush x:Key="IconBgFolder"    Color="#FF003333" />
    <SolidColorBrush x:Key="IconBgWatch"     Color="#FF003300" />
    <SolidColorBrush x:Key="IconBgEvent"     Color="#FF333300" />
    <SolidColorBrush x:Key="IconBgTemplate"  Color="#FF330033" />
    <SolidColorBrush x:Key="IconBgGroup"     Color="#FF003333" />
    <SolidColorBrush x:Key="IconBgAction"    Color="#FF332200" />
    <SolidColorBrush x:Key="IconBgInit"      Color="#FF222222" />
    <SolidColorBrush x:Key="IconBgRef"       Color="#FF330033" />

    <!-- Expander section header -->
    <SolidColorBrush x:Key="ExpanderHeaderBg" Color="#FF1A1A1A" />
    <SolidColorBrush x:Key="ExpanderHeaderFg" Color="#FFCCCCCC" />

    <!-- Alert/error highlight -->
    <SolidColorBrush x:Key="AlertErrorBg"   Color="#FF330000" />
    <SolidColorBrush x:Key="AlertErrorBdr"  Color="#FFFF0000" />

    <!-- Placeholder text -->
    <SolidColorBrush x:Key="PlaceholderFg"  Color="#FF666666" />

    <!-- Icon foreground (for Segoe MDL2 Assets) -->
    <SolidColorBrush x:Key="IconFg"         Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="DisabledFg"     Color="#FF666666" />

    <!-- Execution overlay -->
    <SolidColorBrush x:Key="OverlayBg"      Color="#CC000000" />

    <!-- Watermark -->
    <sys:Double x:Key="WatermarkOpacity">0.12</sys:Double>

    <!-- Agent latency indicator -->
    <SolidColorBrush x:Key="LatencyGood"    Color="#FF00FF00" />
    <SolidColorBrush x:Key="LatencyWarn"    Color="#FFFFFF00" />
    <SolidColorBrush x:Key="LatencyBad"     Color="#FFFF0000" />

    <!-- Panel focus indicator -->
    <SolidColorBrush x:Key="FocusRing"      Color="#FF00FFFF" />

    <!-- Scrollbar track -->
    <SolidColorBrush x:Key="ScrollbarTrack" Color="#FF222222" />
    <SolidColorBrush x:Key="ScrollbarThumb" Color="#FF666666" />

    <!-- Badge pill backgrounds -->
    <SolidColorBrush x:Key="CancelledBadgeBg" Color="#FF333333" />
    <SolidColorBrush x:Key="PartialBadgeBg"   Color="#FF332200" />

</ResourceDictionary>
