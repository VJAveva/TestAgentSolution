<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- Window -->
    <SolidColorBrush x:Key="WindowBg"    Color="#FF000000" />
    <SolidColorBrush x:Key="RibbonBg"    Color="#FF000000" />
    <SolidColorBrush x:Key="RibbonTabBg" Color="#FF1A1A1A" />

    <!-- Surfaces -->
    <SolidColorBrush x:Key="BgPanel"   Color="#FF000000" />
    <SolidColorBrush x:Key="BgCard"    Color="#FF1A1A1A" />
    <SolidColorBrush x:Key="BgSurface" Color="#FF333333" />

    <!-- Accents -->
    <SolidColorBrush x:Key="Accent"    Color="#FF00FFFF" />
    <SolidColorBrush x:Key="AccGreen"  Color="#FF00FF00" />
    <SolidColorBrush x:Key="AccPeach"  Color="#FFFFAA00" />
    <SolidColorBrush x:Key="AccRed"    Color="#FFFF0000" />
    <SolidColorBrush x:Key="AccMauve"  Color="#FFFF00FF" />
    <SolidColorBrush x:Key="AccYellow" Color="#FFFFFF00" />

    <!-- Text -->
    <SolidColorBrush x:Key="TextP"     Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="TextS"     Color="#FFCCCCCC" />
    <SolidColorBrush x:Key="Bdr"       Color="#FFFFFFFF" />

    <!-- Controls -->
    <SolidColorBrush x:Key="BtnBg"          Color="#FF1A1A1A" />
    <SolidColorBrush x:Key="BtnBorder"      Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="BtnHoverBg"     Color="#FF333333" />
    <SolidColorBrush x:Key="BtnPressedBg"   Color="#FF005555" />
    <SolidColorBrush x:Key="FieldBg"        Color="#FF1A1A1A" />
    <SolidColorBrush x:Key="TabSelectedBg"  Color="#FF333333" />
    <SolidColorBrush x:Key="TabHoverBg"     Color="#FF222222" />
    <SolidColorBrush x:Key="GroupBg"        Color="#FF1A1A1A" />
    <SolidColorBrush x:Key="SelectedItemBg" Color="#FF005555" />
    <SolidColorBrush x:Key="HoverItemBg"    Color="#FF003333" />
    <SolidColorBrush x:Key="TreeBadgeFg"    Color="#FF000000" />

    <!-- Accent button backgrounds -->
    <SolidColorBrush x:Key="AccentBtnBg"    Color="#FF003333" />
    <SolidColorBrush x:Key="GreenBtnBg"     Color="#FF003300" />
    <SolidColorBrush x:Key="BlueBtnBg"      Color="#FF003333" />
    <SolidColorBrush x:Key="AccBlue"        Color="#FF00FFFF" />
    <SolidColorBrush x:Key="DangerBtnBg"    Color="#FF330000" />
    <SolidColorBrush x:Key="MauveBtnBg"     Color="#FF330033" />
    <SolidColorBrush x:Key="YellowBtnBg"    Color="#FF333300" />
    <SolidColorBrush x:Key="DangerBtnBgAlt" Color="#FF440000" />

    <!-- Badge overlays -->
    <SolidColorBrush x:Key="RunningBadgeBg" Color="#FF003333" />
    <SolidColorBrush x:Key="SuccessBadgeBg" Color="#FF003300" />
    <SolidColorBrush x:Key="FailedBadgeBg"  Color="#FF330000" />
    <SolidColorBrush x:Key="InfoBoxBg"      Color="#FF1A1A1A" />
    <SolidColorBrush x:Key="WatchRootBg"    Color="#FF003300" />
    <SolidColorBrush x:Key="TemplateRootBg" Color="#FF330033" />

    <!-- Status indicator dot colors -->
    <SolidColorBrush x:Key="StatusGreen"   Color="#FF00FF00" />
    <SolidColorBrush x:Key="StatusRed"     Color="#FFFF0000" />
    <SolidColorBrush x:Key="StatusYellow"  Color="#FFFFFF00" />
    <SolidColorBrush x:Key="StatusGray"    Color="#FF666666" />
    <SolidColorBrush x:Key="StatusBlue"    Color="#FF00FFFF" />

    <!-- Node icon backgrounds by kind -->
    <SolidColorBrush x:Key="IconBgFolder"    Color="#FF003333" />
    <SolidColorBrush x:Key="IconBgWatch"     Color="#FF003300" />
    <SolidColorBrush x:Key="IconBgEvent"     Color="#FF333300" />
    <SolidColorBrush x:Key="IconBgTemplate"  Color="#FF330033" />
    <SolidColorBrush x:Key="IconBgGroup"     Color="#FF003333" />
    <SolidColorBrush x:Key="IconBgAction"    Color="#FF332200" />
    <SolidColorBrush x:Key="IconBgInit"      Color="#FF222222" />
    <SolidColorBrush x:Key="IconBgRef"       Color="#FF330033" />

    <!-- Expander section header -->
    <SolidColorBrush x:Key="ExpanderHeaderBg" Color="#FF1A1A1A" />
    <SolidColorBrush x:Key="ExpanderHeaderFg" Color="#FFCCCCCC" />

    <!-- Alert/error highlight -->
    <SolidColorBrush x:Key="AlertErrorBg"   Color="#FF330000" />
    <SolidColorBrush x:Key="AlertErrorBdr"  Color="#FFFF0000" />

    <!-- Placeholder text -->
    <SolidColorBrush x:Key="PlaceholderFg"  Color="#FF666666" />

    <!-- Icon foreground (for Segoe MDL2 Assets) -->
    <SolidColorBrush x:Key="IconFg"         Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="DisabledFg"     Color="#FF666666" />

    <!-- Execution overlay -->
    <SolidColorBrush x:Key="OverlayBg"      Color="#CC000000" />

    <!-- Watermark -->
    <sys:Double x:Key="WatermarkOpacity">0.12</sys:Double>

    <!-- Agent latency indicator -->
    <SolidColorBrush x:Key="LatencyGood"    Color="#FF00FF00" />
    <SolidColorBrush x:Key="LatencyWarn"    Color="#FFFFFF00" />
    <SolidColorBrush x:Key="LatencyBad"     Color="#FFFF0000" />

    <!-- Panel focus indicator -->
    <SolidColorBrush x:Key="FocusRing"      Color="#FF00FFFF" />

    <!-- Scrollbar track -->
    <SolidColorBrush x:Key="ScrollbarTrack"      Color="#FF222222" />
    <SolidColorBrush x:Key="ScrollbarThumb"      Color="#FF666666" />
    <SolidColorBrush x:Key="ScrollbarThumbHover" Color="#FF999999" />
    <SolidColorBrush x:Key="ScrollbarThumbDrag"  Color="#FFBBBBBB" />

    <!-- Badge pill backgrounds -->
    <SolidColorBrush x:Key="CancelledBadgeBg" Color="#FF333333" />
    <SolidColorBrush x:Key="PartialBadgeBg"   Color="#FF332200" />

    <!-- ═══ TreeView Spec — High-contrast design tokens ═══ -->

    <!-- Surfaces -->
    <SolidColorBrush x:Key="BgWindowBrush"      Color="#FF000000" />
    <SolidColorBrush x:Key="BgPanelBrush"       Color="#FF000000" />
    <SolidColorBrush x:Key="BgHeaderBrush"      Color="#FF1A1A1A" />
    <SolidColorBrush x:Key="BgRowHoverBrush"    Color="#33FFFFFF" />
    <SolidColorBrush x:Key="BgRowSelectedBrush" Color="#FF005555" />

    <!-- Borders & rails -->
    <SolidColorBrush x:Key="BorderSoftBrush"    Color="#55FFFFFF" />
    <SolidColorBrush x:Key="BorderMediumBrush"  Color="#AAFFFFFF" />
    <SolidColorBrush x:Key="RailIdleBrush"      Color="#55FFFFFF" />
    <SolidColorBrush x:Key="RailActiveBrush"    Color="#FF00FFFF" />

    <!-- Text -->
    <SolidColorBrush x:Key="TextStrongBrush"    Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="TextDefaultBrush"   Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="TextMutedBrush"     Color="#FFCCCCCC" />
    <SolidColorBrush x:Key="TextDimBrush"       Color="#FF999999" />

    <!-- Action-type accent colors (bright, WCAG AAA on black) -->
    <SolidColorBrush x:Key="CRunBrush"          Color="#FF00FFFF" />
    <SolidColorBrush x:Key="CRemoteBrush"       Color="#FFFF00FF" />
    <SolidColorBrush x:Key="CEmailBrush"        Color="#FFFFFF00" />
    <SolidColorBrush x:Key="CInitBrush"         Color="#FF00FF00" />
    <SolidColorBrush x:Key="CRefBrush"          Color="#FFFFFFFF" />

    <!-- Group accent colors -->
    <SolidColorBrush x:Key="CSeqBrush"          Color="#FF00FFFF" />
    <SolidColorBrush x:Key="CParBrush"          Color="#FFFF00FF" />
    <SolidColorBrush x:Key="CEventBrush"        Color="#FFFFFF00" />

    <!-- Pill backgrounds (high-contrast solid) -->
    <SolidColorBrush x:Key="PillSeqBg"          Color="#FF003333" />
    <SolidColorBrush x:Key="PillParBg"          Color="#FF330033" />
    <SolidColorBrush x:Key="PillEvtBg"          Color="#FF333300" />
    <SolidColorBrush x:Key="PillRunBg"          Color="#FF003333" />
    <SolidColorBrush x:Key="PillRmtBg"          Color="#FF330033" />
    <SolidColorBrush x:Key="PillEmlBg"          Color="#FF333300" />
    <SolidColorBrush x:Key="PillInitBg"         Color="#FF003300" />
    <SolidColorBrush x:Key="PillRefBg"          Color="#FF222222" />

    <!-- Status dot fills -->
    <SolidColorBrush x:Key="SReadyBrush"        Color="#FF00FF00" />
    <SolidColorBrush x:Key="SRunningBrush"      Color="#FFFFFF00" />
    <SolidColorBrush x:Key="SPassedBrush"       Color="#FF00FF00" />
    <SolidColorBrush x:Key="SFailedBrush"       Color="#FFFF0000" />
    <SolidColorBrush x:Key="SIdleBrush"         Color="#FF666666" />

    <!-- File pill background -->
    <SolidColorBrush x:Key="FilePillBgBrush"    Color="#FF1A1A1A" />

    <!-- Count badge -->
    <SolidColorBrush x:Key="CountBgBrush"       Color="#FF1A1A1A" />
    <SolidColorBrush x:Key="CountRunningBg"     Color="#FF333300" />
    <SolidColorBrush x:Key="CountFailedBg"      Color="#FF330000" />

    <!-- High-Contrast glyph (visible only in HC mode) -->
    <SolidColorBrush x:Key="HcGlyphFg"          Color="#FFFFFFFF" />

    <!-- Dashboard legacy tokens (HC-aware) -->
    <SolidColorBrush x:Key="StatusRunningBg" Color="#FF333300" />
    <SolidColorBrush x:Key="StatusRunningFg" Color="#FFFFFF00" />
    <SolidColorBrush x:Key="StatusSuccessBg" Color="#FF003300" />
    <SolidColorBrush x:Key="StatusSuccessFg" Color="#FF00FF00" />
    <SolidColorBrush x:Key="StatusFailedBg"  Color="#FF330000" />
    <SolidColorBrush x:Key="StatusFailedFg"  Color="#FFFF0000" />
    <SolidColorBrush x:Key="StatusWarningBg" Color="#FF333300" />
    <SolidColorBrush x:Key="StatusWarningFg" Color="#FFFFFF00" />
    <SolidColorBrush x:Key="StatusIdleBg"    Color="#FF1A1A1A" />
    <SolidColorBrush x:Key="StatusIdleFg"    Color="#FF666666" />
    <SolidColorBrush x:Key="DashboardBg"     Color="#FF000000" />
    <SolidColorBrush x:Key="CardBg"          Color="#FF1A1A1A" />
    <SolidColorBrush x:Key="CardBorder"      Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="AgentColumnBg"   Color="#FF000000" />
    <SolidColorBrush x:Key="RowBorder"       Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="TextPrimary"     Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="TextSecondary"   Color="#FFCCCCCC" />
    <SolidColorBrush x:Key="TextDim"         Color="#FF999999" />
    <SolidColorBrush x:Key="MonoFont"        Color="#FF00FFFF" />

</ResourceDictionary>
