<Window x:Class="TestAgent.Diagnostics.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:TestAgent.Diagnostics.Views"
        Title="TestAgent Diagnostics — Failure Tracer + Log Explorer"
        Height="760" Width="1180"
        Background="{DynamicResource WindowBg}"
        TextElement.Foreground="{DynamicResource TextP}"
        FontFamily="Segoe UI" FontSize="13">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Grid.Row="0" Background="{DynamicResource BgPanel}"
                BorderBrush="{DynamicResource Bdr}" BorderThickness="0,0,0,1" Padding="10,8">
            <DockPanel LastChildFill="False">
                <Button DockPanel.Dock="Left" Content="Open Logs…" Padding="12,6" Margin="0,0,8,0"
                        Command="{Binding OpenFilesCommand}" />
                <Button DockPanel.Dock="Left" Content="Reload" Padding="12,6" Margin="0,0,16,0"
                        Command="{Binding ReloadCommand}" />

                <!-- Live controls -->
                <Button DockPanel.Dock="Left" Content="▶ Go Live" Padding="12,6" Margin="0,0,6,0"
                        Command="{Binding GoLiveCommand}"
                        Visibility="{Binding IsLiveActive, Converter={StaticResource InvBoolToVis}}" />
                <Button DockPanel.Dock="Left" Content="■ Stop" Padding="12,6" Margin="0,0,8,0"
                        Command="{Binding StopLiveCommand}"
                        Visibility="{Binding IsLiveActive, Converter={StaticResource BoolToVis}}" />
                <TextBlock DockPanel.Dock="Left" Text="● LIVE" FontWeight="Bold" VerticalAlignment="Center"
                           Margin="0,0,16,0" Foreground="{DynamicResource AccGreen}"
                           Visibility="{Binding IsLiveActive, Converter={StaticResource BoolToVis}}" />

                <!-- View toggle -->
                <Border DockPanel.Dock="Left" CornerRadius="4" Padding="2"
                        Background="{DynamicResource BgCard}" Margin="0,0,16,0">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Content="Failures" GroupName="View" Padding="12,5"
                                     IsChecked="{Binding IsFailures, Mode=OneWay}"
                                     Command="{Binding ShowFailuresCommand}" />
                        <RadioButton Content="Logs" GroupName="View" Padding="12,5"
                                     IsChecked="{Binding IsLogs, Mode=OneWay}"
                                     Command="{Binding ShowLogsCommand}" />
                        <RadioButton Content="Live" GroupName="View" Padding="12,5"
                                     IsChecked="{Binding IsLive, Mode=OneWay}"
                                     Command="{Binding ShowLiveCommand}" />
                    </StackPanel>
                </Border>

                <TextBlock DockPanel.Dock="Right" Text="{Binding SelectedTheme}" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextS}" Margin="8,0,0,0" />
                <ComboBox DockPanel.Dock="Right" Width="130" VerticalAlignment="Center"
                          ItemsSource="{Binding Themes}" SelectedItem="{Binding SelectedTheme}" />
                <TextBlock DockPanel.Dock="Right" Text="Theme:" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextS}" Margin="0,0,6,0" />
            </DockPanel>
        </Border>

        <!-- Content: two views over one record set -->
        <Grid Grid.Row="1">
            <views:FailuresView DataContext="{Binding Failures}"
                                Visibility="{Binding DataContext.IsFailures,
                                    RelativeSource={RelativeSource AncestorType=Window},
                                    Converter={StaticResource BoolToVis}}" />
            <views:LogsView DataContext="{Binding Logs}"
                            Visibility="{Binding DataContext.IsLogs,
                                RelativeSource={RelativeSource AncestorType=Window},
                                Converter={StaticResource BoolToVis}}" />

            <views:LiveStatusView DataContext="{Binding Live}"
                            Visibility="{Binding DataContext.IsLive,
                                RelativeSource={RelativeSource AncestorType=Window},
                                Converter={StaticResource BoolToVis}}" />

            <!-- Empty state -->
            <TextBlock Text="Open one or more log files to find and trace failures."
                       Foreground="{DynamicResource TextS}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="15"
                       Visibility="{Binding HasData, Converter={StaticResource InvBoolToVis}}" />
        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="2" Background="{DynamicResource BgPanel}"
                BorderBrush="{DynamicResource Bdr}" BorderThickness="0,1,0,0" Padding="10,5">
            <TextBlock Text="{Binding Status}" Foreground="{DynamicResource TextS}" />
        </Border>
    </Grid>
</Window>
