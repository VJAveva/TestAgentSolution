<UserControl x:Class="TestAgent.Diagnostics.Views.LiveStatusView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:TestAgent.Diagnostics.ViewModels"
             FontFamily="Segoe UI" FontSize="13">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header + state summary -->
        <DockPanel Grid.Row="0" Margin="0,0,0,8" LastChildFill="False">
            <TextBlock DockPanel.Dock="Left" Text="Live pipeline states" FontSize="15" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextP}" VerticalAlignment="Center" />

            <Border DockPanel.Dock="Right" CornerRadius="4" Padding="10,4" Margin="6,0,0,0"
                    Background="{DynamicResource BgCard}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="✓" Foreground="{DynamicResource AccGreen}" FontWeight="Bold" Margin="0,0,4,0" />
                    <TextBlock Text="Completed" Foreground="{DynamicResource TextS}" Margin="0,0,4,0" />
                    <TextBlock Text="{Binding CompletedCount}" Foreground="{DynamicResource TextP}" FontWeight="SemiBold" />
                </StackPanel>
            </Border>
            <Border DockPanel.Dock="Right" CornerRadius="4" Padding="10,4" Margin="6,0,0,0"
                    Background="{DynamicResource BgCard}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="✗" Foreground="{DynamicResource AccRed}" FontWeight="Bold" Margin="0,0,4,0" />
                    <TextBlock Text="Failed" Foreground="{DynamicResource TextS}" Margin="0,0,4,0" />
                    <TextBlock Text="{Binding FailedCount}" Foreground="{DynamicResource TextP}" FontWeight="SemiBold" />
                </StackPanel>
            </Border>
            <Border DockPanel.Dock="Right" CornerRadius="4" Padding="10,4" Margin="6,0,0,0"
                    Background="{DynamicResource BgCard}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="●" Foreground="{DynamicResource Accent}" FontWeight="Bold" Margin="0,0,4,0" />
                    <TextBlock Text="Running" Foreground="{DynamicResource TextS}" Margin="0,0,4,0" />
                    <TextBlock Text="{Binding RunningCount}" Foreground="{DynamicResource TextP}" FontWeight="SemiBold" />
                </StackPanel>
            </Border>
        </DockPanel>

        <TextBlock Grid.Row="1" Margin="0,0,0,8" TextWrapping="Wrap"
                   Foreground="{DynamicResource TextS}"
                   Text="One row per pipeline run (by RunId). Rows update live as the agents emit events; most-recently-active first. Double-click a run to open its full log trace." />

        <!-- Run table -->
        <ListView Grid.Row="2" ItemsSource="{Binding Runs}" SelectedItem="{Binding SelectedRun}"
                  Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Bdr}"
                  Foreground="{DynamicResource TextP}"
                  ScrollViewer.IsDeferredScrollingEnabled="True"
                  VirtualizingStackPanel.IsVirtualizing="True"
                  VirtualizingStackPanel.VirtualizationMode="Recycling">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <EventSetter Event="MouseDoubleClick" Handler="OnRunDoubleClick" />
                    <Setter Property="Foreground" Value="{DynamicResource TextP}" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="State" Width="110">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type vm:RunStatusVM}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Glyph}" FontWeight="Bold" Width="18">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource Accent}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding State}" Value="Failed">
                                                        <Setter Property="Foreground" Value="{DynamicResource AccRed}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding State}" Value="Completed">
                                                        <Setter Property="Foreground" Value="{DynamicResource AccGreen}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding StateText}" VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Pipeline" Width="170" DisplayMemberBinding="{Binding Pipeline}" />
                    <GridViewColumn Header="Agent" Width="120" DisplayMemberBinding="{Binding Agent}" />
                    <GridViewColumn Header="Last action" Width="130" DisplayMemberBinding="{Binding LastAction}" />
                    <GridViewColumn Header="Run" Width="90" DisplayMemberBinding="{Binding RunIdShort}" />
                    <GridViewColumn Header="Errors" Width="60" DisplayMemberBinding="{Binding ErrorCount}" />
                    <GridViewColumn Header="Started" Width="80" DisplayMemberBinding="{Binding StartedText}" />
                    <GridViewColumn Header="Updated" Width="80" DisplayMemberBinding="{Binding LastUpdateText}" />
                </GridView>
            </ListView.View>
        </ListView>
    </Grid>
</UserControl>
