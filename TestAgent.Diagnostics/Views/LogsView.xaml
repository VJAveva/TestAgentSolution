<UserControl x:Class="TestAgent.Diagnostics.Views.LogsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:TestAgent.Diagnostics.Models"
             FontFamily="Segoe UI" FontSize="13">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Filter bar -->
        <WrapPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Component" VerticalAlignment="Center" Foreground="{DynamicResource TextS}" Margin="0,0,4,0" />
            <ComboBox Width="110" ItemsSource="{Binding Components}" SelectedItem="{Binding ComponentFilter}" Margin="0,0,12,0" />
            <TextBlock Text="Agent" VerticalAlignment="Center" Foreground="{DynamicResource TextS}" Margin="0,0,4,0" />
            <ComboBox Width="110" ItemsSource="{Binding Agents}" SelectedItem="{Binding AgentFilter}" Margin="0,0,12,0" />
            <TextBlock Text="Severity" VerticalAlignment="Center" Foreground="{DynamicResource TextS}" Margin="0,0,4,0" />
            <ComboBox Width="90" ItemsSource="{Binding Severities}" SelectedItem="{Binding SeverityFilter}" Margin="0,0,12,0" />
            <TextBlock Text="RunId" VerticalAlignment="Center" Foreground="{DynamicResource TextS}" Margin="0,0,4,0" />
            <TextBox Width="110" Text="{Binding RunIdFilter, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,12,0" />
            <TextBlock Text="Find" VerticalAlignment="Center" Foreground="{DynamicResource TextS}" Margin="0,0,4,0" />
            <TextBox Width="180" Text="{Binding TextFilter, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,12,0" />
            <Button Content="Export" Padding="12,5" Margin="0,0,8,0" Command="{Binding ExportCommand}" />
        </WrapPanel>

        <!-- "Filtered by" chip + back-to-failure -->
        <Border Grid.Row="1" Margin="0,0,0,8" Padding="8,4" CornerRadius="4"
                Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Accent}" BorderThickness="1"
                HorizontalAlignment="Left"
                Visibility="{Binding HasContext, Converter={StaticResource BoolToVis}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Filtered by:" Foreground="{DynamicResource TextS}" VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBlock Text="{Binding ContextChip}" Foreground="{DynamicResource Accent}" FontWeight="SemiBold" VerticalAlignment="Center" />
                <Button Content="Clear filter" Margin="12,0,0,0" Padding="8,2" Command="{Binding ClearFilterCommand}" />
                <Button Content="← Back to failure" Margin="6,0,0,0" Padding="8,2"
                        Command="{Binding DataContext.BackToFailureCommand,
                            RelativeSource={RelativeSource AncestorType=Window}}" />
            </StackPanel>
        </Border>

        <!-- Grid + details -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.2*" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="1*" MinWidth="260" />
            </Grid.ColumnDefinitions>

            <ListView Grid.Column="0" ItemsSource="{Binding Records}" SelectedItem="{Binding SelectedRecord}"
                      Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Bdr}"
                      Foreground="{DynamicResource TextP}"
                      ScrollViewer.IsDeferredScrollingEnabled="True"
                      VirtualizingStackPanel.IsVirtualizing="True"
                      VirtualizingStackPanel.VirtualizationMode="Recycling"
                      ScrollViewer.CanContentScroll="True">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Foreground" Value="{DynamicResource TextP}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Severity}" Value="{x:Static models:Severity.Error}">
                                <Setter Property="Foreground" Value="{DynamicResource AccRed}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Severity}" Value="{x:Static models:Severity.Warning}">
                                <Setter Property="Foreground" Value="{DynamicResource AccYellow}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Severity}" Value="{x:Static models:Severity.Debug}">
                                <Setter Property="Foreground" Value="{DynamicResource TextS}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Time" Width="160" DisplayMemberBinding="{Binding TimeText}" />
                        <GridViewColumn Header="Severity" Width="70" DisplayMemberBinding="{Binding SeverityText}" />
                        <GridViewColumn Header="Component" Width="90" DisplayMemberBinding="{Binding Component}" />
                        <GridViewColumn Header="Agent" Width="90" DisplayMemberBinding="{Binding Agent}" />
                        <GridViewColumn Header="Message" Width="520" DisplayMemberBinding="{Binding Message}" />
                    </GridView>
                </ListView.View>
            </ListView>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch"
                          Background="{DynamicResource Bdr}" />

            <!-- Details / stack-trace pane -->
            <Border Grid.Column="2" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Bdr}"
                    BorderThickness="1" CornerRadius="4" Padding="10">
                <Grid>
                    <TextBlock Text="Select a row to see full detail."
                               Foreground="{DynamicResource TextS}" TextWrapping="Wrap"
                               Visibility="{Binding SelectedRecord, Converter={StaticResource NullToVis},
                                   ConverterParameter=invert}" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding SelectedRecord, Converter={StaticResource NullToVis}}">
                        <StackPanel>
                            <TextBlock Text="{Binding SelectedRecord.TimeText}" Foreground="{DynamicResource TextS}" />
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                <TextBlock Text="{Binding SelectedRecord.SeverityText}" FontWeight="SemiBold" Margin="0,0,10,0"
                                           Foreground="{DynamicResource TextP}" />
                                <TextBlock Text="{Binding SelectedRecord.Component}" Foreground="{DynamicResource Accent}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                <TextBlock Text="Run:" Foreground="{DynamicResource TextS}" Margin="0,0,4,0" />
                                <TextBlock Text="{Binding SelectedRecord.RunId}" Foreground="{DynamicResource TextP}" Margin="0,0,12,0" />
                                <TextBlock Text="Agent:" Foreground="{DynamicResource TextS}" Margin="0,0,4,0" />
                                <TextBlock Text="{Binding SelectedRecord.Agent}" Foreground="{DynamicResource TextP}" />
                            </StackPanel>
                            <TextBlock Text="{Binding SelectedRecord.Pipeline}" Foreground="{DynamicResource TextS}" Margin="0,2,0,0" />

                            <Separator Margin="0,8" />
                            <TextBlock Text="{Binding SelectedRecord.Message}" TextWrapping="Wrap"
                                       FontFamily="Consolas" Foreground="{DynamicResource TextP}" />

                            <TextBlock Text="Exception" FontWeight="SemiBold" Margin="0,10,0,2"
                                       Foreground="{DynamicResource AccRed}"
                                       Visibility="{Binding SelectedRecord.Exception, Converter={StaticResource NullToVis}}" />
                            <TextBlock Text="{Binding SelectedRecord.Exception}" TextWrapping="Wrap"
                                       FontFamily="Consolas" Foreground="{DynamicResource AccRed}"
                                       Visibility="{Binding SelectedRecord.Exception, Converter={StaticResource NullToVis}}" />

                            <TextBlock Text="Stack trace" FontWeight="SemiBold" Margin="0,10,0,2"
                                       Foreground="{DynamicResource TextS}"
                                       Visibility="{Binding SelectedRecord.StackTrace, Converter={StaticResource NullToVis}}" />
                            <TextBlock Text="{Binding SelectedRecord.StackTrace}" TextWrapping="Wrap"
                                       FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource TextS}"
                                       Visibility="{Binding SelectedRecord.StackTrace, Converter={StaticResource NullToVis}}" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
