<UserControl x:Class="TestAgent.Diagnostics.Views.FailuresView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:TestAgent.Diagnostics.ViewModels"
             FontFamily="Segoe UI" FontSize="13">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" MinWidth="320" />
            <ColumnDefinition Width="6" />
            <ColumnDefinition Width="1.4*" MinWidth="220" />
            <ColumnDefinition Width="6" />
            <ColumnDefinition Width="1.6*" MinWidth="260" />
        </Grid.ColumnDefinitions>

        <!-- ===== Level 1: Failing runs ===== -->
        <DockPanel Grid.Column="0">
            <TextBlock DockPanel.Dock="Top" Text="Failing runs" FontSize="15" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextP}" Margin="0,0,0,6" />
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8" LastChildFill="False">
                <TextBlock Text="Pipeline" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextS}" Margin="0,0,4,0" />
                <ComboBox Width="120" ItemsSource="{Binding Pipelines}"
                          SelectedItem="{Binding PipelineFilter}" Margin="0,0,12,0" />
                <TextBlock Text="Agent" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextS}" Margin="0,0,4,0" />
                <ComboBox Width="110" ItemsSource="{Binding Agents}"
                          SelectedItem="{Binding AgentFilter}" />
            </DockPanel>

            <ListView ItemsSource="{Binding Runs}" SelectedItem="{Binding SelectedRun}"
                      Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Bdr}"
                      Foreground="{DynamicResource TextP}"
                      ScrollViewer.IsDeferredScrollingEnabled="True"
                      VirtualizingStackPanel.IsVirtualizing="True"
                      VirtualizingStackPanel.VirtualizationMode="Recycling">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Pipeline" Width="150"
                                        DisplayMemberBinding="{Binding Pipeline}" />
                        <GridViewColumn Header="Failed at" Width="120"
                                        DisplayMemberBinding="{Binding FailedAction}" />
                        <GridViewColumn Header="Subsystem" Width="90"
                                        DisplayMemberBinding="{Binding Component}" />
                        <GridViewColumn Header="Agent" Width="90"
                                        DisplayMemberBinding="{Binding Agent}" />
                    </GridView>
                </ListView.View>
            </ListView>
        </DockPanel>

        <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch"
                      Background="{DynamicResource Bdr}" />

        <!-- ===== Level 2: Action sequence ===== -->
        <DockPanel Grid.Column="2">
            <TextBlock DockPanel.Dock="Top" Text="Action sequence" FontSize="15" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextP}" Margin="0,0,0,6" />
            <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Bdr}"
                    BorderThickness="1" CornerRadius="4">
                <Grid>
                    <TextBlock Text="Select a failing run to see its steps."
                               Foreground="{DynamicResource TextS}" Margin="12"
                               TextWrapping="Wrap"
                               Visibility="{Binding HasSelectedRun, Converter={StaticResource InvBoolToVis}}" />
                    <ListBox ItemsSource="{Binding SelectedRun.Steps}" SelectedItem="{Binding SelectedStep}"
                             Background="Transparent" BorderThickness="0"
                             Foreground="{DynamicResource TextP}"
                             Visibility="{Binding HasSelectedRun, Converter={StaticResource BoolToVis}}">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ActionStepVM}">
                                <StackPanel Orientation="Horizontal" Margin="2">
                                    <TextBlock Text="{Binding Glyph}" FontWeight="Bold" Width="20"
                                               VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource TextS}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="Passed">
                                                        <Setter Property="Foreground" Value="{DynamicResource AccGreen}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="Failed">
                                                        <Setter Property="Foreground" Value="{DynamicResource AccRed}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" Margin="4,0,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource TextP}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="Failed">
                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                        <Setter Property="Foreground" Value="{DynamicResource AccRed}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding TimeText}" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextS}" FontSize="11" Margin="8,0,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </DockPanel>

        <GridSplitter Grid.Column="3" Width="6" HorizontalAlignment="Stretch"
                      Background="{DynamicResource Bdr}" />

        <!-- ===== Level 3: Failed-action detail ===== -->
        <DockPanel Grid.Column="4">
            <TextBlock DockPanel.Dock="Top" Text="Failed-action detail" FontSize="15" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextP}" Margin="0,0,0,6" />
            <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Bdr}"
                    BorderThickness="1" CornerRadius="4" Padding="12">
                <Grid>
                    <TextBlock Text="Select a step to see the error."
                               Foreground="{DynamicResource TextS}" TextWrapping="Wrap"
                               Visibility="{Binding HasSelectedStep, Converter={StaticResource InvBoolToVis}}" />
                    <StackPanel Visibility="{Binding HasSelectedStep, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding SelectedStep.Name}" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccRed}" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock Text="Subsystem:" Foreground="{DynamicResource TextS}" Margin="0,0,4,0" />
                            <TextBlock Text="{Binding SelectedStep.Component}" Foreground="{DynamicResource TextP}" Margin="0,0,16,0" />
                            <TextBlock Text="Agent:" Foreground="{DynamicResource TextS}" Margin="0,0,4,0" />
                            <TextBlock Text="{Binding SelectedStep.Agent}" Foreground="{DynamicResource TextP}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <TextBlock Text="Time:" Foreground="{DynamicResource TextS}" Margin="0,0,4,0" />
                            <TextBlock Text="{Binding SelectedStep.TimeText}" Foreground="{DynamicResource TextP}" />
                        </StackPanel>

                        <Border Background="{DynamicResource BgPanel}" BorderBrush="{DynamicResource Bdr}"
                                BorderThickness="1" CornerRadius="3" Margin="0,10,0,0" Padding="8"
                                Visibility="{Binding SelectedStep.ErrorRecord, Converter={StaticResource NullToVis}}">
                            <StackPanel>
                                <TextBlock Text="{Binding SelectedStep.ErrorRecord.Message}"
                                           Foreground="{DynamicResource TextP}" TextWrapping="Wrap"
                                           FontFamily="Consolas" />
                                <TextBlock Text="{Binding SelectedStep.ErrorRecord.Exception}"
                                           Foreground="{DynamicResource AccRed}" TextWrapping="Wrap"
                                           FontFamily="Consolas" Margin="0,6,0,0"
                                           Visibility="{Binding SelectedStep.ErrorRecord.Exception, Converter={StaticResource NullToVis}}" />
                            </StackPanel>
                        </Border>

                        <Button Content="View logs →" HorizontalAlignment="Left" Margin="0,12,0,0"
                                Padding="14,7" Command="{Binding ViewLogsCommand}"
                                CommandParameter="{Binding SelectedStep}"
                                Background="{DynamicResource Accent}" Foreground="{DynamicResource WindowBg}"
                                FontWeight="SemiBold" />
                    </StackPanel>
                </Grid>
            </Border>
        </DockPanel>
    </Grid>
</UserControl>
