<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Standalone .NET 10 WPF monitoring tool. References TestControllerGrpc
         to reuse the dashboard window, VM, styles, and tray service so there
         is no duplicated UI code. The only thing this project owns is the
         composition root (App.OnStartup) which selects the SignalR transport
         and an adapter that pumps IExecutionFeed messages into the VM. -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>TestController.Dashboard</RootNamespace>
    <AssemblyName>TestController.Dashboard</AssemblyName>
    <ApplicationIcon>..\TestControllerGrpc\Assets\dashboard.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WindowsForms" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TestControllerGrpc\TestControllerGrpc.csproj" />
    <ProjectReference Include="..\TestControllerGrpc.Core\TestControllerGrpc.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.9" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.9" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
