# Development defaults. The browser uses same-origin relative URLs and the Vite
# dev server proxies /api + /hubs to VITE_DEV_PROXY_TARGET (see vite.config.ts).
# Override locally via `.env.local` (gitignored by convention) if you run the
# backend on a different host/port — e.g. the standalone WebApi.
VITE_API_BASE_URL=
VITE_DEV_PROXY_TARGET=http://127.0.0.1:5200
