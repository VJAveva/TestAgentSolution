<Application x:Class="TestAgentDisplay.App"
         xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:vm="clr-namespace:TestAgentDisplay.ViewModels"
         StartupUri="Views/MainWindow.xaml">
<Application.Resources>
    <vm:NonEmptyToVisibilityConverter x:Key="NonEmptyVis" />
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <Color x:Key="BgDark">#FF1A1A2E</Color>
        <Color x:Key="BgPanel">#FF16213E</Color>
        <Color x:Key="BgCard">#FF0F3460</Color>
        <Color x:Key="Accent">#FF00C9A7</Color>
        <Color x:Key="TextPrimary">#FFE0E0E0</Color>
        <Color x:Key="TextSecondary">#FF90A4AE</Color>

        <SolidColorBrush x:Key="BgDarkBrush"      Color="{StaticResource BgDark}" />
        <SolidColorBrush x:Key="BgPanelBrush"      Color="{StaticResource BgPanel}" />
        <SolidColorBrush x:Key="BgCardBrush"       Color="{StaticResource BgCard}" />
        <SolidColorBrush x:Key="AccentBrush"       Color="{StaticResource Accent}" />
        <SolidColorBrush x:Key="TextPrimaryBrush"  Color="{StaticResource TextPrimary}" />
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondary}" />

        <!-- Semantic palette. View models name a MEANING via ThemeBrushes and never a colour,
             so re-theming the app is an edit to this block alone. -->
        <SolidColorBrush x:Key="AgentStateReadyBrush"          Color="#FF00C9A7" />
        <SolidColorBrush x:Key="AgentStateRunningBrush"        Color="#FF42A5F5" />
        <SolidColorBrush x:Key="AgentStateInactiveBrush"       Color="#FF78909C" />
        <SolidColorBrush x:Key="AgentStateOfflineBrush"        Color="#FF78909C" />
        <SolidColorBrush x:Key="AgentStateUpdatePendingBrush"  Color="#FFFFB74D" />
        <SolidColorBrush x:Key="AgentStateRebootRequiredBrush" Color="#FFCE93D8" />

        <SolidColorBrush x:Key="OutputStdoutBrush"    Color="#FFE0E0E0" />
        <SolidColorBrush x:Key="OutputMutedBrush"     Color="#FF90A4AE" />
        <SolidColorBrush x:Key="OutputCommandBrush"   Color="#FF64B5F6" />
        <SolidColorBrush x:Key="OutputWarnBrush"      Color="#FFFFA726" />
        <SolidColorBrush x:Key="OutputSuccessBrush"   Color="#FF66BB6A" />
        <SolidColorBrush x:Key="OutputErrorBrush"     Color="#FFEF5350" />
        <SolidColorBrush x:Key="OutputSeparatorBrush" Color="#FF444444" />

        <Style TargetType="Button" x:Key="PrimaryButton">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="#FF1A1A2E" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
