<Window x:Class="TestAgentDisplay.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:TestAgentDisplay.ViewModels"
        Title="TestAgent — Real-Time Execution Monitor"
        Height="750" Width="1200" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgDarkBrush}">

    <Window.Icon>
        <DrawingImage>
            <DrawingImage.Drawing>
                <GeometryDrawing Brush="#FF00C9A7" Geometry="M12,2 C6.48,2 2,6.48 2,12 C2,17.52 6.48,22 12,22 C17.52,22 22,17.52 22,12 C22,6.48 17.52,2 12,2 Z M9,16 L5.5,12.5 L6.91,11.09 L9,13.17 L15.59,6.58 L17,8 Z M19,11 L13,11 L13,13 L19,13 Z" />
            </DrawingImage.Drawing>
        </DrawingImage>
    </Window.Icon>

    <Window.Resources>
        <Style x:Key="AgentListItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Padding="{TemplateBinding Padding}"
                                Background="Transparent" CornerRadius="4" Margin="4,1">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource BgCardBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#22FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" MinWidth="200" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- LEFT SIDEBAR -->
        <Border Grid.Column="0" Background="{StaticResource BgPanelBrush}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="🖥  Agent Nodes"
                           FontSize="16" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"
                           Margin="14,14,14,6" />

                <Border DockPanel.Dock="Top" Margin="8,4" Padding="6" CornerRadius="4"
                        Background="{StaticResource BgCardBrush}">
                    <StackPanel>
                        <TextBox Text="{Binding NewAgentAddress, UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="11" Padding="4" Background="#11FFFFFF" Foreground="White"
                                 BorderBrush="#33FFFFFF" />
                        <Button Content="＋ Connect" Margin="0,6,0,0"
                                Style="{StaticResource PrimaryButton}"
                                Command="{Binding ConnectAgentCommand}" />
                    </StackPanel>
                </Border>

                <ListBox ItemsSource="{Binding Agents}"
                         SelectedItem="{Binding SelectedAgent}"
                         Background="Transparent" BorderThickness="0"
                         ItemContainerStyle="{StaticResource AgentListItem}"
                         Margin="0,4,0,0">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:AgentNodeViewModel}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition /><RowDefinition /><RowDefinition />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Ellipse Grid.Row="0" Grid.Column="0" Width="10" Height="10"
                                         Fill="{Binding StateBrush}" Margin="0,2,8,0" VerticalAlignment="Center" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding DisplayName}"
                                           FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding StateText}"
                                           FontSize="11" Foreground="{Binding StateBrush}" VerticalAlignment="Center" />
                                <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                                           Text="{Binding Activity}" FontSize="10"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis" Margin="18,2,0,0" />
                                <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3"
                                           FontSize="10" Foreground="#FF607D8B" Margin="18,1,0,0">
                                    <Run Text="CPU " /><Run Text="{Binding CpuUsage, StringFormat='{}{0:F0}%', Mode=OneWay}" />
                                    <Run Text="  Mem " /><Run Text="{Binding MemoryUsedMb, StringFormat='{}{0:F0}MB', Mode=OneWay}" />
                                    <Run Text="  ✓" /><Run Text="{Binding CompletedCount, Mode=OneWay}" />
                                    <Run Text=" ✗" /><Run Text="{Binding FailedCount, Mode=OneWay}" />
                                </TextBlock>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- RIGHT PANEL -->
        <Grid Grid.Column="1" DataContext="{Binding SelectedAgent}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="3*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="2*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Background="{StaticResource BgPanelBrush}" Padding="14,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="12" Height="12" Fill="{Binding StateBrush}" Margin="0,0,8,0" />
                            <TextBlock FontSize="18" FontWeight="Bold" Foreground="White">
                                <Run Text="{Binding DisplayName, Mode=OneWay}" />
                                <Run Text=" — " Foreground="#FF607D8B" />
                                <Run Text="{Binding StateText, Mode=OneWay}" Foreground="{Binding StateBrush}" />
                            </TextBlock>
                        </StackPanel>
                        <TextBlock FontSize="10" Foreground="#FF607D8B" Margin="20,2,0,0"
                                   Visibility="{Binding CurrentExecutionId, Converter={StaticResource NonEmptyVis}}">
                            <Run Text="Execution ID: " />
                            <Run Text="{Binding CurrentExecutionId, Mode=OneWay}" FontFamily="Consolas" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" />
                        </TextBlock>
                    </StackPanel>
                    <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="16,0"
                               FontSize="11" Foreground="{StaticResource TextSecondaryBrush}">
                        <Run Text="CPU " /><Run Text="{Binding CpuUsage, StringFormat='{}{0:F0}%', Mode=OneWay}" Foreground="{StaticResource AccentBrush}" />
                        <Run Text="  Mem " /><Run Text="{Binding MemoryUsedMb, StringFormat='{}{0:F0}MB', Mode=OneWay}" Foreground="{StaticResource AccentBrush}" />
                        <Run Text="  Disk " /><Run Text="{Binding DiskFreeGb, StringFormat='{}{0:F1}GB', Mode=OneWay}" Foreground="{StaticResource AccentBrush}" />
                    </TextBlock>
                    <Button Grid.Column="2" Content="✕ Disconnect" FontSize="11" Padding="10,4"
                            Background="#33EF5350" Foreground="#FFEF5350" BorderThickness="0" Cursor="Hand"
                            Command="{Binding DataContext.DisconnectAgentCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                </Grid>
            </Border>

            <!-- Command bar -->
            <Border Grid.Row="1" Background="#11FFFFFF" Padding="14,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Margin="0,0,6,0" Padding="6,4"
                             Text="{Binding DataContext.CommandText, UpdateSourceTrigger=PropertyChanged, RelativeSource={RelativeSource AncestorType=Window}}"
                             Background="#11FFFFFF" Foreground="White" BorderBrush="#33FFFFFF"
                             FontFamily="Consolas" FontSize="12" />
                    <TextBox Grid.Column="1" Margin="0,0,6,0" Padding="6,4"
                             Text="{Binding DataContext.CommandArgs, UpdateSourceTrigger=PropertyChanged, RelativeSource={RelativeSource AncestorType=Window}}"
                             Background="#11FFFFFF" Foreground="White" BorderBrush="#33FFFFFF"
                             FontFamily="Consolas" FontSize="12" />
                    <Button Grid.Column="2" Content="▶ Run" Margin="0,0,4,0"
                            Style="{StaticResource PrimaryButton}" FontSize="12" Padding="12,4"
                            Command="{Binding DataContext.RunCommandCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                    <Button Grid.Column="3" Content="■ Kill" Padding="12,4"
                            Background="#33EF5350" Foreground="#FFEF5350" BorderThickness="0"
                            FontSize="12" FontWeight="SemiBold" Cursor="Hand"
                            Command="{Binding DataContext.TerminateExecutionCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                </Grid>
            </Border>

            <!-- Live output -->
            <Border Grid.Row="2" Margin="8,4" CornerRadius="4" Background="#FF0D0D0D">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="#FF1B1B1B" Padding="10,5" CornerRadius="4,4,0,0">
                        <TextBlock Text="▶ Live Execution Output" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource AccentBrush}" />
                    </Border>
                    <ListBox ItemsSource="{Binding OutputLines}"
                             Background="Transparent" BorderThickness="0"
                             FontFamily="Consolas" FontSize="11.5"
                             VirtualizingStackPanel.IsVirtualizing="True"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             x:Name="OutputListBox">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Text}" Foreground="{Binding Foreground}"
                                           TextWrapping="NoWrap" Margin="8,0" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="MinHeight" Value="16" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Row="3" Height="4" HorizontalAlignment="Stretch"
                          Background="{StaticResource BgPanelBrush}" />

            <!-- Execution history -->
            <Border Grid.Row="4" Margin="8,4" CornerRadius="4" Background="#FF0D0D0D">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="#FF1B1B1B" Padding="10,5" CornerRadius="4,4,0,0">
                        <DockPanel>
                            <TextBlock Text="📋 Execution History" FontSize="12" FontWeight="SemiBold" Foreground="White" />
                            <Button DockPanel.Dock="Right" Content="↻ Refresh" FontSize="11"
                                    Padding="8,2" Background="#22FFFFFF" Foreground="White"
                                    BorderThickness="0" Cursor="Hand" HorizontalAlignment="Right"
                                    Command="{Binding DataContext.RefreshHistoryCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                        </DockPanel>
                    </Border>
                    <DataGrid ItemsSource="{Binding History}" AutoGenerateColumns="False"
                              IsReadOnly="True" HeadersVisibility="Column"
                              Background="Transparent" Foreground="White"
                              RowBackground="#FF0D0D0D" AlternatingRowBackground="#FF151515"
                              GridLinesVisibility="None" BorderThickness="0"
                              FontSize="11" CanUserSortColumns="True">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#FF1A1A2E" />
                                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                <Setter Property="Padding" Value="8,4" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding ExecutionId}" Width="100" />
                            <DataGridTextColumn Header="Command" Binding="{Binding Command}" Width="120" />
                            <DataGridTextColumn Header="Command Text" Binding="{Binding CommandText}" Width="*" />
                            <DataGridTextColumn Header="Operation" Binding="{Binding Operation}" Width="90" />
                            <DataGridTextColumn Header="Outcome" Binding="{Binding Outcome}" Width="90" />
                            <DataGridTextColumn Header="Exit" Binding="{Binding ExitCode}" Width="50" />
                            <DataGridTextColumn Header="Duration" Binding="{Binding Duration}" Width="80" />
                            <DataGridTextColumn Header="Started" Binding="{Binding StartedAt}" Width="130" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <!-- Status bar -->
            <Border Grid.Row="5" Background="{StaticResource BgPanelBrush}" Padding="14,4">
                <TextBlock Text="{Binding DataContext.StatusMessage, RelativeSource={RelativeSource AncestorType=Window}}"
                           FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
            </Border>

            <!-- No-agent placeholder -->
            <TextBlock Grid.Row="0" Grid.RowSpan="6"
                       Text="← Select or connect an agent to begin monitoring"
                       FontSize="16" Foreground="#FF455A64"
                       HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>
    </Grid>
</Window>
