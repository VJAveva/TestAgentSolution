  "name": "Example-SmokeE2E",
  "stages": [
    {
      "name": "Prepare",
      "templateId": "Example-Prepare",
      "agentMapping": "pool-fanout"
    },
    {
      "name": "Install",
      "templateId": "Example-Install",
      "agentMapping": "ordered-first-then-rest"
    },
    {
      "name": "Smoke",
      "templateId": "Example-Smoke",
      "agentMapping": "single"
    }
  ]
}
