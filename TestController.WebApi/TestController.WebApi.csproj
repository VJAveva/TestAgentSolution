<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>TestController.WebApi</RootNamespace>
    <SpaRoot>..\TestController.WebClient\</SpaRoot>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\TestControllerGrpc.Core\TestControllerGrpc.Core.csproj" />
    <ProjectReference Include="..\TestController.Api\TestController.Api.csproj" />
    <ProjectReference Include="..\TestController.Persistence\TestController.Persistence.csproj" />
    <ProjectReference Include="..\TestController.Impact\TestController.Impact.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Grpc.Net.Client" Version="2.80.0" />
    <PackageReference Include="Google.Protobuf" Version="3.35.1" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.9" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.9" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.9">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.OpenApi" Version="2.9.0" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.16.0" />
    <PackageReference Include="OpenTelemetry.Exporter.Prometheus.AspNetCore" Version="1.11.2-beta.1" />
    <PackageReference Include="Polly.Core" Version="8.7.0" />
    <PackageReference Include="Scalar.AspNetCore" Version="2.16.7" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Hubs\" />
  </ItemGroup>

  <!-- The impact databases are deliberately NOT packaged. They are resolved at runtime through
       IImpactIndexPathProvider (default %ProgramData%\TestAgentSolution\ImpactIndex) and are host-local
       state, not deliverables: the index is a regenerable cache that reached 1.29 GB, and the outcome
       store is machine-specific learning data. A deployed node provisions the directory via
       Prepare-ControllerNode.ps1 and populates it with Rebuild-ImpactIndex.ps1.
       If these files are ever seen in the publish output, that is a bug, not a missing asset. -->
  <ItemGroup>
    <Content Remove="impact-index.db;impact-index.db-wal;impact-index.db-shm" />
    <Content Remove="impact-outcomes.db;impact-outcomes.db-wal;impact-outcomes.db-shm" />
    <None Remove="impact-index.db;impact-index.db-wal;impact-index.db-shm" />
    <None Remove="impact-outcomes.db;impact-outcomes.db-wal;impact-outcomes.db-shm" />
    <None Update="impact-index.db;impact-index.db-wal;impact-index.db-shm" CopyToPublishDirectory="Never" CopyToOutputDirectory="Never" />
    <None Update="impact-outcomes.db;impact-outcomes.db-wal;impact-outcomes.db-shm" CopyToPublishDirectory="Never" CopyToOutputDirectory="Never" />
  </ItemGroup>

  <!-- IMPACT001: catches a regression to the old in-tree path. The engine must never write a database
       beside the sources again; if it does, the file is one 'git add -f' away from a rejected push.
       Anchored on this file rather than $(SolutionDir), which is undefined when the project builds alone. -->
  <Target Name="WarnOnInTreeImpactIndex" AfterTargets="Build">
    <PropertyGroup>
      <ImpactRepoRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..'))</ImpactRepoRoot>
    </PropertyGroup>
    <ItemGroup>
      <StrayImpactDb Include="$(ImpactRepoRoot)\**\impact-index.db;$(ImpactRepoRoot)\**\impact-outcomes.db"
                     Exclude="$(ImpactRepoRoot)\**\bin\**;$(ImpactRepoRoot)\**\obj\**;$(ImpactRepoRoot)\publish\**" />
    </ItemGroup>
    <Warning Code="IMPACT001"
             Condition="'@(StrayImpactDb)' != ''"
             Text="Impact database found inside the source tree: %(StrayImpactDb.FullPath). It must live under the IImpactIndexPathProvider root (default %25ProgramData%25\TestAgentSolution\ImpactIndex). Delete or move it; see .gitignore and docs/AzureIntegration/FEATURE-ARCHITECTURE.md 'Impact Index Storage'." />
  </Target>
  
   <!-- Auto-build React on publish -->
  <Target Name="BuildReactApp" BeforeTargets="Build" Condition="!Exists('wwwroot\index.html')">
    <Message Importance="high" Text="Building React app from $(SpaRoot)..." />
    <Exec WorkingDirectory="$(SpaRoot)" Command="npm install" />
    <Exec WorkingDirectory="$(SpaRoot)" Command="npm run build" />
    <ItemGroup>
      <ReactBuildFiles Include="$(SpaRoot)dist\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(ReactBuildFiles)" DestinationFolder="wwwroot\%(RecursiveDir)" />
  </Target>

  <!-- Always rebuild React on publish (skip when SkipSpaPublish=true) -->
  <Target Name="PublishReactApp" AfterTargets="ComputeFilesToPublish" Condition="'$(SkipSpaPublish)' != 'true'">
    <Exec WorkingDirectory="$(SpaRoot)" Command="npm ci" />
    <Exec WorkingDirectory="$(SpaRoot)" Command="npm run build" />
    <ItemGroup>
      <ReactPublishFiles Include="$(SpaRoot)dist\**\*" />
      <ResolvedFileToPublish Include="@(ReactPublishFiles)">
        <RelativePath>wwwroot\%(RecursiveDir)%(Filename)%(Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

</Project>
