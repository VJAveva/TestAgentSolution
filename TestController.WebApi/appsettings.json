{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    },
    "CentralSink": {
      "Enabled": false,
      "SeqUrl": "http://localhost:5341",
      "ApiKey": "",
      "BatchSize": 100,
      "FlushIntervalSeconds": 2,
      "MaxBufferedEvents": 10000,
      "MinimumLevel": ""
    }
  },
  "AllowedHosts": "*",
  "ControllerProxyUrl": "http://localhost:5200",
  "WebApiKestrel": {
    "//": "KeepAliveTimeoutHours bounds how long an idle live operator stream stays open. Raise for week-long PSR soak runs. The agent keeps the actual test alive regardless of this value. Default: 4.",
    "KeepAliveTimeoutHours": 4
  },
  "Deployment": {
    "//": "Topology: CoLocated (proxies to a running WPF Controller via ControllerProxyUrl) | Standalone (this WebApi is the sole host, ControllerProxyUrl must be empty) | Auto (infer from ControllerProxyUrl).",
    "Topology": "CoLocated"
  },
  "Ado": {
    "//": "Real Azure DevOps ingest for the Regression tab (CIRP). Enabled=false keeps the mock provider active. Never put PAT/secret values here; the PAT is read from the ADO_PAT environment variable.",
    "Enabled": true,
    "Llm": {
      "//": "LLM-backed code-change summarization (CodeChurn). Off by default. The API key is read from the env var named by ApiKeyEnvVarName (NOT stored here). Endpoint = your Azure OpenAI resource URL; MapModel/ReduceModel = deployment names.",
      "Enabled": false,
      "Endpoint": "",
      "ApiVersion": "2024-10-21",
      "MapModel": "",
      "ReduceModel": "",
      "ApiKeyEnvVarName": "AZURE_OPENAI_API_KEY",
      "MaxFilesPerCommit": 8,
      "MaxDiffBytesPerFile": 8000,
      "CacheDiffs": true,
      "CacheDirectory": "",
      "MaxOutputTokens": 800,
      "Temperature": 0,
      "RequestTimeoutSeconds": 60
    },
    "Organization": "AVEVA-VSTS",
    "Project": "System Platform",
    "OmiProject": "AppServer OMI",
    "Repository": "AASystemPlatformProduct",
    "ActiveSpBuild": "SP-2025",
    "SpBuilds": [
      { "Name": "SP-2025", "DefinitionId": 15744, "LogId": 7 },
      { "Name": "SP2023R2-P01", "DefinitionId": 15753, "LogId": 21 },
      { "Name": "SP-2023-R2-SP1", "DefinitionId": 16092, "LogId": 7 }
    ],
    "SpBuildHistoryCount": 2,
    "AuthMode": "Pat",
    "TenantId": "",
    "ClientId": "",
    "ClientCertificateThumbprint": "",
    "SecretEnvVarName": "ADO_PAT"
  },
  "VocabularyFile": "C:\\TestController\\WatchLists.xml",
  "LogDirectory": "C:\\TestAgentSolution\\Logs",
  "Controller": {
    "Timeouts": {
      "PingTimeoutSeconds": 3,
      "ChannelConnectTimeoutSeconds": 30,
      "KeepAlivePingDelaySeconds": 60,
      "KeepAlivePingTimeoutSeconds": 30,
      "PooledConnectionIdleMinutes": 5,
      "MaxReceiveMessageSizeBytes": 16777216,
      "MaxSendMessageSizeBytes": 16777216,
      "CircuitBreakerBreakSeconds": 30,
      "OuterSafetyNetTimeoutHours": 24,
      "RetryMaxAttempts": 3,
      "RetryDelaySeconds": 1,
      "WaitForAgentFreeMaxSeconds": 30,
      "BusyRecoveryMaxSeconds": 120,
      "BusyRecoveryIntervalSeconds": 10,
      "UnavailableRecoverySeconds": 180,
      "UnavailableRecoveryPollIntervalSeconds": 10,
      "AutoRebootOnUnavailable": true,
      "AutoRebootRecoverySeconds": 300,
      "RebootWaitReadySeconds": 300,
      "RebootRecoveryPollIntervalSeconds": 10,
      "RecoveryControlRpcTimeoutSeconds": 5,
      "TerminateSettleSeconds": 6,
      "OutOfBandRebootCommandTimeoutSeconds": 30
    }
  },
  "BuildResults": {
    "ResultsRootPath": "C:\\TestResults",
    "GoodThreshold": 95.0,
    "WarningThreshold": 85.0,
    "ReportRecipients": "",
    "SmtpServer": "smtp",
    "SmtpPort": 25,
    "FromAddress": "",
    "QaAlertRecipients": "",
    "ConsecutiveFailThreshold": 2,
    "AlertOnLoad": true
  },
  "BuildReportCard": {
    "ReportResultsRoot": "C:\\ReportResults",
    "CiFolders": [
      "SmokeTestResults",
      "LegacyCI",
      "ChangePropagation",
      "WizardPropagation",
      "ObjectWizard",
      "SymbolWizard"
    ],
    "PsrFolderName": "PSR",
    "UseDummyPsr": true,
    "GreenThreshold": 98.0,
    "BlueThreshold": 95.0,
    "AmberThreshold": 90.0,
    "TrendWindow": 10,
    "Grade": {
      "RegressionPenalty": 2.0,
      "PsrFailurePenalty": 3.0,
      "PsrWarningPenalty": 0.5,
      "CiBelow90Penalty": 1.0,
      "AThreshold": 97.0,
      "BThreshold": 93.0,
      "CThreshold": 88.0,
      "DThreshold": 80.0
    },
    "Owners": {
      "SmokeTestResults": { "Team": "Release", "Email": "platform@aveva.com" },
      "LegacyCI": { "Team": "Runtime", "Email": "platform@aveva.com" },
      "ChangePropagation": { "Team": "Config", "Email": "galaxy@aveva.com" },
      "WizardPropagation": { "Team": "Config", "Email": "ide@aveva.com" },
      "ObjectWizard": { "Team": "Config", "Email": "ide@aveva.com" },
      "SymbolWizard": { "Team": "Config", "Email": "symbol@aveva.com" }
    }
  },
  "ImpactMapping": {
    "//": "IndexRoot is where the impact databases live. null = %ProgramData%\\TestAgentSolution\\ImpactIndex (the durable learning store goes to the sibling \\Learning). The IMPACT_INDEX_ROOT environment variable overrides this. Never point it inside the repo: the index is a regenerable cache that reached 1.29 GB and is git-ignored. Provision with deploy\\Prepare-ImpactIndexStorage.ps1, populate with deploy\\Rebuild-ImpactIndex.ps1, check via /health/impact-index.",
    "IndexRoot": null,
    "IndexStaleAfter": "14.00:00:00",
    "Persistence": {
      "//": "Mirrors the DURABLE learning store (impact-outcomes.db) to a share that survives controller VM snapshot reverts, and restores it on startup when the local copy is gone. Snapshots go to <NetworkPath>\\<MachineName>\\ so hosts never overwrite each other. IncludeIndex is off because the retrieval index is regenerable and can exceed 1 GB - rebuilding is cheaper than transferring it.",
      "Enabled": true,
      "NetworkPath": "\\\\dev\\link\\DevTransfer\\VJPersistence",
      "BackupInterval": "00:30:00",
      "StartupDelay": "00:02:00",
      "KeepVersions": 5,
      "IncludeIndex": false,
      "//MergeAcrossHosts": "Folds every host's snapshot into <NetworkPath>\\_canonical and pulls the union back down, so each host learns from runs executed on the others. Safe without locking: outcome rows are append-only facts, so this is a set union. Runs are keyed by Guid; MappingSelections/ExecutionOutcomes use autoincrement ids, so they are unioned on (RunId, TestCaseId) instead - a primary-key union would silently discard another host's rows.",
      "MergeAcrossHosts": true,
      "CanonicalFolderName": "_canonical",
      "//HostId": "Folder name for this host on the share. Empty = machine name. Set only if two impact hosts run on one machine, so they do not overwrite each other's snapshot.",
      "HostId": ""
    }
  },
  "Agents": [
    {
      "Name": "JVGR1",
      "Address": "http://JVGR1:5200"
    },
    {
      "Name": "JVGR2",
      "Address": "http://JVGR2:5200"
    },
    {
      "Name": "JVKPRI",
      "Address": "http://JVKPRI:5200"
    },
    {
      "Name": "JVKBAK",
      "Address": "http://JVKBAK:5200"
    },
    {
      "Name": "JVHIST",
      "Address": "http://JVHIST:5200"
    }
  ],
  "SignalR": {
    "MaximumReceiveMessageSize": 131072,
    "KeepAliveInterval": "00:00:15",
    "ClientTimeoutInterval": "00:00:30"
  },
  "Security": {
    "AuthMode": "None",
    "Domain": {
      "RequireDomain": "XYZ",
      "AdminGroup": "XYZ\\TestAdmins",
      "UserGroup": "XYZ\\TestUsers",
      "FallbackToLocal": true,
      "GroupCacheMinutes": 10
    },
    "Local": {
      "AdminGroup": ".\\Administrators",
      "RequireHttps": true,
      "MinPasswordLength": 12
    },
    "Token": {
      "TokenStore": "secrets.json",
      "TokenRotationDays": 30,
      "EnforceHttps": true
    },
    "Transport": {
      "GrpcMode": "Plaintext",
      "CertThumbprint": "",
      "CertFilePath": "",
      "CertPassword": "",
      "RequireMutualTls": false,
      "TrustedCaThumbprint": "",
      "TlsPort": 5443,
      "CertExpiryWarningDays": 30
    },
    "RateLimit": {
      "Enabled": true,
      "RequestsPerMinute": 300,
      "AdminRequestsPerMinute": 600
    },
    "Audit": {
      "Enabled": true,
      "RetentionDays": 90,
      "LogPath": "C:\\TestControllerService\\Logs"
    }
  }
}
