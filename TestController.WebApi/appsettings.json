{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "CentralSink": {
      "Enabled": false,
      "SeqUrl": "http://localhost:5341",
      "ApiKey": "",
      "BatchSize": 100,
      "FlushIntervalSeconds": 2,
      "MaxBufferedEvents": 10000,
      "MinimumLevel": ""
    }
  },
  "AllowedHosts": "*",
  "ControllerProxyUrl": "http://localhost:5200",
  "WebApiKestrel": {
    "//": "KeepAliveTimeoutHours bounds how long an idle live operator stream stays open. Raise for week-long PSR soak runs. The agent keeps the actual test alive regardless of this value. Default: 4.",
    "KeepAliveTimeoutHours": 4
  },
  "Deployment": {
    "//": "Topology: CoLocated (proxies to a running WPF Controller via ControllerProxyUrl) | Standalone (this WebApi is the sole host, ControllerProxyUrl must be empty) | Auto (infer from ControllerProxyUrl).",
    "Topology": "CoLocated"
  },
  "VocabularyFile": "C:\\TestController\\WatchLists.xml",
  "LogDirectory": "C:\\TestAgentSolution\\Logs",
  "Controller": {
    "Timeouts": {
      "PingTimeoutSeconds": 3,
      "ChannelConnectTimeoutSeconds": 30,
      "KeepAlivePingDelaySeconds": 60,
      "KeepAlivePingTimeoutSeconds": 30,
      "PooledConnectionIdleMinutes": 5,
      "CircuitBreakerBreakSeconds": 30,
      "OuterSafetyNetTimeoutHours": 24,
      "RetryMaxAttempts": 3,
      "RetryDelaySeconds": 1,
      "WaitForAgentFreeMaxSeconds": 30,
      "BusyRecoveryMaxSeconds": 120,
      "BusyRecoveryIntervalSeconds": 10,
      "UnavailableRecoverySeconds": 180,
      "UnavailableRecoveryPollIntervalSeconds": 10,
      "AutoRebootOnUnavailable": true,
      "AutoRebootRecoverySeconds": 300,
      "RebootWaitReadySeconds": 300,
      "RebootRecoveryPollIntervalSeconds": 10,
      "RecoveryControlRpcTimeoutSeconds": 5,
      "TerminateSettleSeconds": 6,
      "OutOfBandRebootCommandTimeoutSeconds": 30
    }
  },
  "BuildResults": {
    "ResultsRootPath": "C:\\TestResults",
    "GoodThreshold": 95.0,
    "WarningThreshold": 85.0,
    "ReportRecipients": "",
    "SmtpServer": "smtp",
    "SmtpPort": 25,
    "FromAddress": "",
    "QaAlertRecipients": "",
    "ConsecutiveFailThreshold": 2,
    "AlertOnLoad": true
  },
  "BuildReportCard": {
    "ReportResultsRoot": "C:\\ReportResults",
    "CiFolders": [
      "SmokeTestResults",
      "LegacyCI",
      "ChangePropagation",
      "WizardPropagation",
      "ObjectWizard",
      "SymbolWizard"
    ],
    "PsrFolderName": "PSR",
    "UseDummyPsr": true,
    "GreenThreshold": 98.0,
    "BlueThreshold": 95.0,
    "AmberThreshold": 90.0,
    "TrendWindow": 10,
    "Grade": {
      "RegressionPenalty": 2.0,
      "PsrFailurePenalty": 3.0,
      "PsrWarningPenalty": 0.5,
      "CiBelow90Penalty": 1.0,
      "AThreshold": 97.0,
      "BThreshold": 93.0,
      "CThreshold": 88.0,
      "DThreshold": 80.0
    },
    "Owners": {
      "SmokeTestResults": { "Team": "platform-team", "Email": "platform@aveva.com" },
      "LegacyCI": { "Team": "platform-team", "Email": "platform@aveva.com" },
      "ChangePropagation": { "Team": "galaxy-team", "Email": "galaxy@aveva.com" },
      "WizardPropagation": { "Team": "ide-team", "Email": "ide@aveva.com" },
      "ObjectWizard": { "Team": "ide-team", "Email": "ide@aveva.com" },
      "SymbolWizard": { "Team": "symbol-team", "Email": "symbol@aveva.com" }
    }
  },
  "Agents": [
    {
      "Name": "JVGR1",
      "Address": "http://JVGR1:5200"
    },
    {
      "Name": "JVGR2",
      "Address": "http://JVGR2:5200"
    },
    {
      "Name": "JVKPRI",
      "Address": "http://JVKPRI:5200"
    },
    {
      "Name": "JVKBAK",
      "Address": "http://JVKBAK:5200"
    },
    {
      "Name": "JVHIST",
      "Address": "http://JVHIST:5200"
    }
  ],
  "SignalR": {
    "MaximumReceiveMessageSize": 131072,
    "KeepAliveInterval": "00:00:15",
    "ClientTimeoutInterval": "00:00:30"
  },
  "Security": {
    "AuthMode": "None",
    "Domain": {
      "RequireDomain": "XYZ",
      "AdminGroup": "XYZ\\TestAdmins",
      "UserGroup": "XYZ\\TestUsers",
      "FallbackToLocal": true,
      "GroupCacheMinutes": 10
    },
    "Local": {
      "AdminGroup": ".\\Administrators",
      "RequireHttps": true,
      "MinPasswordLength": 12
    },
    "Token": {
      "TokenStore": "secrets.json",
      "TokenRotationDays": 30,
      "EnforceHttps": true
    },
    "Transport": {
      "GrpcMode": "Plaintext",
      "CertThumbprint": "",
      "CertFilePath": "",
      "CertPassword": "",
      "RequireMutualTls": false,
      "TrustedCaThumbprint": "",
      "TlsPort": 5443,
      "CertExpiryWarningDays": 30
    },
    "RateLimit": {
      "Enabled": true,
      "RequestsPerMinute": 300,
      "AdminRequestsPerMinute": 600
    },
    "Audit": {
      "Enabled": true,
      "RetentionDays": 90,
      "LogPath": "C:\\TestControllerService\\Logs"
    }
  }
}
