{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Execution Dashboard Data Model",
  "description": "Shared JSON schema for WPF and Web Client execution dashboard data consistency.",
  "definitions": {
    "Session": {
      "type": "object",
      "required": ["sessionId", "watchItemTag", "status", "startedUtc", "agents"],
      "properties": {
        "sessionId":       { "type": "string" },
        "watchItemTag":    { "type": "string" },
        "userId":          { "type": "string" },
        "source":          { "type": "string", "enum": ["WPF", "WebClient"] },
        "status":          { "type": "string", "enum": ["Running", "Success", "Failed", "Cancelled", "Queued"] },
        "startedUtc":      { "type": "string", "format": "date-time" },
        "completedUtc":    { "type": ["string", "null"], "format": "date-time" },
        "elapsed":         { "type": "string" },
        "buildNumber":     { "type": ["string", "null"] },
        "lockedAgents":    { "type": "array", "items": { "type": "string" } },
        "totalActions":    { "type": "integer" },
        "completedActions":{ "type": "integer" },
        "passedActions":   { "type": "integer" },
        "failedActions":   { "type": "integer" },
        "progressPercent": { "type": "integer", "minimum": 0, "maximum": 100 },
        "agents":          { "type": "array", "items": { "$ref": "#/definitions/Agent" } }
      }
    },
    "Agent": {
      "type": "object",
      "required": ["agentName", "status", "actions"],
      "properties": {
        "agentName":       { "type": "string" },
        "status":          { "type": "string", "enum": ["Idle", "Executing", "Rebooting", "Success", "Failed"] },
        "actions":         { "type": "array", "items": { "$ref": "#/definitions/Action" } },
        "completedCount":  { "type": "integer" },
        "totalCount":      { "type": "integer" },
        "progressPercent": { "type": "integer", "minimum": 0, "maximum": 100 },
        "currentAction":   { "type": ["string", "null"] },
        "lastOutput":      { "type": ["string", "null"] }
      }
    },
    "Action": {
      "type": "object",
      "required": ["tag", "status"],
      "properties": {
        "tag":             { "type": "string" },
        "actionType":      { "type": "string" },
        "agentName":       { "type": "string" },
        "command":         { "type": "string" },
        "status":          { "type": "string", "enum": ["Pending", "Running", "Success", "Failed", "Skipped"] },
        "exitCode":        { "type": ["integer", "null"] },
        "errorMessage":    { "type": ["string", "null"] },
        "duration":        { "type": ["string", "null"] },
        "progressPercent": { "type": ["integer", "null"] },
        "startedUtc":      { "type": ["string", "null"], "format": "date-time" },
        "durationSeconds": { "type": ["number", "null"] }
      }
    },
    "LogEntry": {
      "type": "object",
      "required": ["timestamp", "message"],
      "properties": {
        "timestamp":  { "type": "string", "format": "date-time" },
        "sessionId":  { "type": "string" },
        "agentName":  { "type": "string" },
        "category":   { "type": "string" },
        "message":    { "type": "string" },
        "severity":   { "type": "string", "enum": ["Info", "Warning", "Error", "Success"] }
      }
    }
  },
  "type": "object",
  "properties": {
    "sessions": {
      "type": "array",
      "items": { "$ref": "#/definitions/Session" }
    },
    "logs": {
      "type": "array",
      "items": { "$ref": "#/definitions/LogEntry" }
    }
  }
}
